    '備　考：
    Private Sub vsfFlowList_GotFocus(ByVal sender As Object, ByVal e As EventArgs) Handles vsfFlowList0.Enter, vsfFlowList1.Enter
        Dim lvsfFlowList    As C1FlexGrid   'NSYS イベント元グリッド

        Try
            lvsfFlowList = CType(sender, C1FlexGrid)

            'NSYS データ行がない場合は処理を抜ける
            If lvsfFlowList.Rows.Count <= lvsfFlowList.Rows.Fixed Then
                Return
            End If
            
            '@ｺﾋﾟｰ元工順ｸﾞﾘｯﾄﾞが非表示の場合
            If vsfFlowList1.Visible = False Then
                Exit Sub
            End If

            Select Case True
                
                Case sender Is vsfFlowList1
                    cmdUP.Enabled = False
                    cmdDown.Enabled = False
                    cmdDel.Enabled = False
                    cmdEdit.Enabled = False
                    cmdTimeLimitSet.Enabled = False
                    cmdApcSet.Enabled = False
                Case Else
                
                    '@移動ﾎﾞﾀﾝ(↑)(↓)・削除ﾎﾞﾀﾝ
                    Call prvCmdUpDownDelEnabled_Set(lvsfFlowList)
            
                    '@登録ﾎﾞﾀﾝの使用許可
                    Call prvCmdUpdateEnabled_Set()
                    
                    '@APC設定ﾎﾞﾀﾝ制御
                    Call prvcmdApcEnabled_Set()
            
                    '@時間制限ﾎﾞﾀﾝの使用許可
                    Call prvcmdTimeLimitEnabled_Set()
            End Select

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "vsfFlowList_GotFocus"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


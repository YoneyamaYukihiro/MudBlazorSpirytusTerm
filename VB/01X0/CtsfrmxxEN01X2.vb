    '関数名：mnu1_Click
    '機　能：ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ　行のｺﾋﾟｰ/行の挿入
    '引　数：なし
    '戻り値：なし
    '作成日：2006/07/12 (Wed) 10:24:34 N.Kasai
    '更新日：2006/07/12 (Wed) 10:24:34
    '備　考：
    Private Sub mnu1_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu1.Opening

        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            '@行ｺﾋﾟｰﾌﾗｸﾞｵﾝの場合
            If mblnClipCopy = True Then
                
                If mlngWkRow = -1 Then
                    mnu11.Enabled = False   '行のｺﾋﾟｰ
                    mnu12.Enabled = True    '[ｺﾋﾟｰした行を上へ挿入]ﾒﾆｭｰ使用可
                    mnu13.Enabled = False   '[ｺﾋﾟｰした行を下へ挿入]ﾒﾆｭｰ使用不可
                    Exit Sub
                End If
            
                '@編集不可工程の場合
                If vsfFlowList0.GetCellRange(mlngWkRow, CPlngvsfFlowAbsNo).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray) Then
                    mnu11.Enabled = True    '行のｺﾋﾟｰ
                    mnu12.Enabled = False   '[ｺﾋﾟｰした行を上へ挿入]ﾒﾆｭｰ使用不可
                    mnu13.Enabled = False   '[ｺﾋﾟｰした行を下へ挿入]ﾒﾆｭｰ使用不可
                    
                    '@選択行が最終工程の場合
                    If mlngWkRow = vsfFlowList0.Rows.Count - 1 Then
                        
                        Select Case vsfFlowList0.GetData(mlngWkRow, CPlngvsfFlowPermit)
                            
                            '@R、Aﾛｯﾄの最終工程以外の場合は挿入を許可
                            Case CMstrPermit3
                            
                                Select Case vsfFlowList0.GetData(mlngWkRow, CPlngvsfFlowState)
                                    Case CMstrState13
                                        mnu11.Enabled = True    '行ｺﾋﾟｰ
                                        mnu12.Enabled = True    '[ｺﾋﾟｰした行を上へ挿入]ﾒﾆｭｰ使用可
                                        mnu13.Enabled = False   '[ｺﾋﾟｰした行を下へ挿入]ﾒﾆｭｰ使用不可
                                    Case CMstrState14
                                        mnu11.Enabled = True    '行ｺﾋﾟｰ
                                        mnu12.Enabled = False   '[ｺﾋﾟｰした行を上へ挿入]ﾒﾆｭｰ使用不可
                                        mnu13.Enabled = False   '[ｺﾋﾟｰした行を下へ挿入]ﾒﾆｭｰ使用不可
                                    Case Else
                                        mnu11.Enabled = True    '行ｺﾋﾟｰ
                                        mnu12.Enabled = False   '[ｺﾋﾟｰした行を上へ挿入]ﾒﾆｭｰ使用不可
                                        mnu13.Enabled = True    '[ｺﾋﾟｰした行を下へ挿入]ﾒﾆｭｰ使用可
                                End Select
                            
                            Case Else
                                mnu11.Enabled = True    '行ｺﾋﾟｰ
                                mnu12.Enabled = False   '[ｺﾋﾟｰした行を上へ挿入]ﾒﾆｭｰ使用不可
                                mnu13.Enabled = True    '[ｺﾋﾟｰした行を下へ挿入]ﾒﾆｭｰ使用可
                        End Select
                    End If
                    
                Else
                    mnu11.Enabled = True    '行ｺﾋﾟｰ
                    mnu12.Enabled = True    '[ｺﾋﾟｰした行を上へ挿入]ﾒﾆｭｰ使用可
                    mnu13.Enabled = True    '[ｺﾋﾟｰした行を下へ挿入]ﾒﾆｭｰ使用可
                End If
            Else
                If mlngWkRow = -1 Then
                    mnu11.Enabled = False   '行ｺﾋﾟｰ
                    mnu12.Enabled = False   '[ｺﾋﾟｰした行を上へ挿入]ﾒﾆｭｰ使用不可
                    mnu13.Enabled = False   '[ｺﾋﾟｰした行を下へ挿入]ﾒﾆｭｰ使用不可
                    
                    Exit Sub
                End If
                mnu11.Enabled = True
                mnu12.Enabled = False       '[ｺﾋﾟｰした行を上へ挿入]ﾒﾆｭｰ使用不可
                mnu13.Enabled = False       '[ｺﾋﾟｰした行を下へ挿入]ﾒﾆｭｰ使用不可
            End If

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu1_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：mnu11_Click
    '機　能：ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ　行のｺﾋﾟｰ
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/30 (Tue) 17:55:36 N.Kasai
    '更新日：2017/11/08 (Wed) 11:24:44 T.Oide
    '　　　：2009/02/13 (Fri) 10:10:18 T.Oide   Chip電特対応(CDEN_CLASS追加)
    '      ：2016/02/08 (Mon) 22:54:20 H.Hayashi    GRB対応(R12-04)
    '備　考：
    Private Sub mnu11_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu11.Click

        Dim llngRowStart            As Integer  'ｽﾀｰﾄ行
        Dim llngRowEnd              As Integer  'ｴﾝﾄﾞ行
        Dim llngColStart            As Integer  'ｽﾀｰﾄ列
        Dim llngColEnd              As Integer  'ｴﾝﾄﾞ列
        Dim llngAryCount            As Integer  '配列ｶｳﾝﾀ
        Dim llngRow                 As Integer  '行No
        Dim llngIndex               As Integer  'ｲﾝﾃﾞｯｸｽ
        Dim llngCnt2                As Integer  'ｶｳﾝﾀ2
        
        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            '@目的の値をｸﾘｯﾌﾟﾎﾞｰﾄﾞに代入
            With vsfFlowList0
            
                '@選択範囲の取得
                llngRowStart = .Selection.TopRow
                llngColStart = .Selection.LeftCol
                llngRowEnd = .Selection.BottomRow
                llngColEnd = .Selection.RightCol
                
                '@見出しも含め選択された場合
                If llngRowStart = 0 Then
                    llngRowStart = 1
                End If
                
                ptypCopyCondDetailList.lngProcCondDetailCnt = 0
                If ptypCopyCondDetailList.typProcCondDetail Is Nothing Then
                    ptypCopyCondDetailList.typProcCondDetail = New List(Of ProcCondDetail)
                Else
                    ptypCopyCondDetailList.typProcCondDetail.Clear
                End If

                mstrOpIdCopy = vbNullString
                mstrStepIdCopy = vbNullString
                mstrConditionCopy = vbNullString
                mstrConditionCopyVer = vbNullString
                mstrConditionCopyValid = vbNullString
                mstrConditionOne = vbNullString
                mstrLotRecipeFlag = vbNullString
                mstrWFRecipeFlag = vbNullString
                mstrRecipeChgFlg = vbNullString
                
                '@ｺﾋﾟｰ配列再定義
                mtypCopyFlowList.lngLotProcFlowCnt = llngRowEnd - llngRowStart + 1

                If mtypCopyFlowList.typLotProcFlow Is Nothing Then
                    mtypCopyFlowList.typLotProcFlow = New List(Of FlowList)
                Else
                    mtypCopyFlowList.typLotProcFlow.Clear
                End If

                llngAryCount = 0
                '@選択範囲分、以下の処理を繰り返す
                For llngRow = llngRowStart To llngRowEnd
                    Dim typLotProcFlowTmp As New FlowList
                    '@ｺﾋﾟｰ配列に代入
                    typLotProcFlowTmp.strAbsNo = .GetData(llngRow, CPlngvsfFlowAbsNo)                              '絶対工順番号
                    typLotProcFlowTmp.strOpID = .GetData(llngRow, CPlngvsfFlowOpID)                                '大工程名
                    typLotProcFlowTmp.strStepID = .GetData(llngRow, CPlngvsfFlowStepID)                            '小工程名
                    typLotProcFlowTmp.strConditionId = .GetData(llngRow, CPlngvsfFlowConditionID)                  '処理条件ｾｯﾄID
                    typLotProcFlowTmp.strConditionVersion = .GetData(llngRow, CPlngvsfFlowConditionVer)            '処理条件Ver
                    typLotProcFlowTmp.strConditionOne = .GetData(llngRow, CPlngvsfFlowConditionOne)                '処理条件（個別）
                    typLotProcFlowTmp.strSelectConditionID = .GetData(llngRow, CPlngvsfFlowSelectConditionID)      'WF選択条件ｾｯﾄID
                    typLotProcFlowTmp.strCollectionID = .GetData(llngRow, CPlngvsfFlowCollectionID)                '収集項目ｾｯﾄID
                    typLotProcFlowTmp.strCollectionVersion = .GetData(llngRow, CPlngvsfFlowCollectionVer)          '収集項目Ver
                    typLotProcFlowTmp.strLotScrapSetID = .GetData(llngRow, CPlngvsfFlowLotScrapSetId)              '不良項目ｾｯﾄID
                    typLotProcFlowTmp.strReworkRouteID = .GetData(llngRow, CPlngvsfFlowReworkRouteID)              'ﾘﾜｰｸﾙｰﾄID
                    typLotProcFlowTmp.strReworkReturnOpID = vbNullString                                                    'ﾘﾜｰｸﾙｰﾄ戻り大工程
                    typLotProcFlowTmp.strReworkReturnStepID = vbNullString                                                  'ﾘﾜｰｸﾙｰﾄ戻り小工程
                    typLotProcFlowTmp.strSpecialRouteID = .GetData(llngRow, CPlngvsfFlowSPRouteID)                 '特殊ﾙｰﾄID
                    typLotProcFlowTmp.strSpecialReturnOpID = vbNullString                                                   '特殊ﾙｰﾄ戻り大工程
                    typLotProcFlowTmp.strSpecialReturnStepID = vbNullString                                                 '特殊ﾙｰﾄ戻り小工程
                    typLotProcFlowTmp.strSwapIndicator = .GetData(llngRow, CPlngvsfFlowSwapIndictor)               '入替可能工程
                    typLotProcFlowTmp.strAltPointer = vbNullString                                                          '代替工程
                    typLotProcFlowTmp.strAltStartFlag = vbNullString                                                        '代替工程
                    typLotProcFlowTmp.strAltEndFlag = vbNullString                                                          '代替工程
                    
                    '@時間制限
                    typLotProcFlowTmp.lngTimeOrderCnt = 0                                                                   '時間制限ﾘｽﾄｶｳﾝﾄ
                    typLotProcFlowTmp.strRestrictFlag = vbNullString
                    
                    typLotProcFlowTmp.strSFlag = .GetData(llngRow, CPlngvsfFlowSFlag)                              '特殊特性
                    typLotProcFlowTmp.strEntryID = .GetData(llngRow, CPlngvsfFlowEntryID)                          'ｴﾝﾄﾘID
                    typLotProcFlowTmp.strWorkCondition = .GetData(llngRow, CPlngvsfFlowWorkCondition)              '作業条件
                    typLotProcFlowTmp.strCommitFlag = .GetData(llngRow, CPlngvsfFlowCommitFlag)                    '号機指定
                    typLotProcFlowTmp.strJudgeSkipFlag = .GetData(llngRow, CPlngvsfFlowJudgeSkipFlag)              'SPC判定ｽｷｯﾌﾟﾌﾗｸﾞ( 0: SKIP不可、1:SKIP可）
                    typLotProcFlowTmp.strApcSkipFlag = vbNullString                                                         'APC適用外
                    typLotProcFlowTmp.strApcCalcSkipFlag = vbNullString                                                     'APC計算除外
                    typLotProcFlowTmp.strWpRestrictKind = vbNullString                                                     'APC計算除外
                    typLotProcFlowTmp.strWpRestrictNum = vbNullString                                                     'APC計算除外
                    
                    
                    typLotProcFlowTmp.strState = CMstrState8           '状態（追加挿入）
                    typLotProcFlowTmp.strPermit = CMstrPermit1         '変更可否（変更可）
                    typLotProcFlowTmp.strChange = CMstrChange1         '変更区分（変更あり）
                    
                    '@Discon情報格納
                    typLotProcFlowTmp.strOpValid = .GetData(llngRow, CPlngvsfFlowOpValid)                          '大工程有効ﾌﾗｸﾞ
                    typLotProcFlowTmp.strStepValid = .GetData(llngRow, CPlngvsfFlowStepValid)                      '小工程有効ﾌﾗｸﾞ
                    typLotProcFlowTmp.strConditionValid = .GetData(llngRow, CPlngvsfFlowConditionValid)            '処理条件ｾｯﾄID有効ﾌﾗｸﾞ
                    typLotProcFlowTmp.strCollectionValid = .GetData(llngRow, CPlngvsfFlowCollectionValid)          '収集項目ｾｯﾄID有効ﾌﾗｸﾞ
                    typLotProcFlowTmp.strReworkRouteValid = .GetData(llngRow, CPlngvsfFlowReworkRouteValid)        'ﾘﾜｰｸﾙｰﾄID有効ﾌﾗｸﾞ
                    typLotProcFlowTmp.strSpecialRouteValid = .GetData(llngRow, CPlngvsfFlowSPRouteValid)           '特殊ﾙｰﾄID有効ﾌﾗｸﾞ
                    
                    typLotProcFlowTmp.strCdenClass = .GetData(llngRow, CPlngvsfFlowCdenClass)                      'CDEN_CLASS
                    typLotProcFlowTmp.strTpalClass = .GetData(llngRow, CPlngvsfFlowTpalClass)                      'TPAL設定
                    typLotProcFlowTmp.strCarrierCategoryId = .GetData(llngRow, CPlngvsfFlowCarrierCategoryID)      'ｷｬﾘｱｶﾃｺﾞﾘ
                    typLotProcFlowTmp.strMapUseFlag = vbNullString
                    typLotProcFlowTmp.strGrbClass = .GetData(llngRow, CPlngvsfFlowGrbClass)                        'GRB限定工程設定

                    '@区間優先度はｺﾋﾟｰ対象外
                    typLotProcFlowTmp.strPriority = vbNullString
                    
                    '@ﾌﾗｸﾞ格納
                    '@枚葉ﾚｼﾋﾟﾌﾗｸﾞのみ、WF選択条件が設定されるとｺﾝﾄﾛｰﾙｻｰﾊﾞｰでWFﾚｼﾋﾟﾌﾗｸﾞが立つ場合がある。
                    typLotProcFlowTmp.strProcChangeRecipeFlag = .GetData(llngRow, CPlngvsfFlowRecipeChgFlg)
                    
                    '@個別処理条件設定ずみの場合
                    If .GetData(llngRow, CPlngvsfFlowRecipeChgFlg) = "1" Then
                        '@ﾛｯﾄ、WFﾚｼﾋﾟﾌﾗｸﾞを反映
                        typLotProcFlowTmp.strLotRecipeFlag = .GetData(llngRow, CPlngvsfFlowLotRecipeFlag)
                        typLotProcFlowTmp.strWfRecipeFlag = .GetData(llngRow, CPlngvsfFlowWFRecipeFlag)
                    Else
                        typLotProcFlowTmp.strLotRecipeFlag = "0"
                        typLotProcFlowTmp.strWfRecipeFlag = "0"
                    End If
                    
                    '@個別処理条件格納
                    If .GetData(llngRow, CPlngvsfFlowConditionOne) <> vbNullString Then
                        '@ｲﾝﾃﾞｯｸｽ初期化
                        llngIndex = -1

                        '@対象ｲﾃﾞｰﾀ検索
                        For llngCnt2 = 0 To ptypProcCondDetailList.lngProcCondDetailCnt -1

                            '@ｺﾋﾟｰ元のSeq_Noと実構造体の
                            If typLotProcFlowTmp.strAbsNo = ptypProcCondDetailList.typProcCondDetail(llngCnt2).strAbsNo Then
                                llngIndex = llngCnt2
                                Exit For
                            End If
                        Next
                     
                        '@検索結果
                        If llngIndex <> -1 Then
                            With ptypCopyCondDetailList
                                '@個別処理設定配列を再定義
                                .lngProcCondDetailCnt = .lngProcCondDetailCnt + 1
                                Dim ltypProcCondDetailTmp As New ProcCondDetail

                                '@工順番号ｾｯﾄ
                                ltypProcCondDetailTmp = ptypProcCondDetailList.typProcCondDetail(llngIndex)
                                'NSYS ディープコピー
                                If ptypProcCondDetailList.typProcCondDetail(llngIndex).typProcCond IsNot Nothing Then
                                    ltypProcCondDetailTmp.typProcCond = _
                                        New List(Of ProcCond)(ptypProcCondDetailList.typProcCondDetail(llngIndex).typProcCond)
                                End If
                                .typProcCondDetail.Add(ltypProcCondDetailTmp)

                            End With
                        End If
                    End If
                    mtypCopyFlowList.typLotProcFlow.Add(typLotProcFlowTmp)
                    '@ﾃﾞｰﾀｶｳﾝﾄｱｯﾌﾟ
                    llngAryCount = llngAryCount + 1
                Next
            
            End With

            '@行ｺﾋﾟｰﾌﾗｸﾞｵﾝ
            mblnClipCopy = True

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu11_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：mnu12_Click
    '機　能：ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ　ｺﾋﾟｰした行を上へ挿入
    '引　数：なし
    '戻り値：なし
    '作成日：2006/06/30 (Fri) 18:45:27 N.Kasai
    '更新日：2006/06/30 (Fri) 18:45:27
    '備　考：
    Private Sub mnu12_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu12.Click
        
        Dim llngCnt             As Integer      'ｶｳﾝﾀ
        Dim llngCnt2            As Integer      'ｶｳﾝﾀ2
        
        Dim llngMsgAns          As Integer      'ﾒｯｾｰｼﾞ戻り値
        Dim llngFindRow         As Integer      '検索行
        Dim lstrSeekWord        As String       '検索戻り値
        Dim lstrAltPointer      As String       '代替番号文字列を格納
        Dim llngRow             As Integer      'ｸﾘｱ対象行
        Dim lstrSearchString    As String       'ｸﾘｱ文字
        
        Dim lstrAry()           As String       'ｾﾙ内時間制限配列
        Dim llngAryCount        As Integer      '配列ｶｳﾝﾀ1
        Dim lstrAry2()          As String       'ｾﾙ内時間制限配列
        Dim llngAryCount2       As Integer      '配列ｶｳﾝﾀ2
        Dim lstrAry3()          As String       '代替番号配列
        Dim llngAryCount3       As Integer      '配列ｶｳﾝﾀ3
        
        Dim lblnErrFlag         As Boolean      'ｴﾗｰ表示ﾌﾗｸﾞ
        Dim lblnSwapIndictor    As Boolean      '入替存在ﾌﾗｸﾞ
        Dim lblnAltSet          As Boolean      '代替存在ﾌﾗｸﾞ
        Dim lblnTimeLimit       As Boolean      '時間制限
        
        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            '@ｴﾗｰ表示ﾌﾗｸﾞ初期化
            lblnErrFlag = False
            
            '@存在ﾌﾗｸﾞ初期化
            lblnSwapIndictor = False
            lblnAltSet = False
            lblnTimeLimit = False
            
            With vsfFlowList0
            
                '@入れ替え工程
                If mlngWkRow > 1 Then
                        
                    '@入替工程
                    If .GetData(mlngWkRow, CPlngvsfFlowSwapIndictor) <> vbNullString Then
                    
                        If .GetData(mlngWkRow - 1, CPlngvsfFlowSwapIndictor) <> vbNullString Then
                            '@入替工程の間に行挿入した場合
                            lblnErrFlag = True
                            lblnSwapIndictor = True
                        End If
                    End If
                    
                    '@代替工程
                    '@該当工程より上の工程を検索
                    For llngCnt = mlngWkRow - 1 To 1 Step -1
                        '@代替工程検索
                        If .GetData(llngCnt, CPlngvsfFlowAltSet) <> vbNullString Then
                            If Strings.Right$(.GetData(llngCnt, CPlngvsfFlowAltSet), 1) = CMstrStartMark Then
                                
                                '@S→Eにﾘﾌﾟﾚｲｽ
                                lstrSeekWord = Replace(.GetData(llngCnt, CPlngvsfFlowAltSet), CMstrStartMark, CMstrEndMark)
                                '@文字列検索
                                llngFindRow = .FindRow(lstrSeekWord, .Rows.Fixed, CPlngvsfFlowAltSet, False)
                                
                                If llngFindRow <> -1 Then
                                    If llngFindRow >= mlngWkRow Then
                                        lblnErrFlag = True
                                        lblnAltSet = True
                                        '@対象代替番号を取得
                                        lstrAltPointer = lstrAltPointer & Strings.Left$(.GetData(llngCnt, CPlngvsfFlowAltSet), CMlngLeftGetStringNo5) & CMstrComma
                                        '@削除対象代替番号を格納
                                        lstrAry3 = Split(lstrAltPointer, CMstrComma)
                                    End If
                                End If
                            End If
                        End If
                    Next
                    
                    '@時間制限
                    '@該当工程より上の工程を検索
                    For llngCnt = mlngWkRow - 1 To 1 Step -1
                    
                        '@時間制限検索
                        If .GetData(llngCnt, CPlngvsfFlowTimeLimit) <> vbNullString Then
                            
                            '@現在のｾﾙの値を配列に格納
                            lstrAry = Split(.GetData(llngCnt, CPlngvsfFlowTimeLimit), CMstrComma)
            
                            '@配列数分、以下の処理を繰り返す
                            For llngAryCount = 0 To UBound(lstrAry)
                            
                                If Strings.Right$(lstrAry(llngAryCount), 1) = CMstrStartMark Then
                                    '@検索文字取得
                                    lstrSeekWord = Replace(lstrAry(llngAryCount), CMstrStartMark, CMstrEndMark)
                                    
                                    For llngCnt2 = mlngWkRow To .Rows.Count - 1
                                    
                                        '@時間制限検索
                                        If .GetData(llngCnt2, CPlngvsfFlowTimeLimit) <> vbNullString Then
                                            
                                            '@現在のｾﾙの値を配列に格納
                                            lstrAry2 = Split(.GetData(llngCnt2, CPlngvsfFlowTimeLimit), CMstrComma)
                            
                                            '@配列数分、以下の処理を繰り返す
                                            For llngAryCount2 = 0 To UBound(lstrAry2)
                                                
                                                If lstrSeekWord = lstrAry2(llngAryCount2) Then
                                                    lblnErrFlag = True
                                                    lblnTimeLimit = True
                                                    Exit For
                                                End If
                                            Next
                                        End If
                                        
                                        If lblnTimeLimit = True Then
                                            Exit For
                                        End If
                                    Next
                                End If
                            Next
                        End If
                        
                        If lblnTimeLimit = True Then
                            Exit For
                        End If
                    Next
                    
                    '@注意ありの場合
                    If lblnErrFlag = True Then
                        
                        '@入替え又は代替工程が存在し、時間制限が未設定の場合
                        If (lblnSwapIndictor = True Or lblnAltSet = True) And lblnTimeLimit = False Then
                            '@表示ﾒｯｾｰｼﾞ変換
                            '@"<TRM5QI>$$入替、代替工程が設定されている工程間に挿入しようとしています。
                            '@ $設定はクリアされますがよろしいですか？"
                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005Q)
                    
                        End If
                         
                        '@時間制限、入替え又は代替工程が存在の場合
                        If (lblnSwapIndictor = True Or lblnAltSet = True) And lblnTimeLimit = True Then
                            '@表示ﾒｯｾｰｼﾞ変換
                            '@"<TRM5SI>$$時間制限、入替、代替工程が設定されている工程間に挿入しようとしています。
                            '@ $挿入した場合は時間制限内容を見直してください。
                            '@ $入替、代替設定についてはクリアされますがよろしいですか？"
                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005S)
                        End If
                        
                        '@入替、代替工程なし、時間制限存在の場合
                        If lblnSwapIndictor = False And lblnAltSet = False And lblnTimeLimit = True Then
                            '@表示ﾒｯｾｰｼﾞ変換
                            '@"<TRM5RI>$$時間制限が設定されている工程間に挿入しようとしています。
                            '@ $挿入した場合は時間制限内容を見直してください。$よろしいですか？"
                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005R)
                        End If
                        
                        llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                        '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                        If llngMsgAns = vbNo Then       '「いいえ」を選択(削除処理ｷｬﾝｾﾙ)
                            Exit Sub
                        End If
               
                
                        '@表示ｸﾘｱ処理
                    
                        '@入替工程ｸﾘｱ処理
                        If lblnSwapIndictor = True Then
                            lstrSearchString = vbNullString
                            '@該当文字格納
                            lstrSearchString = .GetData(mlngWkRow - 1, CPlngvsfFlowSwapIndictor)
                            '@該当文字列を検索
                            For llngRow = 1 To .Rows.Count - 1
                                '@該当文字判定
                                If .GetData(llngRow, CPlngvsfFlowSwapIndictor) = lstrSearchString Then
                                    '@表示ｸﾘｱ
                                    .SetData(llngRow, CPlngvsfFlowSwapIndictor, vbNullString)
                                    .SetData(llngRow, CPlngvsfFlowSwapIndictorCopy, vbNullString)
                                    '@ﾊﾞｯｸｶﾗｰ変更処理
                                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                    Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowSwapIndictor)
                                    cellRange.Style = newStyle
                                    .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）

                                End If
                            Next
                        End If
                        
                        '@代替工程
                        If lblnAltSet = True Then
                            '@配列数分、以下の処理を繰り返す
                            For llngAryCount3 = 0 To UBound(lstrAry3)
                                '@ﾌﾛｰﾘｽﾄを検索
                                For llngRow = 1 To .Rows.Count - 1
                                    '@代替が設定されていたら
                                    If .GetData(llngRow, CPlngvsfFlowAltSet) <> vbNullString Then
                                        If lstrAry3(llngAryCount3) = Strings.Left$(.GetData(llngRow, CPlngvsfFlowAltSet), CMlngLeftGetStringNo5) Then
                                            '@代替工程を削除
                                            .SetData(llngRow, CPlngvsfFlowAltSet, vbNullString)
                                            .SetData(llngRow, CPlngvsfFlowAltPointer, vbNullString)
                                            .SetData(llngRow, CPlngvsfFlowAltStartFlag, CMstrFlgOff)
                                            .SetData(llngRow, CPlngvsfFlowAltEndFlag, CMstrFlgOff)
                                            '@ﾊﾞｯｸｶﾗｰ変更処理
                                            Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                            Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowAltSet)
                                            cellRange.Style = newStyle
                                            .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）

                                        End If
                                    End If
                                Next
                            Next
                        End If
                    End If
                End If
            End With

            '@配列のｸﾘｱ
            Erase lstrAry
            Erase lstrAry2
            Erase lstrAry3
            
            '@行挿入処理
            Call prvPasteCopyLine_Exec()
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu12_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：mnu13_Click
    '機　能：ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ　ｺﾋﾟｰした行を下へ挿入
    '引　数：なし
    '戻り値：
    '作成日：2006/06/28 (Wed) 14:40:26 N.Kasai
    '更新日：2006/06/28 (Wed) 14:40:26
    '備　考：
    Private Sub mnu13_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu13.Click

        Dim llngCnt             As Integer      'ｶｳﾝﾀ
        Dim llngCnt2            As Integer      'ｶｳﾝﾀ2
        
        Dim llngMsgAns          As Integer      'ﾒｯｾｰｼﾞ戻り値
        Dim llngFindRow         As Integer      '検索行
        Dim lstrSeekWord        As String       '検索戻り値
        Dim lstrAltPointer      As String       '代替番号文字列を格納
        Dim llngRow             As Integer      'ｸﾘｱ対象行
        Dim lstrSearchString    As String       'ｸﾘｱ文字
        
        Dim lstrAry()           As String       'ｾﾙ内時間制限配列
        Dim llngAryCount        As Integer      '配列ｶｳﾝﾀ1
        Dim lstrAry2()          As String       'ｾﾙ内時間制限配列
        Dim llngAryCount2       As Integer      '配列ｶｳﾝﾀ2
        Dim lstrAry3()          As String       '代替番号配列
        Dim llngAryCount3       As Integer      '配列ｶｳﾝﾀ3
        
        Dim lblnErrFlag         As Boolean      'ｴﾗｰ表示ﾌﾗｸﾞ
        Dim lblnSwapIndictor    As Boolean      '入替存在ﾌﾗｸﾞ
        Dim lblnAltSet          As Boolean      '代替存在ﾌﾗｸﾞ
        Dim lblnTimeLimit       As Boolean      '時間制限
        
        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            '@ｴﾗｰ表示ﾌﾗｸﾞ初期化
            lblnErrFlag = False
            
            '@存在ﾌﾗｸﾞ初期化
            lblnSwapIndictor = False
            lblnAltSet = False
            lblnTimeLimit = False
            
            With vsfFlowList0
            
                If mlngWkRow <> .Rows.Count - 1 Then
                        
                    '@入替工程
                    If .GetData(mlngWkRow, CPlngvsfFlowSwapIndictor) <> vbNullString Then
                    
                        If .GetData(mlngWkRow + 1, CPlngvsfFlowSwapIndictor) <> vbNullString Then
                            '@入替工程の間に行挿入した場合
                            lblnErrFlag = True
                            lblnSwapIndictor = True
                        End If
                    End If
                    
                    '@代替工程
                    '@該当工程より下の工程を検索
                    For llngCnt = mlngWkRow + 1 To .Rows.Count - 1
                        '@代替工程検索
                        If .GetData(llngCnt, CPlngvsfFlowAltSet) <> vbNullString Then
                            If Strings.Right$(.GetData(llngCnt, CPlngvsfFlowAltSet), 1) = CMstrEndMark Then
                                
                                lstrSeekWord = Replace(.GetData(llngCnt, CPlngvsfFlowAltSet), CMstrEndMark, CMstrStartMark)
                                
                                llngFindRow = .FindRow(lstrSeekWord, .Rows.Fixed, CPlngvsfFlowAltSet, False)
                                
                                If llngFindRow <> -1 Then
                                    If llngFindRow <= mlngWkRow Then
                                        lblnErrFlag = True
                                        lblnAltSet = True
                                        '@対象代替番号を取得
                                        lstrAltPointer = lstrAltPointer & Strings.Left$(.GetData(llngCnt, CPlngvsfFlowAltSet), CMlngLeftGetStringNo5) & CMstrComma
                                        '@削除対象代替番号を格納
                                        lstrAry3 = Split(lstrAltPointer, CMstrComma)
            
                                        Exit For
                                    End If
                                End If
                            End If
                        End If
                    Next
                    
                    '@時間制限
                    '@該当工程より上の工程を検索
                    For llngCnt = mlngWkRow + 1 To .Rows.Count - 1
                    
                        '@時間制限検索
                        If .GetData(llngCnt, CPlngvsfFlowTimeLimit) <> vbNullString Then
                            
                            '@現在のｾﾙの値を配列に格納
                            lstrAry = Split(.GetData(llngCnt, CPlngvsfFlowTimeLimit), CMstrComma)
            
                            '@配列数分、以下の処理を繰り返す
                            For llngAryCount = 0 To UBound(lstrAry)
                            
                                If Strings.Right$(lstrAry(llngAryCount), 1) = CMstrEndMark Then
                                
                                    '@対象文字取得
                                    lstrSeekWord = Replace(lstrAry(llngAryCount), CMstrEndMark, CMstrStartMark)
                                    
                                    For llngCnt2 = mlngWkRow To 1 Step -1
                                    
                                        '@時間制限検索
                                        If .GetData(llngCnt2, CPlngvsfFlowTimeLimit) <> vbNullString Then
                                            
                                            '@現在のｾﾙの値を配列に格納
                                            lstrAry2 = Split(.GetData(llngCnt2, CPlngvsfFlowTimeLimit), CMstrComma)
                            
                                            '@配列数分、以下の処理を繰り返す
                                            For llngAryCount2 = 0 To UBound(lstrAry2)
                                                
                                                If lstrSeekWord = lstrAry2(llngAryCount2) Then
                                                    lblnErrFlag = True
                                                    lblnTimeLimit = True
                                                    Exit For
                                                End If
                                            Next
                                        End If
                                        
                                        If lblnTimeLimit = True Then
                                            Exit For
                                        End If
                                    Next
                                End If
                            Next
                        End If
                        
                        If lblnTimeLimit = True Then
                            Exit For
                        End If
                    Next
            
                    '@注意ありの場合
                    If lblnErrFlag = True Then
                        '@入替え又は代替工程が存在し、時間制限が未設定の場合
                        If (lblnSwapIndictor = True Or lblnAltSet = True) And lblnTimeLimit = False Then
                            '@表示ﾒｯｾｰｼﾞ変換
                            '@"<TRM5QI>$$入替、代替工程が設定されている工程間に挿入しようとしています。
                            '@ $設定はクリアされますがよろしいですか？"
                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005Q)
                    
                        End If
                         
                        '@時間制限、入替え又は代替工程が存在の場合
                        If (lblnSwapIndictor = True Or lblnAltSet = True) And lblnTimeLimit = True Then
                            '@表示ﾒｯｾｰｼﾞ変換
                            '@"<TRM5SI>$$時間制限、入替、代替工程が設定されている工程間に挿入しようとしています。
                            '@ $挿入した場合は時間制限内容を見直してください。
                            '@ $入替、代替設定についてはクリアされますがよろしいですか？"
                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005S)
                        End If
                        
                        '@入替、代替工程なし、時間制限存在の場合
                        If lblnSwapIndictor = False And lblnAltSet = False And lblnTimeLimit = True Then
                            '@表示ﾒｯｾｰｼﾞ変換
                            '@"<TRM5RI>$$時間制限が設定されている工程間に挿入しようとしています。
                            '@ $挿入した場合は時間制限内容を見直してください。$よろしいですか？"
                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005R)
                        End If
                        
                        llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                        '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                        If llngMsgAns = vbNo Then       '「いいえ」を選択(削除処理ｷｬﾝｾﾙ)
                            Exit Sub
                        End If
                    End If
                    
                    '@表示ｸﾘｱ処理
                
                    '@入替工程ｸﾘｱ処理
                    If lblnSwapIndictor = True Then
                        lstrSearchString = vbNullString
                        '@該当文字格納
                        lstrSearchString = .GetData(mlngWkRow + 1, CPlngvsfFlowSwapIndictor)
                        '@該当文字列を検索
                        For llngRow = 1 To .Rows.Count - 1
                            '@該当文字判定
                            If .GetData(llngRow, CPlngvsfFlowSwapIndictor) = lstrSearchString Then
                                '@表示ｸﾘｱ
                                .SetData(llngRow, CPlngvsfFlowSwapIndictor, vbNullString)
                                .SetData(llngRow, CPlngvsfFlowSwapIndictorCopy, vbNullString)
                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowSwapIndictor)
                                cellRange.Style = newStyle
                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）

                            End If
                        Next
                    End If
                
                    '@代替工程ｸﾘｱ処理
                    If lblnAltSet = True Then
                        '@配列数分、以下の処理を繰り返す
                        For llngAryCount3 = 0 To UBound(lstrAry3)
                            '@ﾌﾛｰﾘｽﾄを検索
                            For llngRow = 1 To .Rows.Count - 1
                                '@代替が設定されていたら
                                If .GetData(llngRow, CPlngvsfFlowAltSet) <> vbNullString Then
                                    If lstrAry3(llngAryCount3) = Strings.Left$(.GetData(llngRow, CPlngvsfFlowAltSet), CMlngLeftGetStringNo5) Then
                                        '@代替工程を削除
                                        .SetData(llngRow, CPlngvsfFlowAltSet, vbNullString)
                                        .SetData(llngRow, CPlngvsfFlowAltPointer, vbNullString)
                                        .SetData(llngRow, CPlngvsfFlowAltStartFlag, CMstrFlgOff)
                                        .SetData(llngRow, CPlngvsfFlowAltEndFlag, CMstrFlgOff)
                                        '@ﾊﾞｯｸｶﾗｰ変更処理
                                        Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                        Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowAltSet)
                                        cellRange.Style = newStyle
                                        .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）

                                    End If
                                End If
                            Next
                        Next
                    End If
                End If
            End With
            
            '@配列のｸﾘｱ
            Erase lstrAry
            Erase lstrAry2
            Erase lstrAry3
            
            '@行の再定義
            mlngWkRow = mlngWkRow + 1
            
            '@行挿入処理
            Call prvPasteCopyLine_Exec()
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu13_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：mnu2_Click
    '機　能：ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ　ｺﾋﾟｰ/貼り付け/削除
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/30 (Tue) 14:35:35 N.Kasai
    '更新日：2006/05/30 (Tue) 14:35:35
    '備　考：
    Private Sub mnu2_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu2.Opening
        
        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

        '@----------------------------------------
        '@mnu21：ｺﾋﾟｰ、mnu22：貼り付け、mnu23：削除
        '@----------------------------------------
            With vsfFlowList0
                '@内容がない場合は、ｺﾋﾟｰ/削除できない
                If .GetData(.Row, .Col) = vbNullString Then
                    mnu21.Enabled = False
                    mnu23.Enabled = False
                    '@現工程以前の場合、貼り付け不可
                    If .GetCellRange(.Row, .Col).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray) Then
                        mnu22.Enabled = False
                        Exit Sub
                    End If
                Else
                    mnu21.Enabled = True

                    '@現工程以前の場合、貼り付け/削除不可
                    If .GetCellRange(.Row, .Col).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray) Then
                        mnu22.Enabled = False
                        mnu23.Enabled = False
                        Exit Sub
                    Else
                        mnu22.Enabled = False
                        mnu23.Enabled = True
                    End If
                End If
                
                Select Case .Col
                    
                    '大工程
                    Case CPlngvsfFlowOpID
                        
                        '@ｺﾋﾟｰされていない場合は、貼り付けできない
                        If mstrOpIdCopy = vbNullString Then
                            mnu22.Enabled = False
                        Else
                            mnu22.Enabled = True
                        End If
                    
                    '小工程
                    Case CPlngvsfFlowStepID
                        
                        '@ｺﾋﾟｰされていない場合は、貼り付けできない
                        If mstrStepIdCopy = vbNullString Then
                            mnu22.Enabled = False
                        Else
                            mnu22.Enabled = True
                        End If
                    
                    '@処理条件ｾｯﾄID
                    Case CPlngvsfFlowConditionID
                        
                        '@ｺﾋﾟｰされていない場合は、貼り付けできない
                        If mstrConditionCopy = vbNullString Then
                            mnu22.Enabled = False
                        Else
                            mnu22.Enabled = True
                        End If
                    
                    '@個別処理条件
                    Case CPlngvsfFlowConditionOne
                        
                        '@ｺﾋﾟｰされていない場合は、貼り付けできない
                        If mstrConditionCopy = vbNullString Or mstrConditionOne = vbNullString Then
                            mnu22.Enabled = False
                        Else
                            '@----------------------------
                            '@WF選択条件の設定判定
                            '@WF選択条件が設定されている場合は
                            '@個別設定の貼り付けは不可
                            '@----------------------------
                            If .GetData(.Row, CPlngvsfFlowSelectConditionID) <> vbNullString Then
                                mnu22.Enabled = False
                                Exit Sub
                            End If
                            
                            '@大工程が選択済み
                            If .GetData(.Row, CPlngvsfFlowOpID) = vbNullString Then
                                mnu22.Enabled = False
                                Exit Sub
                            End If
                            
                            '@小工程が選択済み
                            If .GetData(.Row, CPlngvsfFlowStepID) = vbNullString Then
                                mnu22.Enabled = False
                                Exit Sub
                            End If
                                                
                            mnu22.Enabled = True
                            
                        End If
                    
                    
                    '@WF選択条件
                    Case CPlngvsfFlowSelectConditionID
                        
                        '@ｺﾋﾟｰされていない場合は、貼り付けできない
                        If mstrSelectConCopy = vbNullString Then
                            mnu22.Enabled = False
                        Else
                            '@----------------------------
                            '@個別ﾚｼﾋﾟの設定判定
                            '@個別ﾚｼﾋﾟが設定されている場合は
                            '@WF選択条件の貼り付けは不可
                            '@----------------------------
                            If .GetData(.Row, CPlngvsfFlowConditionOne) <> vbNullString Then
                                mnu22.Enabled = False
                            Else
                                mnu22.Enabled = True
                            End If
                        End If
                      
                    '@収集項目
                    Case CPlngvsfFlowCollectionID
                        
                        '@ｺﾋﾟｰされていない場合は、貼り付けできない
                        If mstrCollectionCopy = vbNullString Then
                            mnu22.Enabled = False
                        Else
                            mnu22.Enabled = True
                        End If
                    
                    '@不良項目
                    Case CPlngvsfFlowLotScrapSetId
                        
                        '@ｺﾋﾟｰされていない場合は、貼り付けできない
                        If mstrScrapSetIDCopy = vbNullString Then
                            mnu22.Enabled = False
                        Else
                            mnu22.Enabled = True
                        End If
                        
                End Select
                
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu2_Click"

                                '@限-号機限定番号(000)-M
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowWpRestrict, _
                                        CMstrWpRestrictMark & CMstrHyphen & _
                                        Format$(CInt(.strWpRestrictNum), CMstrNoFormat) & _
                                        CMstrHyphen & CMstrWpMarkMark)  '限-[連番（三桁）]-M
                            '@限定

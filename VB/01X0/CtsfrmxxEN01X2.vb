    '関数名：mnu61_Click
    '機　能：ﾛｯﾄ間　単ｺﾋﾟｰ
    '引　数：なし
    '戻り値：なし
    '作成日：2006/06/20 (Tue) 12:21:04 N.Kasai
    '更新日：2006/06/20 (Tue) 12:21:04
    '備　考：
    Private Sub mnu61_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu61.Click

        Dim lblnAns     As Boolean  '汎用戻り値

        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            With vsfFlowList1

                Select Case .Col
 
                    '大工程
                    Case CPlngvsfFlowOpID
                        
                        '@Disconﾁｪｯｸ
                        lblnAns = prvblnDisconCellCopy_Chk(vsfFlowList1, .Row, CPlngvsfFlowOpID)

                        '@結果判定
                        If lblnAns = False Then
                        '@失敗の場合
                            '@処理抜け
                            Exit Sub
                        End If
                        
                        '@変数にｺﾋﾟｰ
                        mstrOpIdCopy = .GetData(.Row, CPlngvsfFlowOpID)

                    '小工程
                    Case CPlngvsfFlowStepID
                        
                        '@Disconﾁｪｯｸ
                        lblnAns = prvblnDisconCellCopy_Chk(vsfFlowList1, .Row, CPlngvsfFlowStepID)

                        '@結果判定
                        If lblnAns = False Then
                        '@失敗の場合
                            '@処理抜け
                            Exit Sub
                        End If
                        
                        '@変数にｺﾋﾟｰ
                        mstrStepIdCopy = .GetData(.Row, CPlngvsfFlowStepID)

                    '@処理条件ｾｯﾄID
                    Case CPlngvsfFlowConditionID
                        
                        '@Disconﾁｪｯｸ
                        lblnAns = prvblnDisconCellCopy_Chk(vsfFlowList1, .Row, CPlngvsfFlowConditionID)

                        '@結果判定
                        If lblnAns = False Then
                        '@失敗の場合
                            '@処理抜け
                            Exit Sub
                        End If
                        
                        '@変数にｺﾋﾟｰ
                        mstrConditionCopy = .GetData(.Row, CPlngvsfFlowConditionID)            '処理条件ID
                        mstrConditionCopyVer = .GetData(.Row, CPlngvsfFlowConditionVer)        'Ver
                        mstrConditionCopyValid = .GetData(.Row, CPlngvsfFlowConditionValid)      '有効ﾌﾗｸﾞ
                    
                    '@個別処理条件
                    Case CPlngvsfFlowConditionOne
                        
                        '@ﾕｰｻﾞﾌﾟﾛｾｽの場合は個別処理条件のｺﾋﾟｰはしない
                        If pstrEN01X0KindFlag = "2" Then
                            Exit Sub
                        End If

                        '@Disconﾁｪｯｸ
                        lblnAns = prvblnDisconCellCopy_Chk(vsfFlowList1, .Row, CPlngvsfFlowConditionID)
                        
                        '@結果判定
                        If lblnAns = False Then
                        '@失敗の場合
                            '@処理抜け
                            Exit Sub
                        End If
                        
                        '@単一ｺﾋﾟｰの為、構造体は1件のみ
                        ptypCopyCondDetailList.lngProcCondDetailCnt = 1
                        
                        lblnAns = pubblnConditionOneCopy_Set(.Row)
                        
                        If lblnAns = True Then
                             mstrConditionOne = CPstrRecpNot           '未設定
                        Else
                             mstrConditionOne = .GetData(.Row, CPlngvsfFlowConditionOne)       '個別表示(全数/部分）
                        End If
                        
                        '@ﾃﾞｰﾀ例外処理
                        If ptypCopyCondDetailList.lngProcCondDetailCnt = 0 Then
                            mstrConditionOne = CPstrRecpNot           '未設定
                        End If
                           
                        '@変数にｺﾋﾟｰ
                        mstrConditionCopy = .GetData(.Row, CPlngvsfFlowConditionID)            '処理条件ID
                        mstrConditionCopyVer = .GetData(.Row, CPlngvsfFlowConditionVer)        'Ver
                        mstrConditionCopyValid = .GetData(.Row, CPlngvsfFlowConditionValid)    '有効ﾌﾗｸﾞ
                        mstrLotRecipeFlag = .GetData(.Row, CPlngvsfFlowLotRecipeFlag)          'ﾛｯﾄ個別ﾚｼﾋﾟ設定ﾌﾗｸﾞ
                        mstrWFRecipeFlag = .GetData(.Row, CPlngvsfFlowWFRecipeFlag)            'WF個別ﾚｼﾋﾟ設定ﾌﾗｸﾞ
                        mstrRecipeChgFlg = .GetData(.Row, CPlngvsfFlowRecipeChgFlg)            '工順ﾚｼﾋﾟ変更ﾌﾗｸﾞｵﾝ
                
                    '@WF選択条件
                    Case CPlngvsfFlowSelectConditionID
                        
                        '@変数にｺﾋﾟｰ
                        mstrSelectConCopy = .GetData(.Row, .Col)                               'WF選択条件
                    
                    '@収集項目
                    Case CPlngvsfFlowCollectionID
                    
                        '@Disconﾁｪｯｸ
                        lblnAns = prvblnDisconCellCopy_Chk(vsfFlowList1, .Row, CPlngvsfFlowCollectionID)
                        
                        '@結果判定
                        If lblnAns = False Then
                        '@失敗の場合
                            '@処理抜け
                            Exit Sub
                        End If
                        
                        '@変数にｺﾋﾟｰ
                        mstrCollectionCopy = .GetData(.Row, .Col)                              '収集項目ｾｯﾄID
                        mstrCollectionCopyVer = .GetData(.Row, CPlngvsfFlowCollectionVer)      'Ver
                        mstrCollectionCopyValid = .GetData(.Row, CPlngvsfFlowCollectionValid)  '有効ﾌﾗｸﾞ
                    
                    '@不良項目
                    Case CPlngvsfFlowLotScrapSetId
                        
                        '@変数にｺﾋﾟｰ
                        mstrScrapSetIDCopy = .GetData(.Row, .Col)                              '不良項目
                        
                End Select
                
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu61_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：mnu7_Click
    '機　能：ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【処理号機設定】
    '引　数：なし
    '戻り値：なし
    '作成日：2007/05/30 (Wed) 15:28:34 N.Kasai
    '更新日：2007/05/30 (Wed) 15:28:34
    '備　考：
    Private Sub mnu7_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu7.Opening

        Dim llngRtn     As Integer '汎用戻り値

        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            With vsfFlowList0
            
                '@大工程、小工程、処理条件が未設定の場合は設定させない。
                If .GetData(mlngWkRow, CPlngvsfFlowOpID) = vbNullString Or _
                    .GetData(mlngWkRow, CPlngvsfFlowStepID) = vbNullString Or _
                    .GetData(mlngWkRow, CPlngvsfFlowConditionID) = vbNullString Then
                    
                    '@ﾒﾆｭｰ制限
                    mnu71.Enabled = False       '号機記憶
                    mnu72.Enabled = False       '号機限定
            
                    Exit Sub
                End If
            
                '@選択ｾﾙの入力状態をﾁｪｯｸ
                If .GetData(mlngWkRow, mlngWkCol) <> vbNullString Then
                    '@同一設定不可（これは仕様です。）
                    '@ﾒﾆｭｰ制限
                    mnu71.Enabled = False       '号機記憶
                    mnu72.Enabled = False       '号機限定
                Else
                    
                    mnu71.Enabled = True        '号機記憶
                    
                    '@号機限定制御
                    llngRtn = prvlngWpRestrictMark_Chk
                    
                    Select Case llngRtn
                        '@記憶設定なし
                        Case 0
                            mnu72.Enabled = False       '号機限定（使用不可）
                        '記憶設定複数あり
                        Case -1
                            mnu72.Enabled = True        '号機限定（使用可）
                    End Select
                End If
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu7_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()


        End Try

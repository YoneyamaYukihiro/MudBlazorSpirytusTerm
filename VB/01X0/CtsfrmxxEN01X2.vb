    '関数名：vsfSelectCondition_DblClick
    '機　能：測定条件ｾｯﾄIDﾘｽﾄ ﾀﾞﾌﾞﾙｸﾘｯｸ時
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/26 (Fri) 11:19:30 N.Kasai
    '更新日：2018/03/15 (Thu) 16:00:10 T.Oide
    '備　考：
    Private Sub vsfSelectCondition_DblClick(ByVal sender As Object, ByVal e As MouseEventArgs) Handles vsfSelectCondition.DoubleClick

        Dim lstrSendId      As String   'ﾜｰｸ文字列
        Dim lblnAns         As Boolean  '結果格納

        Try
            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            'NSYS データ行がない場合は処理を抜ける
            If vsfSelectCondition.Rows.Count <= vsfSelectCondition.Rows.Fixed Then
                Return
            End If

            With vsfSelectCondition
                
                '@ﾍｯﾀﾞｰﾀﾞﾌﾞﾙｸﾘｯｸの場合
                If .HitTest(e.X,e.Y).Type = HitTestTypeEnum.ColumnHeader Then
                    Exit Sub
                End If
                
                '@一覧が存在しない場合には処理抜け
                If .Rows.Count = 1 Then
                    Exit Sub
                End If
                
                'NSYS EmptyAreaﾀﾞﾌﾞﾙｸﾘｯｸの場合
                If .HitTest(e.X,e.Y).Type = HitTestTypeEnum.None Then
                    Exit Sub
                End If

                '@個別処理条件設定による判別
                lblnAns = prvblnvsfConditionOnClear_Chk
                '@結果判定
                If lblnAns = False Then
                    Exit Sub
                End If
                
                '@内容を変数に代入
                lstrSendId = .GetData(.Row, CMlngvsfSelectConditionID)

                '@変数の内容ﾁｪｯｸ
                If lstrSendId = vbNullString Then
                    '@空白の場合
                    Exit Sub
                End If
                
            End With
                
            With vsfFlowList0
                
                '@編集不可工程の場合
                If .GetData(.Row, CPlngvsfFlowPermit) = CMstrPermit2 Then
                    Exit Sub
                End If
                
                '@ﾌﾛｰﾘｽﾄWF選択条件と選択した内容が同じ場合
                If .GetData(.Row, CPlngvsfFlowSelectConditionID) = lstrSendId Then
                    Exit Sub
                End If
                
        '@↓2018/03/15 (Thu) 15:59:56 T.Oide **************************************************
                '@「ﾚｼﾋﾟ選択APC」ﾁｪｯｸ
                If prvblnWfSelectAndRecpSelApc_Chk = False Then
                    Exit Sub
                End If
        '@↑2018/03/15 (Thu) 15:59:56 T.Oide **************************************************
                
                '@選択ｾﾙの内容をﾌﾟﾛｾｽﾌﾛｰ画面に渡す
                .SetData(.Row, CPlngvsfFlowSelectConditionID, lstrSendId) '測定条件ID
                .AutoSizeCol(CPlngvsfFlowSelectConditionID, 6) '列幅自動調整

                '@ﾊﾞｯｸｶﾗｰを変更
                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                Dim cellRange As CellRange = .GetCellRange(.Row, CPlngvsfFlowSelectConditionID)
                cellRange.Style = newStyle
                .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）

                
                '@ｾﾙの移動
                .Col = CPlngvsfFlowSelectConditionID
                .ShowCell(.Row, CPlngvsfFlowSelectConditionID)
                
                If vsfFlowList1.Visible = True Then
                    .HighLight = HighLightEnum.Always
                     vsfFlowList1.HighLight = HighLightEnum.Never
                End If
                        
                '@変更ﾌﾗｸﾞｵﾝ
                pblnEN01X2Edit = True
                
            End With
                
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "vsfSelectCondition_DblClick"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：vsfSelectCondition_RowColChange
    '機　能：WF選択条件ｾｯﾄIDﾘｽﾄ 行列変更時
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/26 (Fri) 12:28:17 N.Kasai
    '更新日：2007/03/12 (Mon) 16:57:35 N.Kasai
    '備　考：
    '　　　：2007/03/12 (Mon) 16:57:35 N.Kasai  MIDDLE_WAFERS追加
    Private Sub vsfSelectCondition_RowColChange(ByVal sender As Object, ByVal e As EventArgs) Handles vsfSelectCondition.RowColChange

        Dim lstrSlotNo As String 'ｽﾛｯﾄNo文字列
        Dim llngStart  As Integer'ｽﾛｯﾄNo文字列取得の開始位置
        Dim llngIndex  As Integer'ｽﾛｯﾄNoﾁｪｯｸのｲﾝﾃﾞｯｸｽ
        Dim llngCount  As Integer'ｶｳﾝﾀ

        Try

            'NSYS データ行がない場合は処理を抜ける
            If vsfSelectCondition.Rows.Count <= vsfSelectCondition.Rows.Fixed Then
                Return
            End If
            'NSYS 選択行がない場合は処理を抜ける
            If vsfSelectCondition.Row < vsfSelectCondition.Rows.Fixed Then
                Exit Sub
            End If

            '@測定条件内容の表示
            With vsfSelectCondition
            
                If .Rows.Count = 1 Then
                    Exit Sub
                End If

                '@選択ﾙｰﾙ
                lblSelectRule.Text = .GetData(.Row, CMlngvsfSelectConditionRuleID)
                
                '@選択ﾙｰﾙが空欄の場合
                If lblSelectRule.Text = vbNullString Then
                    '@ｽﾛｯﾄNo
                    '@すべてｸﾘｱ
                    fraSlotNo.Enabled = False
                    For llngCount = 1 To CMlngSlotNoMaxIndex
                        CType(Me.fraSlotNo.Controls("chkSlotNo" & llngCount.ToString), CheckBox).Checked = False
                        CType(Me.fraSlotNo.Controls("chkSlotNo" & llngCount.ToString), CheckBox).Enabled = False
                    Next
                    
                    '@WF枚数
                    fraWFNo.Enabled = False
                    '@上から
                    lblWFUp.Text = vbNullString
                    '@真中から
                    lblWFMiddle.Text = vbNullString
                    '@下から
                    lblWFDown.Text = vbNullString
                Else
                    '@ｽﾛｯﾄNo
                    '@すべてｸﾘｱ
                    For llngCount = 1 To CMlngSlotNoMaxIndex
                        CType(Me.fraSlotNo.Controls("chkSlotNo" & llngCount.ToString), CheckBox).Checked = False
                    Next
                    
                    '@ｽﾛｯﾄNo文字列を取得
                    lstrSlotNo = .GetData(.Row, CMlngvsfSelectConditionSlots)
                    '@ｽﾛｯﾄ№がNullでない場合
                    If lstrSlotNo <> vbNullString Then
                        '@ｽﾛｯﾄNo文字列取得の開始位置を初期化
                        llngStart = 1
                        Do Until llngStart > Len(lstrSlotNo)
                            '@ｽﾛｯﾄNo文字列から2文字ずつ取得
                            llngIndex = CLng(Mid(lstrSlotNo, llngStart, 2))
                            '@ｽﾛｯﾄNoをﾁｪｯｸ
                            CType(Me.fraSlotNo.Controls("chkSlotNo" & llngIndex.ToString), CheckBox).Checked = True
                            '@開始位置をｶｳﾝﾄｱｯﾌﾟ
                            llngStart = llngStart + 2
                        Loop
                    End If
                    
                    '@WF枚数
                    '@上から
                    If .GetData(.Row, CMlngvsfSelectConditionTopWF) = 0 Then
                        lblWFUp.Text = vbNullString
                    Else
                        lblWFUp.Text = Format(CInt(.GetData(.Row, CMlngvsfSelectConditionTopWF)), CPstrSlotNoFormat)
                    End If
                    '@真中から
                    If .GetData(.Row, CMlngvsfSelectConditionMiddleWF) = 0 Then
                        lblWFMiddle.Text = vbNullString
                    Else
                        lblWFMiddle.Text = Format(CInt(.GetData(.Row, CMlngvsfSelectConditionMiddleWF)), CPstrSlotNoFormat)
                    End If
                    
                    '@下から
                    If .GetData(.Row, CMlngvsfSelectConditionBottomWF) = 0 Then
                        lblWFDown.Text = vbNullString
                    Else
                        lblWFDown.Text = Format(CInt(.GetData(.Row, CMlngvsfSelectConditionBottomWF)), CPstrSlotNoFormat)
                    End If
                End If
                
                '@ﾕｰｻﾞ選択
                chkUserSelect.Enabled = True
                If .GetData(.Row, CMlngvsfSelectConditionUserFlag) = vbNullString Then
                    chkUserSelect.Checked = False
                Else
                    chkUserSelect.Checked = CBool(.GetData(.Row, CMlngvsfSelectConditionUserFlag))
                End If
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "vsfSelectCondition_RowColChange"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub



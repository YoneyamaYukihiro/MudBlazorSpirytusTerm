    '関数名：prvblnWpRestrictSave_Chk
    '機　能：処理号機設定確定ﾁｪｯｸ
    '引　数：llngRow：該当行
    '戻り値：True:ｴﾗｰなし、False:ｴﾗｰあり
    '作成日：2007/05/31 (Thu) 17:22:53 N.Kasai
    '更新日：2007/05/31 (Thu) 17:22:53
    '備　考：
    Private Function prvblnWpRestrictSave_Chk(ByVal llngRow As Integer) As Boolean
        
        Dim llngFindRow As Integer '検索行
        
        Try
            
            '@戻り値初期化
            prvblnWpRestrictSave_Chk = False

            With vsfFlowList0
                '@ﾁｪｯｸ対象が記憶の場合
                If Strings.Right$(.GetData(llngRow, CPlngvsfFlowWpRestrict), 1) = CMstrWpMarkMark Then
                
                    '@対となる限定検索
                    llngFindRow = .FindRow(Strings.Left$(.GetData(llngRow, CPlngvsfFlowWpRestrict), 6) & CMstrWpUseMark, .Rows.Fixed, CPlngvsfFlowWpRestrict,False)
                                
                    '@号機記憶のみ設定の場合
                    If llngFindRow = -1 Then
                    
                        '@記憶設定流動判定(編集不可も含みます。)
                        If .GetCellRange(llngRow, CPlngvsfFlowWpRestrict).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray) Or _
                                        .GetData(llngRow, CPlngvsfFlowPermit) = CMstrPermit2 Then
                            '@記憶設定が流動済みの場合はｴﾗｰとしない。
                        Else
                            '@表示ﾒｯｾｰｼﾞ変換
                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar009D)
                            '@"<TRM9DW>$$号機記憶が設定済みですが、該当する号機限定が未設定です。$設定を見直して下さい。"
                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                      Me.Text, True, 16, False)
                            Exit Function
                        End If
                    Else
                        '@設定工程（記憶<限定）ﾁｪｯｸ
                        If llngRow > llngFindRow Then
                            '@表示ﾒｯｾｰｼﾞ変換
                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar009E)
                            '@"<TRM9EW>$$号機記憶が設定済みですが、対象となる号機限定が前工程に設定されています。$設定を見直して下さい。"
                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                      Me.Text, True, 16, False)
                            Exit Function
                        End If
                    
                        '@入替工程の場合（記憶-限定が含まれる場合）
                        '@入替設定済みの場合
                        If .GetData(llngRow, CPlngvsfFlowSwapIndictor) <> vbNullString Then
                            '同じ入替工程内の場合
                            If .GetData(llngFindRow, CPlngvsfFlowSwapIndictor) = _
                                        .GetData(llngRow, CPlngvsfFlowSwapIndictor) Then
                            
                                '@表示ﾒｯｾｰｼﾞ変換
                                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar009F)
                                '@"<TRM9FW>$$処理号機設定（記憶-限定）に入替設定が設定されています。$設定を見直してください。"
                                Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                          Me.Text, True, 16, False)
                                Exit Function
                            End If
                        End If
                    
                    End If
                End If
            End With
            
            prvblnWpRestrictSave_Chk = True
            
            
            Exit Function
            
        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvblnWpRestrictSave_Chk"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Function

    '関数名：prvblnLotRecipeSave_Chk
    '機　能：WF選択条件設定ﾁｪｯｸ
    '引　数：llngRow：対象行
    '戻り値：True：ｴﾗｰなし、False：ｴﾗｰあり
    '作成日：2007/09/19 (Wed) 16:32:31 N.Kasai
    '更新日：2007/09/19 (Wed) 16:32:31
    '備　考：
    Private Function prvblnLotRecipeSave_Chk(ByVal llngRow As Integer) As Boolean
        
        Dim llngWpListCnt           As Integer          '装置件数
        Dim ltypWpList              As List(Of WpList)  '装置一覧格納用
        Dim lblnAns                 As Boolean          '汎用戻り値
        Dim llngWpCnt               As Integer          '装置ｶｳﾝﾄ
        Dim lstrEventName           As String           'ｲﾍﾞﾝﾄ名（ﾚｽﾎﾟﾝｽ）
        
        Try
            
            '@戻り値初期化
            prvblnLotRecipeSave_Chk = False

            With vsfFlowList0
                '@流動済み以外であること
                If .GetData(llngRow, CPlngvsfFlowState) <> CMstrState1 Then
                    '@WF選択条件が設定済みであること
                    If .GetData(llngRow, CPlngvsfFlowSelectConditionID) <> vbNullString Then
                        
                        '@処理条件に紐付く装置のLOT_RECIPE_FLAGを判定する。
                        '@WF選択条件が設定済みでWFﾚｼﾋﾟ不可装置が存在する場合はNG
                        '@個別処理条件とWF選択条件は混在しない為、ここでは特に処理なし
                        
                        '@装置一覧構造体の初期化
                        ptypWPList = ltypWpList
                        
                        '@ﾚｽﾎﾟﾝｽ取得開始
                        lstrEventName = "prvblnLotRecipeSave_Chk"
                        Call pubResponseStart(Me.Name, lstrEventName)

                        
                        '@MSG【装置情報取得】(CPstrCD1O：処理条件指定)
                        lblnAns = pubblnWpList_Sel(CMstrmas_wplist__Ver, _
                                                   llngWpListCnt, _
                                                   pstrSBID, _
                                                   CPstrCD1O, , , _
                                                   .GetData(llngRow, CPlngvsfFlowConditionID), _
                                                   .GetData(llngRow, CPlngvsfFlowConditionVer))
                        '@結果判定
                        If lblnAns = True Then
                        
                            '@ﾚｽﾎﾟﾝｽ取得終了
                            Call publngResponseEnd(Me.Name, lstrEventName)
                        
                            '@成功の場合
                            For llngWpCnt = 0 To llngWpListCnt -1
                                '@ﾊﾞｯﾁ装置が存在する場合
                                If ptypWPList(llngWpCnt).strEqType = CPstrEqTypeBatch Then
                                
                                    '@"<TRM5RW>$$処理条件に設定されている[%1]は$[%2]装置です。$WF選択条件の設定はできません。"
                                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar005R, ptypWPList(llngWpCnt).strWpName, CPstrWFBatchNgMSG)
                                    '@警告ﾒｯｾｰｼﾞ
                                    Call publngMsgBoxInfo(pstrDMsg, vbExclamation, Me.Text, True, 16)
                                    Exit Function
                                End If
                                
                                '@枚葉ﾚｼﾋﾟ設定可否を判定（CPstrWfRecpNgFlag：1:枚葉ﾚｼﾋﾟ設定不可）
                                If ptypWPList(llngWpCnt).strLotRecipeFlag = CPstrWfRecpNgFlag Then
                                        '@"<TRM5RW>$$処理条件に設定されている[%1]は$[%2]装置です。$WF選択条件の設定はできません。"
                                        pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar005R, ptypWPList(llngWpCnt).strWpName, CPstrWFRecipeNgMSG)
                                        '@警告ﾒｯｾｰｼﾞ
                                        Call publngMsgBoxInfo(pstrDMsg, vbExclamation, Me.Text, True, 16)
                                    Exit Function
                                End If
                            Next llngWpCnt
                        Else
                            '@失敗の場合

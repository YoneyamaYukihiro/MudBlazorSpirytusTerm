    '関数名：prvRecpSelApcSet
    '機　能：ﾚｼﾋﾟ選択APCの設定値を構造体にｾｯﾄする
    '引　数：llngCnt        ：処理中の行
    '　　　：ltypRecipSelApc：「ﾚｼﾋﾟ選択APC」情報格納構造体
    '　　　：strRecipSelApc ：「ﾚｼﾋﾟ選択APC」設定値
    '戻り値：
    '作成日：2018/03/14 (Wed) 11:31:31 T.Oide
    '更新日：2018/03/14 (Wed) 11:31:31
    '備　考：
    Private Sub prvRecpSelApcSet(ByVal llngCnt As Integer, _
                                 ByRef ltypRecipSelApc As RecipeSelApc, _
                                 ByVal strRecipSelApc As String)

        Dim lstrListOrder       As String   'ﾚｼﾋﾟ選択APCのLIST_ORDER
        Dim lstrStatus          As String
        Dim lstrApcString       As String
        Dim llngSerchRow        As Integer

        Try
            
            With vsfFlowList0
            
                '@設定値から「ﾘｽﾄｵｰﾀﾞ」と「P or M」と「APC設定」を取得
                lstrListOrder = CLng(Mid$(.GetData(llngCnt, CPlngvsfFlowRecpSelApc), 4, 3))
                lstrStatus = Mid$(.GetData(llngCnt, CPlngvsfFlowRecpSelApc), 8, 1)
                lstrApcString = Mid$(.GetData(llngCnt, CPlngvsfFlowRecpSelApc), 1, 7)
            
            End With
            
            '@Mの場合処理を中止(PのときMの情報も格納するので)
            If lstrStatus = CPstrMeasureMark Then
                Exit Sub
            End If
                
            With ltypRecipSelApc
            
                '@要素を追加して登録する
                
                Dim typRecipeSelApcTmp As New RecpSelApcElem

                With typRecipeSelApcTmp

                    '@APCﾀｲﾌﾟ判定
                    Select Case Mid$(lstrApcString, 1, 2)
                        
                        '@FBの場合
                        Case CMstrFBMark
                            .strApcType = CMstrApcTypeFB
                            
                        '@FFの場合
                        Case CMstrFFMark
                            .strApcType = CMstrApcTypeFF
                            
                    End Select
                    
                    '@ﾘｽﾄｵｰﾀﾞｰ格納(既存の場合、値は変わらないが、新規の場合があるので格納する)
                    .strListOrder = CLng(Mid$(lstrApcString, 4, 3))
                    
                    '@処理工程の値を更新(Mの行程でここにはこない)
                    .strProcOpId = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowOpID)
                    .strProcStepId = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowStepID)
                
                    '@枚葉の場合ﾌﾗｸﾞを設定
                    If InStr(vsfFlowList0.GetData(llngCnt, CPlngvsfFlowRecpSelApc), CPstrWfApc) > 0 Then
                        .blnApcWfUnitFlg = True
                    Else
                        .blnApcWfUnitFlg = False
                    End If
                    
                    '@M工程を探す
                    llngSerchRow = vsfFlowList0.FindRow(lstrApcString & CPstrMeasureMark, vsfFlowList0.Rows.Fixed, CPlngvsfFlowRecpSelApc, False)
                    
                    '@見つからなかったか
                    If llngSerchRow = -1 Then
                    
                        '@見つからないので設定異常
                        '@"<TRM0SE>$$「レシピ選択APC」の設定が不正です。$システム担当者に連絡してください。"
                        pstrDMsg = pubstrMsgReplace_Set(CPstrCommonMsgErr00Y4)
                        Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                  Me.Text, True, 16, False)
                        Exit Sub
                        
                    End If
                    
                    '@M行程の情報を更新
                    .strMeasOpId = vsfFlowList0.GetData(llngSerchRow, CPlngvsfFlowOpID)
                    .strMeasStepId = vsfFlowList0.GetData(llngSerchRow, CPlngvsfFlowStepID)
                                         
                End With

                .typRecipeSelApc.Add(typRecipeSelApcTmp)
                .lngRecipeSelApcCnt = .lngRecipeSelApcCnt + 1
            End With
            
            Exit Sub
            
        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvRecpSelApcSet"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Sub

    '関数名：prvblnWfSelectAndRecpSelApc_Chk
    '機　能：「ﾚｼﾋﾟ選択APC」と「WF選択条件」のﾀﾞﾌﾞﾙ設定ﾁｪｯｸ
    '引　数：なし
    '戻り値：True：OK、False：NG
    '作成日：2018/03/15 (Thu) 16:24:39 T.Oide
    '更新日：2018/03/15 (Thu) 16:24:39
    '備　考：
    Private Function prvblnWfSelectAndRecpSelApc_Chk() As Boolean

        Dim llngProcRow     As Integer      '測定行程から処理工程検索用
        Dim lstrApcString   As String

        Try
            
            '@==仕様メモ===========================================================================
            '@  ・「ﾚｼﾋﾟ選択APC」（非枚葉APC設定）の測定工程の場合「WF選択条件」とのﾀﾞﾌﾞﾙ設定はOK
            '@  ・「ﾚｼﾋﾟ選択APC」（枚葉APC設定）　の測定工程の場合「WF選択条件」とのﾀﾞﾌﾞﾙ設定はNG
            '@  ・「ﾚｼﾋﾟ選択APC」                 の処理工程の場合「WF選択条件」とのﾀﾞﾌﾞﾙ設定は常にNG
            '======================================================================================
               
            
            '@結果の初期化
            prvblnWfSelectAndRecpSelApc_Chk = False
            
            With vsfFlowList0
            
                '@ﾚｼﾋﾟ設定文字列格納
                lstrApcString = .GetData(.Row, CPlngvsfFlowRecpSelApc)
            
                '@「ﾚｼﾋﾟ選択APC」の設定はあるか？
                If lstrApcString <> vbNullString Then
                    
                    '@処理工程か?
                    If Mid$(lstrApcString, 8, 1) = CPstrProcessMark Then
                        
                        '@"「ﾚｼﾋﾟ選択APC」処理工程で「WF選択条件」の同時設定はできません。"
                        pstrDMsg = pubstrMsgReplace_Set(CPstrCommonMsgWar00Y3, CPstrKeyTRM)
                        Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                        Exit Function
                        
                    Else
                        '@測定行程の場合
                        
                        '@枚葉のAPC設定か確認のため処理工程の設定を探す
                        llngProcRow = .FindRow(Mid$(lstrApcString, 1, 7) + CPstrProcessMark, .Rows.Fixed, CPlngvsfFlowRecpSelApc, False, False, False)
                        
                        '@設定異常
                        If llngProcRow = -1 Then
                            
                            '@"「レシピ選択APC」の設定が不正です。$システム担当者に連絡してください。"
                            pstrDMsg = pubstrMsgReplace_Set(CPstrCommonMsgErr00Y4, CPstrKeyTRM)
                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                      Me.Text, True, 16, False)
                            Exit Function
                        End If
                        
                        '@枚葉のAPC設定か
                        If InStr(.GetData(llngProcRow, CPlngvsfFlowRecpSelApc), CPstrWfApc) > 0 Then
                        
                            '@"「ﾚｼﾋﾟ選択APC」測定工程で[枚葉APC]の場合「WF選択条件」の同時設定はできません。"
                            pstrDMsg = pubstrMsgReplace_Set(CPstrCommonMsgWar00Y4, CPstrKeyTRM)
                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                            Exit Function
                            
                        End If
                        
                    End If
                End If
            End With
            
            '@ﾁｪｯｸOK
            prvblnWfSelectAndRecpSelApc_Chk = True
            
            Exit Function
            
        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvblnWfSelectAndRecpSelApc_Chk"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Function



    Private Sub prvAryConDetailEnable_Set(ByVal llngRow As Integer)
        
        Dim llngCnt             As Integer'ｶｳﾝﾀ

        Try
            
            '@構造体新規追加
            With ptypProcCondDetailList
                
                '@構造体全件検索
                For llngCnt = 0 To .lngProcCondDetailCnt -1
                    
                    '@工順番号と格納構造体の工順番号を比較し一致した場合
                    If vsfFlowList0.GetData(llngRow, CPlngvsfFlowAbsNo) = .typProcCondDetail(llngCnt).strAbsNo Then
                        '有効/無効ﾌﾗｸﾞ更新
                        Dim typProcCondDetailTmp As New ProcCondDetail 
                        typProcCondDetailTmp = .typProcCondDetail(llngCnt)
                        typProcCondDetailTmp.blnEnableFlag = False
                        .typProcCondDetail(llngCnt) = typProcCondDetailTmp
        '@↓2017/05/23 (Tue) 11:09:46 T.Oide **************************************************
        '@  構造体にない場合､個別フラグがクリアされず
        '@  ﾌﾗｸﾞが立っているが、個別ﾚｼﾋﾟが存在しないといった矛盾した状態になるため、この処理はIF文の外に出す
        '@                '@ﾌﾗｸﾞを初期化設定
        '@                With vsfFlowList(0)
        '@                    .Cell(flexcpText, llngRow, CPlngvsfFlowLotRecipeFlag) = CMstrFlgOff     'ﾛｯﾄ個別ﾚｼﾋﾟ設定ﾌﾗｸﾞｵﾌ
        '@                    .Cell(flexcpText, llngRow, CPlngvsfFlowWFRecipeFlag) = CMstrFlgOff      'WF個別ﾚｼﾋﾟ設定ﾌﾗｸﾞｵﾌ
        '@                    .Cell(flexcpText, llngRow, CPlngvsfFlowRecipeChgFlg) = CMstrFlgOff      '工順ﾚｼﾋﾟ変更ﾌﾗｸﾞｵﾌ
        '@                    .Cell(flexcpText, llngRow, CPlngvsfFlowWorkCondition) = vbNullString    '作業条件ｸﾘｱ
        '@                End With
        '@↑2017/05/23 (Tue) 11:09:46 T.Oide **************************************************
                        
                    End If
                Next
                
            End With
            
        '@↓2017/05/23 (Tue) 11:09:58 T.Oide **************************************************
            '@ﾌﾗｸﾞを初期化設定
            With vsfFlowList0
                .SetData(llngRow, CPlngvsfFlowLotRecipeFlag, CMstrFlgOff)     'ﾛｯﾄ個別ﾚｼﾋﾟ設定ﾌﾗｸﾞｵﾌ
                .SetData(llngRow, CPlngvsfFlowWFRecipeFlag, CMstrFlgOff)      'WF個別ﾚｼﾋﾟ設定ﾌﾗｸﾞｵﾌ
                .SetData(llngRow, CPlngvsfFlowRecipeChgFlg, CMstrFlgOff)      '工順ﾚｼﾋﾟ変更ﾌﾗｸﾞｵﾌ
                .SetData(llngRow, CPlngvsfFlowWorkCondition, vbNullString)    '作業条件ｸﾘｱ
            End With
        '@'@↑2017/05/23 (Tue) 11:09:58 T.Oide **************************************************

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvAryConDetailEnable_Set"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：mnu23_Click
    '機　能：ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ「削除」
    '引　数：なし
    '戻り値：なし
    '作成日：2006/07/12 (Wed) 10:38:18 N.Kasai
    '更新日：2011/07/01 (Fri) 15:41:30 M.Sakka
    '備　考：
    Private Sub mnu23_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu23.Click

        Dim lstrCategory    As String       'ｶﾃｺﾞﾘ退避
        Dim lstrSelect1     As String       '大工程/小工程/処理条件/収集項目 ID
        Dim lstrSelect2     As String       '大工程/小工程/処理条件/収集項目 Ver
        
        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            With vsfFlowList0
                Select Case .Col
                    Case CPlngvsfFlowConditionID
                    '@処理条件
                        '@ｶﾃｺﾞﾘｾｯﾄ
                        lstrCategory = CMstrvsftCondition
                        lstrSelect1 = .GetData(.Row, CPlngvsfFlowConditionID)
                        lstrSelect2 = .GetData(.Row, CPlngvsfFlowConditionVer)
                        
                        '@ｾﾙ内容削除
                        .SetData(.Row, .Col, vbNullString)
                        .SetData(.Row, CPlngvsfFlowConditionVer, vbNullString)
                        '@ﾊﾞｯｸｶﾗｰ変更処理
                        Dim newStyle As CellStyle
                        Dim cellRange As CellRange
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        cellRange = .GetCellRange(.Row, .Col)
                        cellRange.Style = newStyle
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        cellRange = .GetCellRange(.Row, CPlngvsfFlowConditionVer)
                        cellRange.Style = newStyle
                        .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                        
                        '@Discon初期化
                        .SetData(.Row, CPlngvsfFlowConditionValid, CMlngValid)
                        
                        '@個別処理条件が設定されているか
                        If .GetData(.Row, CPlngvsfFlowConditionOne) <> vbNullString Then
                            '@個別処理条件にNULLをｾｯﾄ
                            .SetData(.Row, CPlngvsfFlowConditionOne, vbNullString)
                            '@ﾊﾞｯｸｶﾗｰ変更処理
                            newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                            cellRange = .GetCellRange(.Row, CPlngvsfFlowConditionOne)
                            cellRange.Style = newStyle
                            .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）

                            '@個別処理条件削除
                            Call prvAryConDetailEnable_Set(.Row)
                            
                            '@ﾃﾞﾌｫﾙﾄ処理条件再表示処理
                            Call prvCondition_Disp(.Row)
                            
                            '@個別処理条件ﾎﾞﾀﾝ使用不可
                            cmdParCondition.Enabled = False
                        
                        End If

                    
                    Case CPlngvsfFlowConditionOne
                    '@個別処理条件
                        '@ｶﾃｺﾞﾘｾｯﾄ
                        lstrCategory = vbNullString
                        lstrSelect1 = vbNullString
                        lstrSelect2 = vbNullString
                        
                        '@ﾌﾗｸﾞｵﾌ
                        .SetData(.Row, CPlngvsfFlowLotRecipeFlag, CMstrFlgOff)     'ﾛｯﾄ個別ﾚｼﾋﾟ設定ﾌﾗｸﾞｵﾌ
                        .SetData(.Row, CPlngvsfFlowWFRecipeFlag, CMstrFlgOff)      'WF個別ﾚｼﾋﾟ設定ﾌﾗｸﾞｵﾌ
                        .SetData(.Row, CPlngvsfFlowRecipeChgFlg, CMstrFlgOff)      '工順ﾚｼﾋﾟ変更ﾌﾗｸﾞｵﾌ
                        
                         '@ｾﾙの内容を削除
                        .SetData(.Row, .Col, vbNullString)
                        '@ﾊﾞｯｸｶﾗｰ変更処理
                        Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = .GetCellRange(.Row, .Col)
                        cellRange.Style = newStyle
                        .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）

                        '@個別処理条件削除
                        Call prvAryConDetailEnable_Set(.Row)
                        
                        '@ﾃﾞﾌｫﾙﾄ処理条件再表示処理
                        Call prvCondition_Disp(.Row)
                        
                        '@個別処理条件ﾎﾞﾀﾝ使用不可
                        cmdParCondition.Enabled = False
            
                        'APC枚葉設定制御
                        Call ControlApcWfUnitFlg(vsfFlowList0, .Row)
            
                    Case CPlngvsfFlowCollectionID
                    '@収集項目
                        '@ｶﾃｺﾞﾘｾｯﾄ
                        lstrCategory = CMstrvsftCollection
                        lstrSelect1 = .GetData(.Row, CPlngvsfFlowCollectionID)
                        lstrSelect2 = .GetData(.Row, CPlngvsfFlowCollectionVer)
                        
                        '@ｾﾙ内容削除
                         .SetData(.Row, .Col, vbNullString)
                         .SetData(.Row, CPlngvsfFlowCollectionVer, vbNullString)
                        '@ﾊﾞｯｸｶﾗｰ変更処理
                        Dim newStyle As CellStyle
                        Dim cellRange As CellRange
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        cellRange = .GetCellRange(.Row, .Col)
                        cellRange.Style = newStyle
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        cellRange = .GetCellRange(.Row, CPlngvsfFlowCollectionVer)
                        cellRange.Style = newStyle
                        .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                        
                        '@Discon初期化
                        .SetData(.Row, CPlngvsfFlowCollectionValid, CMlngValid)
                        
                    Case CPlngvsfFlowSelectConditionID
                    '@測定条件
                        '@ｾﾙの内容を削除
                        .SetData(.Row, .Col, vbNullString)
                        '@ﾊﾞｯｸｶﾗｰ変更処理
                        Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = .GetCellRange(.Row, .Col)
                        cellRange.Style = newStyle
                        
                        '@注意！！！！！
                        '@現工程、作業待ち、WF選択条件ありの場合はWFﾚｼﾋﾟﾌﾗｸﾞがONである。ここでWF選択条件を削除した場合
                        '@WFﾚｼﾋﾟﾌﾗｸﾞをOFFにしないと、登録時又は、個別ﾚｼﾋﾟ設定画面を起動した場合、ﾛｯﾄﾚｼﾋﾟの内容で、WFﾚｼﾋﾟﾌﾗｸﾞがON
                        '@状態になりﾃﾞｰﾀに不整合がおきます。そのためWFﾚｼﾋﾟﾌﾗｸﾞをOFFする。
                        If mstrCurrentOpID = .GetData(.Row, CPlngvsfFlowOpID) And _
                            mstrCurrentStepID = .GetData(.Row, CPlngvsfFlowStepID) And _
                                mstrCurrentStatus = CPstrWaitWorkSt Then
                            .SetData(.Row, CPlngvsfFlowWFRecipeFlag, CMstrFlgOff)     'WF個別ﾚｼﾋﾟ設定ﾌﾗｸﾞOFF
                        End If
                    
                    Case Else
                        '@ｾﾙの内容を削除
                        .SetData(.Row, .Col, vbNullString)
                        '@ﾊﾞｯｸｶﾗｰ変更処理
                        Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = .GetCellRange(.Row, .Col)
                        cellRange.Style = newStyle
                        .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）

                End Select
                
            End With
            
            '@変更ﾌﾗｸﾞｵﾝ
            pblnEN01X2Edit = True

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu23_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：mnu3_Click
    '機　能：'ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ　時間制限
    '引　数：なし
    '戻り値：なし
    '作成日：2006/06/05 (Mon) 09:05:05 N.Kasai
    '更新日：2006/06/05 (Mon) 09:05:05
    '備　考：
    Private Sub mnu3_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu3.Opening

        Dim lstrAry()    As String   'ｾﾙ内時間制限配列
        Dim lblnSameNo   As Boolean  '同番号ﾌﾗｸﾞ
        Dim llngAryCount As Integer  '配列ｶｳﾝﾀ
        Dim llngRow      As Integer  '行

        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            '@mlngTimeLimitFlg
            '@時間制限設定中ﾌﾗｸﾞ（0:開始を設定　1:終了を設定）

            With vsfFlowList0
                
                mnu3b.Enabled = False   '境界線
                
                '@選択ｾﾙの入力状態をﾁｪｯｸ
                If .GetData(mlngWkRow, mlngWkCol) = vbNullString Then
                    
                    '@-------------------
                    '@選択ｾﾙが未入力の場合
                    '@-------------------
                    '@設定中ﾌﾗｸﾞのﾁｪｯｸ
                    If mlngTimeLimitFlg = 0 Then
                        '@開始を設定
                        mnu31.Enabled = True                '時間制限開始/有効
                        mnu32.Enabled = False               '時間制限終了/無効
                        mnu33.Enabled = True                '処理時間制限/有効
                    Else
                        '@開始の位置を取得
                        llngRow = prvlngTimeLimit_Chk
                        
                        '@開始がない場合
                        If llngRow = -1 Then
                            '@設定中ﾌﾗｸﾞの初期化
                            mlngTimeLimitFlg = 0
                            '@開始を設定
                            mnu31.Enabled = True            '時間制限開始/有効
                            mnu32.Enabled = False           '時間制限終了/無効
                            mnu33.Enabled = True            '処理時間制限/有効
                        Else
                            '@終了を設定
                            '@開始の行が現在の行より下の場合
                            If .Row <= llngRow Then
                                mnu31.Enabled = False       '時間制限開始/無効
                                mnu32.Enabled = False       '時間制限終了/無効
                                mnu33.Enabled = False       '処理時間制限/無効
                            Else
                                mnu31.Enabled = False       '時間制限開始/無効
                                mnu32.Enabled = True        '時間制限終了/有効
                                mnu33.Enabled = False       '処理時間制限/無効
                            End If
                        End If
                    End If

               
                Else
                    '@-------------------
                    '@選択ｾﾙが入力済の場合
                    '@-------------------
                    '@設定中ﾌﾗｸﾞのﾁｪｯｸ
                    If mlngTimeLimitFlg = 0 Then
                        '@開始を設定
                        mnu31.Enabled = True                '時間制限開始/有効
                        mnu32.Enabled = False               '時間制限終了/無効
                    
                    
                        '@-------------------
                        '@処理時間のﾁｪｯｸ
                        '@-------------------
                        '@現在のｾﾙの値を配列に格納
                        lstrAry = Split(.GetData(mlngWkRow, mlngWkCol), CMstrComma)
                        '@配列数分、以下の処理を繰り返す
                        For llngAryCount = 0 To UBound(lstrAry)
                            '@処理時間設定済み
                            If "制3" = Strings.Left$(lstrAry(llngAryCount), 2) Then
                                '@同番号ﾌﾗｸﾞｵﾝ
                                lblnSameNo = True
                                Exit For
                            End If
                        Next
                        '@検索結果判定
                        If lblnSameNo = True Then
                            mnu33.Enabled = False       '処理時間制限/無効
                        Else
                            mnu33.Enabled = True        '処理時間制限/有効
                        End If
                    
                    Else
                        '@終了を設定
                        '@開始の位置を取得
                        llngRow = prvlngTimeLimit_Chk
                        
                        '@開始の行が現在の行より下の場合
                        If .Row <= llngRow Then
                            mnu31.Enabled = False           '時間制限開始/無効
                            mnu32.Enabled = False           '時間制限終了/無効
                            mnu33.Enabled = False           '処理時間制限/無効
                        Else
                            mnu31.Enabled = False           '時間制限開始/無効
                            mnu32.Enabled = True            '時間制限終了/有効
                            mnu33.Enabled = False           '処理時間制限/無効
                        End If
                    End If
                    
                    
                    '@配列のｸﾘｱ
                    Erase lstrAry
                End If
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu3_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：mnu31_Click
    '機　能：'ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ　時間制限開始
    '引　数：なし
    '戻り値：なし
    '作成日：2006/06/05 (Mon) 09:09:06 N.Kasai
    '更新日：2006/06/05 (Mon) 09:09:06
    '備　考：
    Private Sub mnu31_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu31.Click

        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            '@mlngTimeLimitFlg
            '@時間制限設定中ﾌﾗｸﾞ（0:開始を設定　1:終了を設定）
            
            With vsfFlowList0
            
                '@大工程が未入力の場合
                If .GetData(mlngWkRow, CPlngvsfFlowOpID) = vbNullString Then
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001L)
                    '@「大工程を入力して下さい」ﾒｯｾｰｼﾞを表示
                    Call publngMsgBox(pstrDMsg, vbExclamation, Me.Text, True, 16, False)
                    Exit Sub
                End If

                '@小工程が未入力の場合
                If .GetData(mlngWkRow, CPlngvsfFlowStepID) = vbNullString Then
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001M)
                    '@「小工程を入力して下さい」ﾒｯｾｰｼﾞを表示
                    Call publngMsgBox(pstrDMsg, vbExclamation, Me.Text, True, 16, False)
                    Exit Sub
                End If

                '@空白の場合
                If .GetData(mlngWkRow, mlngWkCol) = vbNullString Then
                    '@選択ｾﾙに文字列をｾｯﾄ
                    .SetData(mlngWkRow, mlngWkCol, CMstrTimeLimitMark & CMstrHyphen & _
                                                              Format$(plngTimeLimitCnt, CMstrNoFormat) & _
                                                              CMstrHyphen & CMstrStartMark)   '制-[連番（三桁）]-S
                Else
                    '@選択ｾﾙに文字列をｾｯﾄ(制-999-E,制-999-S…)
                    .SetData(mlngWkRow, mlngWkCol, .GetData(mlngWkRow, mlngWkCol) & CMstrComma & _
                                                              CMstrTimeLimitMark & CMstrHyphen & _
                                                              Format$(plngTimeLimitCnt, CMstrNoFormat) & _
                                                              CMstrHyphen & CMstrStartMark)   '制-[連番（三桁）]-S
                End If
                
                '@列幅自動調整
                .AutoSizeCol(mlngWkCol, 6)

                '@設定中ﾌﾗｸﾞの更新
                mlngTimeLimitFlg = 1        '@時間制限設定中ﾌﾗｸﾞ

            End With
            
            '@変更ﾌﾗｸﾞｵﾝ
            pblnEN01X2Edit = True

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu31_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：mnu32_Click

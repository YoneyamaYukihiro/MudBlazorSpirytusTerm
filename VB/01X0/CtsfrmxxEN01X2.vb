    '関数名：vsfConditionList_DblClick
    '機　能：処理条件ｸﾞﾘｯﾄﾀﾞﾌﾞﾙｸﾘｯｸ処理
    '引　数：Index：ｲﾝﾃﾞｯｸｽ
    '戻り値：なし
    '作成日：2006/07/12 (Wed) 10:12:35 N.Kasai
    '更新日：2018/03/15 (Thu) 12:38:39 T.Oide
    '備　考：
    Private Sub vsfConditionList_DblClick(ByVal sender As Object, ByVal e As MouseEventArgs) Handles vsfConditionList1.DoubleClick, vsfConditionList2.DoubleClick, vsfConditionList3.DoubleClick
        
        Dim lstrSendId      As String       '処理条件ｾｯﾄID
        Dim lstrVER         As String       'ﾊﾞｰｼﾞｮﾝ
        Dim lblnRtn         As Boolean      '汎用戻り値
        Dim lvsfConditionList   As C1FlexGrid   'NSYS イベント元グリッド

        Try
            lvsfConditionList = CType(sender, C1FlexGrid)

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            'NSYS データ行がない場合は処理を抜ける
            If lvsfConditionList.Rows.Count <= lvsfConditionList.Rows.Fixed Then
                Return
            End If
            
            '@処理条件ｾｯﾄID詳細の場合は処理なし
            If lvsfConditionList Is vsfConditionList2 Then
                Exit Sub
            End If
            
             '@処理条件ｾｯﾄID詳細の場合は処理なし
            If lvsfConditionList Is vsfConditionList3 Then
                Exit Sub
            End If
            
            '@処理条件ｸﾞﾘｯﾄに情報がない場合
            With lvsfConditionList
                '@行数ﾁｪｯｸ
                If .Rows.Count = .Rows.Fixed Then
                    Exit Sub
                End If
                
                '@ﾍｯﾀﾞｰﾀﾞﾌﾞﾙｸﾘｯｸの場合
                If .HitTest(e.X,e.Y).Type = HitTestTypeEnum.ColumnHeader Then
                    Exit Sub
                End If
                
                'NSYS EmptyAreaﾀﾞﾌﾞﾙｸﾘｯｸの場合
                If .HitTest(e.X,e.Y).Type = HitTestTypeEnum.None Then
                    Exit Sub
                End If
                
                '@ﾀﾞﾌﾞﾙｸﾘｯｸされた場所の内容を変数に代入
                lstrSendId = .GetData(.Row, CPlngvsfConListConID)  '処理条件ｾｯﾄID
                lstrVER = .GetData(.Row, CPlngvsfConListVer)       'Ver
            End With
            
            With vsfFlowList0
                Dim newStyle    As CellStyle
                Dim cellRange   As CellRange
                '@反映内容のﾁｪｯｸ
                If lstrSendId = vbNullString Or lstrVER = vbNullString Then
                    Exit Sub
                End If
                
                '@行数ﾁｪｯｸ
                If .Rows.Count = .Rows.Fixed Then
                    Exit Sub
                End If
                
                '@編集不可工程の場合
                If .GetData(.Row, CPlngvsfFlowPermit) = CMstrPermit2 Then
                    Exit Sub
                End If
                
                '@有効無効ﾁｪｯｸ：無効ﾌﾗｸﾞが立っている場合：処理を中断
        '@↓2018/06/28 (Thu) 17:07:11 T.Oide **************************************************
        '@        lblnRtn = prvblnvsfEditListInValid_Chk(vsfConditionList(Index), vsfConditionList(Index).Row)
                lblnRtn = prvblnvsfEditListInValidCnd_Chk(lvsfConditionList.Row)
        '@↑2018/06/28 (Thu) 17:07:11 T.Oide **************************************************
                
                '@結果判定
                If lblnRtn = False Then
                '@無効の場合
                    Exit Sub
                End If
                
                '@ﾌﾚｰﾑの表題を「処理条件セットID　詳細」にする
                fraCondition2.Text = CMstrConditionDetail
                
                '@変更された場合は個別処理条件を削除
                
                '@処理条件ｾｯﾄIDが「個別処理条件」の場合
                If .GetData(.Row, CPlngvsfFlowConditionOne) <> vbNullString Then
                    newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                    cellRange = .GetCellRange(.Row, CPlngvsfFlowConditionOne)
                    cellRange.Style = newStyle    '処理条件ｾｯﾄID
                    .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)                      '変更区分（変更あり）
                End If
                
                '@個別処理条件に空白をｾｯﾄ
                .SetData(.Row, CPlngvsfFlowConditionOne, vbNullString)
                
                '@個別処理条件削除処理
                Call prvAryConDetailEnable_Set(.Row)
                
                '@個別処理条件の表示
                Call prvPersonalCondition_Disp(lvsfConditionList)
                            
                'APC TEOS制御
                Call ControlApcTeosData(vsfFlowList0, CPlngvsfConListConID, lstrSendId, .Row)
                If lstrSendId = .GetData(.Row, CPlngvsfConListConID).ToString Then
                    '処理条件IDが同じでもバージョンが変わった場合も考慮する
                    Call ControlApcTeosData(vsfFlowList0, CPlngvsfConListVer, lstrVER, .Row)
                End If
                
        '@↓2018/03/15 (Thu) 12:38:21 T.Oide **************************************************
                '@「ﾚｼﾋﾟ選択APC」削除ﾁｪｯｸ
                If pubRecpSelApcSettingDel_chk(.Row, CMstrvsftCondition) = False Then
                    '@ﾁｪｯｸ結果Falseなら処理中止
                    Exit Sub
                End If
        '@↑2018/03/15 (Thu) 12:38:21 T.Oide **************************************************
                
                '@選択ｾﾙの内容をﾌﾟﾛｾｽﾌﾛｰ画面に渡す
                .SetData(.Row, CPlngvsfFlowConditionID, lstrSendId) '処理条件ｾｯﾄID
                .SetData(.Row, CPlngvsfFlowConditionVer, lstrVER)   'ﾊﾞｰｼﾞｮﾝ
                
                .AutoSizeCol(CPlngvsfFlowConditionID, 6) '列幅自動調整
                
                '@ﾊﾞｯｸｶﾗｰを変更
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                cellRange = .GetCellRange(.Row, CPlngvsfFlowConditionID)
                cellRange.Style = newStyle     '処理条件ｾｯﾄID
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                cellRange = .GetCellRange(.Row, CPlngvsfFlowConditionVer)
                cellRange.Style = newStyle    'ﾊﾞｰｼﾞｮﾝ
                .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)                      '変更区分（変更あり）

                
                '@Discon情報反映
                If lvsfConditionList.GetData(lvsfConditionList.Row, CPlngvsfConListStatID) = CMstrDisconJ Then    '廃止
                    .SetData(.Row, CPlngvsfFlowConditionValid, CMlngInValid)      '無効
                Else
                    .SetData(.Row, CPlngvsfFlowConditionValid, CMlngValid)        '有効
                End If
                
                If vsfFlowList1.Visible = True Then
                    .HighLight = HighLightEnum.Always
                     vsfFlowList1.HighLight = HighLightEnum.Never
                End If
                
                '@ｾﾙの移動
                .Col = CPlngvsfFlowConditionID
                .ShowCell(.Row, CPlngvsfFlowConditionID)
                            
                            
                '@変更ﾌﾗｸﾞｵﾝ
                pblnEN01X2Edit = True
                
                '@個別処理条件ﾎﾞﾀﾝ制御
                Call prvcmdParConditionEnabled_Set()
                
                'APC枚葉設定制御
                Call ControlApcWfUnitFlg(vsfFlowList0, .Row)

            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "vsfConditionList_DblClick"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：vsfConditionList_EnterCell
    '機　能：処理条件ｾｯﾄIDﾘｽﾄ　ｱｸﾃｨﾌﾞ時
    '引　数：Index：ｲﾝﾃﾞｯｸｽ
    '戻り値：なし
    '作成日：2006/06/20 (Tue) 16:33:16 N.Kasai
    '更新日：2006/06/20 (Tue) 16:33:16
    '備　考：
    Private Sub vsfConditionList_EnterCell(ByVal sender As Object, ByVal e As EventArgs) Handles vsfConditionList1.EnterCell,vsfConditionList2.EnterCell,vsfConditionList3.EnterCell

        Dim lstrConditionID         As String               '処理条件ｾｯﾄID
        Dim lstrConditionIDVer      As String               '処理条件ｾｯﾄIDVer
        Dim lblnAns                 As Boolean              '戻り値
        Dim ltypMasCondDetailList   As MasCondDetailList    '取得情報
        Dim lstrEventName           As String               'ｲﾍﾞﾝﾄ名格納（ﾚｽﾎﾟﾝｽ用）
        Dim lvsfConditionList       As C1FlexGrid           'NSYS イベント元グリッド

        Try
            lvsfConditionList = CType(sender, C1FlexGrid)
           
            '@処理条件ｾｯﾄID以外は処理中止
            If sender IsNot vsfConditionList1 Then
                 Exit Sub
            End If
            
            '@処理条件ﾘｽﾄﾃﾞｰﾀなしの場合
            With lvsfConditionList
                If .Rows.Count <= .Rows.Fixed Then
                    Exit Sub
                End If
            End With
            
            '@ﾚｽﾎﾟﾝｽ取得開始
            lstrEventName = "vsfConditionList_EnterCell"
            Call pubResponseStart(Me.Name, lstrEventName)
                
            '@ﾌﾚｰﾑの表題を「処理条件セットID　詳細」にする
            fraCondition2.Text = CMstrConditionDetail
                
            '@初期化
            RemoveHandler vsfConditionList1.EnterCell, AddressOf vsfConditionList_EnterCell

            '@処理条件ｾｯﾄID詳細(装置個別）
            With vsfConditionList2
                .Redraw = False
                .Rows.Count = .Rows.Fixed                          '行
                .Redraw = True
                .Cols(CPlngvsfConDetailListWF).Visible = False  '非表示（WF列）
            End With
            
            '@処理条件ｾｯﾄID詳細(装置個別）
            With vsfConditionList3
                .Redraw = False
                .Rows.Count = .Rows.Fixed                          '行
                .Redraw = True
                .Cols(CPlngvsfConDetailListWF).Visible = False  '非表示（WF列）
            End With
            
            '@装置一覧
            With vsfConditionWP
                .Redraw = False
                .Rows.Count = .Rows.Fixed                          '行
                .Redraw = True
            End With

            AddHandler vsfConditionList1.EnterCell, AddressOf vsfConditionList_EnterCell

            '@処理条件一覧の場合
            With vsfConditionList1
                '@選択ｾﾙの内容を変数に代入
                lstrConditionID = .GetData(.Row, CPlngvsfConListConID)  '処理条件ｾｯﾄID
                lstrConditionIDVer = .GetData(.Row, CPlngvsfConListVer) '処理条件ｾｯﾄIDVer
                
                '@MSG【ﾏｽﾀ処理条件詳細取得】
                lblnAns = pubblnMasCondDetailList_Sel(pstrSBID, CMstrmas_conddetaillistVer, lstrConditionID, _
                                lstrConditionIDVer, ltypMasCondDetailList)
                
                '@MSGの結果判定
                If lblnAns = False Then
                    '@ﾚｽﾎﾟﾝｽｷｬﾝｾﾙ
                    Call pubResponseCancel(Me.Name, lstrEventName)
                    Exit Sub
                End If

                '@取得項目を表示する
                Call prvvsfConditionRecipe_Disp(ltypMasCondDetailList)
                
                '@処理条件詳細情報退避
                mtypMasCondDetailList = ltypMasCondDetailList
                
            End With
            
            '@ﾚｽﾎﾟﾝｽ取得終了
            Call publngResponseEnd(Me.Name, lstrEventName)
                
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "vsfConditionList_EnterCell"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：cmdParCondition_Click
    '機　能：個別処理条件設定
    '引　数：なし
    '戻り値：なし
    '作成日：2006/07/12 (Wed) 10:16:03 N.Kasai
    '更新日：2011/07/01 (Fri) 15:41:30 M.Sakka
    '備　考：2009/01/29 (Thu) 13:22:33 M.Koni   ptypMasCondDetailList 配列数と消去対応
    '　　　：
    Private Sub cmdParCondition_Click(ByVal sender As Object, ByVal e As EventArgs) Handles cmdParCondition.Click
        
        Dim llngCnt                 As Integer          'ﾙｰﾌﾟｶｳﾝﾀ
        Dim llngListCnt             As Integer          'ﾙｰﾌﾟｶｳﾝﾀ
        Dim lstrID                  As String           '処理条件ID退避
        Dim lstrVER                 As String           '処理条件Ver退避
        Dim llngMsgAns              As Integer          'ﾒｯｾｰｼﾞ戻り値
        
        Try
            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            '@--------------------------------------------------------------------------------------
            '@個別処理条件ﾎﾞﾀﾝ押下時、vsfFlowListとvsfConditionListの処理条件&Verが相違する場合がある。
            '@相違した場合はvsfFlowListを正として同期を合わせるそうしないと恐ろしい事に.....。
            '@--------------------------------------------------------------------------------------
            
            With vsfFlowList0
                
                '@表示内容の洗い替え
            
                '@vsfFlowListの処理条件ID&Verを退避
                lstrID = .GetData(.Row, CPlngvsfFlowConditionID)
                lstrVER = .GetData(.Row, CPlngvsfFlowConditionVer)
                
                '@同じ処理条件ID、処理条件Verを検索する
                For llngCnt = 1 To vsfConditionList1.Rows.Count - 1
                    If lstrID = vsfConditionList1.GetData(llngCnt, CPlngvsfConListConID) And _
                        lstrVER = vsfConditionList1.GetData(llngCnt, CPlngvsfConListVer) Then
                        
                        '@その行を表示
                        vsfConditionList1.Row = llngCnt
                        vsfConditionList1.ShowCell(llngCnt, CPlngvsfConListConID)
                        Exit For
                    End If
                Next

                '@個別設定済みの場合は処理条件ｾｯﾄID詳細の内容を再表示
                If .GetData(.Row, CPlngvsfFlowConditionOne) <> vbNullString Then
                    
                    '@個別処理条件の表示
                    Call prvPersonalCondition_Disp(vsfFlowList0)
                    
                End If
            
                '@処理条件編集画面起動ﾁｪｯｸ
                
                '@編集不可工程の場合
                If .GetData(.Row, CPlngvsfFlowPermit) = CMstrPermit2 Then
                    Exit Sub
                End If
                
                '@大工程入力ﾁｪｯｸ
                If .GetData(.Row, CPlngvsfFlowOpID) = vbNullString Then
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001L)
                    '@"<TRM1LW>$$大工程を入力してください。"
                    Call publngMsgBox(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                    '@ﾌｫｰｶｽの移動
                    .Col = CPlngvsfFlowOpID
                    .ShowCell(.Row, .Col)
                     Exit Sub
                End If
                
                '@小工程入力ﾁｪｯｸ
                If .GetData(.Row, CPlngvsfFlowStepID) = vbNullString Then
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001M)
                    '@"<TRM1MW>$$小工程を入力してください。"
                    Call publngMsgBox(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                    '@ﾌｫｰｶｽの移動
                    .Col = CPlngvsfFlowStepID
                    .ShowCell(.Row, .Col)
                     Exit Sub
                End If
                
                '@Disconﾁｪｯｸ
                With vsfConditionList1
                    If .GetData(.Row, CPlngvsfConListStatID) = CMstrDisconJ Then
                        '@表示ﾒｯｾｰｼﾞ変換
                        pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005M)
                
                        '@"<TRM5MI>$$選択された内容は無効データです。処理を続行しますか？"
                        llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                        '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                        If llngMsgAns = vbNo Then       '「いいえ」を選択(削除処理ｷｬﾝｾﾙ)
                            Exit Sub
                        End If
                    End If
                End With
                
            End With
            
            '@ﾃﾞﾌｫﾙﾄﾚｼﾋﾟを格納しているようだ
            '@構造体初期化
            If ptypMasCondDetailList.typMasCondDetail Is Nothing Then
                ptypMasCondDetailList.typMasCondDetail = New List(Of CondDetail)
            Else
                ptypMasCondDetailList.typMasCondDetail.Clear
            End If 
            
            '@ｶｳﾝﾀ初期化
            llngListCnt = 0
            
            '@ﾏｽﾀの処理条件（全件）からﾃﾞﾌｫﾙﾄﾚｼﾋﾟのみ抽出
            For llngCnt = 0 To mtypMasCondDetailList.lngMasCondDetailCnt -1
                '@ﾃﾞﾌｫﾙﾄﾌﾗｸﾞが1の場合
                If mtypMasCondDetailList.typMasCondDetail(llngCnt).strDefaultFlag = 1 Then
                    '@ｶｳﾝﾄｱｯﾌﾟ
                    llngListCnt = llngListCnt + 1
                    '@格納数
                    ptypMasCondDetailList.lngMasCondDetailCnt = llngListCnt
                    '@構造体再定義
                    Dim typMasCondDetailTmp As New CondDetail

                    With typMasCondDetailTmp
                    
                        '@装置名
                        .strWpName = mtypMasCondDetailList.typMasCondDetail(llngCnt).strWpName
                        '@WFID
                        .strWfId = mtypMasCondDetailList.typMasCondDetail(llngCnt).strWfId
                        '@ﾚｼﾋﾟID
                        .strRecipeId = mtypMasCondDetailList.typMasCondDetail(llngCnt).strRecipeId
                        '@装置ID
                        .strWpID = mtypMasCondDetailList.typMasCondDetail(llngCnt).strWpID
                        '@ﾚｼﾋﾟﾊﾞｰｼﾞｮﾝ
                        .strRecipeVersion = mtypMasCondDetailList.typMasCondDetail(llngCnt).strRecipeVersion
                        '@ｺﾒﾝﾄ
                        .strComments = mtypMasCondDetailList.typMasCondDetail(llngCnt).strComments
                
                        ptypMasCondDetailList.typMasCondDetail.Add(typMasCondDetailTmp)
                    End With
                End If
            Next

            '@処理条件詳細配列数を設定
            '@ﾏｽﾀｰ情報から，ﾃﾞﾌｫﾙﾄﾚｼﾋﾟのみ抽出した場合，lngMasCondDetailCnt と，typMasCondDetail()の
            '@配列数が相違する場合があるので，配列再定義した数(llngListCnt)と，lngMasCondDetailCnt を
            '@一致させてやる。
            ptypMasCondDetailList.lngMasCondDetailCnt = llngListCnt

            '@ﾃﾞﾌｫﾙﾄﾚｼﾋﾟが存在しない場合，typMasCondDetail()配列はｸﾘｱされたままであるので，
            '@このままでは，typMasCondDetail()の情報が表示されなくなる。→　装置，ｳｴﾊ，ﾚｼﾋﾟ情報等が無い。
            '@そこで，この場合は，ﾏｽﾀｰ情報をそのまま使用させる事にするため，再参照させる。
            
            If llngListCnt = 0 Then
                ptypMasCondDetailList = mtypMasCondDetailList
            End If

            '@処理条件編集画面の表示
            frmxxEN01X3.Instance.ShowDialog(Me)
            frmxxEN01X3.Instance = Nothing
            
            '@ﾌｫｰﾑの初期化
            frmxxEN01X3.Instance = Nothing

            'APC枚葉設定制御
            Call ControlApcWfUnitFlg(vsfFlowList0, -1)

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "cmdParCondition_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


    '関数名：vsfCollectionList_DblClick
    '機　能：収集項目ｸﾞﾘｯﾄﾀﾞﾌﾞﾙｸﾘｯｸ処理
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/26 (Fri) 12:41:09 N.Kasai
    '更新日：2006/05/26 (Fri) 12:41:09
    '備　考：
    Private Sub vsfCollectionList_DblClick(ByVal sender As Object, ByVal e As MouseEventArgs) Handles vsfCollectionList.DoubleClick

        Dim lstrSendId              As String   '収集項目ｾｯﾄID
        Dim lstrVER                 As String   'ﾊﾞｰｼﾞｮﾝ
        Dim lblnRtn                 As Boolean  '汎用戻り値

        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            'NSYS データ行がない場合は処理を抜ける
            If vsfCollectionList.Rows.Count <= vsfCollectionList.Rows.Fixed Then
                Return
            End If
            
            '@収集項目ﾘｽﾄの場合
            With vsfCollectionList
                '@収集項目ｸﾞﾘｯﾄにﾃﾞｰﾀがない場合、処理中止
                If .Rows.Count = 1 Then
                    Exit Sub
                End If

                '@ﾍｯﾀﾞｰﾀﾞﾌﾞﾙｸﾘｯｸの場合
                If .HitTest(e.X,e.Y).Type = HitTestTypeEnum.ColumnHeader Then
                    Exit Sub
                End If

                'NSYS EmptyAreaﾀﾞﾌﾞﾙｸﾘｯｸの場合
                If .HitTest(e.X,e.Y).Type = HitTestTypeEnum.None Then
                    Exit Sub
                End If
                
                '@DISCONの場合
                If .Rows(.Row).Visible = False Then
                    Exit Sub
                End If

                '@ﾀﾞﾌﾞﾙｸﾘｯｸされた場所の内容を変数に代入
                lstrSendId = .GetData(.Row, CMlngvsfCollectionColID)   '収集項目ID
                lstrVER = .GetData(.Row, CMlngvsfCollectionVer)        '収集項目Ver
                
                '@変数の内容ﾁｪｯｸ
                If lstrSendId = vbNullString Or lstrVER = vbNullString Then
                    '@空白の場合
                    Exit Sub
                End If
                
            End With
                    
            With vsfFlowList0
                
                '@編集不可工程の場合
                If .GetData(.Row, CPlngvsfFlowPermit) = CMstrPermit2 Then
                    Exit Sub
                End If
                
                '@ﾌﾛｰﾘｽﾄ収集項目ID/Verと選択した収集項目ID/Verが同じ場合
                If .GetData(.Row, CPlngvsfFlowCollectionID) = lstrSendId And _
                        .GetData(.Row, CPlngvsfFlowCollectionVer) = lstrVER Then
                    Exit Sub
                End If
                
                '@有効無効ﾁｪｯｸ：無効ﾌﾗｸﾞが立っている場合：処理を中断
                lblnRtn = prvblnvsfEditListInValid_Chk(vsfCollectionList, _
                                                       vsfCollectionList.Row)
                '@結果判定
                If lblnRtn = False Then
                '@無効の場合
                    Exit Sub
                End If
                    
                '@選択ｾﾙの内容をﾌﾟﾛｾｽﾌﾛｰ画面に渡す
                .SetData(.Row, CPlngvsfFlowCollectionID, lstrSendId) '収集項目ｾｯﾄID
                .SetData(.Row, CPlngvsfFlowCollectionVer, lstrVER)   'ﾊﾞｰｼﾞｮﾝ
                
                .AutoSizeCol(CPlngvsfFlowCollectionID, 6) '列幅自動調整
                
                '@ﾊﾞｯｸｶﾗｰを変更
                Dim newStyle As CellStyle
                Dim cellRange As CellRange
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                cellRange = .GetCellRange(.Row, CPlngvsfFlowCollectionID)
                cellRange.Style = newStyle  '収集項目ｾｯﾄID
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                cellRange = .GetCellRange(.Row, CPlngvsfFlowCollectionVer)
                cellRange.Style = newStyle 'ﾊﾞｰｼﾞｮﾝ
                .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                
                '@Discon情報反映
                If vsfCollectionList.GetData(vsfCollectionList.Row, CMlngvsfCollectionStatus) = CMstrApplyJ Then    '状態（適用済み）
                    .SetData(.Row, CPlngvsfFlowCollectionValid, CMlngValid)       '有効
                Else
                    .SetData(.Row, CPlngvsfFlowCollectionValid, CMlngInValid)     '無効
                End If
                
                
                '@ｾﾙの移動
                .Col = CPlngvsfFlowCollectionID
                .ShowCell(.Row, CPlngvsfFlowCollectionID)
                
                If vsfFlowList1.Visible = True Then
                    .HighLight = HighLightEnum.Always
                     vsfFlowList1.HighLight = HighLightEnum.Never
                End If
                
                '@変更ﾌﾗｸﾞｵﾝ
                pblnEN01X2Edit = True
                
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "vsfCollectionList_DblClick"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


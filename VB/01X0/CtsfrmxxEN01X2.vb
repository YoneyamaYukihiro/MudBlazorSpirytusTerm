    '関数名：vsfStepList_DblClick
    '機　能：小工程　ﾀﾞﾌﾞﾙｸﾘｯｸ処理
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/25 (Thu) 15:47:12 N.Kasai
    '更新日：2014/01/14 (Tue) 18:35:05 T.Oide
    '備　考：
    Private Sub vsfStepList_DblClick(ByVal sender As Object, ByVal e As MouseEventArgs) Handles vsfStepList.DoubleClick
        
        Dim lstrSendId      As String       'ﾜｰｸ文字列
        Dim lblnRtn         As Boolean      '汎用戻り値
        Dim lstrNowStepID   As String       '変更前小工程ID
    '@↓2014/01/14 (Tue) 18:46:42 T.Oide **************************************************
        Dim llngMsgAns      As Integer
    '@↑2014/01/14 (Tue) 18:46:42 T.Oide **************************************************

        Try
            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            'NSYS データ行がない場合は処理を抜ける
            If vsfStepList.Rows.Count <= vsfStepList.Rows.Fixed Then
                Return
            End If

            With vsfStepList
                
                '@ﾍｯﾀﾞｰﾀﾞﾌﾞﾙｸﾘｯｸの場合
                If .HitTest(e.X,e.Y).Type = HitTestTypeEnum.ColumnHeader Then
                    Exit Sub
                End If
                
                '@一覧が存在しない場合には処理抜け
                If .Rows.Count = 1 Then
                    Exit Sub
                End If
                
                'NSYS EmptyAreaﾀﾞﾌﾞﾙｸﾘｯｸの場合
                If .HitTest(e.X,e.Y).Type = HitTestTypeEnum.None Then
                    Exit Sub
                End If

                '@内容を変数に代入
                lstrSendId = .GetData(.Row, CMlngvsfStepListStepID)

                '@変数の内容ﾁｪｯｸ
                If lstrSendId = vbNullString Then
                    '@空白の場合
                    Exit Sub
                End If
                
                '@有効無効ﾁｪｯｸ：無効ﾌﾗｸﾞが立っている場合：処理を中断
                lblnRtn = prvblnvsfEditListInValid_Chk(vsfStepList, vsfStepList.Row)
                
                '@結果判定
                If lblnRtn = False Then
                    '@無効の場合
                    Exit Sub
                End If
                
             End With
                
             With vsfFlowList0
                
                '@編集不可工程の場合
                If .GetData(.Row, CPlngvsfFlowPermit) <> CMstrPermit1 Then
                    Exit Sub
                End If
                
                '@ﾌﾛｰﾘｽﾄ小工程と選択した小工程が同じ場合
                If .GetData(.Row, CPlngvsfFlowStepID) = lstrSendId Then
                    Exit Sub
                End If

                '@現在の大工程を退避(重複ﾁｪｯｸで引っ掛かった場合の処理の為)
                lstrNowStepID = .GetData(.Row, CPlngvsfFlowStepID)
                
                'APC TEOS制御
                Call ControlApcTeosData(vsfFlowList0, CPlngvsfFlowStepID, lstrSendId, .Row)
                
                '@選択ｾﾙの内容をﾌﾛｰﾘｽﾄ画面に渡す
                .SetData(.Row, CPlngvsfFlowStepID, lstrSendId)
                .AutoSizeCol(CPlngvsfFlowStepID, 6) '列幅自動調整
                

                '@大工程・小工程の重複ﾁｪｯｸ
                lblnRtn = prvblnOpStepIDDouble_Chk
                '@重複ﾁｪｯｸ判定
                If lblnRtn = False Then
                    '@退避しておいた元大工程に戻す
                    .SetData(.Row, CPlngvsfFlowStepID, lstrNowStepID)
                    Exit Sub
                End If
                
        '@↓2014/01/14 (Tue) 18:35:12 T.Oide **************************************************
                '@実績報告工程チェック
                lblnRtn = prvblnReportpoint_Chk(.Row)
                
                '@判定
                If lblnRtn = True Then
                
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar0126, CMstrChangAction, Me.Text)
                    '@"<TRM126W>$$実績報告工程(赤字工程)を[%1]すると在庫の差異が発生します。 "
                    '　　　　　　 [%1]する場合は必ず生産管理担当者と調整のうえ実行してください。"
                    llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                    
                    '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                    If llngMsgAns = vbNo Then       '「いいえ」を選択(削除処理ｷｬﾝｾﾙ)
                    
                        '@退避しておいた元大工程に戻す
                        .SetData(.Row, CPlngvsfFlowStepID, lstrNowStepID)
                        Exit Sub
                    End If
                End If
        '@↑2014/01/14 (Tue) 18:35:12 T.Oide **************************************************
                
                '@APC削除ﾁｪｯｸ
                lblnRtn = prvblnApcClear_Chk
                '@ﾁｪｯｸ判定
                If lblnRtn = False Then
                    '@退避しておいた元大工程に戻す
                    .SetData(.Row, CPlngvsfFlowStepID, lstrNowStepID)
                    Exit Sub
                End If
            
                '@ﾊﾞｯｸｶﾗｰを変更
                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                Dim cellRange As CellRange = .GetCellRange(.Row, CPlngvsfFlowStepID)
                cellRange.Style = newStyle
                .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                
                '@Discon情報反映
                If vsfStepList.GetData(vsfStepList.Row, CMlngvsfStepListStatus) = CMstrValid Then    '状態（有効）
                    .SetData(.Row, CPlngvsfFlowStepValid, CMlngValid)       '有効
                Else
                    .SetData(.Row, CPlngvsfFlowStepValid, CMlngInValid)     '無効
                End If
                
                If vsfFlowList1.Visible = True Then
                    .HighLight = HighLightEnum.Always
                     vsfFlowList1.HighLight = HighLightEnum.Never
                End If
                
                '@ｾﾙの移動
                .Col = CPlngvsfFlowStepID
                .ShowCell(.Row, CPlngvsfFlowStepID)

                '@変更ﾌﾗｸﾞｵﾝ
                pblnEN01X2Edit = True
             
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "vsfStepList_DblClick"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


    '関数名：prvvsfConditionRecipe_Disp
    '機　能：処理条件情報の表示
    '引　数：ltypMasConDetailList ：取得情報
    '戻り値：なし
    '作成日：2006/06/21 (Wed) 09:21:08 N.Kasai
    '更新日：2006/06/21 (Wed) 09:21:08
    '備　考：
    Private Sub prvvsfConditionRecipe_Disp(ByRef ltypMasCondDetailList As MasCondDetailList)

        Dim llngCnt     As Integer  'ｶｳﾝﾀ
        Dim lstrWPName  As String   '装置名
        Dim llngWpCnt   As Integer  '装置ｶｳﾝﾄ
        Dim llngRow     As Integer  'NSYS 行ｶｳﾝﾀ

        Try
            
            '@-----------------------------------------------
            '@　共通/個別によってﾌﾚｰﾑを表示/非表示を行っています。
            '@  ﾌﾚｰﾑが重なっています。注意！！
            '@-----------------------------------------------
            '@装置共通ﾚｼﾋﾟﾌﾗｸﾞ( 0: 個別、1: 共通）
            Select Case ltypMasCondDetailList.strWpCommonRecipeFlag
                Case CMstrFlgOff
                    '@個別ﾚｼﾋﾟ表示
                    fraRecipeAll.Visible = False
                    fraRecipe.Visible = True
                Case CMstrFlgOn
                    '@共通ﾚｼﾋﾟ表示
                    fraRecipeAll.Visible = True
                    fraRecipe.Visible = False
                Case Else
                    fraRecipeAll.Visible = True
                    fraRecipe.Visible = False
            End Select
            
            
            With vsfConditionList2
                '@表示件数が0件の場合
                If ltypMasCondDetailList.lngMasCondDetailCnt = 0 Then
                    '@ﾛｯｸ
                    .Enabled = False
                    vsfConditionList3.Enabled = False
                    vsfConditionWP.Enabled = False
                    
                    Exit Sub
                End If
                
                '@ﾛｯｸ解除
                .Enabled = True
                '@描画ﾛｯｸ
                .Redraw = False
                '@初期化
                .Rows.Count = 1                  '行
                '@WF列は非表示
                .Cols(CPlngvsfConDetailListWF).Visible = False
                '@最大行数を設定
                .Rows.Count = ltypMasCondDetailList.lngMasCondDetailCnt + 1

                '@取得件数分だけﾙｰﾌﾟ
                For llngCnt = 0 To ltypMasCondDetailList.lngMasCondDetailCnt -1
                    llngRow = llngCnt + 1
                    '@ﾚｼﾋﾟを表示
                    .SetData(llngRow, CPlngvsfConListNo, llngRow)                     '№
                    .SetData(llngRow, CPlngvsfConDetailListWpName, _
                         ltypMasCondDetailList.typMasCondDetail(llngCnt).strWpName)             '装置名
                        
                    .SetData(llngRow, CPlngvsfConDetailListRecID, _
                         ltypMasCondDetailList.typMasCondDetail(llngCnt).strRecipeId)           'ﾚｼﾋﾟ
                        
                    .SetData(llngRow, CPlngvsfConDetailListDefaultFlag, _
                         ltypMasCondDetailList.typMasCondDetail(llngCnt).strDefaultFlag)        'ﾃﾞﾌｫﾙﾄﾌﾗｸﾞ
                        
                    .SetData(llngRow, CPlngvsfConDetailListWpID, _
                         ltypMasCondDetailList.typMasCondDetail(llngCnt).strWpID)               '装置ID
                        
                    .SetData(llngRow, CPlngvsfConDetailListRecVer, _
                         ltypMasCondDetailList.typMasCondDetail(llngCnt).strRecipeVersion)      'ﾚｼﾋﾟﾊﾞｰｼﾞｮﾝ
                
                    '@行高さ設定
                    .Rows(llngRow).Height = CMlngvsfListRowHeight2
                Next llngCnt
                
                '@再描画
                .Redraw = True
                '@列幅自動調整
                .AutoSizeCols(CPlngvsfConDetailListWpName, CPlngvsfConDetailListRecID, 6)
            End With
            
            '@WPｶｳﾝﾄの初期化
            llngWpCnt = 1
             
            With vsfConditionWP
                '@ﾛｯｸ解除
                .Enabled = True
                '@描画ﾛｯｸ
                .Redraw = False

                '@初期化
                .Rows.Count = 1                  '行
                '@最大行数を設定
                .Rows.Count = ltypMasCondDetailList.lngMasCondDetailCnt + 1
                
                '@取得件数分だけﾙｰﾌﾟ
                For llngCnt = 0 To ltypMasCondDetailList.lngMasCondDetailCnt -1
                    If lstrWPName <> ltypMasCondDetailList.typMasCondDetail(llngCnt).strWpName Then
                        '@ﾚｼﾋﾟを表示
                        .SetData(llngWpCnt, CMlngvsfConDetailWpNo, llngWpCnt)         '№
                        
                        .SetData(llngWpCnt, CMlngvsfConDetailWpCK, "1")               'ﾁｪｯｸｵﾝ
                        
                        .SetData(llngWpCnt, CMlngvsfConDetailWpID, _
                             ltypMasCondDetailList.typMasCondDetail(llngCnt).strWpID)           'WPID
                        
                        .SetData(llngWpCnt, CMlngvsfConDetailWpName, _
                             ltypMasCondDetailList.typMasCondDetail(llngCnt).strWpName)         '装置名
                        
                        '@先頭装置のWPIDを退避
                        lstrWPName = ltypMasCondDetailList.typMasCondDetail(llngCnt).strWpName
                        
                        '@行高さ設定
                        .Rows(llngWpCnt).Height = CMlngvsfListRowHeight2

                        llngWpCnt = llngWpCnt + 1
                    End If
                    
                Next llngCnt
                
                '@行数の再設定
                .Rows.Count = llngWpCnt
                
                '@再描画
                .Redraw = True
                '@列幅自動調整
                .AutoSizeCols(CPlngvsfConListNo, CMlngvsfConDetailWpName, 6)
            End With

            '@WPｶｳﾝﾄの初期化
            llngWpCnt = 1
            
             With vsfConditionList3
                '@ﾛｯｸ解除
                .Enabled = True
                '@描画ﾛｯｸ
                .Redraw = False
                '@初期化

                .Rows.Count = 1                  '行
                '@WF列は非表示
                .Cols(CPlngvsfConDetailListWF).Visible = False
                '@最大行数を設定
                .Rows.Count = ltypMasCondDetailList.lngMasCondDetailCnt + 1

                '@取得件数分だけﾙｰﾌﾟ
                For llngCnt = 0 To ltypMasCondDetailList.lngMasCondDetailCnt -1
                    llngRow = llngCnt + 1
                    '@ﾚｼﾋﾟを表示
                    .SetData(llngRow, CPlngvsfConListNo, llngRow)                     '№
                    
                    .SetData(llngRow, CPlngvsfConDetailListWpName, _
                         ltypMasCondDetailList.typMasCondDetail(llngCnt).strWpName)             '装置名
                        
                    .SetData(llngRow, CPlngvsfConDetailListRecID, _
                         ltypMasCondDetailList.typMasCondDetail(llngCnt).strRecipeId)           'ﾚｼﾋﾟ
                        
                    .SetData(llngRow, CPlngvsfConDetailListDefaultFlag, _
                         ltypMasCondDetailList.typMasCondDetail(llngCnt).strDefaultFlag)        'ﾃﾞﾌｫﾙﾄﾌﾗｸﾞ
                        
                    .SetData(llngRow, CPlngvsfConDetailListWpID, _
                         ltypMasCondDetailList.typMasCondDetail(llngCnt).strWpID)               '装置ID
                        
                    .SetData(llngRow, CPlngvsfConDetailListRecVer, _
                         ltypMasCondDetailList.typMasCondDetail(llngCnt).strRecipeVersion)      'ﾚｼﾋﾟﾊﾞｰｼﾞｮﾝ
                    
                    '@先頭装置のWPIDを退避
                    If llngCnt = 0 Then
                        lstrWPName = ltypMasCondDetailList.typMasCondDetail(llngCnt).strWpName
                    End If
                    
                    '@装置が変わったら終了（共通ﾚｼﾋﾟの為、同一ﾚｼﾋﾟである）
                    If lstrWPName <> ltypMasCondDetailList.typMasCondDetail(llngCnt).strWpName Then
                        Exit For
                    End If
                    
                    '@行高さ設定
                    .Rows(llngRow).Height = CMlngvsfListRowHeight2
                Next llngCnt
                
                '@行数の再設定
                .Rows.Count = llngRow +1
                '@再描画
                .Redraw = True
                '@列幅自動調整
                .AutoSizeCols(CPlngvsfConDetailListWpName, CPlngvsfConDetailListRecID, 6)
            End With
            
            '@ﾊﾟﾌﾞﾘｯｸ構造体の設定
            ptypMasCondDetailList.strSkipFlag = ltypMasCondDetailList.strSkipFlag                               'ｽｷｯﾌﾟﾌﾗｸﾞ
            ptypMasCondDetailList.strLoaderUnloaderFlag = ltypMasCondDetailList.strLoaderUnloaderFlag           'ﾛｰﾀﾞｰｱﾝﾛｰﾀﾞｰﾌﾗｸﾞ
            ptypMasCondDetailList.strTransModeName = ltypMasCondDetailList.strTransModeName                     '移載ﾓｰﾄﾞ名
            ptypMasCondDetailList.strWorkCondition = ltypMasCondDetailList.strWorkCondition                     '作業条件
            ptypMasCondDetailList.strComments = ltypMasCondDetailList.strComments                               'ｺﾒﾝﾄ
            ptypMasCondDetailList.strBeforeCarrierTypeName = ltypMasCondDetailList.strBeforeCarrierTypeName     '移載元ｷｬﾘｱ名
            ptypMasCondDetailList.strAfterCarrierTypeName = ltypMasCondDetailList.strAfterCarrierTypeName       '移載先ｷｬﾘｱ名
            ptypMasCondDetailList.strWpCommonRecipeFlag = ltypMasCondDetailList.strWpCommonRecipeFlag           '装置共通ﾚｼﾋﾟﾌﾗｸﾞ( 0: 個別、1: 共通）
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvvsfConditionRecipe_Disp"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


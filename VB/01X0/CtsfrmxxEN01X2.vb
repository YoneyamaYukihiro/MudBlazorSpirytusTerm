    '関数名：cmbStepCategory_Validate
    '機　能：小工程ｶﾃｺﾞﾘ　ﾊﾞﾘﾃﾞｨﾄ処理
    '引　数：Cancel：未使用
    '戻り値：なし
    '作成日：2006/05/26 (Fri) 10:06:13 N.Kasai
    '更新日：2006/05/26 (Fri) 10:06:13
    '備　考：
    Private Sub cmbStepCategory_Validate(ByVal sender As Object, ByVal e As CancelEventArgs) Handles cmbStepCategory.Validating
        
        Dim ltypMasStepList As MasStepList  '取得情報
        Dim lblnAns         As Boolean      '戻り値
        Dim lstrEventName   As String       'ｲﾍﾞﾝﾄ名格納（ﾚｽﾎﾟﾝｽ用）

        Try

            'NSYS 画面を閉じる場合は処理を抜ける
            If mblnWindowClose = True Then
                Exit Sub
            End If
            
            '@--------------------------------------------------------------
            '@小工程ｶﾃｺﾞﾘ変更なし
            '@--------------------------------------------------------------
            If mstrStepCategory = cmbStepCategory.Text Then
                If ActiveControl.Name = cmbStepCategory.Name Then
                    '@ﾌｫｰｶｽ制御
                    If vsfStepList.Rows.Count > 1 Then
                        '@ﾘｽﾄが存在する場合
                        '@ﾌｫｰｶｽｾｯﾄ
                        Call pubSetFocus(vsfStepList)
                    Else
                        '@ﾘｽﾄが存在しない場合
                        Call pubSetFocus(cmbStepCategory)
                    End If
                End If

                Exit Sub
                
            End If
            
            '@--------------------------------------------------------------
            '@小工程ｶﾃｺﾞﾘが変更されていたら
            '@--------------------------------------------------------------

            '@ﾚｽﾎﾟﾝｽ取得開始
            lstrEventName = "cmbStepCategory_Validate"
            Call pubResponseStart(Me.Name, lstrEventName)
            
            '@現在の大工程ｶﾃｺﾞﾘを格納
            mstrStepCategory = cmbStepCategory.Text

            '@小工程ｶﾃｺﾞﾘ/小工程名の選択処理
            With vsfStepList
                '@初期化
                .Rows.Count = .Rows.Fixed
                
                If cmbStepCategory.Text = CMstrAllCategory Then
                    '@すべての場合
                    '@MSG【小工程ﾏｽﾀ取得】（CPstrCD02：全件）
                    lblnAns = pubblnMasUseStepList_Sel(pstrSBID, CMstrmas_usesteplistVer, CPstrCD02, ltypMasStepList)
                Else
                    '@ｶﾃｺﾞﾘ指定の場合
                    '@MSG【小工程ﾏｽﾀ取得】（CPstrCD2M：ｶﾃｺﾞﾘID指定）
                    lblnAns = pubblnMasUseStepList_Sel(pstrSBID, CMstrmas_usesteplistVer, CPstrCD2M, ltypMasStepList, , mstrStepCategory)
                End If
                    
                '@MSG[小工程取得]の結果判定
                If lblnAns = False Then
                    '@小工程取得に失敗
                    '@ﾚｽﾎﾟﾝｽｷｬﾝｾﾙ
                    Call pubResponseCancel(Me.Name, lstrEventName)
                    
                    Exit Sub
                End If
            
                '@MSG[小工程取得]での取得情報を表示
                Call prvvsfStepList_Disp(ltypMasStepList)

                '@有効ﾁｪｯｸによる処理判別
                If chkValidStepID.Checked = True Then
                    '@有効の場合
                    Call prvvsfEditLsit_Proc(vsfStepList, True)
                Else
                    '@無効の場合
                    Call prvvsfEditLsit_Proc(vsfStepList, False)
                End If
            
                '@ﾌｫｰｶｽの制御
                If .Rows.Count > 1 Then
                    If ActiveControl.Name = cmbStepCategory.Name Then
                        '@ﾘｽﾄが存在する場合
                        Call pubSetFocus(vsfStepList)
                    End If
                    .Col = 0
                    .Row = 1
                    '@1行目を選択状態
                    .ShowCell(.Row, .Col)           '@ﾌｫｰｶｽｾｯﾄ
                Else
                    If ActiveControl.Name = cmbStepCategory.Name Then
                        '@ﾘｽﾄが存在しない場合
                        Call pubSetFocus(cmbStepCategory)
                    End If
                End If
            
            End With

            '@ﾚｽﾎﾟﾝｽ取得終了
            Call publngResponseEnd(Me.Name, lstrEventName)
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "cmbStepCategory_Validate"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


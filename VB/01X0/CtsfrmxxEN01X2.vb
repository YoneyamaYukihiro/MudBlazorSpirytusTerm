                        If .GetCellCheck(.Row, CPlngvsfFlowJudgeSkipFlag) = CheckEnum.Unchecked Then
                            '@ﾁｪｯｸなし→ﾁｪｯｸ
                            '@編集：ｷｰﾎﾞｰﾄﾞ可
                            .AllowEditing = True

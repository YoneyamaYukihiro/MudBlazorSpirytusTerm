                '@ﾌｫｰｶｽの移動/ﾊﾞﾘﾃﾞｨﾄ処理へ
                RemoveHandler cmbConditionCategory.Validating, AddressOf cmbConditionCategory_Validate
                Call cmbConditionCategory_Validate(cmbConditionCategory,New CancelEventArgs(True))

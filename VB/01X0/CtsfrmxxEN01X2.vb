    '関数名：cmbConditionCategory_Validate
    '機　能：処理条件ｶﾃｺﾞﾘ　ﾊﾞﾘﾃﾞｨﾄ処理
    '引　数：Cancel：ｷｬﾝｾﾙ値
    '戻り値：なし
    '作成日：2006/06/20 (Tue) 14:01:50 N.Kasai
    '更新日：2018/06/28 (Thu) 11:08:12 T.Oide
    '備　考：
    Private Sub cmbConditionCategory_Validate(ByVal sender As Object, ByVal e As CancelEventArgs) Handles cmbConditionCategory.Validating

        Dim lblnAns                 As Boolean              '戻り値
        Dim ltypMasConditionList    As MasConditionList     '処理条件ｾｯﾄIDﾘｽﾄ
        Dim lstrEventName           As String               'ｲﾍﾞﾝﾄ名格納（ﾚｽﾎﾟﾝｽ用）
        Dim llngCnt                 As Integer              'ｶｳﾝﾀ
        
        Try

            'NSYS 画面を閉じる場合は処理を抜ける
            If mblnWindowClose = True Then
                Exit Sub
            End If

            '@処理条件ｶﾃｺﾞﾘが選択されていない場合、処理中止
            If cmbConditionCategory.ListIndex = -1 Then
                Exit Sub
            End If
            
            '@退避領域と同じ場合には処理を行わない
            If mstrCondition = cmbConditionCategory.Text Then
                Exit Sub
            End If
            
            '@↓2020/02/27 (Thu) 14:02:59 Y.Yoneyama 「.Netへ反映未」 **************************************************
            '@全検索は運用環境では通信TimeOutする為、禁止(2020.02.27)
            If cmbConditionCategory.Text = CMstrAllCategory Then
                '@"<TRM171W>$$データ量が多い為、全検索は制限しています。"
                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar0171, CPstrKeyTRM)
                Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                
                Exit Sub
            End If
            '@↑2020/02/27 (Thu) 14:02:59 Y.Yoneyama 「.Netへ反映未」 **************************************************

            '@退避領域へｶﾃｺﾞﾘｾｯﾄ
            mstrCondition = cmbConditionCategory.Text
            
            '@ﾚｽﾎﾟﾝｽ取得開始
            lstrEventName = "cmbConditionCategory_Validate"
            Call pubResponseStart(Me.Name, lstrEventName)
            
            '@初期化
            vsfConditionList1.Redraw = False
            vsfConditionList1.Rows.Count = 1
            vsfConditionList1.Redraw = True
            vsfConditionList2.Redraw = False
            vsfConditionList2.Rows.Count = 1
            vsfConditionList2.Redraw = True
            vsfConditionList3.Redraw = False
            vsfConditionList3.Rows.Count = 1
            vsfConditionList3.Redraw = True
            vsfConditionWP.Redraw = False
            vsfConditionWP.Rows.Count = 1
            vsfConditionWP.Redraw = True

            vsfConditionList2.Cols(CPlngvsfConDetailListWFCol).Visible = False 'WF非表示
            
            '@ﾌﾚｰﾑの表題を「処理条件セットID　詳細」にする
            fraCondition2.Text = CMstrConditionDetail
                    
            '@ｶﾃｺﾞﾘ選択条件判定
            If cmbConditionCategory.Text = CMstrAllCategory Then
                '@ｶﾃｺﾞﾘが「（すべて）」の場合
                '@MSG【処理条件ｾｯﾄIDﾘｽﾄ取得】（全て[02]）
                lblnAns = pubblnMasConditionList_Sel(pstrSBID, _
                                                     CMstrmas_conditionlistVer, _
                                                     CPstrCD02, _
                                                     ltypMasConditionList)
            Else
                '@ｶﾃｺﾞﾘが指定されているの場合
                '@MSG【処理条件ｾｯﾄIDﾘｽﾄ取得】（ｶﾃｺﾞﾘ指定[2M]）
                lblnAns = pubblnMasConditionList_Sel(pstrSBID, _
                                                     CMstrmas_conditionlistVer, _
                                                     CPstrCD2M, _
                                                     ltypMasConditionList, , _
                                                     mstrCondition)
            End If
            
            '@MSG[処理条件取得]の結果判定
            If lblnAns = False Then
            '@処理条件取得に失敗
                '@ﾚｽﾎﾟﾝｽｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If

            '@処理条件ｾｯﾄID一覧を表示
            RemoveHandler cmbConditionCategory.Change,AddressOf cmbConditionCategory_Change
            Call prvvsfConditionList_Disp(ltypMasConditionList)
            AddHandler cmbConditionCategory.Change,AddressOf cmbConditionCategory_Change

        '@↓2018/06/28 (Thu) 11:05:35 T.Oide **************************************************
        '@    '@有効ﾁｪｯｸによる処理判別
        '@    If chkValidCondition.Value = CMlngValid Then
        '@        '@有効の場合
        '@        Call prvvsfEditLsit_Proc(vsfConditionList(CMlngvsfConListIndex1), True)
        '@    Else
        '@        '@無効の場合
        '@        Call prvvsfEditLsit_Proc(vsfConditionList(CMlngvsfConListIndex1), False)
        '@    End If
        '@------------------------------------------------------------------------------------
                
            '@処理条件のｸﾞﾘｯﾄﾞ再表示(行の表示/非表示設定）
            Call prvvsfEditLsitCondition_Proc()
        '@↑2018/06/28 (Thu) 11:05:35 T.Oide **************************************************
            
            '@ﾚｽﾎﾟﾝｽ取得終了
            Call publngResponseEnd(Me.Name, lstrEventName)
            
            '@ﾌｫｰｶｽの制御
            With vsfConditionList1
                '@処理条件ｾｯﾄID一覧ﾘｽﾄに件数がある場合
                '@ﾁｪｯｸを切り替えることで,選択行を表示されている1行目へ
                If .Rows.Fixed <> .Rows.Count Then
                    '@選択行を初期化
                    .Row = .Rows.Fixed
                    For llngCnt = .Rows.Fixed To .Rows.Count - 1
                        '@隠し行でない場合

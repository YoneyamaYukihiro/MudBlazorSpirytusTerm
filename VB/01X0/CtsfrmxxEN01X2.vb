                            Case CPstrTpalJRight
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, CPstrTpalJRightName)
                            
                            '@蒸着ﾊﾞｯﾁ+左貼合
                            Case CPstrTpalJBatchLeft
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, CPstrTpalJBatchLeftName)
                            
                            '@蒸着ﾊﾞｯﾁ+右貼合
                            Case CPstrTpalJBatchRight
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, CPstrTpalJBatchRightName)
                            
                            '@表面ﾊﾞｯﾁ貼合
                            Case CPstrTpalHBatch
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, CPstrTpalHBatchName)
                            
                            '該当項目なしは空
                            Case Else
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, vbNullString)
                            
                        End Select
                        
                        '@-------------------------------------------------
                        '@ｷｬﾘｱｶﾃｺﾞﾘ
                        '@-------------------------------------------------
                        If .strCarrierCategoryId <> vbNullString Then
                            
                            '@ｷｬﾘｱｶﾃｺﾞﾘﾘｽﾄを検索して該当ｷｬﾘｱｶﾃｺﾞﾘIDを探す
                            For llngCateCnt = 0 To mtypCarrierCategoryList.typCarrierCategory.Count -1
                            
                                '@ｷｬﾘｱｶﾃｺﾞﾘIDをｷｬﾘｱｶﾃｺﾞﾘ名にして表示
                                If mtypCarrierCategoryList.typCarrierCategory(llngCateCnt).strCategoryID = .strCarrierCategoryId Then
                                    
                                    lvsfFlowList.SetData(llngRow, CPlngvsfFlowCarrierCategoryID, _
                                        mtypCarrierCategoryList.typCarrierCategory(llngCateCnt).strCategoryName)
                                    Exit For
                                
                                '@ｷｬﾘｱｶﾃｺﾞﾘIDがﾘｽﾄにない場合はｷｬﾘｱｶﾃｺﾞﾘIDをそのまま表示
                                Else
                                    lvsfFlowList.SetData(llngRow, CPlngvsfFlowCarrierCategoryID, .strCarrierCategoryId)
                                End If
                            Next llngCateCnt
                        Else
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowCarrierCategoryID, vbNullString)
                        End If
                        
                        '@-------------------------------------------------
                        '@ﾏｯﾌﾟ適用
                        '@-------------------------------------------------
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowMapUseFlag, .strMapUseFlag)          'ﾏｯﾌﾟ適用ﾌﾗｸﾞ
                        '組立(2A0)以外無効化
                        If pstrSBID <> CPstrSBID2A0 Then
                            newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                            cellRange = lvsfFlowList.GetCellRange(llngRow, CPlngvsfFlowMapUseFlag, _
                                                              llngRow, CPlngvsfFlowMapUseFlag)
                            cellRange.Style = newStyle
                        End If
                        
                        '@-------------------------------------------------
                        '@区間優先
                        '@-------------------------------------------------
                        '@工順変更対象ﾛｯﾄの場合は区間優先度を指定
                        
                        '@「変更中工順」か
                        If lvsfFlowList Is vsfFlowList0 Then
                            '「変更中工順」の場合
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowPriority, .strPriority)           '区間優先度
                        Else
                            '@「ｺﾋﾟｰ工順」の場合
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowPriority, vbNullString)           '区間優先度
                        End If
            
                        '@-------------------------------------------------
                        '@実績報告ﾎﾟｲﾝﾄ
                        '@-------------------------------------------------
                        '@工順変更対象ﾛｯﾄで報告ﾎﾟｲﾝﾄﾏｽﾀｰが空で無い場合は値を設定
                        
                        '@「変更中工順」か
                        If lvsfFlowList Is vsfFlowList0 And ltypeReportPoint.lngPdListCnt > 0 Then
                            '@「変更中工順」の場合
                            ' 一致する工程を構造体から探して設定
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowReportPointFlag, _
                                                                        prvReportPointFlagRaw(ltypeReportPoint, llngRow))    '実績報告工程
                        Else
                            '@「ｺﾋﾟｰ工順」の場合
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowReportPointFlag, vbNullString)    '実績報告工程
                        End If

        '@↓2018/03/12 (Mon) 14:27:27 T.Oide **************************************************
                        '@-------------------------------------------------
                        '@ﾚｼﾋﾟ選択APC設定
                        '@-------------------------------------------------
                        Call prvReciSelApc_Disp(lvsfFlowList, llngRow, ltypFlowListAns.typLotProcFlow(llngCnt))
        '@↑2018/03/12 (Mon) 14:27:27 T.Oide **************************************************

                        '@1行の高さを指定
                        lvsfFlowList.Rows(llngRow).Height = CMlngvsfListRowHeight
                        
                        '@「変更中工順」か（ここからはﾊﾞｯｸｶﾗｰの設定)
                        If lvsfFlowList Is vsfFlowList0 Then
                            
                            '@「変更中工順」の場合
                            
                            '@処理条件ｾｯﾄIDVerのﾊﾞｯｸｶﾗｰを変更不可色へ変更
                            newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                            cellRange = lvsfFlowList.GetCellRange(1, CPlngvsfFlowConditionVer, _
                                                              llngRow, CPlngvsfFlowConditionVer)
                            cellRange.Style = newStyle
                            '@収集項目ｾｯﾄIDVerのﾊﾞｯｸｶﾗｰを変更不可色へ変更
                            newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                            cellRange = lvsfFlowList.GetCellRange(1, CPlngvsfFlowCollectionVer, _
                                                              llngRow, CPlngvsfFlowCollectionVer)
                            cellRange.Style = newStyle
                            '@代替工程部分のﾊﾞｯｸｶﾗｰを変更
                            newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                            cellRange = lvsfFlowList.GetCellRange(1, CPlngvsfFlowAltSet, _
                                                              llngRow, CPlngvsfFlowAltEndFlag)
                            cellRange.Style = newStyle
                                                              
                            '@特殊ﾛｯﾄの場合は時間制限/号機限定の新規設定は不可
                            If pstrEN01X0ProcFlag = "1" Then
                                '@時間制限部分のﾊﾞｯｸｶﾗｰを変更
                                newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                cellRange = lvsfFlowList.GetCellRange(1, CPlngvsfFlowTimeLimit, _
                                                              llngRow, CPlngvsfFlowTimeLimitFlag)
                                cellRange.Style = newStyle
                                                              
                                                              
                                '@処理号機部分のﾊﾞｯｸｶﾗｰを変更
                                newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                cellRange = lvsfFlowList.GetCellRange(1, CPlngvsfFlowWpRestrict, _
                                                              llngRow, CPlngvsfFlowWpRestrictFlag)
                                cellRange.Style = newStyle
                            End If
                            
                            '@実績報告工程ﾌﾗｸﾞ
                            newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                            cellRange = lvsfFlowList.GetCellRange(1, CPlngvsfFlowReportPointFlag, _
                                                            llngRow, CPlngvsfFlowReportPointFlag)
                            cellRange.Style = newStyle
                        
        '@↓2018/03/12 (Mon) 12:55:13 T.Oide **************************************************
                            '@ﾚｼﾋﾟ選択APC
                            newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                            cellRange = lvsfFlowList.GetCellRange(1, CPlngvsfFlowRecpSelApc, _
                                                            llngRow, CPlngvsfFlowRecpSelApc)
                            cellRange.Style = newStyle
        '@↑2018/03/12 (Mon) 12:55:13 T.Oide **************************************************
                        
                        Else
                            
                            '@ｺﾋﾟｰ工順の場合
                            ' ﾊﾞｯｸｶﾗｰをｸﾞﾚｰに設定
                            newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                            cellRange = lvsfFlowList.GetCellRange(1, 0, llngRow, lvsfFlowList.Cols.Count - 1) 
                            cellRange.Style = newStyle
                        End If
                        
                        '@-------------------------------------------------
                        '@TEOS F/B設定表示
                        '@-------------------------------------------------
                        Call SetApcTeosData(lvsfFlowList, llngRow, .typApcTeos, nKeepRow, strKeepGroup)
                    
                        '@-------------------------------------------------
                        '@TEOS PrismAPC設定表示
                        '@-------------------------------------------------
                        If .typTeosPrismApc.strGroupNo <> vbNullString Then
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowTeosPrismAPC, _
                                                            Format$(CInt(.typTeosPrismApc.strGroupNo), CMstrTeosAPCFormat) & _
                                                            CMstrCaptionHyphen & .typTeosPrismApc.strApcType)
                        End If
                        
                        newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                        cellRange = lvsfFlowList.GetCellRange(1, CPlngvsfFlowTeosPrismAPC, _
                                                    llngRow, CPlngvsfFlowTeosPrismAPC)
                        cellRange.Style = newStyle
                                                            
                    End With
                    
                Next llngCnt
                
                '@描画ﾛｯｸ解除
                .Redraw = True
                
                '@「変更中工順」か
                If lvsfFlowList Is vsfFlowList0 Then
                
                    '@「変更中工順」の場合
                
                    '@ﾘﾜｰｸ、特殊ﾛｯﾄの場合はﾘﾜｰｸ、特殊ﾙｰﾄの設定は行わない
                    Select Case pstrEN01X0ProcFlag
                        
                        '@特殊ﾛｯﾄ（ﾘﾜｰｸ、特殊流動）
                        Case "1"
                            '@ﾘﾜｰｸ&特集関連非表示
                            lvsfFlowList.Cols(CPlngvsfFlowReworkRouteID).Visible = False
                            lvsfFlowList.Cols(CPlngvsfFlowReworkReturnOpID).Visible = False
                            lvsfFlowList.Cols(CPlngvsfFlowReworkReturnStepID).Visible = False
                            lvsfFlowList.Cols(CPlngvsfFlowSPRouteID).Visible = False
                            lvsfFlowList.Cols(CPlngvsfFlowSPReturnOpID).Visible = False
                            lvsfFlowList.Cols(CPlngvsfFlowSPReturnStepID).Visible = False

                        Case Else
                            '@ﾘﾜｰｸ&特集関連表示
                            lvsfFlowList.Cols(CPlngvsfFlowReworkRouteID).Visible = True
                            lvsfFlowList.Cols(CPlngvsfFlowReworkReturnOpID).Visible = True
                            lvsfFlowList.Cols(CPlngvsfFlowReworkReturnStepID).Visible = True
                            lvsfFlowList.Cols(CPlngvsfFlowSPRouteID).Visible = True
                            lvsfFlowList.Cols(CPlngvsfFlowSPReturnOpID).Visible = True
                            lvsfFlowList.Cols(CPlngvsfFlowSPReturnStepID).Visible = True
                    End Select
                Else
                    
                    '@ｺﾋﾟｰ工順の場合
                    
                    '@表示列再表示
                    lvsfFlowList.Cols(CPlngvsfFlowConditionOne).Visible = True              '個別処理条件
                    lvsfFlowList.Cols(CPlngvsfFlowApcSkipFlag).Visible = True               'APCｽｷｯﾌﾟ
                    lvsfFlowList.Cols(CPlngvsfFlowApcCalcSkipFlag).Visible = True           'APC計算対象外
                    
                    '@見出のﾊﾞｯｸｶﾗｰ変更
                    '@pstrEN01X0KindFlag:種別（1:ﾛｯﾄ工順変更、2:組立工順一時保存）
                    '@ﾛｯﾄ状態が「投入待ち」の場合は個別処理条件のｺﾋﾟｰはしない
                    '@ﾛｯﾄ状態が空白の場合（工順なし）は個別処理条件のｺﾋﾟｰはしない
                    Dim cellRange As CellRange
                    Dim newStyle As CellStyle
                    If pstrEN01X0KindFlag = "2" Or _
                       lblCurrentStatus.Text = CPstrWaitThrowSt Or _
                       lblCurrentStatus.Text = vbNullString Then
                            
                        newStyle = lvsfFlowList.Styles.Add("CustomStyle_ForeColor_CPlngVbColorBlue_BackColor_CMlngBackColorGray")
                        newStyle.ForeColor = ColorTranslator.FromWin32(CPlngVbColorBlue)
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                        cellRange = lvsfFlowList.GetCellRange(CMlngvsfListRowTitle, CPlngvsfFlowConditionOne, CMlngvsfListRowTitle, CPlngvsfFlowConditionOne)
                        cellRange.Style = newStyle
                    Else
                        newStyle = lvsfFlowList.Styles.Add("CustomStyle_ForeColor_vbYellow_BackColor_CPlngBlueColor")
                        newStyle.ForeColor = Color.Yellow
                        newStyle.BackColor = ColorTranslator.FromWin32(CPlngBlueColor)
                        cellRange = lvsfFlowList.GetCellRange(CMlngvsfListRowTitle, CPlngvsfFlowConditionOne, CMlngvsfListRowTitle, CPlngvsfFlowConditionOne)
                        cellRange.Style = newStyle
                    End If
                    
                    '@ｺﾏﾝﾄﾞﾎﾞﾀﾝ制御
                    cmdApcSet.Enabled = False       'APC設定
                    cmdTimeLimitSet.Enabled = False '時間制限
                
                End If
                
                '@列幅を自動調整
                .AutoSizeCols(CPlngvsfFlowNo, .Cols.Count - 1, 6)
                
                '@「変更中工順」か
                If lvsfFlowList Is vsfFlowList0 Then
                
                    If .Rows.Count - 1 < mlngCurrentRow Then
                        '@現在行を表示
                        .TopRow = mlngCurrentRow - 1
                        .Row = mlngCurrentRow - 1
                    Else
                        '@現在行を表示
                        .TopRow = mlngCurrentRow
                        .Row = mlngCurrentRow
                    End If
                    
                    .ShowCell(.Row, CPlngvsfFlowOpID)
                    
                    '@絶対工順番号を設定
                    plngSeqNoCnt = llngSeqCnt + 1
                
                End If
                
                If nKeepRow <> -1 Then
                    Dim newStyle As CellStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_vbWhite")
                    newStyle.BackColor = Color.White
                    Dim cellRange As CellRange = lvsfFlowList.GetCellRange(nKeepRow, CPlngvsfFlowApcTeosCalcSkipFlag)
                    cellRange.Style = newStyle
                End If
                
                '編集可能行以前のデータを全て編集可能に上書きする
                For i = 1 To (mlngCurrentRow - 1)
                    Dim newStyle As CellStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                    Dim cellRange As CellRange = lvsfFlowList.GetCellRange(i, CPlngvsfFlowApcTeosCalcSkipFlag)
                    cellRange.Style = newStyle
                Next
                    
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvvsfFlowList_Disp"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvvsfOpList_Disp
    '機　能：大工程情報表示
    '引　数：ltypMasOpList：取得情報
    '　　　：lstrCategory ：大工程ｶﾃｺﾞﾘ
    '戻り値：なし
    '作成日：2006/05/18 (Thu) 11:23:56 N.Kasai
    '更新日：2006/05/18 (Thu) 11:23:56
    '備　考：
    Private Sub prvvsfOpList_Disp(ByRef ltypMasOpList As MasOpList, _
                                  Optional ByVal lstrCategory As String = vbNullString)

        Dim llngCnt As Integer 'ｶｳﾝﾀ
        Dim llngRow As Integer 'NSYS 行ｶｳﾝﾀ

        Try
            
            '@ｶﾃｺﾞﾘが「（すべて）」以外の場合
            If lstrCategory <> CMstrAllCategory Then
                '@退避領域にｾｯﾄ
                mstrOpCategory = ltypMasOpList.strCategoryID
                
                '@ｶﾃｺﾞﾘの表示
                cmbOpCategory.Text = ltypMasOpList.strCategoryID
            Else
                '@退避領域にｾｯﾄ
                mstrOpCategory = CMstrAllCategory
            End If
            
            With vsfOpList

                '@ﾛｯｸ解除
                .Enabled = True

                '@描画ﾛｯｸ
                .Redraw = False
                
                '@行数初期化
                .Rows.Count = .Rows.Fixed
                
                '@有効行数を設定
                .Rows.Count = ltypMasOpList.lngMasOpCnt + 1
                
                '@取得件数分ﾙｰﾌﾟ
                For llngCnt = 0 To ltypMasOpList.lngMasOpCnt -1
                    llngRow = llngCnt + 1
                    .SetData(llngRow, CMlngvsfOpListNo, llngRow)                                      '№
                    .SetData(llngRow, CMlngvsfOpListOpID, ltypMasOpList.typMasOpId(llngCnt).strOpID)  '大工程名
                    
                    '@状態判定（有効/無効）
                    If ltypMasOpList.typMasOpId(llngCnt).strValidFlag = CMlngValid Then
                        .SetData(llngRow, CMlngvsfOpListStatus, CMstrValid)                           '状態（有効）
                    Else
                        .SetData(llngRow, CMlngvsfOpListStatus, CMstrInValid)                         '状態（無効）
                    End If
                Next llngCnt
                
                '@再描画
                .Redraw = True
            
                '@取得件数が0件の場合
                If ltypMasOpList.lngMasOpCnt = 0 Then
                    '@ﾛｯｸ
                    .Enabled = False
                End If
            
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvvsfOpList_Disp"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvvsfStepList_Disp
    '機　能：小工程情報表示
    '引　数：ltypMasStepList ：取得情報
    '戻り値：なし
    '作成日：2006/05/18 (Thu) 12:30:30 N.Kasai
    '更新日：2006/05/18 (Thu) 12:30:30
    '備　考：
    Private Sub prvvsfStepList_Disp(ByRef ltypMasStepList As MasStepList)

        Dim llngCnt As Integer 'ｶｳﾝﾀ
        Dim llngRow As Integer 'NSYS 行ｶｳﾝﾀ

        Try
            
            '@ｶﾃｺﾞﾘが「（すべて）」以外の場合
            If cmbStepCategory.Text <> CMstrAllCategory Then
                '@退避領域にｾｯﾄ
                mstrStepCategory = ltypMasStepList.strCategoryID
                
                '@小工程ｶﾃｺﾞﾘの表示
                cmbStepCategory.Text = ltypMasStepList.strCategoryID
            Else
                '@退避領域にｾｯﾄ
                mstrStepCategory = CMstrAllCategory
            End If
            
            With vsfStepList
                
                '@ﾛｯｸ解除
                .Enabled = True

                '@描画ﾛｯｸ
                .Redraw = False
                
                '@行初期可
                .Rows.Count = .Rows.Fixed
                
                '@有効行数を設定
                .Rows.Count = ltypMasStepList.lngMasStepCnt + 1
                               
                '@取得件数分ﾙｰﾌﾟ
                For llngCnt = 0 To ltypMasStepList.lngMasStepCnt -1
                    llngRow = llngCnt + 1
                    '@取得内容をｾﾙに出力

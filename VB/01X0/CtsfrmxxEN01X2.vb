    '戻り値：なし
    '作成日：2006/06/14 (Wed) 15:05:14 N.Kasai
    '更新日：2006/06/14 (Wed) 15:05:14
    '備　考：
    Private Sub prvcmdTimeLimitEnabled_Set()

        Dim llngRow            As Integer '行

        Try
            
            '@編集ﾌﾗｸﾞ（0/未編集　1/編集中　2/編集済　3/編集開始前）
            If mlngEditFlag <> 1 Then
                Exit Sub
            End If
            
            '@特殊ﾛｯﾄの場合は時間制限の新規設定は不可
            If pstrEN01X0ProcFlag = "1" Then
                '@時間制限設定ﾎﾞﾀﾝ使用不可
                cmdTimeLimitSet.Enabled = False
                
                Exit Sub
            End If
            
            With vsfFlowList0
            
                '@ﾌﾟﾛｾｽｸﾞﾘｯﾄに時間制限が設定されているかﾁｪｯｸ
                For llngRow = 1 To .Rows.Count - 1
                    If .GetData(llngRow, CPlngvsfFlowTimeLimit) <> vbNullString Then
                        cmdTimeLimitSet.Enabled = True  '存在する
                        Exit Sub
                    End If
                Next
                
                '@存在しない場合
                '@時間制限設定ﾎﾞﾀﾝ使用不可
                cmdTimeLimitSet.Enabled = False
                
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvcmdTimeLimitEnabled_Set"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


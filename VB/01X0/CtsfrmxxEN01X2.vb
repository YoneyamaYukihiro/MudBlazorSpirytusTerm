                                         .ShowCell(.Row, CMlngvsfCollectionColID)
                                         '@ﾌｫｰｶｽ設定
                                         Call pubSetFocus(vsfCollectionList)
                                             
                                         Exit For
                                     End If
                                 Next llngCnt
                             End With
                             
                             '@ﾚｽﾎﾟﾝｽ取得終了
                             Call publngResponseEnd(Me.Name, lstrEventName)
                        End If
                    
                    Case CPlngvsfFlowLotScrapSetId      '不良項目
                    
                        '@ﾌﾟﾛｾｽﾌﾛｰ画面の高さを設定
                        .Height = mlngvsfPcTabOnHeight
                        With stbSetPanel
                            '@編集画面の表示
                            .Visible = True
                            .SelectedIndex = CMlngScrapTabNo  '不良項目ﾀﾌﾞを表示
                            .Top = lvsfFlowList.Top + mlngvsfPcTabOnHeight
                        End With
                        cmdSetPanel.Enabled = True  '詳細表示ﾎﾞﾀﾝ使用可
                        
                        '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞが表示されている場合
                        If vsfFlowList1.Visible = True Then
                            If sender Is vsfFlowList0 Then
                                With lblFlowList0
                                    .Font = New Font(.Font, .Font.Style Or FontStyle.Bold) 
                                End With
                                lblFlowList0.ForeColor = Color.Red
                                With lblFlowList1
                                    .Font = New Font(.Font, .Font.Style And Not FontStyle.Bold) 
                                End With
                                lblFlowList1.ForeColor = Color.Black
                                
                                vsfFlowList0.HighLight = HighLightEnum.Always
                                vsfFlowList1.HighLight = HighLightEnum.Never
                            Else
                                With lblFlowList1
                                    .Font = New Font(.Font, .Font.Style Or FontStyle.Bold) 
                                End With
                                lblFlowList1.ForeColor = Color.Red
                                With lblFlowList0
                                    .Font = New Font(.Font, .Font.Style And Not FontStyle.Bold) 
                                End With
                                lblFlowList0.ForeColor = Color.Black
                                
                                vsfFlowList0.HighLight = HighLightEnum.Never
                                vsfFlowList1.HighLight = HighLightEnum.Always

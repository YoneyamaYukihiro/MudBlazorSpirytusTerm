    '備　考：
    Private Sub mnu21_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu21.Click

        Dim lblnAns     As Boolean  '汎用戻り値
        Dim llngIndex   As Integer  'ｲﾝﾃﾞｯｸｽ
        Dim llngCnt     As Integer  'ｶｳﾝﾀ

        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
        '@----------------------------------------
        '@mnu21：ｺﾋﾟｰ、mnu22：貼り付け、mnu23：削除
        '@----------------------------------------

            With vsfFlowList0

                Select Case .Col

                    '大工程
                    Case CPlngvsfFlowOpID
                        
                        '@Disconﾁｪｯｸ
                        lblnAns = prvblnDisconCellCopy_Chk(vsfFlowList0, .Row, CPlngvsfFlowOpID)
                        
                        '@結果判定
                        If lblnAns = False Then
                        '@失敗の場合
                            '@処理抜け
                            Exit Sub
                        End If
                        
                        '@変数にｺﾋﾟｰ
                        mstrOpIdCopy = .GetData(.Row, CPlngvsfFlowOpID)

                    '小工程
                    Case CPlngvsfFlowStepID
                        
                        '@Disconﾁｪｯｸ
                        lblnAns = prvblnDisconCellCopy_Chk(vsfFlowList0, .Row, CPlngvsfFlowStepID)
                        
                        '@結果判定
                        If lblnAns = False Then
                        '@失敗の場合
                            '@処理抜け
                            Exit Sub
                        End If
                        
                        '@変数にｺﾋﾟｰ
                        mstrStepIdCopy = .GetData(.Row, CPlngvsfFlowStepID)

                    '@処理条件ｾｯﾄID
                    Case CPlngvsfFlowConditionID
                        
                        '@Disconﾁｪｯｸ
                        lblnAns = prvblnDisconCellCopy_Chk(vsfFlowList0, .Row, CPlngvsfFlowConditionID)
                        
                        '@結果判定
                        If lblnAns = False Then
                        '@失敗の場合
                            '@処理抜け
                            Exit Sub
                        End If
                        
                        '@変数にｺﾋﾟｰ
                        mstrConditionCopy = .GetData(.Row, CPlngvsfFlowConditionID)            '処理条件ID
                        mstrConditionCopyVer = .GetData(.Row, CPlngvsfFlowConditionVer)        'Ver
                        mstrConditionCopyValid = .GetData(.Row, CPlngvsfFlowConditionValid)    '有効ﾌﾗｸﾞ
                        
                    '@個別処理条件
                    Case CPlngvsfFlowConditionOne
                        
                        '@Disconﾁｪｯｸ
                        lblnAns = prvblnDisconCellCopy_Chk(vsfFlowList0, .Row, CPlngvsfFlowConditionID)
                        
                        '@結果判定
                        If lblnAns = False Then
                        '@失敗の場合
                            '@処理抜け
                            Exit Sub
                        End If
                        
                        '@ｲﾝﾃﾞｯｸｽ初期化
                        llngIndex = -1
                        '@該当ﾃﾞｰﾀ検索
                        For llngCnt = 0 To ptypProcCondDetailList.lngProcCondDetailCnt -1
                            '@絶対工順番号が同じ場合
                            If .GetData(.Row, CPlngvsfFlowAbsNo) = ptypProcCondDetailList.typProcCondDetail(llngCnt).strAbsNo Then
                                '@該当ｲﾝﾃﾞｯｸｽ退避
                                llngIndex = llngCnt
                                Exit For
                            End If
                        Next
                        
                        '@該当ﾃﾞｰﾀが存在する場合
                        If llngIndex <> -1 Then
                            ptypCopyCondDetailList.lngProcCondDetailCnt = 1
                            ptypCopyCondDetailList.typProcCondDetail = New List(Of ProcCondDetail)

                            Dim ltypProcCondDetailTmp As ProcCondDetail = New ProcCondDetail

                            '@ｺﾋﾟｰ内容を構造体に設定
                            ptypCopyCondDetailList.lngProcCondDetailCnt = 1
                            ltypProcCondDetailTmp = ptypProcCondDetailList.typProcCondDetail(llngIndex)
                            With ltypProcCondDetailTmp
                                'NSYS ディープコピー
                                If ptypProcCondDetailList.typProcCondDetail(llngIndex).typProcCond IsNot Nothing Then
                                    .typProcCond = _
                                        New List(Of ProcCond)(ptypProcCondDetailList.typProcCondDetail(llngIndex).typProcCond)
                                End If

                                .strAbsNo = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowAbsNo)
                                .strOpID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowOpID)
                                .strStepID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowStepID)
                                
                            End With
                            ptypCopyCondDetailList.typProcCondDetail.Add(ltypProcCondDetailTmp)

                            '@変数にｺﾋﾟｰ
                            mstrConditionCopy = .GetData(.Row, CPlngvsfFlowConditionID)            '処理条件ID
                            mstrConditionCopyVer = .GetData(.Row, CPlngvsfFlowConditionVer)        'Ver
                            mstrConditionCopyValid = .GetData(.Row, CPlngvsfFlowConditionValid)    '有効ﾌﾗｸﾞ
                            mstrConditionOne = .GetData(.Row, CPlngvsfFlowConditionOne)            '個別表示(全数/部分）
                            mstrLotRecipeFlag = .GetData(.Row, CPlngvsfFlowLotRecipeFlag)          'ﾛｯﾄ個別ﾚｼﾋﾟ設定ﾌﾗｸﾞ
                            mstrWFRecipeFlag = .GetData(.Row, CPlngvsfFlowWFRecipeFlag)            'WF個別ﾚｼﾋﾟ設定ﾌﾗｸﾞ
                            mstrRecipeChgFlg = .GetData(.Row, CPlngvsfFlowRecipeChgFlg)            '工順ﾚｼﾋﾟ変更ﾌﾗｸﾞｵﾝ
                        End If
                        
                        
                    '@WF選択条件
                    Case CPlngvsfFlowSelectConditionID
                        
                        '@変数にｺﾋﾟｰ
                        mstrSelectConCopy = .GetData(.Row, .Col)                               'WF選択条件
                    
                    '@収集項目
                    Case CPlngvsfFlowCollectionID
                    
                        '@Disconﾁｪｯｸ
                        lblnAns = prvblnDisconCellCopy_Chk(vsfFlowList0, .Row, CPlngvsfFlowCollectionID)
                        
                        '@結果判定
                        If lblnAns = False Then
                        '@失敗の場合
                            '@処理抜け
                            Exit Sub
                        End If
                        
                        '@変数にｺﾋﾟｰ
                        mstrCollectionCopy = .GetData(.Row, .Col)                              '収集項目ｾｯﾄID
                        mstrCollectionCopyVer = .GetData(.Row, CPlngvsfFlowCollectionVer)      'Ver
                        mstrCollectionCopyValid = .GetData(.Row, CPlngvsfFlowCollectionValid)  '有効ﾌﾗｸﾞ
                    
                    '@不良項目
                    Case CPlngvsfFlowLotScrapSetId
                        
                        '@変数にｺﾋﾟｰ
                        mstrScrapSetIDCopy = .GetData(.Row, .Col)                              '不良項目
                        
                End Select
                
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu21_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


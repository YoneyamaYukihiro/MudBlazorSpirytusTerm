    '機　能：ﾌｫﾄF/B(合せ)でﾊﾟｯﾁ分割ありの場合、APC計算除外ﾁｪｯｸON/OFFをｸﾞﾙｰﾌﾟ全てに適用する
    '引　数：strOrder：APC設定
    '　　　：lngChecked：1:ON、2:OFF
    '戻り値：
    '作成日：2017/02/20 (Mon) 12:51:15 T.Oide
    '更新日：2017/02/20 (Mon) 12:51:15
    '備　考：
    Private Sub prvPatchApcCalcSkip_check(ByVal strOrder As String, ByVal lngCheck As Integer)

        Dim llngRowCnt      As Integer

        Try
            
            With vsfFlowList0
            
                '@ｸﾞﾘｯﾄﾞ行で回す
                For llngRowCnt = 1 To .Rows.Count - 1
                    
                    '@同じｸﾞﾙｰﾌﾟ設定の測定行程か(現在行以外)
                    If Mid$(.GetData(llngRowCnt, CPlngvsfFlowApc), 1, 8) = Mid$(strOrder, 1, 8) And _
                       .Row <> llngRowCnt Then
                        '@ﾁｪｯｸ状態を変更する
                        .SetCellCheck(llngRowCnt, CPlngvsfFlowApcCalcSkipFlag, lngCheck)
                        
                        '@ﾊﾞｯｸｶﾗｰを変更
                        Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = .GetCellRange(llngRowCnt, CPlngvsfFlowApcCalcSkipFlag)
                        cellRange.Style = newStyle
                        .SetData(llngRowCnt, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                    End If
                Next
            
            End With
            
            Exit Sub
            
        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvPatchApcCalcSkip_check"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Sub

    '関数名：prvReciSelApc_Disp
    '機　能：「ﾚｼﾋﾟ選択APC」情報表示
    '引　数：
    '　　　：lngIndex       ：0:編集中ﾌﾛｰ、1:ｺﾋﾟｰﾌﾛｰ
    '　　　：lngCnt         ：対象行
    '　　　：typLotProcFlow ：工程情報
    '戻り値：なし
    '作成日：2018/03/12 (Mon) 15:05:55 T.Oide
    '更新日：2018/03/12 (Mon) 15:26:38 T.Oide
    '備　考：
    Private Sub prvReciSelApc_Disp(ByVal lvsfFlowList As C1FlexGrid, ByVal lngCnt As Integer, ByRef typLotProcFlow As FlowList)

        Dim llngApcCnt      As Integer
        Dim lstrStart       As String
        Dim lstrStatus      As String

        Try

            With typLotProcFlow

                '@ﾚｼﾋﾟ選択APCﾘｽﾄ数あるか判定
                If .lngRecpSelApcCnt > 0 Then

                    '@ﾚｼﾋﾟ選択APCﾘｽﾄ取得
                    For llngApcCnt = 0 To .lngRecpSelApcCnt -1
            
                        With .typRecpSelApc(llngApcCnt)

                            '@APCﾀｲﾌﾟ判定
                            Select Case .strApcType
                            
                                '@FB
                                Case CMstrApcTypeFB
                                    lstrStart = CMstrFBMark & CMstrHyphen
            
                                '@FF
                                Case CMstrApcTypeFF
                                    lstrStart = CMstrFFMark & CMstrHyphen
            
                                '@例外
                                Case Else
                                    lstrStart = vbNullString
                                    
                            End Select
            
            
                            '@先頭1文字を格納
                            lstrStatus = Mid$(.strStatusFlag, 1, 1)
            
                           '@ｽﾃｰﾀｽを判定して表示切替
                            Select Case lstrStatus
            
                                '@P：処理工程
                                Case CPstrProcessMark
            
                                    '@FB-ﾘｽﾄｵｰﾀﾞ№(000)-P/FF-ﾘｽﾄｵｰﾀﾞ№(000)-P
                                    lvsfFlowList.SetData(lngCnt, CPlngvsfFlowRecpSelApc, _
                                        lvsfFlowList.GetData(lngCnt, CPlngvsfFlowRecpSelApc) & _
                                            lstrStart & _
                                            Format$(CInt(.strListOrder), CMstrNoFormat) & _
                                            CMstrHyphen & .strStatusFlag)  'FB-[連番（三桁）]-P
            
                                    'APC枚葉設定か
                                    If .blnApcWfUnitFlg <> True Then
                                    
                                        '@枚葉ではない場合
                                        lvsfFlowList.SetData(lngCnt, CPlngvsfFlowRecpSelApc, _
                                            lvsfFlowList.GetData(lngCnt, CPlngvsfFlowRecpSelApc) & _
                                            CMstrComma)
                                    Else
                                    
                                        '@枚葉の場合、末尾に「(枚)」を表示
                                        lvsfFlowList.SetData(lngCnt, CPlngvsfFlowRecpSelApc, _
                                           lvsfFlowList.GetData(lngCnt, CPlngvsfFlowRecpSelApc) & _
                                            CPstrWfApc & CMstrComma)
                                    
                                    End If
            
                                '@M：測定行程
                                Case CPstrMeasureMark
            
                                    '@FB-ﾘｽﾄｵｰﾀﾞ№(000)-M/FF-ﾘｽﾄｵｰﾀﾞ№(000)-M
                                     lvsfFlowList.SetData(lngCnt, CPlngvsfFlowRecpSelApc, _
                                        lvsfFlowList.GetData(lngCnt, CPlngvsfFlowRecpSelApc) & _
                                            lstrStart & _
                                            Format$(CInt(.strListOrder), CMstrNoFormat) & _
                                            CMstrHyphen & .strStatusFlag & CMstrComma)  'FB-[連番（三桁）]-M
            
                            End Select
            
                        End With
                        
                    Next
            
                    '@最後にｶﾝﾏがついていたら
                    If Strings.Right$(lvsfFlowList.GetData(lngCnt, CPlngvsfFlowRecpSelApc), 1) = CMstrComma Then
                    
                        '@ｶﾝﾏを削除
                        lvsfFlowList.SetData(lngCnt, CPlngvsfFlowRecpSelApc, _
                            Strings.Left$(lvsfFlowList.GetData(lngCnt, CPlngvsfFlowRecpSelApc), Len(lvsfFlowList.GetData(lngCnt, CPlngvsfFlowRecpSelApc)) - 1))
                    End If

                End If
                
            End With

            Exit Sub
            
        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvReciSelApc_Disp"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Sub

    '関数名：prvRecpSelApcData_Set

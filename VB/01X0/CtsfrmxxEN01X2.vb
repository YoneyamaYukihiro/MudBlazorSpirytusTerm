    '更新日：2007/05/25 (Fri) 10:19:42
    '備　考：
    Private Sub prvWpRestrictDisp_Del(ByVal llngRow As Integer)

        Dim llngCnt         As Integer  'ｶｳﾝﾀ
        Dim lblnClearFlag   As Boolean  'ﾌﾗｸﾞ
        
        
        Try

            With vsfFlowList0
                '@削除対象が記憶の場合
                If Strings.Right$(.GetData(llngRow, CPlngvsfFlowWpRestrict), 1) = CMstrWpMarkMark Then
                    '@限定設定済みの設定もまとめてｸﾘｱ
                    

    '関数名：prvPersonalCondition_Disp
    '機　能：個別処理条件ﾃﾞｰﾀ表示
    '引　数：なし
    '戻り値：なし
    '作成日：2006/06/23 (Fri) 09:04:56 N.Kasai
    '更新日：2006/06/23 (Fri) 09:04:56
    '備　考：
    Private Sub prvPersonalCondition_Disp(ByVal lvsfFlowList As C1FlexGrid)
        
        Dim llngCnt                     As Integer              'ｶｳﾝﾀ
        Dim llngWpCnt                   As Integer              '装置ｶｳﾝﾀ
        Dim llngIndex                   As Integer              'ｲﾝﾃﾞｯｸｽ
        Dim lstrWPName                  As String               '初回読込み装置名退避
        Dim llngListCnt                 As Integer              'ｶｳﾝﾀ
        Dim lblnWpFlag                  As Boolean              'WP初回読込みﾌﾗｸﾞ
        Dim lstrWpCommonRecipeFlag      As String               '装置共通ﾚｼﾋﾟﾌﾗｸﾞ( 0: 個別、1: 共通）
        Dim ltypCondDetailList          As ProcCondDetailList   'ﾃﾞｰﾀ格納
        
        Try
                
            '@ｸﾞﾘｯﾄﾞのｲﾝﾃﾞｯｸｽを判定して格納構造体を変更
            If lvsfFlowList Is vsfFlowList0 Then
                ltypCondDetailList = ptypProcCondDetailList
            Else
                ltypCondDetailList = ptypCondDetailListCp
            End If
            
            '@初期化
            llngIndex = -1
            
            With ltypCondDetailList
            
                '@個別処理設定配列を検索
                For llngCnt = 0 To .lngProcCondDetailCnt -1
                    With .typProcCondDetail(llngCnt)
                    
                        '@工順番号が一致するｲﾝﾃﾞｯｸｽを取得する。
                        If .strAbsNo = lvsfFlowList.GetData(lvsfFlowList.Row, CPlngvsfFlowAbsNo) Then
                            '@有効ﾃﾞｰﾀであること
                            If .blnEnableFlag = True Then
                                '@ｲﾝﾃﾞｯｸｽを保持
                                llngIndex = llngCnt
                                
                                Exit For
                            End If
                            
                        End If
                    End With
                Next
                
                '@ｲﾝﾃﾞｯｸｽが見つからない場合
                If llngIndex = -1 Then
                    '@ﾃﾞｰﾀ例外
                    Exit Sub
                End If
                
                '@ｲﾝﾃﾞｯｸｽが存在した場合(個別ﾚｼﾋﾟ設定あり）
               
                '@WP初回ﾌﾗｸﾞ初期化
                lblnWpFlag = False
                    
                '@WPｸﾞﾘｯﾄﾞ（ﾃﾞﾌｫﾙﾄ設定）の初期化
                '@装置件数分ﾙｰﾌﾟ
                With vsfConditionWP
                    For llngCnt = 1 To .Rows.Count - 1
                        '@ﾁｪｯｸﾎﾞｯｸｽにﾁｪｯｸｵﾌ
                        .SetData(llngCnt, CMlngvsfConDetailWpCK, CMstrFlgOff)
                    Next
                    '@WPｸﾞﾘｯﾄﾞ
                    .Enabled = True
                End With
                
                '@装置個別ﾚｼﾋﾟｸﾞﾘｯﾄﾞ
                With vsfConditionList2
                    '@ﾛｯｸ解除
                    .Enabled = True
                    '@初期化
                    .Redraw = False
                    .Rows.Count = 1
                    .Redraw = True
                End With
                
                '@装置共通ﾚｼﾋﾟｸﾞﾘｯﾄﾞ
                With vsfConditionList3
                    '@ﾛｯｸ解除
                    .Enabled = True
                    '@初期化
                    .Redraw = False
                    .Rows.Count = 1
                    .Redraw = True
                End With
                
                With .typProcCondDetail(llngIndex)
                    '@装置共通ﾚｼﾋﾟﾌﾗｸﾞ退避
                    lstrWpCommonRecipeFlag = .strWpCommonRecipeFlag
                    
                    '@装置共通ﾚｼﾋﾟﾌﾗｸﾞ( 0: 個別、1: 共通）
                    If lstrWpCommonRecipeFlag = "0" Then
                        vsfConditionWP.Rows.Count = 1
                    End If
                    
                    '@ﾌﾚｰﾑの表題を「個別処理条件」にする
                    fraCondition2.Text = CPstrParsonalCondition
                    
                    '@個別処理設定配列の詳細ﾃﾞｰﾀを検索
                    For llngWpCnt = 0 To .lngCondDetailCnt -1
                    
                        With .typProcCond(llngWpCnt)
                            '@個別処理条件に表示(装置個別）
                            vsfConditionList2.AddItem( _
                                    llngWpCnt & vbTab & _
                                    .strWpName & vbTab & _
                                    .strWfId & vbTab & _
                                    .strRecipeId)
                            
                            
                            '@装置共通ﾚｼﾋﾟﾌﾗｸﾞ( 0: 個別、1: 共通）
                            If lstrWpCommonRecipeFlag = "0" Then
                                '@個別処理条件に表示（装置共通WP）
                                '@重複装置は表示しない。
                                If lstrWPName <> .strWpName Then
                                    '@ﾃﾞﾌｫﾙﾄﾌﾗｸﾞ = 1(ﾃﾞﾌｫﾙﾄﾚｼﾋﾟ)
                                    If .strDefaultFlag = CMstrFlgOn Then
                                        '@個別処理条件に表示
                                        vsfConditionWP.AddItem( _
                                            llngListCnt + 1 & vbTab & _
                                            CMstrFlgOff & vbTab & _
                                            .strWpID & vbTab & _
                                            .strWpName)
                                    Else
                                        '@個別処理条件に表示
                                        vsfConditionWP.AddItem( _
                                            llngListCnt + 1 & vbTab & _
                                            CMstrFlgOn & vbTab & _
                                            .strWpID & vbTab & _
                                            .strWpName)
                                        
                                        '@初回判定
                                        If lblnWpFlag = False Then
                                            lstrWPName = .strWpName
                                            lblnWpFlag = True
                                        End If
                                    End If
                                    llngListCnt = llngListCnt + 1
                                End If
                            Else
                                
                                '@個別処理条件に表示（装置共通WP）
                                '@重複装置は表示しない。
                                If lstrWPName <> .strWpName Then
                                    '@ﾃﾞﾌｫﾙﾄﾌﾗｸﾞ = 1(ﾃﾞﾌｫﾙﾄﾚｼﾋﾟ)
                                    If .strDefaultFlag = CMstrFlgOn Then
                                    
                                       '@なし
                                    Else
                                        '@装置件数分ﾙｰﾌﾟ
                                        For llngCnt = 1 To vsfConditionWP.Rows.Count - 1
                                            '@ﾏｽﾀ内容=個別設定済みの装置名が一致
                                            If vsfConditionWP.GetData(llngCnt, CMlngvsfConDetailWpName) = .strWpName Then
                                                '@ﾁｪｯｸﾎﾞｯｸｽにﾁｪｯｸ
                                                vsfConditionWP.SetData(llngCnt, CMlngvsfConDetailWpCK, CMstrFlgOn)
                                                
                                                '@初回ﾌﾗｸﾞ判定
                                                If lblnWpFlag = False Then
                                                    lstrWPName = .strWpName
                                                    lblnWpFlag = True
                                                End If
                                                Exit For
                                            End If
                                        Next
                                    End If
                                    llngListCnt = llngListCnt + 1
                                End If
                            End If
                            
                            '@個別処理条件に表示（装置共通RECIPE）
                            '@複数装置ﾚｼﾋﾟ共通の為、重複ﾚｼﾋﾟは表示しない。
                            If lstrWPName = .strWpName Then
                            
                                '@個別処理条件に表示
                                vsfConditionList3.AddItem( _
                                        llngWpCnt & vbTab & _
                                        .strWpName & vbTab & _
                                        .strWfId & vbTab & _
                                        .strRecipeId)
                            End If
                            
                         End With
                    Next
                    
                    
                    '@列幅自動調整
                    vsfConditionList2.AutoSizeCols(CPlngvsfConDetailListNo, CPlngvsfConDetailListRecID, 6)
                    
                    If .lngCondDetailCnt > 0 Then
                        '@WF列の表示/非表示
                        If .typProcCond(0).strWfId = vbNullString Then
                            vsfConditionList2.Cols(CPlngvsfConDetailListWF).Visible = False
                        Else
                            vsfConditionList2.Cols(CPlngvsfConDetailListWF).Visible = True
                        End If
                        
                        '@列幅自動調整
                        vsfConditionList3.AutoSizeCols(CPlngvsfConDetailListNo, CPlngvsfConDetailListRecID, 6)
                        '@WF列の表示/非表示
                        If .typProcCond(0).strWfId = vbNullString Then
                            vsfConditionList3.Cols(CPlngvsfConDetailListWF).Visible = False
                        Else
                            vsfConditionList3.Cols(CPlngvsfConDetailListWF).Visible = True
                        End If
                    End If
                    
                    '@列幅自動調整
                    vsfConditionWP.AutoSizeCols(CPlngvsfConDetailListNo, CMlngvsfConDetailWpName, 6)
                    
                    '@Noの再ｾｯﾄ
                    Call prvNo_Set(vsfConditionList2)
                    
                
                    '@個別処理条件表示ﾌﾚｰﾑ切替
                    '@装置共通ﾚｼﾋﾟﾌﾗｸﾞ( 0: 個別、1: 共通）
                    Select Case .strWpCommonRecipeFlag
                        
                        '@0: 個別
                        Case "0"
                            fraRecipeAll.Visible = False    '装置共通
                            fraRecipe.Visible = True        '装置個別
                        
                        '@1: 共通
                        Case "1"
                            fraRecipeAll.Visible = True     '装置共通
                            fraRecipe.Visible = False       '装置個別
                            
                        '@例外（初期値：個別）
                        Case Else
                            fraRecipeAll.Visible = False    '装置共通
                            fraRecipe.Visible = True        '装置個別
                            
                    End Select
                    
                End With
            End With
            
            '@ﾌﾛｰﾘｽﾄ・個別処理条件の表示
            With lvsfFlowList
                .ShowCell(.Row, .Col)
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvPersonalCondition_Disp"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvCondition_Disp
    '機　能：処理条件再表示処理
    '引　数：llngRow：対象行番号
    '戻り値：なし
    '作成日：2006/06/23 (Fri) 15:03:57 N.Kasai
    '更新日：2006/06/23 (Fri) 15:03:57
    '備　考：
    Private Sub prvCondition_Disp(ByVal llngRow As Integer)
        
        '@個別処理条件を削除された場合、表示内容もﾃﾞﾌｫﾙﾄ表示へ変更する。
        
        
        Dim lstrConditionID     As String   '処理条件ｾｯﾄID
        Dim lstrConditionIDVer  As String   '処理条件Ver
        
        Try
            'NSYS データ行がない場合処理を抜ける
            If vsfConditionList1.Row < vsfConditionList1.Rows.Fixed Then
                Exit Sub
            End If 

            If stbSetPanel.Visible = False Then
                Exit Sub
            End If
            
            '@現在表示している処理条件ｾｯﾄIDを取得
            With vsfConditionList1
                lstrConditionID = .GetData(.Row, CPlngvsfConListConID)  '処理条件ｾｯﾄID
                lstrConditionIDVer = .GetData(.Row, CPlngvsfConListVer) '処理条件ｾｯﾄIDVer
            End With
            
            '@削除対象の個別処理条件と現在表示されているｾｯﾄIDが一致した場合
            If lstrConditionID = vsfFlowList0.GetData(llngRow, CPlngvsfFlowConditionID) And _
                lstrConditionIDVer = vsfFlowList0.GetData(llngRow, CPlngvsfFlowConditionVer) Then
            
                '@ﾌﾚｰﾑの表題を「処理条件セットID　詳細」にする
                fraCondition2.Text = CMstrConditionDetail
            
                '@初期化
                '@処理条件ｾｯﾄID詳細(装置個別）
                With vsfConditionList2
                    .Redraw = False
                    .Rows.Count = .Rows.Fixed                           '行
                    .Redraw = True
                    .Cols(CPlngvsfConDetailListWF).Visible = False      '非表示（WF列）
                End With
                
                '@処理条件ｾｯﾄID詳細(装置個別）
                With vsfConditionList3
                    .Redraw = False
                    .Rows.Count = .Rows.Fixed                           '行
                    .Redraw = True
                    .Cols(CPlngvsfConDetailListWF).Visible = False      '非表示（WF列）
                End With
                
                '@装置一覧
                With vsfConditionWP
                    .Redraw = False
                    .Rows.Count = .Rows.Fixed                          '行
                    .Redraw = True
                End With
                
                '@個別処理条件からﾃﾞﾌｫﾙﾄへ内容再表示
                With vsfConditionList1
                    .Select(.Row, CPlngvsfConListConID)
                End With
                
            End If

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvCondition_Disp"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Sub

    '関数名：prvblnOpStepIDDouble_Chk
    '機　能：大工程・小工程の重複ﾁｪｯｸ
    '引　数：llngChkRow：ﾁｪｯｸ行
    '戻り値：True:重複していない  False：重複している
    '作成日：2006/05/31 (Wed) 18:14:08 N.Kasai
    '更新日：2006/05/31 (Wed) 18:14:08
    '備　考：
    Private Function prvblnOpStepIDDouble_Chk() As Boolean

        Dim lblnMatch  As Boolean '大工程・小工程一致ﾌﾗｸﾞ
        Dim llngRow    As Integer '行番号
        Dim llngChkRow As Integer 'ｶｳﾝﾀ

        Try
            
            '@初期化
            prvblnOpStepIDDouble_Chk = False
            
            With vsfFlowList0
            
                '@現在行を取得
                llngChkRow = .Row
                
                '@大工程・小工程の重複ﾁｪｯｸ
                lblnMatch = False
                
                '@大工程・小工程のどちらかが空白の場合、処理中止
                If .GetData(llngChkRow, CPlngvsfFlowOpID) = vbNullString Or _
                   .GetData(llngChkRow, CPlngvsfFlowStepID) = vbNullString Then
                   '@重複していない
                   prvblnOpStepIDDouble_Chk = True
                   Exit Function
                End If
                
                '@ﾌﾟﾛｾｽｸﾞﾘｯﾄ分、以下の処理を繰り返す
                For llngRow = 1 To .Rows.Count - 1
                    If llngRow <> llngChkRow Then
                        '@大工程・小工程の組み合わせがﾌﾟﾛｾｽｸﾞﾘｯﾄ内の大工程・小工程と一致するかﾁｪｯｸ
                        If .GetData(llngChkRow, CPlngvsfFlowOpID) = _
                           .GetData(llngRow, CPlngvsfFlowOpID) And _
                           .GetData(llngChkRow, CPlngvsfFlowStepID) = _
                           .GetData(llngRow, CPlngvsfFlowStepID) Then
                           '@一致
                           lblnMatch = True
                           Exit For
                        End If
                    End If
                Next
                
                '@一致した場合
                If lblnMatch = True Then
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001O)
                    '@"<TRM1OW>$$大工程・小工程の組み合わせが重複しています。"
                    Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                    '@ﾌｫｰｶｽの移動
                    .Row = llngChkRow
                    .ShowCell(.Row, .Col)
                    
                    Exit Function
                    
                End If
                
                '@既に大工程/小工程に重複が存在し、重複を修正した場合
                '@ﾊﾞｯｸｶﾗｰを初期値に戻す。
                If .GetCellRange(llngChkRow, CPlngvsfFlowOpID).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorLGreen) Then
                    
                    '@該当行のﾊﾞｯｸｶﾗｰがｸﾞﾘｰﾝの場合対となる工程を検索
                    For llngRow = 1 To .Rows.Count - 1
                        
                        '@大工程
                        If .GetCellRange(llngRow, CPlngvsfFlowOpID).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorLGreen) Then
                            
                            If .GetCellRange(llngRow, CPlngvsfFlowAbsNo).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray) Then
                            
                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowOpID)
                                cellRange.Style = newStyle
                            Else
                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_vbWhite")
                                newStyle.BackColor = Color.White
                                Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowOpID)
                                cellRange.Style = newStyle
                            End If
                        End If
                        
                        '@小工程
                        If .GetCellRange(llngRow, CPlngvsfFlowStepID).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorLGreen) Then
                            If .GetCellRange(llngRow, CPlngvsfFlowAbsNo).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray) Then
                        
                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowStepID)
                                cellRange.Style = newStyle
                            Else
                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_vbWhite")
                                newStyle.BackColor = Color.White
                                Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowStepID)
                                cellRange.Style = newStyle
                            
                            End If
                        End If
                    Next
                    
                End If
            
            End With
            
            '@重複していない
            prvblnOpStepIDDouble_Chk = True
            
            Exit Function

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvblnOpStepIDDouble_Chk"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Function


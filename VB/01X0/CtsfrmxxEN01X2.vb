                    cmdCommentDown.Enabled = False                  'ｺﾒﾝﾄ ▼ﾎﾞﾀﾝ
        '@↓2016/07/22 (Fri) 13:43:56 T.Oide **************************************************
                    cmdSpcSkipChkOn.Enabled = False                 'SPCｽｷｯﾌﾟ全On
                    serchSetting.Enabled = False                    '設定値検索
        '@↑2016/07/22 (Fri) 13:43:56 T.Oide **************************************************
                    
                '@編集中
                Case Else
            
                    '@ﾌﾟﾛｾｽﾌﾛｰﾃﾞｰﾀ
                    If vsfFlowList0.Rows.Count = 1 Then
                        '@使用不可
                        cmdSave1.Enabled = False                   '一時保存
                        cmdSave2.Enabled = False                   '確定
                        cmdAdd.Enabled = True                      '行追加
        '@↓2016/07/22 (Fri) 13:43:56 T.Oide **************************************************

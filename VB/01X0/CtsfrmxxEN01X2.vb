    '関数名：mnu4_Click
    '機　能：'ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ「入替可能工程設定」
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/29 (Mon) 14:05:42 N.Kasai
    '更新日：2006/05/29 (Mon) 14:05:42
    '備　考：
    Private Sub mnu4_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu4.Opening

        Dim llngRowStart As Integer 'ｽﾀｰﾄ行
        Dim llngRowEnd   As Integer 'ｴﾝﾄﾞ行
        Dim llngColStart As Integer 'ｽﾀｰﾄ列
        Dim llngColEnd   As Integer 'ｴﾝﾄﾞ列
        Dim llngCount    As Integer 'ｶｳﾝﾀ
        Dim lblnEdit     As Boolean '編集済みﾌﾗｸﾞ
        Dim lblnAltSet   As Boolean '代替設定済みﾌﾗｸﾞ
        
        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            With vsfFlowList0
                '@ﾌﾗｸﾞｸﾘｱ
                lblnEdit = False
                lblnAltSet = False
                
                '@選択範囲の取得
                llngRowStart = .Selection.TopRow
                llngColStart = .Selection.LeftCol
                llngRowEnd = .Selection.BottomRow
                llngColEnd = .Selection.RightCol

                '@ﾌﾟﾛｾｽｸﾞﾘｯﾄの行数文、以下の処理を繰り返す
                For llngCount = llngRowStart To llngRowEnd
                    '@入替工程に何か入力されている場合
                    If .GetData(llngCount, CPlngvsfFlowSwapIndictor) <> vbNullString Then
                        lblnEdit = True   '編集済み
                    End If
                    
                    '@代替工程に何か入力されている場合
                    If .GetData(llngCount, CPlngvsfFlowAltSet) <> vbNullString Then
                        lblnAltSet = True '代替設定済みﾌﾗｸﾞ
                    End If
                    
                Next
                
                '@編集済みの場合
                If lblnEdit = True Then
                    mnu41.Enabled = False  '設定使用不可
                    mnu42.Enabled = True   '削除使用可
                Else
                    '@代替設定済みの場合
                    If lblnAltSet = True Then
                        mnu41.Enabled = False  '設定使用不可
                        mnu42.Enabled = False  '削除使用不可
                    Else
                        mnu41.Enabled = True   '設定使用可
                        mnu42.Enabled = False  '削除使用不可
                    End If
                End If
            End With
            
            Exit Sub
            
        Catch ex As Exception
           
            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu4_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
           
           
        End Try
    End Sub

    '関数名：mnu41_Click
    '機　能：'ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ「設定」
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/29 (Mon) 13:50:51 N.Kasai
    '更新日：2006/05/29 (Mon) 13:50:51
    '備　考：
    Private Sub mnu41_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu41.Click
        
        Dim llngCnt             As Integer 'ｶｳﾝﾀ
        Dim llngSwapIndictor    As Integer '入替え№
        
        Dim llngRowStart As Integer
        Dim llngColStart As Integer
        Dim llngRowEnd As Integer
        Dim llngColEnd As Integer

        Dim ltypCellRange       As CellRange    'NSYS セルレンジ
        
        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            With vsfFlowList0
            
                '@選択ｾﾙに文字列をｾｯﾄ
                ltypCellRange = .GetCellRange(.Row, .Col, .RowSel, .ColSel)
                ltypCellRange.Data = CMstrSwapIndictorMark & CMstrHyphen & Format$(mlngSwapCnt, CMstrNoFormat)

                '@ﾊﾞｯｸｶﾗｰ変更処理
                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                Dim cellRange As CellRange = .GetCellRange(.Row, .Col, .RowSel, .ColSel)
                cellRange.Style = newStyle
                
                '@選択範囲の取得
                llngRowStart = .Selection.TopRow
                llngColStart = .Selection.LeftCol
                llngRowEnd = .Selection.BottomRow
                llngColEnd = .Selection.RightCol

                For llngCnt = llngRowStart To llngRowEnd
                    .SetData(llngCnt, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                Next

                '@ｶｳﾝﾄｱｯﾌﾟ
                mlngSwapCnt = mlngSwapCnt + 1
                
                '@------------------
                '@入替え№採番処理
                '@------------------
                '@№初期化
                llngSwapIndictor = 1
                
                '@選択範囲
                For llngCnt = llngRowEnd To llngRowStart Step -1
                    .SetData(llngCnt, CPlngvsfFlowSwapIndictorCopy, llngSwapIndictor)
                    '@入替え№ｶｳﾝﾄ
                    llngSwapIndictor = llngSwapIndictor + 1
                Next llngCnt

            End With
            
            '@変更ﾌﾗｸﾞｵﾝ
            pblnEN01X2Edit = True
            
            Exit Sub
            
        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu41_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Sub


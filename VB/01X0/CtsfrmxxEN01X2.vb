    '関数名：mnu72_Click
    '機　能：ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【号機限定】
    '引　数：なし
    '戻り値：なし
    '作成日：2007/05/30 (Wed) 15:29:51 N.Kasai
    '更新日：2007/05/30 (Wed) 15:29:51
    '備　考：
    Private Sub mnu72_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu72.Click
        
        Dim llngRow             As Integer  '行番号
        Dim llngDataCnt         As Integer  'ﾃﾞｰﾀｶｳﾝﾄ
        Dim llngOrderNo         As Integer  '号機限定番号
        
        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            With vsfFlowList0
                '@処理条件が未入力の場合
                If .GetData(mlngWkRow, CPlngvsfFlowConditionID) = vbNullString Then
                    
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001N)
                    '@"<TRM1NW>$$処理条件セットIDを入力してください。"
                    Call publngMsgBox(pstrDMsg & vbCrLf, vbExclamation, _
                                      Me.Text, True, 16, False)
                    Exit Sub
                End If
                
                llngDataCnt = 0
                '@配列の初期化
                ptypWpRestrictInfo.lngWpRestrictCnt = 0
                If ptypWpRestrictInfo.typWpRestrict Is Nothing Then
                    ptypWpRestrictInfo.typWpRestrict = New List(Of WpRestrict)
                Else
                    ptypWpRestrictInfo.typWpRestrict.Clear
                End If
                '@号機限定（記憶）が設定済みの場合
                For llngRow = 1 To .Rows.Count - 1
                    If .GetData(llngRow, mlngWkCol) <> vbNullString Then
                        If Strings.Right$(.GetData(llngRow, mlngWkCol), 1) = CMstrWpMarkMark Then
                        
                            '@ﾃﾞｰﾀｶｳﾝﾄ
                            llngDataCnt = llngDataCnt + 1

                            '@配列の再定義
                            Dim typWpRestrictTmp As New WpRestrict

                            '@画面引渡
                            typWpRestrictTmp.strWpRestrictNum = _
                                Mid$(.GetData(llngRow, mlngWkCol), 3, 3)
                            typWpRestrictTmp.strOpID = _
                                .GetData(llngRow, CPlngvsfFlowOpID)
                            typWpRestrictTmp.strStepID = _
                                .GetData(llngRow, CPlngvsfFlowStepID)
                            
                            If mlngWkRow < llngRow Then
                                typWpRestrictTmp.strValidFlag = "0"
                            Else
                                typWpRestrictTmp.strValidFlag = "1"
                            End If
                            
                            ptypWpRestrictInfo.typWpRestrict.Add(typWpRestrictTmp)

                            '@ﾃﾞｰﾀ件数
                            ptypWpRestrictInfo.lngWpRestrictCnt = llngDataCnt

                        End If
                    End If
                Next
                
                If ptypWpRestrictInfo.lngWpRestrictCnt > 1 Then
                
                    '@号機記憶一覧を起動
                    frmxxEN01X8.Instance.ShowDialog(Me)
                    frmxxEN01X8.Instance = Nothing
                    
                    '@戻り値判定
                    If pstrEN01X8 <> vbNullString Then
                        .SetData(mlngWkRow, mlngWkCol, CMstrWpRestrictMark & _
                            CMstrHyphen & Format$(CInt(pstrEN01X8), CMstrNoFormat) & _
                            CMstrHyphen & CMstrWpUseMark)    '限-[連番（三桁）]-U
                        
                        '@ﾊﾞｯｸｶﾗｰ変更処理
                        Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = .GetCellRange(mlngWkRow, mlngWkCol)
                        cellRange.Style = newStyle
                        .SetData(mlngWkRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                        .SetData(mlngWkRow, CPlngvsfFlowWpRestrictFlag, "1")          '変更あり

                    End If
                Else
                    
                    '@号機限定番号ｾｯﾄ
                    llngOrderNo = ptypWpRestrictInfo.typWpRestrict(0).strWpRestrictNum
                    
                    '@選択ｾﾙに文字列をｾｯﾄ
                    .SetData(mlngWkRow, mlngWkCol, CMstrWpRestrictMark & _
                        CMstrHyphen & Format$(llngOrderNo, CMstrNoFormat) & _
                        CMstrHyphen & CMstrWpUseMark)   '限-[連番（三桁）]-U
                    
                    '@ﾊﾞｯｸｶﾗｰ変更処理
                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                    Dim cellRange As CellRange = .GetCellRange(mlngWkRow, mlngWkCol)
                    cellRange.Style = newStyle
                    .SetData(mlngWkRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                    .SetData(mlngWkRow, CPlngvsfFlowWpRestrictFlag, "1")          '変更あり

                End If
                
                '@自動列幅調整
                .AutoSizeCol(mlngWkCol, 6)
                            
            End With
            
            '@編集済み
            pblnEN01X2Edit = True
            
            Exit Sub
            
        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu72_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


    Private Sub mnu32_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu32.Click

        Dim lstrMarkString      As String   '検索用文字列1
        Dim lstrSearchString    As String   '検索用文字列2
        Dim lstrAry()           As String   'ｾﾙ内時間制限配列
        Dim llngCnt             As Integer  'ｶｳﾝﾀ
        Dim llngAryCount        As Integer  '配列ｶｳﾝﾀ

        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            '@mlngTimeLimitFlg
            '@時間制限設定中ﾌﾗｸﾞ（0:開始を設定　1:終了を設定）
            
            With vsfFlowList0
            
                '@大工程が未入力の場合
                If .GetData(mlngWkRow, CPlngvsfFlowOpID) = vbNullString Then
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001L)
                    '@「大工程を入力して下さい」ﾒｯｾｰｼﾞを表示
                    Call publngMsgBox(pstrDMsg, vbExclamation, Me.Text, True, 16, False)
                    Exit Sub
                End If

                '@小工程が未入力の場合
                If .GetData(mlngWkRow, CPlngvsfFlowStepID) = vbNullString Then
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001M)
                    '@「小工程を入力して下さい」ﾒｯｾｰｼﾞを表示
                    Call publngMsgBox(pstrDMsg, vbExclamation, Me.Text, True, 16, False)
                    Exit Sub
                End If
                
                
                '@整形文字列
                lstrMarkString = CMstrTimeLimitMark & _
                                 CMstrHyphen & _
                                 Format$(plngTimeLimitCnt, CMstrNoFormat)   '制-[連番（三桁）]-E
                
                '@空白の場合
                If .GetData(mlngWkRow, mlngWkCol) = vbNullString Then
                    '@選択ｾﾙに文字列をｾｯﾄ
                    .SetData(mlngWkRow, mlngWkCol, lstrMarkString & _
                                                                CMstrHyphen & CMstrEndMark)
                Else
                    '@選択ｾﾙに文字列をｾｯﾄ(制-999-S,制-999-E…)
                    .SetData(mlngWkRow, mlngWkCol, .GetData(mlngWkRow, mlngWkCol) & CMstrComma & _
                                                                lstrMarkString & _
                                                                CMstrHyphen & CMstrEndMark)
                End If
                 
                '@初期化
                If ptypLTSelectList.typLTSelectList Is Nothing Then
                    ptypLTSelectList.typLTSelectList = New List(Of TimeLimitSelectList)
                Else
                    ptypLTSelectList.typLTSelectList.Clear
                End If
                
                '@配列数分、以下の処理を繰り返す
                With ptypLTSelectList

                    '@配列作成
                    .lngLTSelectListCnt = 1
                    Dim typLTSelectListTmp As New TimeLimitSelectList

                    '@情報を退避
                    typLTSelectListTmp.strListOrder = _
                        Format$(plngTimeLimitCnt, CMstrNoFormat)                            'ｵｰﾀﾞ番号
                    typLTSelectListTmp.strEnableFlag = "1"               '有効/無効ﾌﾗｸﾞ
                    typLTSelectListTmp.strRestrictTypeID = "1"           '制約ﾀｲﾌﾟ(初期値）
                    typLTSelectListTmp.strToOpId = vsfFlowList0.GetData(mlngWkRow, CPlngvsfFlowOpID)                     '先大工程
                    typLTSelectListTmp.strToStepId = vsfFlowList0.GetData(mlngWkRow, CPlngvsfFlowStepID)                 '先小工程
                    .typLTSelectList.Add(typLTSelectListTmp)

                End With
                 
                '@列幅自動調整
                .AutoSizeCol(mlngWkCol, 6)
                
                '@検索文字列の整形(開始工程を検索)
                lstrSearchString = lstrMarkString & CMstrHyphen & CMstrStartMark

                '@設定中ﾌﾗｸﾞの更新
                mlngTimeLimitFlg = 0        'ﾌﾗｸﾞON（開始）
                '@時間制限ｶｳﾝﾀｶｳﾝﾄｱｯﾌﾟ
                plngTimeLimitCnt = plngTimeLimitCnt + 1
                
                pblnEN01X5LockOn = True
                pblnEN00X5SelectOn = True
                pblnEN01X5NewData = True
                
                '@ﾌﾟﾛｾｽｸﾞﾘｯﾄの行数分、以下の処理を繰り返す
                For llngCnt = 1 To .Rows.Count - 1
                    '@空白ｾﾙ以外の場合
                    If .GetData(llngCnt, mlngWkCol) <> vbNullString Then
                        '@現在のｾﾙの値を配列に格納
                        lstrAry = Split(.GetData(llngCnt, mlngWkCol), CMstrComma)

                        '@配列数分、以下の処理を繰り返す
                        For llngAryCount = 0 To UBound(lstrAry)
                            '@開始が見つかった場合
                            If lstrSearchString = lstrAry(llngAryCount) Then
                                Dim ltypTimeLimitSelectListTmp As TimeLimitSelectList = New TimeLimitSelectList

                                '@配列数分、以下の処理を繰り返す
                                ltypTimeLimitSelectListTmp = _
                                    ptypLTSelectList.typLTSelectList(ptypLTSelectList.lngLTSelectListCnt - 1)
                                With ltypTimeLimitSelectListTmp
                                    .strFromOpId = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowOpID)     '元大工程
                                    .strFromStepId = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowStepID) '元小工程
                                End With
                                ptypLTSelectList.typLTSelectList(ptypLTSelectList.lngLTSelectListCnt - 1) = _
                                    ltypTimeLimitSelectListTmp

                                Exit For
                            End If
                        Next
                    End If
                Next llngCnt

                pblnEN00X5SelectOn = True
                 
                '@時間制限画面を開く
                frmxxEN01X5.Instance.ShowDialog(Me)
                frmxxEN01X5.Instance = Nothing
            
            End With
            
            '@変更ﾌﾗｸﾞｵﾝ
            pblnEN01X2Edit = True
            
            '@配列のｸﾘｱ
            Erase lstrAry

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu32_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


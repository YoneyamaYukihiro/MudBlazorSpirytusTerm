    '関数名：prvcmbCategory_Disp
    '機　能：ｶﾃｺﾞﾘ情報表示
    '引　数：ltypOpCategory() ：ｶﾃｺﾞﾘ
    '　　　：llngOpCategoryCnt：ｶﾃｺﾞﾘ件数
    '戻り値：なし
    '作成日：2006/05/16 (Tue) 15:21:36 N.Kasai
    '更新日：2006/05/16 (Tue) 15:21:53
    '備　考：
    Private Sub prvcmbCategory_Disp(ByRef ltypMasCategoryIdList As MasCategoryIdList, _
                                    ByVal lctlCmbNm As SEComboBoxEx.ComboBoxEx)

        Dim llngCnt     As Integer  'ｶｳﾝﾄ

        Try
            
            With lctlCmbNm
                .Clear                                                                          '初期化
                .ColAlignment(0) = TextAlignEnum.LeftCenter                                           '左寄せ中央揃え
                .AddItem(CMstrAllCategory)                                                       '(すべて)
                
                '@ｶﾃｺﾞﾘ情報ｾｯﾄ
                For llngCnt = 0 To ltypMasCategoryIdList.lngMasCategoryIDCnt -1
                    .AddItem(ltypMasCategoryIdList.typMasCategoryID(llngCnt).strCategoryID)      'ｶﾃｺﾞﾘ名
                Next llngCnt
                
                '@初期表示：Null
                .ListIndex = -1
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvcmbCategory_Disp"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvvsfSelectCondition_Disp
    '機　能：測定条件ｾｯﾄIDﾘｽﾄの表示
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/16 (Tue) 15:47:04 N.Kasai
    '更新日：2006/05/16 (Tue) 15:47:04
    '備　考：
    Private Sub prvvsfSelectCondition_Disp(ByRef ltypMasMeasureTermsList As MasMeasureTermsList)
        
        Dim llngCnt As Integer  'ｶｳﾝﾀ
        Dim llngRow As Integer  'NSYS 行ｶｳﾝﾀ

        Try

            With vsfSelectCondition
                RemoveHandler vsfSelectCondition.RowColChange,AddressOf vsfSelectCondition_RowColChange
                .Row = -1

                '@描画なし
                .Redraw = False
                
                '@ﾛｯｸ
                .Enabled = True
                
                '@初期化
                .Rows.Count = .Rows.Fixed
                '@有効行数を設定
                .Rows.Count = ltypMasMeasureTermsList.lngMeasureTermsCnt + 1
               
                '@WF選択条件を表示
                For llngCnt = 0 To ltypMasMeasureTermsList.lngMeasureTermsCnt -1
                    llngRow = llngCnt + 1
                    .SetData(llngRow, CMlngvsfSelectConditionNo, llngRow)                 '№
                    .SetData(llngRow, CMlngvsfSelectConditionID, _
                            ltypMasMeasureTermsList.typMeasureTerms(llngCnt).strSelectConditionID)   '測定条件ｾｯﾄID
                    .SetData(llngRow, CMlngvsfSelectConditionRuleID, _
                            ltypMasMeasureTermsList.typMeasureTerms(llngCnt).strSelectRuleID)        '選択ﾙｰﾙ
                    .SetData(llngRow, CMlngvsfSelectConditionSlots, _
                            ltypMasMeasureTermsList.typMeasureTerms(llngCnt).strSlots)               'ｽﾛｯﾄNo
                    .SetData(llngRow, CMlngvsfSelectConditionTopWF, _
                            ltypMasMeasureTermsList.typMeasureTerms(llngCnt).strTopWafers)           'WF数上
                    .SetData(llngRow, CMlngvsfSelectConditionMiddleWF, _
                            ltypMasMeasureTermsList.typMeasureTerms(llngCnt).strMiddleWafers)        'WF数真中
                    .SetData(llngRow, CMlngvsfSelectConditionBottomWF, _
                            ltypMasMeasureTermsList.typMeasureTerms(llngCnt).strBottomWafers)        'WF数下
                    .SetData(llngRow, CMlngvsfSelectConditionUserFlag, _
                            ltypMasMeasureTermsList.typMeasureTerms(llngCnt).strUserSelectFlag)      'ﾕｰｻﾞ選択
                 Next
                
                .Row = 0
                AddHandler vsfSelectCondition.RowColChange,AddressOf vsfSelectCondition_RowColChange

                '@直接描画
                .Redraw = True

            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvvsfSelectCondition_Disp"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvvsfFlowList_Disp
    '機　能：ﾌﾛｰﾘｽﾄ情報表示
    '引　数：ltypFlowListAns()：取得情報
    '      ：ltypeReportPoint:実績報告工程
    '      ：llngIndex:0メイン、1コピー工順
    '戻り値：なし
    '作成日：2006/07/12 (Wed) 10:44:42 N.Kasai
    '更新日：2018/03/12 (Mon) 13:38:41 T.Oide
    '備　考：
    Private Sub prvvsfFlowList_Disp(ByRef ltypFlowListAns As ProcFlowListAns, _
                                    ByRef ltypeReportPoint As ReportPoint, _
                                    ByVal lvsfFlowList As C1FlexGrid)

        Dim llngCnt             As Integer  'ｶｳﾝﾀ
        Dim llngAltCnt          As Integer  '代替工程ｶｳﾝﾀ
        Dim llngTimeLimit       As Integer  '時間制限ｶｳﾝﾀ
        Dim lstrTimeLimit       As String   '時間制限文字列
        Dim lstrMark            As String   '時間制限表示ﾏｰｸ
        Dim lblnAbsNoFlag       As Boolean  '絶対工順番号読込ﾌﾗｸﾞ（True:読込、False:未読込）
        Dim lblnPermitFlag      As Boolean  '編集可否ﾌﾗｸﾞ（True:読込、False:未読込）
        Dim llngSeqCnt          As Integer  '絶対工順番号退避
        Dim lstrStart           As String   '検索文字列
        Dim llngApcCnt          As Integer  'APCｶｳﾝﾀ
        Dim llngSeqNo           As Integer
        Dim llngCateCnt         As Integer  'ｷｬﾘｱｶﾃｺﾞﾘｶｳﾝﾀ
        Dim lblnApcWfUnitFlg    As Boolean  'APC枚葉設定
        Dim lstrStatus          As String
        Dim nKeepRow            As Integer  '行数保持用変数
        Dim strKeepGroup        As String   'グループ番号保持用変数
        Dim i                   As Integer  '汎用カウンタ
        
        Dim llngRow             As Integer  'NSYS 行ｶｳﾝﾀ
        

        Try
            
            '@初期化
            llngCnt = 0
            mlngSwapCnt = 1
            mlngCurrentRow = 1
            nKeepRow = -1
            strKeepGroup = ""
            
            lblnAbsNoFlag = False   '絶対工順番号読込ﾌﾗｸﾞ
            lblnPermitFlag = False '編集可否ﾌﾗｸﾞ（True:読込、False:未読込）
            
            With lvsfFlowList
                .Row = -1

                '@描画ﾛｯｸ
                .Redraw = False
                '@初期化
                If .Rows.Count > .Rows.Fixed Then
                    .Clear(ClearFlags.Content, .Rows.Fixed, 0, .Rows.Count - 1, .Cols.Count - 1)         'ﾌﾟﾛｾｽﾌﾛｰ画面
                End If
                '@ﾌﾟﾛｾｽﾌﾛｰ画面のｻｲｽﾞ指定
                If stbSetPanel.Visible = True Then
                    .Height = mlngvsfPcTabOnHeight     '高さ
                Else
                    .Height = mlngvsfPcTabOffHeight    '高さ
                End If

                '@有効行数を設定
                .Rows.Count = ltypFlowListAns.lngLotProcFlowCnt + 1
                
                '@「変更中工順」か
                If lvsfFlowList Is vsfFlowList0 Then
                    '@ﾍｯﾀﾞ部の表示
                    lblOpID.Text = ltypFlowListAns.strCurrentOpID
                    lblStepID.Text = ltypFlowListAns.strCurrentStepID
                    lblCurrentStatus.Text = ltypFlowListAns.strCurrentStatusName
                End If
                
                llngSeqNo = 1
                
                '@ﾃﾞｰﾀ部の表示
                For llngCnt = 0 To ltypFlowListAns.lngLotProcFlowCnt -1
                    llngRow = llngCnt + 1

                    'APC枚葉設定の初期化
                    lblnApcWfUnitFlg = False
                
                    With ltypFlowListAns.typLotProcFlow(llngCnt)
                    
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowNo, llngRow)              '№
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowState, .strState)         '状態(STATE)
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowPermit, .strPermit)       '編集可否(PERMIT)
                        
                        If .strAbsNo < 1 Then
                            lvsfFlowList.Rows(llngRow).Visible = False
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowNo, .strAbsNo)        '№
                        Else
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowNo, llngSeqNo)        '№
                            llngSeqNo = llngSeqNo + 1
                        End If

                        '@GRB限定工程設定時
                        Dim newStyle            As CellStyle
                        Dim cellRange           As CellRange
                        If .strGrbClass <> vbNullString Then
                            '@背景色を変更
                            newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorPink")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorPink)
                            cellRange = lvsfFlowList.GetCellRange(llngRow, CPlngvsfFlowOpID, llngRow, CPlngvsfFlowStepID)
                            cellRange.Style = newStyle
                        End If
                        
                        '@ﾊﾞｯｸｶﾗｰ変更処理
                        Select Case .strPermit
                            
                            '@完全編集不可
                            Case CMstrPermit2
                                '@背景色を変更
                                newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                cellRange = lvsfFlowList.GetCellRange(llngRow, CPlngvsfFlowNo, llngRow, lvsfFlowList.Cols.Count - 1) 
                                cellRange.Style = newStyle

                            '@部分編集可
                            Case CMstrPermit3
                                '@背景色を変更
                                newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                cellRange = lvsfFlowList.GetCellRange(llngRow, CPlngvsfFlowNo, llngRow, CPlngvsfFlowStepID)
                                cellRange.Style = newStyle
                                newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                cellRange = lvsfFlowList.GetCellRange(llngRow, CPlngvsfFlowSwapIndictor, llngRow, CPlngvsfFlowSwapIndictorCopy)
                                cellRange.Style = newStyle
                            
                            '@大工程、小工程変更不可
                            Case CMstrPermit4
                                '@背景色を変更
                                newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                cellRange = lvsfFlowList.GetCellRange(llngRow, CPlngvsfFlowOpID, llngRow, CPlngvsfFlowStepID)
                                cellRange.Style = newStyle
                        End Select
                        
                        '@変更可能（ｶﾚﾝﾄ行の取得）
                        If .strPermit = CMstrPermit2 Or .strPermit = CMstrPermit3 Then
                            '@変更不可
                        Else
                            '@変更可能（ｶﾚﾝﾄ行の取得）
                            If lblnPermitFlag = False Then
                                mlngCurrentRow = llngRow
                                lblnPermitFlag = True
                            End If
                        End If
                        
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowChange, .strChange)       '変更区分(CHANGE)
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowAbsNo, .strAbsNo)         '工順絶対番号
                        
                        '@初回のみ
                        If lblnAbsNoFlag = False Then
                            '@絶対工順番号退避
                            llngSeqCnt = .strAbsNo
                            '@ﾌﾗｸﾞON
                            lblnAbsNoFlag = True
                        Else
                            '@絶対工順番号の大小比較
                            If llngSeqCnt < .strAbsNo Then
                                '@絶対工順番号最大値を取得
                                llngSeqCnt = .strAbsNo
                            End If
                        End If
                            
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowOpID, .strOpID)                               '大工程
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowOpValid, .strOpValid)                         '大工程有効ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowStepID, .strStepID)                           '小工程
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowStepValid, .strStepValid)                     '小工程有効ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowLotRecipeFlag, .strLotRecipeFlag)             'ﾛｯﾄ個別ﾚｼﾋﾟ設定ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowWFRecipeFlag, .strWfRecipeFlag)               'WF個別ﾚｼﾋﾟ設定ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowConditionID, .strConditionId)                 '処理条件ｾｯﾄID
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowConditionVer, .strConditionVersion)           '処理条件ｾｯﾄIDﾊﾞｰｼﾞｮﾝ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowConditionValid, .strConditionValid)           '処理条件ｾｯﾄID有効ﾌﾗｸﾞ
                        
                        '@********************************************************************************************
                        '@ 「個別処理条件」を表示
                        '@
                        '@ ★工順ﾚｼﾋﾟ変更ﾌﾗｸﾞ判定
                        '@ ① 測定条件が設定されている場合は流動するとWFﾚｼﾋﾟﾌﾗｸﾞが立つ為、表示上「全数」となる。
                        '@ ② 測定条件のみの設定の場合は空白表示とする。(2005/07/15落合氏確認）
                        '@********************************************************************************************
                        If .strProcChangeRecipeFlag = CMstrFlgOn Then
                            If .strLotRecipeFlag = CMstrFlgOn Or .strWfRecipeFlag = CMstrFlgOn Then
                                '@ﾛｯﾄ個別ﾚｼﾋﾟ設定の場合
                                If .strLotRecipeFlag = CMstrFlgOn Then
                                    lvsfFlowList.SetData(llngRow, CPlngvsfFlowConditionOne, CPstrRecpAll)
                                End If
                                
                                '@枚葉個別ﾚｼﾋﾟ設定の場合
                                If .strWfRecipeFlag = CMstrFlgOn Then
                                    '@枚葉ﾚｼﾋﾟ設定 ﾌﾗｸﾞ(0：全数、1:部分）
                                    If .strWfPartialRecipeFlag = CMstrFlgOn Then
                                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowConditionOne, CPstrRecppartial)   '部分
                                    Else
                                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowConditionOne, CPstrRecpAll)       '全数
                                    End If
                                End If
                            Else
                                '@個別設定なし
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowConditionOne, vbNullString)           'なし（空白）
                            End If
                        Else
                            '@個別設定なし
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowConditionOne, vbNullString)               'なし（空白）
                        End If
                        
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowSelectConditionID, .strSelectConditionID)     'WF選択条件ｾｯﾄID
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowCollectionID, .strCollectionID)               '収集項目ｾｯﾄID
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowCollectionVer, .strCollectionVersion)         '収集項目ｾｯﾄIDﾊﾞｰｼﾞｮﾝ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowCollectionValid, .strCollectionValid)         '収集項目ｾｯﾄID有効ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowLotScrapSetId, .strLotScrapSetID)             '不良項目ｾｯﾄID
                        
                        '@-------------------------------------------------
                        '@ﾘﾜｰｸﾙｰﾄID//(空ﾘﾜｰｸ) or ReworkRouteID
                        '@-------------------------------------------------
                        If .strReworkRouteID = CMstrRouteIDEmpty Then
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowReworkRouteID, CMstrEmptyRework)
                        Else
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowReworkRouteID, .strReworkRouteID)
                        End If
                        
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowReworkRouteValid, .strReworkRouteValid)       'ﾘﾜｰｸﾙｰﾄ有効ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowReworkReturnOpID, .strReworkReturnOpID)       'ﾘﾜｰｸﾙｰﾄ戻り先大工程ID
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowReworkReturnStepID, .strReworkReturnStepID)   'ﾘﾜｰｸﾙｰﾄ戻り先小工程ID

                        '@-------------------------------------------------
                        '@特殊ﾙｰﾄID//(追加流動なし) or strSpecialRouteID
                        '@-------------------------------------------------
                        If .strSpecialRouteID = CMstrRouteIDEmpty Then
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowSPRouteID, CMstrAddFlowNo)
                        Else
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowSPRouteID, .strSpecialRouteID)
                        End If
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowSPRouteValid, .strSpecialRouteValid)          '特殊ﾙｰﾄ有効ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowSPReturnOpID, .strSpecialReturnOpID)          '特殊ﾙｰﾄ戻り先大工程ID
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowSPReturnStepID, .strSpecialReturnStepID)      '特殊ﾙｰﾄ戻り先小工程ID
                        
                        '@-------------------------------------------------
                        '@SPCｽｷｯﾌﾟﾁｪｯｸ欄(CMstrSpcSkipOK = 1)
                        '@SPC判定ｽｷｯﾌﾟﾌﾗｸﾞ( 0: SKIP不可、1:SKIP可）
                        '@-------------------------------------------------
                        If .strJudgeSkipFlag = CMstrSpcSkipOK Then
                            lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowJudgeSkipFlag, CheckEnum.Checked)
                        Else
                            lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowJudgeSkipFlag, CheckEnum.Unchecked)
                        End If

                        '@-------------------------------------------------
                        '@APC設定
                        '@  初期ﾊﾞｯｸｶﾗｰをｸﾞﾚｰとし、内容によって使用可能部分を白抜きとする。
                        '@  ﾊﾞｯｸｶﾗｰをｸﾞﾚｰにする。
                        '@-------------------------------------------------
                        
                        '@「変更中工順」か
                        If lvsfFlowList Is vsfFlowList0 Then
                            newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                            cellRange = lvsfFlowList.GetCellRange(llngRow, CPlngvsfFlowApc, _
                                                        llngRow, CPlngvsfFlowApcCalcSkipFlag)
                            cellRange.Style = newStyle
                        End If
                        
                        'APC設定可否情報を設定する
                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcWfUnitFlgSetable, CheckEnum.Unchecked)
                                        
                        '@APCﾘｽﾄの件数判定
                        If .lngApcOrderCnt > 0 Then
                            
                            '@APC設定が存在する場合はﾎﾞﾀﾝの使用可
                            cmdApcSet.Enabled = True
                            
                            '@APCﾘｽﾄ取得
                            For llngApcCnt = 0 To .lngApcOrderCnt -1
                                
                                With .typApcOrder(llngApcCnt)
                                    
                                    '@APCﾀｲﾌﾟ判定
                                    Select Case .strApcType
                                        '@ﾌｫﾄ
                                        Case CMstrApcTypeFB
                                            lstrStart = CMstrFBMark & CMstrHyphen
                
                                        '@ｺﾝﾀｸﾄｴｯﾁｬｰ
                                        Case CMstrApcTypeFF
                                            lstrStart = CMstrFFMark & CMstrHyphen
                                            'APC枚葉設定の設定(複数ある場合はひとつでもFFを持っていれば設定可能とする)
                                            lblnApcWfUnitFlg = True
                                            
                                        '@例外
                                        Case Else
                                            lstrStart = vbNullString
                                    End Select
                                    
                                    
                                    '@先頭1文字を格納
                                    lstrStatus = Mid$(.strStatusFlag, 1, 1)
                                    
                                   '@ｽﾃｰﾀｽを判定して表示切替
                                    Select Case lstrStatus
                                    
                                        Case CPstrProcessMark
                                            
                                            '@FB-ﾘｽﾄｵｰﾀﾞ№(000)-P/FF-ﾘｽﾄｵｰﾀﾞ№(000)-P、またはPn(「ﾌｫﾄF/B(合せ)」のﾊﾟｯﾁ分割ありの場合P1～P9が来る)
                                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowApc, _
                                                lvsfFlowList.GetData(llngRow, CPlngvsfFlowApc) & _
                                                    lstrStart & _
                                                    Format$(CInt(.strListOrder), CMstrNoFormat) & _
                                                    CMstrHyphen & .strStatusFlag & CMstrComma)  'FB-[連番（三桁）]-P（n)
                                                    
                                                    '@編集可の場合
                                                    If ltypFlowListAns.typLotProcFlow(llngCnt).strPermit <> "2" Then
                                                        '@ﾁｪｯｸﾎﾞｯｸｽ使用可
                                                        newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_vbWhite")
                                                        newStyle.BackColor = Color.White
                                                        cellRange = lvsfFlowList.GetCellRange(llngRow, CPlngvsfFlowApcSkipFlag)
                                                        cellRange.Style = newStyle
                                                    End If
                                                    
                                                    '@APC適用外ﾁｪｯｸ欄(CMstrFlgOn = 1)
                                                    '@APC適用外ﾌﾗｸﾞ( 0: 適用、1:適用外）
                                                    If ltypFlowListAns.typLotProcFlow(llngCnt).strApcSkipFlag = CMstrFlgOn Then
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcSkipFlag, CheckEnum.Checked)
                                                    Else
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcSkipFlag, CheckEnum.Unchecked)
                                                    End If
                
                                            'FFで且つ、プロセスの場合にはAPC枚葉設定を有効にする
                                            If lblnApcWfUnitFlg <> False Then
                                                'APC設定可否情報を設定する
                                                lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcWfUnitFlgSetable, CheckEnum.Checked)
                                                'APC枚葉設定制御
                                                Call ControlApcWfUnitFlg(lvsfFlowList, llngRow, True)
                                            End If
                                        
                                        Case CPstrMeasureMark
                                        
                                            '@FB-ﾘｽﾄｵｰﾀﾞ№(000)-M/FF-ﾘｽﾄｵｰﾀﾞ№(000)-M、またはMn(「ﾌｫﾄF/B(合せ)」のﾊﾟｯﾁ分割ありの場合M1～M9が来る)
                                             lvsfFlowList.SetData(llngRow, CPlngvsfFlowApc, _
                                                lvsfFlowList.GetData(llngRow, CPlngvsfFlowApc) & _
                                                    lstrStart & _
                                                    Format$(CInt(.strListOrder), CMstrNoFormat) & _
                                                    CMstrHyphen & .strStatusFlag & CMstrComma)  'FB-[連番（三桁）]-M（n)
                                                    
                                                    '@F/Bの場合のみ
                                                    If .strApcType = CMstrApcTypeFB Then
                                                        
                                                        '@編集可の場合
                                                        If ltypFlowListAns.typLotProcFlow(llngCnt).strPermit <> "2" Then
                                                            '@ﾁｪｯｸﾎﾞｯｸｽ使用可
                                                            newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_vbWhite")
                                                            newStyle.BackColor = Color.White
                                                            cellRange = lvsfFlowList.GetCellRange(llngRow, CPlngvsfFlowApcCalcSkipFlag)
                                                            cellRange.Style = newStyle
                                                        End If
                                                        '@APC計算除外ﾁｪｯｸ欄(CMstrFlgOn = 1)
                                                        '@APC計算除外ﾌﾗｸﾞ( 0: 対象、1:除外）
                                                        If ltypFlowListAns.typLotProcFlow(llngCnt).strApcCalcSkipFlag = CMstrFlgOn Then
                                                            lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcCalcSkipFlag, CheckEnum.Checked)
                                                        Else
                                                            lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcCalcSkipFlag, CheckEnum.Unchecked)
                                                        End If
                                                    End If
                                        Case Else
                                            '@ﾃﾞｰﾀ例外
                                            '@FB-ﾘｽﾄｵｰﾀﾞ№(000)-/FF-ﾘｽﾄｵｰﾀﾞ№(000)-
                                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowApc, _
                                                lvsfFlowList.GetData(llngRow, CPlngvsfFlowApc) & _
                                                    lstrStart & _
                                                    Format$(CInt(.strListOrder), CMstrNoFormat) & CMstrHyphen & CMstrComma)
                
                                                    '@APC適用外ﾁｪｯｸ欄(CMstrFlgOn = 1)
                                                    '@APC適用外ﾌﾗｸﾞ( 0: 適用、1:適用外）
                                                    If ltypFlowListAns.typLotProcFlow(llngCnt).strApcSkipFlag = CMstrFlgOn Then
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcSkipFlag, CheckEnum.Checked)
                                                    Else
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcSkipFlag, CheckEnum.Unchecked)
                                                    End If
                                                    
                                                    '@編集可の場合
                                                    If ltypFlowListAns.typLotProcFlow(llngCnt).strPermit = "1" Then
                                                        '@ﾁｪｯｸﾎﾞｯｸｽ使用可
                                                        newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_vbWhite")
                                                        newStyle.BackColor = Color.White
                                                        cellRange = lvsfFlowList.GetCellRange(llngRow, CPlngvsfFlowApcCalcSkipFlag)
                                                        cellRange.Style = newStyle
                                                    End If
                                                    '@APC計算除外ﾁｪｯｸ欄(CMstrFlgOn = 1)
                                                    '@APC計算除外ﾌﾗｸﾞ( 0: 対象、1:除外）
                                                    If ltypFlowListAns.typLotProcFlow(llngCnt).strApcCalcSkipFlag = CMstrFlgOn Then
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcCalcSkipFlag, CheckEnum.Checked)
                                                    Else
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcCalcSkipFlag, CheckEnum.Unchecked)
                                                    End If
                                    End Select
                                                               
                                    'APC枚葉設定の設定
                                    If .blnApcWfUnitFlg <> False Then
                                        '複数のAPC設定がされている場合は1つでも枚葉設定されている場合はチェックONとする
                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcWfUnitFlg, CheckEnum.Checked)
                                    End If
                                
                                End With
                            Next
                            
                            '@最後にｶﾝﾏがついていたら
                            If Strings.Right$(lvsfFlowList.GetData(llngRow, CPlngvsfFlowApc), 1) = CMstrComma Then
                                '@ｶﾝﾏを削除
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowApc, _
                                    Strings.Left$(lvsfFlowList.GetData(llngRow, CPlngvsfFlowApc), Len(lvsfFlowList.GetData(llngRow, CPlngvsfFlowApc)) - 1))
                            End If
                        Else
                            '@ﾃﾞｰﾀなしの場合
                            lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcSkipFlag, CheckEnum.Unchecked)
                            lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcCalcSkipFlag, CheckEnum.Unchecked)
                        End If
                        
                        '@-------------------------------------------------
                        '@入替工程
                        '@-------------------------------------------------
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowSwapIndictorCopy, .strSwapIndicator)      '入替可能ｲﾝｼﾞｹｰﾀ退避
                        '@取得した値が空白の場合は表示処理を行わない
                        If .strSwapIndicator <> vbNullString Then
                            '@選択ｾﾙに文字列をｾｯﾄ
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowSwapIndictor, _
                                                CMstrSwapIndictorMark & CMstrHyphen & Format$(mlngSwapCnt, CMstrNoFormat))       '入替可能ｲﾝｼﾞｹｰﾀ
                            '@今回と前回の入替可能工程の値をﾁｪｯｸ
                            If .strSwapIndicator = 1 Then
                                '@ｶｳﾝﾄｱｯﾌﾟ
                                mlngSwapCnt = mlngSwapCnt + 1
                            End If
                        End If
                        
                        '@-------------------------------------------------
                        '@代替工程
                        '@-------------------------------------------------
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowAltPointer, .strAltPointer)     '代替ﾎﾟｲﾝﾀ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowAltStartFlag, .strAltStartFlag) '代替開始ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowAltEndFlag, .strAltEndFlag)     '代替終了ﾌﾗｸﾞ
                        '@開始・終了の場合[S/E]
                        If .strAltStartFlag = CMstrFlgOn And .strAltEndFlag = CMstrFlgOn Then
                            '@代替番号が数値の場合のみ
                            If IsNumeric(Strings.Right$(.strAltPointer, 3)) = True Then
                                '@代替番号の取得
                                llngAltCnt = CLng(Strings.Right$(.strAltPointer, 3))
            
                                '@選択ｾﾙに文字列をｾｯﾄ
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowAltSet, _
                                        CMstrAltMark & CMstrHyphen & Format$(llngAltCnt, CMstrNoFormat) & _
                                        CMstrHyphen & CMstrStartEndMark)  '代-[連番（三桁）]-S/E
                            End If
                        Else
                            '@代替工程の編集
                            '@開始の場合[S]
                            If .strAltStartFlag = CMstrFlgOn Then
                                
                                '@代替番号が数値の場合のみ
                                If IsNumeric(Strings.Right$(.strAltPointer, 3)) = True Then
                                    '@代替番号の取得
                                    llngAltCnt = CLng(Strings.Right$(.strAltPointer, 3))
            
                                    '@選択ｾﾙに文字列をｾｯﾄ
                                    lvsfFlowList.SetData(llngRow, CPlngvsfFlowAltSet, _
                                            CMstrAltMark & CMstrHyphen & Format$(llngAltCnt, CMstrNoFormat) & _
                                            CMstrHyphen & CMstrStartMark) '代-[連番（三桁）]-S
                                End If
                            End If
                            '@代替工程の編集
                            '@終了の場合[E]
                            If .strAltEndFlag = CMstrFlgOn Then
                                '@代替番号が数値の場合のみ
                                If IsNumeric(Strings.Right$(.strAltPointer, 3)) = True Then
                                    '@代替番号の取得
                                    llngAltCnt = CLng(Strings.Right$(.strAltPointer, 3))
                                    '@選択ｾﾙに文字列をｾｯﾄ
                                    lvsfFlowList.SetData(llngRow, CPlngvsfFlowAltSet, _
                                            CMstrAltMark & CMstrHyphen & Format$(llngAltCnt, CMstrNoFormat) & _
                                            CMstrHyphen & CMstrEndMark) '代-[連番（三桁）]-E
                                End If

                            End If
                        End If
                        
                        '@-------------------------------------------------
                        '@時間制限
                        '@-------------------------------------------------
                        lstrTimeLimit = vbNullString
                        lstrMark = vbNullString
                        
                        '@ﾘｽﾄｶｳﾝﾄ分ﾙｰﾌﾟ
                        For llngTimeLimit = 0 To .lngTimeOrderCnt -1
                        
                            '@外部時間制限判定
                            Select Case .typTimeOrder(llngTimeLimit).strOutSideFlag
                                
                                Case "0"
                                    lstrMark = CMstrTimeLimitMark   '制
                                Case "1"
                                    lstrMark = CMstrTakeOverMark    '引
                                Case Else
                                    lstrMark = CMstrTimeLimitMark   '制
                                
                            End Select
                            
                            '@制限ﾀｲﾌﾟ判定
                            If .typTimeOrder(llngTimeLimit).strRestrictTypeID = "3" Then
                                
                                '@処理時間制限の場合
                                '@表示文字
                                lstrTimeLimit = lstrTimeLimit & lstrMark & _
                                            .typTimeOrder(llngTimeLimit).strRestrictTypeID & _
                                            CMstrHyphen & _
                                            Format$(CInt(.typTimeOrder(llngTimeLimit).strListOrder), CMstrNoFormat) & CMstrComma
                            Else
                                '@時間制限（以上、以下）の場合
                                '@表示文字
                                lstrTimeLimit = lstrTimeLimit & lstrMark & _
                                                .typTimeOrder(llngTimeLimit).strRestrictTypeID & _
                                                CMstrHyphen & _
                                                Format$(CInt(.typTimeOrder(llngTimeLimit).strListOrder), CMstrNoFormat) & _
                                                CMstrHyphen & _
                                                .typTimeOrder(llngTimeLimit).strStatusFlag & CMstrComma
                            End If
                        Next
                        
                        '@最後にｶﾝﾏがついていたら
                        If Strings.Right$(lstrTimeLimit, 1) = CMstrComma Then
                            '@ｶﾝﾏを削除
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowTimeLimit, _
                                Strings.Left$(lstrTimeLimit, Len(lstrTimeLimit) - 1))
                        End If
                        
                        '@時間制限ﾌﾗｸﾞ//(非表示設定):0:ﾌﾗｸﾞOFF(未編集)/1:ﾌﾗｸﾞON(編集中)
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowTimeLimitFlag, CMstrFlgOff)
                        

                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowSFlag, .strSFlag)                         '特殊特性ﾌﾗｸﾞ

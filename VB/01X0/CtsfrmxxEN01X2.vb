    '***************************************************************************************
    '                              * イベントハンドラの記述 *
    '***************************************************************************************
    '======================================Private==========================================
    '関数名：Form_Load
    '機　能：ﾌｫｰﾑﾛｰﾄﾞ
    '引　数：なし
    '戻り値：なし
    '作成日：2006/07/13 (Thu) 17:06:02 N.Kasai
    '更新日：2014/04/04 (Fri) 12:42:43 T.Oide
    '備　考：
    '　　　：2006/10/13 (Fri) 10:57:33 N.Kasai  時間制限番号基準対応
    '　　　：2008/10/14 (Tue) 16:49:24 M.Koni   ltypProcWaferList のﾓｼﾞｭｰﾙ変数化。<案件No.02871>
    Private Sub Form_Load()

        Dim lblnAns                     As Boolean                  '戻り値
        Dim llngMaxListOrder            As Integer                  '最大ﾘｽﾄｵｰﾀﾞｰ
        Dim llngListOrder               As Integer                  'ﾘｽﾄｵｰﾀﾞｰ
        Dim llngCount                   As Integer                  'ｶｳﾝﾀ
        Dim ltypProcTimeLimitInfo       As ProcTimeLimitInfo        '時間制限ﾘｽﾄ
        Dim ltypProcCondDetailList      As ProcCondDetailList       'LOT処理条件詳細情報
        Dim ltypFlowListReq             As ProcFlowListReq          'ﾌﾛｰﾘｽﾄ
        Dim ltypFlowListAns             As ProcFlowListAns          'ﾌﾛｰﾘｽﾄ
        Dim ltypApcAns                  As ApcAns                   'APC情報取得
        Dim lstrEventName               As String                   'ｲﾍﾞﾝﾄ名格納（ﾚｽﾎﾟﾝｽ用）
        Dim ltypProcWaferList           As ProcWaferList            'ﾛｯﾄｳｪﾊ情報
        
        Dim llngCnt                     As Integer                  'ｶｳﾝﾀ
        Dim llngCnt2                    As Integer                  'ｶｳﾝﾀ2
        Dim llngRow                     As Integer                  'Rowｶｳﾝﾀ
        Dim lstrPdID                    As String                   '機種

        Try

            '@画面起動判定初期化
            mblnFormActive = False
            
            'NSYS 表示位置設定
            StartPosition = FormStartPosition.Manual
            Top = 0
            Left = -My.Settings.FormOffset

            '@画面初期化
            Call prvfrmxxEN01X2_Init()
            
            '@ﾛｯﾄ工順変更画面から情報を取得
            With frmxxEN01X0.Instance.vsfProcCngList
                
                '@編集ﾌﾗｸﾞを設定
                Select Case .GetData(.Row, CPlngvsfProcCngListEditStatus)
                    Case CMstrStateNotEdit '未編集
                        mlngEditFlag = 0
                    Case CMstrStateEditing '編集中
                        mlngEditFlag = 1
                    Case CMstrStateEdited  '編集済
                        mlngEditFlag = 2
                End Select
                
                '@現工程の取得(工順変更中ﾘｽﾄから取得)
                mstrCurrentOpID = .GetData(.Row, CPlngvsfProcCngListOpID)              '大工程
                mstrCurrentStepID = .GetData(.Row, CPlngvsfProcCngListStepID)          '小工程
                mstrCurrentStatus = .GetData(.Row, CPlngvsfProcCngListLotStatus)       '現在工程状態
        '@↓2014/01/14 (Tue) 11:24:51 T.Oide **************************************************
                lstrPdID = .GetData(.Row, CPlngvsfProcCngListPdID)                     '機種
        '@↑2014/01/14 (Tue) 11:24:51 T.Oide **************************************************

                txtComments.Text = .GetData(.Row, CPlngvsfProcCngListComments)         'ｺﾒﾝﾄ
                
            End With
            
            '@ﾚｽﾎﾟﾝｽ取得開始
            lstrEventName = "Form_Load"
            Call pubResponseStart(Me.Name, lstrEventName)
            
            '@----------------
            '@ｷｬﾘｱｶﾃｺﾞﾘ情報取得
            '@----------------
            '@MSG【ｷｬﾘｱｶﾃｺﾞﾘ情報取得】
            lblnAns = pubblnCarrierCategoryList_Sel(CMstrmas_carriercategorylistVer, _
                                                    pstrSBID, _
                                                    mtypCarrierCategoryList)
            '@結果判定
            If lblnAns = True Then
                '@構造体に格納
                ptypApcAns = ltypApcAns
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If
            

            '@----------------
            '@実績報告ﾏｽﾀｰ情報取得
            '@----------------
            '@MSG【実績報告工程取得】
            
        '@↓2014/04/04 (Fri) 11:08:13 T.Oide **************************************************
        '    '@ PRまたはESか
        '    If pstrFlowClass = CPstrFlowClassPR Or pstrFlowClass = CPstrFlowClassES Then
        '-------------------------------------------------------------------------------------

            '@ PRまたはESで基板か
            '@　メモ：本当は組立のCFの場合、実績報告マスターのチェックを飛ばすようにしたい
            '@　　　　CFフラグが情報としてないため、基板のみのチェックとする
            '@　　　　組立は流動中の実績報告がないので現状の運用では問題なし
            If (pstrFlowClass = CPstrFlowClassPR Or pstrFlowClass = CPstrFlowClassES) And _
                pstrSBID = CPstrSBID1A0 Then
        '@↑2014/04/04 (Fri) 11:08:13 T.Oide **************************************************

                '@基板でPRまたはESの場合、実績報告工程を取得
                lblnAns = pubblnReportPoint_Sel(CMstrmas_reportpointVer, _
                                                pstrSBID, _
                                                lstrPdID, _
                                                mtypeReportPoint)
                '@結果判定
                If lblnAns <> True Then
                    '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                    Call pubResponseCancel(Me.Name, lstrEventName)
                    Exit Sub
                End If
            End If
            
            
            '@----------------
            '@変更中工順
            '@----------------
            With ltypFlowListReq
                .strSbID = pstrSBID
                .strMsgVer = CMstrprocprocflowlistVer
                .strLotID = pstrLotID
                .strTravelerType = CMTravelerTypeTemp
            End With
            
            '@MSG【工程ﾌﾛｰ取得】
            lblnAns = pubblnProcProcFlowList_Sel(ltypFlowListReq, ltypFlowListAns)
           
            '@結果判定
            If lblnAns = True Then
                
                '@=======================
                '@ ｷｬﾘｱｶﾃｺﾞﾘ(ｸﾞﾘｯﾄﾞｺﾝﾎﾞ)設定処理
                '@=======================
                Call prvCarrierCategoryComboList_Set(pstrSBID)
                
                '@変更中工順表示
        '@↓2014/01/14 (Tue) 13:19:47 T.Oide **************************************************
        '        Call prvvsfFlowList_Disp(ltypFlowListAns, 0)
                Call prvvsfFlowList_Disp(ltypFlowListAns, mtypeReportPoint, vsfFlowList0)
        '@↑2014/01/14 (Tue) 13:19:47 T.Oide **************************************************
                
                '@ﾛｯﾄID表示
                lblLotID.Text = pstrLotID
                '@種別表示
                lblFlowClass.Text = pstrFlowClass
                
                '@工順が存在しない場合
                If ltypFlowListAns.lngLotProcFlowCnt = 0 Then
                    '@絶対工順番号初期値
                    plngSeqNoCnt = 1
                End If
                
                '@工順変更中ﾛｯﾄ編集前の場合(CHANGE=0：変更なし、1:編集開始済み 2:変更あり）
                If ltypFlowListAns.strChange = "0" Then
                    '@編集ﾌﾗｸﾞ（0/未編集　1/編集中　2/編集済 /3編集開始前）
                    mlngEditFlag = 3
                    cmdEditStart.Enabled = True                     '編集開始ﾎﾞﾀﾝ
                Else
                    If mlngEditFlag = 0 Then
                        '@投入前の場合
                        mlngEditFlag = 1
                    End If
                     cmdEditStart.Enabled = False                   '編集開始ﾎﾞﾀﾝ
                End If
                
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If
            
            '@変更点取得格納
            mstrChange = ltypFlowListAns.strChange
            
            '@----------------
            '@時間制限
            '@----------------
            '@MSG【時間制限情報取得】
            lblnAns = pubblnProcTimeLimitInfo_Sel(pstrSBID, CMstrproctimelimitinfoVer, pstrLotID, ltypProcTimeLimitInfo)

            '@結果判定
            If lblnAns = True Then

                '@時間制限情報を保持
                With ltypProcTimeLimitInfo

                    '@時間制限が1件以上存在する場合
                    If .lngProcTimeLimitCnt > 0 Then

                        '@その数分、時間制限保持配列を作成
                        ptypProcTimeLimitInfo.lngProcTimeLimitCnt = .lngProcTimeLimitCnt
                        If ptypProcTimeLimitInfo.typProcTimeLimit Is Nothing Then
                            ptypProcTimeLimitInfo.typProcTimeLimit = New List(Of ProcTimeLimit)
                        Else
                            ptypProcTimeLimitInfo.typProcTimeLimit.Clear
                        End If                        

                        '@取得した時間制限配列を時間制限保持配列へｾｯﾄ
                        For llngCount = 0 To ltypProcTimeLimitInfo.lngProcTimeLimitCnt -1
                            Dim typProcTimeLimitTmp As New ProcTimeLimit
                            '@ﾘｽﾄｵｰﾀﾞｰを取得
                            llngListOrder = ltypProcTimeLimitInfo.typProcTimeLimit(llngCount).strListOrder
                            '@ﾘｽﾄｵｰﾀﾞｰの番号に時間制限の内容をｾｯﾄ
                            typProcTimeLimitTmp _
                                            = ltypProcTimeLimitInfo.typProcTimeLimit(llngCount)
                            typProcTimeLimitTmp.blnEnableFlag = True '有効ﾃﾞｰﾀ
                            ptypProcTimeLimitInfo.typProcTimeLimit.Add(typProcTimeLimitTmp)

                            '@初回のみ
                            If llngCount = 0 Then
                                '@最大のﾘｽﾄｶｳﾝﾄを取得
                                llngMaxListOrder = CLng(.typProcTimeLimit(.lngProcTimeLimitCnt -1).strListOrder)
                            Else
                                If llngMaxListOrder < CLng(.typProcTimeLimit(.lngProcTimeLimitCnt -1).strListOrder) Then
                                    llngMaxListOrder = CLng(.typProcTimeLimit(.lngProcTimeLimitCnt -1).strListOrder)
                                End If
                            End If
                        Next

                        '@時間制限番号を設定
                        plngTimeLimitCnt = llngMaxListOrder + 1

                        '@取得時時間制限の情報をﾓｼﾞｭｰﾙ変数へ退避
                        mtypProcTimeLimitInfo = ptypProcTimeLimitInfo


                        '@特殊ﾛｯﾄの場合は時間制限の新規設定は不可
                        If pstrEN01X0ProcFlag = "1" Then
                            '@時間制限設定ﾎﾞﾀﾝ使用不可
                            cmdTimeLimitSet.Enabled = False
                        Else
                            '@時間制限設定ﾎﾞﾀﾝ使用可
                            cmdTimeLimitSet.Enabled = True
                        End If
                    End If
                    
                    '@時間制限番号を再設定
                    If IsNumeric(.strListOrderBase) = True Then
                        If CLng(.strListOrderBase) > llngMaxListOrder + 1 Then
                            '@時間制限番号基準値+1
                            plngTimeLimitCnt = CLng(.strListOrderBase) + 1
                        End If
                    End If
                    
                End With
            Else
                '@時間制限番号を設定
                plngTimeLimitCnt = 1

                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If

            '@----------------
            '@処理条件詳細
            '@----------------
            '@MSG【LOT処理条件詳細取得】
            lblnAns = pubblnProcCondDetailList_Sel(pstrSBID, _
                                                  CMstrprocconddetaillistVer, _
                                                  pstrLotID, CMTravelerTypeTemp, _
                                                  ltypProcCondDetailList)
            '@結果判定
            If lblnAns = True Then
                '@LOT処理条件詳細情報を保持
                ptypProcCondDetailList = ltypProcCondDetailList

                '@個別処理条件が存在する場合
                If ptypProcCondDetailList.lngProcCondDetailCnt > 0 Then
                    '@構造体格納数分検索
                    For llngCnt = 0 To ptypProcCondDetailList.lngProcCondDetailCnt -1
                        '@ﾌﾛｰﾘｽﾄ検索
                        With vsfFlowList0
                            For llngRow = 1 To .Rows.Count - 1
                                Dim typProcCondDetailTmp As ProcCondDetail = ptypProcCondDetailList.typProcCondDetail(llngCnt)
                                If ptypProcCondDetailList.typProcCondDetail(llngCnt).strOpID = .GetData(llngRow, CPlngvsfFlowOpID) And _
                                    ptypProcCondDetailList.typProcCondDetail(llngCnt).strStepID = .GetData(llngRow, CPlngvsfFlowStepID) Then

                                    '@工順番号ｾｯﾄ
                                    '@以降はこの工順番号をkeyとする。
                                    typProcCondDetailTmp.strAbsNo = .GetData(llngRow, CPlngvsfFlowAbsNo)
                                    typProcCondDetailTmp.blnEnableFlag = True    '有効ﾃﾞｰﾀ
                                    ptypProcCondDetailList.typProcCondDetail(llngCnt) = typProcCondDetailTmp

                                    For llngCnt2 = 0 To ptypProcCondDetailList.typProcCondDetail(llngCnt).lngCondDetailCnt -1
                                        '@ﾚｼﾋﾟIDに「＠レシピ」が存在する場合
                                        If ptypProcCondDetailList.typProcCondDetail(llngCnt).typProcCond(llngCnt2).strRecipeId = CPstrRecpNotID Then
                                            '@個別処理条件表示変更（未設定）
                                            .SetData(llngRow, CPlngvsfFlowConditionOne, CPstrRecpNot)
                                            Dim newStyle As CellStyle = .Styles.Add("CustomStyle_ForeColor_vbRed")
                                            newStyle.ForeColor = Color.Red
                                            Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowConditionOne)
                                            cellRange.Style = newStyle
                                            '@列幅を自動調整
                                            .AutoSizeCol(CPlngvsfFlowConditionOne, 6)
                                            Exit For
                                        End If
                                    Next

                                    Exit For
                                End If
                            Next
                        End With
                    Next
                End If
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If

            '@----------------
            '@APC情報取得
            '@----------------
            '@MSG【APC情報取得】
            lblnAns = pubblnMasApcList_Sel(CMstrmas_apclist_Ver, ltypApcAns)
            '@結果判定
            If lblnAns = True Then
                '@構造体に格納
                ptypApcAns = ltypApcAns
             Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If

            '@ﾕｰｻﾞｰﾌﾟﾛｾｽ判定
            If pstrEN01X0KindFlag <> "2" Then
               '@ﾕｰｻﾞﾌﾟﾛｾｽの場合は取得しない。

                '@----------------
                '@ﾛｯﾄｳｪﾊ情報取得
                '@----------------
                
                '@ﾛｯﾄｳｴﾊ情報構造体の初期化
                mtypProcWaferList = ltypProcWaferList

                '@MSG【ﾛｯﾄｳｪﾊ情報取得】
                lblnAns = pubblnProcWaferList_Sel(CMstrprocwaferlistVer, mtypProcWaferList, pstrSBID, pstrLotID)

                '@結果判定
                If lblnAns = True Then
                    ptypWaferListCp = mtypProcWaferList

                Else
                    '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                    Call pubResponseCancel(Me.Name, lstrEventName)
                    Exit Sub
                End If

            End If
            
            '@ﾚｽﾎﾟﾝｽ取得終了
            Call publngResponseEnd(Me.Name, lstrEventName)
            
            '@登録ﾎﾞﾀﾝの使用許可
            Call prvCmdUpdateEnabled_Set()
            
            '@編集ﾌﾗｸﾞｸﾘｱ
            pblnEN01X2Edit = False
            
            '@Form_Loadﾌﾗｸﾞ（正常）
            pblnFormLoad = True

            '@ﾌﾟﾛｾｽﾌﾛｰの高さの初期値をｾｯﾄ
            mlngvsfPcTabOffHeight = CMlngvsfPcTabOffHeight
            mlngvsfPcTabOnHeight = CMlngvsfPcTabOnHeight

            'NSYS 背景色に白を設定
            cmbOpCategory.BackColor = Color.White
            cmbStepCategory.BackColor = Color.White
            cmbConditionCategory.BackColor = Color.White
            cmbCollectionCategory.BackColor = Color.White

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "Form_Load"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：Form_Activate
    '機　能：画面Activate
    '引　数：なし
    '戻り値：なし
    '作成日：2006/08/31 (Thu) 10:16:24 N.Kasai
    '更新日：2006/08/31 (Thu) 10:16:24
    '備　考：
    Private Sub Form_Activate(ByVal sender As Object, ByVal e As EventArgs) Handles MyBase.Activated

        Dim lblnAns                     As Boolean                  '戻り値
        Dim ltypMasCategoryIdList       As MasCategoryIdList        'ｶﾃｺﾞﾘﾘｽﾄ
        Dim ltypMasMeasureTermsList     As MasMeasureTermsList      '測定条件ｾｯﾄID
        Dim ltypMasScrapSetIdList       As MasScrapSetIdList        '不良項目ｾｯﾄIDﾃﾞｰﾀ
        Dim ltypFlowChgListReq          As ProcFlowListReq          'ﾌﾛｰﾘｽﾄ
        Dim ltypFlowChgListAns          As ProcFlowListAns          'ﾌﾛｰﾘｽﾄ
        Dim ltypMasPclistReq            As pclistreq                'ﾌﾟﾛｾｽ要求ﾘｽﾄ
        Dim lstrEventName               As String                   'ｲﾍﾞﾝﾄ名格納（ﾚｽﾎﾟﾝｽ用）
        
        Try
            
            '@画面起動判定
            If mblnFormActive = True Then
                '@初回のみ走行
                Exit Sub
            End If
            
            '@画面起動済み
            mblnFormActive = True
            
           '@ﾚｽﾎﾟﾝｽ取得開始
            lstrEventName = "Form_Activate"
            Call pubResponseStart(Me.Name, lstrEventName)
            
                
            '@----------------
            '@大工程
            '@----------------
            '@大工程ｶﾃｺﾞﾘ
            '@MSG【ｶﾃｺﾞﾘID取得】
            lblnAns = pubblnMasCategoryIdList_Sel(pstrSBID, _
                                                  CMstrmas_categoryidlistVer, _
                                                  CPstrCD28, _
                                                  ltypMasCategoryIdList)
            '@結果判定
            If lblnAns = True Then
                '@大工程ｶﾃｺﾞﾘ設定
                Call prvcmbCategory_Disp(ltypMasCategoryIdList, cmbOpCategory)
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If

            '@----------------
            '@小工程
            '@----------------
            '@小工程ｶﾃｺﾞﾘ
            '@MSG【ｶﾃｺﾞﾘID取得】
            lblnAns = pubblnMasCategoryIdList_Sel(pstrSBID, _
                                                  CMstrmas_categoryidlistVer, _
                                                  CPstrCD29, _
                                                  ltypMasCategoryIdList)
            '@結果判定
            If lblnAns = True Then
                '@小工程ｶﾃｺﾞﾘ設定
                Call prvcmbCategory_Disp(ltypMasCategoryIdList, cmbStepCategory)
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If

            '@----------------
            '@処理条件
            '@----------------
            '@処理条件ｶﾃｺﾞﾘ
            '@MSG【ｶﾃｺﾞﾘID取得】
            lblnAns = pubblnMasCategoryIdList_Sel(pstrSBID, _
                                                  CMstrmas_categoryidlistVer, _
                                                  CPstrCD1O, _
                                                  ltypMasCategoryIdList)
            '@結果判定
            If lblnAns = True Then
                '@処理条件ｶﾃｺﾞﾘ設定
                Call prvcmbCategory_Disp(ltypMasCategoryIdList, cmbConditionCategory)
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If

            '@----------------
            '@収集項目
            '@----------------
            '@収集項目ｶﾃｺﾞﾘ
            '@MSG【ｶﾃｺﾞﾘID取得】
            lblnAns = pubblnMasCategoryIdList_Sel(pstrSBID, _
                                                  CMstrmas_categoryidlistVer, _
                                                  CPstrCD1P, _
                                                  ltypMasCategoryIdList)
            '@結果判定
            If lblnAns = True Then
                '@収集項目ｶﾃｺﾞﾘ設定
                Call prvcmbCategory_Disp(ltypMasCategoryIdList, cmbCollectionCategory)
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If

            '@----------------
            '@WF選択条件
            '@----------------
            '@WF選択条件ｾｯﾄID
            '@MSG【WF選択条件取得】
            lblnAns = pubblnMasMeasureTermsList_Sel(pstrSBID, _
                                                    CMstrmas_measuretermslistVer, _
                                                    ltypMasMeasureTermsList)
            '@結果判定
            If lblnAns = True Then
                '@WF選択条件設定
                Call prvvsfSelectCondition_Disp(ltypMasMeasureTermsList)
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If

            '@----------------
            '@不良項目
            '@----------------
            '@不良項目ｾｯﾄID
            '@MSG【不良項目ｾｯﾄID取得】
            lblnAns = pubblnMasScrapSetIdList_Sel(pstrSBID, _
                                                  CMstrmas_scrapsetidlistVer, _
                                                  ltypMasScrapSetIdList)
            '@結果判定
            If lblnAns = True Then
                '@不良項目設定
                Call prvLotScrapSetIDList_Disp(ltypMasScrapSetIdList)
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If

            '@----------------
            '@ﾘﾜｰｸﾙｰﾄID
            '@----------------
            '@要求構造体の情報をｾｯﾄ
            With ltypMasPclistReq
                .strMsgVer = CMstrMas_Pclist__Ver
                .strSbID = pstrSBID
                .strFlowType = CMstrRework
            End With

            '@MSG【ﾘﾜｰｸﾙｰﾄID取得】
            lblnAns = pubblnMasPcList_Sel(ltypMasPclistReq, mtypReworkPcList)

            '@結果判定
            If lblnAns = True Then
                '@ﾘﾜｰｸﾙｰﾄｺﾝﾎﾞ設定
                Call prvcmbRework_Set()
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If

            '@----------------
            '@追加流動ﾙｰﾄID
            '@----------------
            '@要求構造体の情報をｾｯﾄ
            With ltypMasPclistReq
                .strMsgVer = CMstrMas_Pclist__Ver
                .strSbID = pstrSBID
                .strFlowType = CMstrAdd
            End With

            '@MSG【追加流動ﾙｰﾄID取得】
            lblnAns = pubblnMasPcList_Sel(ltypMasPclistReq, mtypSpecialPcList)

            '@結果判定
            If lblnAns = True Then
                '@追加流動ｺﾝﾎﾞ設定
                Call prvcmbSpecial_Set()
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If
            
            '@----------------
            '@工順ﾌﾛｰ変更点取得
            '@----------------
            '@変更ありの場合(CHANGE=0：変更なし、1:編集開始済み 2:変更あり）
            If mstrChange = "2" Then
                    
                '@ｲﾝﾌｫﾒｰｼｮﾝ画面起動
                frmxxCM00X0.Instance = New frmxxCM00X0()
            
                '@ﾌｫｰﾑのｷｬﾌﾟｼｮﾝ設定
                frmxxCM00X0.Instance.Text = Me.Text
                frmxxCM00X0.Instance.lblInfomation1.Text = "変更箇所を検索中です。"
                
                '@ｲﾝﾌｫﾒｰｼｮﾝﾌｫｰﾑを先行して描画する為、記述しています。
                '@ｲﾝﾌｫﾒｰｼｮﾝﾌｫｰﾑを先行して描画する為、記述しています。
                frmxxCM00X0.Instance.Show(Me)
                frmxxCM00X0.Instance.Refresh
                Me.Refresh
            
                With ltypFlowChgListReq
                    .strSbID = pstrSBID
                    .strMsgVer = CMstrprocprocflowchglistVer
                    .strLotID = pstrLotID
                End With

                '@MSG【工程ﾌﾛｰ変更点取得】
                lblnAns = pubblnProcProcFlowChgList_Sel(ltypFlowChgListReq, ltypFlowChgListAns)

                '@結果判定
                If lblnAns = True Then
                    Call prvvsfFlowChgList_Disp(ltypFlowChgListAns)
                Else
                    '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                    Call pubResponseCancel(Me.Name, lstrEventName)
                    '@ｲﾝﾌｫﾒｰｼｮﾝ画面を閉じる
                    frmxxCM00X0.Instance = Nothing
                    Exit Sub
                End If
            
            
                '@ｲﾝﾌｫﾒｰｼｮﾝ画面を閉じる
                frmxxCM00X0.Instance = Nothing
               
            End If
            
            
            '@ﾚｽﾎﾟﾝｽ取得終了
            Call publngResponseEnd(Me.Name, lstrEventName)

            'NSYS Activate中にpublngMsgBox等で別ウィンドウを表示するとActivateがキャンセルされるため、再Activateする
            'NSYS Activateイベント中にActivate()を呼び出しても作用しないため、遅延で実行する。ラムダ式使用
            Dim lfuncActivate As Action = Sub()
                                              Me.Activate()
                                          End Sub
            Me.BeginInvoke(lfuncActivate)

            Exit Sub

        Catch ex As Exception
            
            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey
                .strProcName = "Form_Activate"
                .strErrMessage = vbNullString
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Sub


    '関数名：Form_KeyDown
    '機　能：ﾌｫｰﾑｷｰﾀﾞｳﾝ
    '引　数：KeyCode    ：ｷｰｺｰﾄﾞ
    '　　　：Shift      ：Shift/Ctrl/Altｷｰ
    '戻り値：なし
    '作成日：2006/05/16 (Tue) 16:55:37 N.Kasai
    '更新日：2006/05/16 (Tue) 16:55:37
    '備　考：
    Private Sub Form_KeyDown(ByVal sender As Object, ByVal e As KeyEventArgs) Handles MyBase.KeyDown
        
        Try
            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            Select Case ActiveControl.Name
                
                Case vsfFlowList0.Name
                    
                    '@SPCｽｷｯﾌﾟﾌﾗｸﾞの場合
                    If vsfFlowList0.Col = CPlngvsfFlowJudgeSkipFlag Then
                        Select Case e.KeyCode
                            '@ｽﾍﾟｰｽの場合
                            Case Keys.Space
                                Call vsfFlowList_Click(vsfFlowList0,e)
                        End Select
                    End If
                    
                    '@F/B適用外の場合
                    If vsfFlowList0.Col = CPlngvsfFlowApcSkipFlag Then
                        Select Case e.KeyCode
                            '@ｽﾍﾟｰｽの場合
                            Case Keys.Space
                                Call vsfFlowList_Click(vsfFlowList0,e)
                        End Select
                    End If
                    
                    '@F/B計算除外の場合
                    If vsfFlowList0.Col = CPlngvsfFlowApcCalcSkipFlag Then
                        Select Case e.KeyCode
                            '@ｽﾍﾟｰｽの場合
                            Case Keys.Space
                                Call vsfFlowList_Click(vsfFlowList0,e)
                        End Select
                    End If
                
                Case vsfOpList.Name
                    '@ｸﾞﾘｯﾄﾞｷｰ制御（ｷｰｺｰﾄﾞ、ｱｸﾃｨﾌﾞｺﾝﾄﾛｰﾙ名、ｸﾞﾘｯﾄﾞ）
                    Call pubVsf_KeyDown(e, ActiveControl.Name, vsfOpList, Nothing, Nothing, False)
                
                Case vsfStepList.Name
                    '@ｸﾞﾘｯﾄﾞｷｰ制御（ｷｰｺｰﾄﾞ、ｱｸﾃｨﾌﾞｺﾝﾄﾛｰﾙ名、ｸﾞﾘｯﾄﾞ）
                    Call pubVsf_KeyDown(e, ActiveControl.Name, vsfStepList, Nothing, Nothing, False)
                
                Case vsfScrapList.Name
                    '@ｸﾞﾘｯﾄﾞｷｰ制御（ｷｰｺｰﾄﾞ、ｱｸﾃｨﾌﾞｺﾝﾄﾛｰﾙ名、ｸﾞﾘｯﾄﾞ）
                    Call pubVsf_KeyDown(e, ActiveControl.Name, vsfScrapList, Nothing, Nothing, False)
                
                Case vsfConditionList1.Name
                    '@ｸﾞﾘｯﾄﾞｷｰ制御（ｷｰｺｰﾄﾞ、ｱｸﾃｨﾌﾞｺﾝﾄﾛｰﾙ名、ｸﾞﾘｯﾄﾞ）
                    Call pubVsf_KeyDown(e, ActiveControl.Name, vsfConditionList1, Nothing, Nothing, False)

                Case vsfConditionList2.Name
                    '@ｸﾞﾘｯﾄﾞｷｰ制御（ｷｰｺｰﾄﾞ、ｱｸﾃｨﾌﾞｺﾝﾄﾛｰﾙ名、ｸﾞﾘｯﾄﾞ）
                    Call pubVsf_KeyDown(e, ActiveControl.Name, vsfConditionList2, Nothing, Nothing, False)
                
                
                '@収集項目
                Case vsfCollectionList.Name
                    '@ｸﾞﾘｯﾄﾞｷｰ制御（ｷｰｺｰﾄﾞ、ｱｸﾃｨﾌﾞｺﾝﾄﾛｰﾙ名、ｸﾞﾘｯﾄﾞ）
                    Call pubVsf_KeyDown(e, ActiveControl.Name, vsfCollectionList)
                
                '@収集項目（ﾊﾟﾗﾒｰﾀ）
                    '@ｸﾞﾘｯﾄﾞｷｰ制御（ｷｰｺｰﾄﾞ、ｱｸﾃｨﾌﾞｺﾝﾄﾛｰﾙ名、ｸﾞﾘｯﾄﾞ）
                    Call pubVsf_KeyDown(e, ActiveControl.Name, vsfCollectionPara)
                
                Case txtComments.Name 'ｺﾒﾝﾄ
                    '@ﾃｷｽﾄ内改行の為処理なし

                '@大工程ｶﾃｺﾞﾘComboの場合
                Case cmbOpCategory.Name
                    
                    '@ｷｰｺｰﾄﾞによる処理分岐
                    Select Case e.KeyCode
                        
                        '@Enterｷｰの場合
                        Case Keys.Return
                            '@Validate処理を動かす
                            RemoveHandler cmbOpCategory.Validating, AddressOf cmbOpCategory_Validate
                            Call cmbOpCategory_Validate(cmbOpCategory,New CancelEventArgs(False))
                            AddHandler cmbOpCategory.Validating, AddressOf cmbOpCategory_Validate
                    End Select
                
                '@小工程ｶﾃｺﾞﾘComboの場合
                Case cmbStepCategory.Name
                    
                    '@ｷｰｺｰﾄﾞによる処理分岐
                    Select Case e.KeyCode
                        
                        '@Enterｷｰの場合
                        Case Keys.Return
                            '@Validate処理を動かす
                            RemoveHandler cmbStepCategory.Validating, AddressOf cmbStepCategory_Validate
                            Call cmbStepCategory_Validate(cmbStepCategory,New CancelEventArgs(False))
                            AddHandler cmbStepCategory.Validating, AddressOf cmbStepCategory_Validate
                    End Select
                
                '@処理条件Comboの場合
                Case cmbConditionCategory.Name
                    
                    '@ｷｰｺｰﾄﾞによる処理分岐
                    Select Case e.KeyCode
                        
                        '@Enterｷｰの場合
                        Case Keys.Return
                            '@Validate処理を動かす
                            RemoveHandler cmbConditionCategory.Validating, AddressOf cmbConditionCategory_Validate
                            Call cmbConditionCategory_Validate(cmbConditionCategory,New CancelEventArgs(False))
                            AddHandler cmbConditionCategory.Validating, AddressOf cmbConditionCategory_Validate
                            '@ﾌｫｰｶｽ制御
                            If vsfConditionList1.Rows.Count > 1 Then
                            '@ﾘｽﾄが存在する場合
                                '@ﾌｫｰｶｽｾｯﾄ
                                Call pubSetFocus(vsfConditionList1)
                                '@1行目を選択状態
                                vsfConditionList1.ShowCell(1, 1)
                            Else
                            '@ﾘｽﾄが存在しない場合
                                '@行削除
                                vsfConditionList1.Rows.Count = 1
                                
                                '@ﾌｫｰｶｽｾｯﾄ
                                Call pubSetFocus(cmbConditionCategory)
                            End If
                    End Select

                '@収集項目Comboの場合
                Case cmbCollectionCategory.Name
                    
                    '@ｷｰｺｰﾄﾞによる処理分岐
                    Select Case e.KeyCode
                        
                        '@Enterｷｰの場合
                        Case Keys.Return
                            '@Validate処理を動かす
                            RemoveHandler cmbCollectionCategory.Validating,AddressOf cmbCollectionCategory_Validate
                            Call cmbCollectionCategory_Validate(cmbCollectionCategory,New CancelEventArgs(False))
                            AddHandler cmbCollectionCategory.Validating,AddressOf cmbCollectionCategory_Validate
                    End Select
                
                Case Else
                    '@ｴﾝﾀｰでﾀﾌﾞと同じように進む
                    If e.KeyCode = Keys.Return Then
                        If ActiveControl IsNot vsfFlowList0.Editor Then
                            SendKeys.SendWait(CPstrSendKeysTab)
                            e.Handled = True
                        End If
                    End If
                    
            End Select

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "Form_KeyDown"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：Form_QueryUnload
    '機　能：ﾌｫｰﾑのｸｴﾘｱﾝﾛｰﾄﾞ処理
    '引　数：Cancel：未使用
    '　　　：UnloadMode：未使用
    '戻り値：なし
    '作成日：2006/05/16 (Tue) 16:59:22 N.Kasai
    '更新日：2006/05/16 (Tue) 16:59:22
    '備　考：
    Private Sub Form_QueryUnload(ByVal sender As Object, ByVal e As FormClosingEventArgs) Handles MyBase.FormClosing
        
        Dim llngMsgAns  As Integer      'ﾒｯｾｰｼﾞﾎﾞｯｸｽ関数の戻り値格納

        Try        
            '@編集済みでない　かつ　変更が行われた場合
            If mlngEditFlag <> 2 And pblnEN01X2Edit = True Then
                '@終了確認ﾒｯｾｰｼﾞの表示
                '@表示ﾒｯｾｰｼﾞ変換
                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf001W)
                '@「編集中のデータは破棄されます。終了してもよろしいですか？」
                llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)

                '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                Select Case llngMsgAns
                    Case vbYes      '「はい」を選択
                    Case vbNo       '「いいえ」を選択
                        e.Cancel = True
                        Exit Sub
                End Select
            End If

            '@×にて閉じた場合は閉じるﾎﾞﾀﾝをCALLする
            If mblnCloseFromControlMenu Then
                RemoveHandler MyBase.FormClosing,AddressOf Form_QueryUnload
                Call cmdClose_Click(cmdClose,New CancelEventArgs)
                AddHandler MyBase.FormClosing,AddressOf Form_QueryUnload
            End If

            '@配列のｸﾘｱ
            Call prvAryData_Clr()
          
            '@ﾛｯﾄ工順変更画面の編集
            With frmxxEN01X0.Instance.vsfProcCngList
                '@状態が未編集の場合は「編集中」にする
                If .GetData(.Row, CPlngvsfProcCngListEditStatus) = CMstrStateNotEdit Then
                    .SetData(.Row, CPlngvsfProcCngListEditStatus, CMstrStateEditing)          '編集状態＝「編集中」
                End If
                
                If mstrCurrentHoldFlag = "1" Then
                    .SetData(.Row, CPlngvsfProcCngListLotHold, "1")
                End If
                
                .SetData(.Row, CPlngvsfProcCngListEditTime, Format(Now, CPstrDateTimeYMDHM))  '最終更新日時
                .SetData(.Row, CPlngvsfProcCngListComments, txtComments.Text)                 'ｺﾒﾝﾄ
            End With

            'NSYS 静的イベントハンドラ解除
            RemoveHandler System.Windows.Forms.Application.Idle, AddressOf Application_Idle

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "Form_QueryUnload"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：cmbResize_Change
    '機　能：画面表示比率変更ｺﾝﾎﾞ
    '引　数：なし
    '戻り値：なし
    '作成日：2006/06/29 (Thu) 18:23:37 N.Kasai
    '更新日：2006/06/29 (Thu) 18:23:37
    '備　考：
    Private Sub cmbResize_Change(ByVal sender As Object, ByVal e As EventArgs) Handles cmbResize.Change
        
        Dim llngWidth           As Integer  '最大表示幅
        Dim llngCalcWidth       As Integer  '計算結果
        Dim llngListIndex       As Integer  'ｺﾝﾎﾞﾘｽﾄｲﾝﾃﾞｯｸｽ
        
        Try
            
            llngListIndex = cmbResize.ListIndex + 1
            
            llngWidth = vsfFlowList0.Width + vsfFlowList1.Width

            llngCalcWidth = (llngWidth * llngListIndex / 10)


            vsfFlowList0.Width = llngCalcWidth

            vsfFlowList1.Width = llngWidth - llngCalcWidth

            vsfFlowList1.Left = 8 + vsfFlowList0.Width + CMlngBlankWidth

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "cmbResize_Change"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


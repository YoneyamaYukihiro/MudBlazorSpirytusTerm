    Private Function prvblnApcClear_Chk() As Boolean

        Dim llngMsgAns              As Integer  'ﾒｯｾｰｼﾞ応答戻り値
        
        Try
            
            '@変更NG
            prvblnApcClear_Chk = False
            
            With vsfFlowList0
               
                '@APC設定が設定済みの場合
                If .GetData(.Row, CPlngvsfFlowApc) <> vbNullString Then
                
                    '@ﾒｯｾｰｼﾞ
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005H)
                    

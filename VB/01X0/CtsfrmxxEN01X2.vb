                            End If
                        End With
                        
                    Case CPlngvsfFlowTimeLimit          '時間制限
                        
                        '@ｺﾋﾟｰ元の場合は処理不可
                        If sender Is vsfFlowList1 Then
                            Exit Sub
                        End If
                        
                        '@単一選択されているｾﾙの内容ﾁｪｯｸ
                        If .GetData(.Row, CPlngvsfFlowTimeLimit) <> vbNullString Then
                            '@時間制限ﾎﾞﾀﾝｸﾘｯｸ
                            Call cmdTimeLimitSet_Click(cmdTimeLimitSet,New EventArgs)
                        End If
                        
                    Case CPlngvsfFlowReworkRouteID      'ﾘﾜｰｸﾙｰﾄID
                        
                        '@ｺﾋﾟｰ元の場合は処理不可
                        If sender Is vsfFlowList1 Then
                            Exit Sub
                        End If
                            
                        '@既流動ではない場合
                        If .GetCellRange(.Row, CPlngvsfFlowReworkRouteID).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorGray) Then
                            
                            '@既にﾊﾞｯｸｶﾗｰが変更されている場合には,白にしない
                            If .GetCellRange(.Row, CPlngvsfFlowReworkRouteID).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorSBlue) Then
                                '@ﾊﾞｯｸｶﾗｰを白へ変更
                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_vbWhite")
                                newStyle.BackColor = Color.White
                                Dim cellRange As CellRange = .GetCellRange(.Row, CPlngvsfFlowReworkRouteID)

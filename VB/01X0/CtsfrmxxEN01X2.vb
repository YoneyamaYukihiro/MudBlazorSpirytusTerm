    '備　考：
    Private Sub prvLotScrapSetIDList_Disp(ByRef ltypMasScrapSetIdList As MasScrapSetIdList)

        Dim llngCnt As Integer 'ｶｳﾝﾀ
        Dim llngRow As Integer 'NSYS 行ｶｳﾝﾀ

        Try

            With vsfLotScrapSetID
                RemoveHandler vsfLotScrapSetID.RowColChange,AddressOf vsfLotScrapSetID_RowColChange
                .Row = -1

                'ﾛｯｸ解除
                .Enabled = True

                '@描画なし

    '関数名：cmdLotEntry_Click
    '機　能：ﾛｯﾄ工順ｺﾋﾟｰﾎﾞﾀﾝｸﾘｯｸ
    '引　数：なし
    '戻り値：なし
    '作成日：2006/06/28 (Wed) 11:40:46 N.Kasai
    '更新日：2006/06/28 (Wed) 11:40:46
    '備　考：
    Private Sub cmdLotEntry_Click(ByVal sender As Object, ByVal e As EventArgs) Handles cmdLotEntry.Click
        
        Dim ltypFlowListReq         As ProcFlowListReq      'ﾌﾛｰﾘｽﾄ（要求）
        Dim ltypFlowListCp          As ProcFlowListAns      'ﾌﾛｰﾘｽﾄ（応答）
        Dim ltypCondDetailListCp    As ProcCondDetailList   '処理条件格納
        Dim lblnAns                 As Boolean              '汎用戻り値
        Dim lstrEventName           As String               'ﾚｽﾎﾟﾝｽ用
        Dim llngCnt                 As Integer              'ｶｳﾝﾀ
        Dim llngRow                 As Integer              '行ｶｳﾝﾀ
        Dim ltypEN01X4              As EN01X4               '引継ぎ構造体
        Dim ltypeReportPoint        As ReportPoint          '実績報告工程(空で渡すためのダミー)


        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            '@ｺﾋﾟｰ元ﾛｯﾄ工順選択画面起動
            frmxxEN01X7.Instance.ShowDialog(Me)
            frmxxEN01X7.Instance = Nothing
            
            '@戻り値判定
            If ptypEN01X7.strLotID = vbNullString Then
                Exit Sub
            End If
            
            '@引継ぎ構造体のｸﾘｱ
            ptypEN01X4 = ltypEN01X4
            
            '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞ表示
            vsfFlowList1.Visible = True
            vsfFlowList1.Enabled = True
            
            '@ｺﾋﾟｰ工順非表示ﾎﾞﾀﾝ使用可
            cmdEntryDisp.Enabled = True
            
            '@表示比率ｺﾝﾎﾞ表示
            cmbResize.Visible = True
             
            '@ﾚｽﾎﾟﾝｽ取得ｽﾀｰﾄ
            lstrEventName = "cmdLotEntry_Click"
            Call pubResponseStart(Me.Name, lstrEventName)
            
            With ltypFlowListReq
                .strSbID = pstrSBID
                .strMsgVer = CMstrprocprocflowlistVer
                .strLotID = ptypEN01X7.strLotID
                .strTravelerType = CMTravelerTypeReal '(0:tmp 1:alt)
            End With
            
            '@----------------
            '@変更中工順
            '@----------------
            '@MSG【工程ﾌﾛｰ取得】
            lblnAns = pubblnProcProcFlowList_Sel(ltypFlowListReq, ltypFlowListCp)
            
            '@結果判定
            If lblnAns = True Then
                '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞ表示
        '@↓2014/01/14 (Tue) 13:19:07 T.Oide **************************************************
        '        Call prvvsfFlowList_Disp(ltypFlowListCp, 1)
                Call prvvsfFlowList_Disp(ltypFlowListCp, ltypeReportPoint, vsfFlowList1)
        '@↑2014/01/14 (Tue) 13:19:07 T.Oide **************************************************
                '@表示見出し
                lblFlowList1.Text = "【コピー元工順　ロット：" & ptypEN01X7.strLotID & " 情報取得日時：" & ptypEN01X7.strNowDate & "】"
                lblFlowList1.Visible = True
                
                '@ﾛｯﾄがﾘﾜｰｸ、特殊の場合は新規でﾘﾜｰｸﾙｰﾄ、特殊ﾙｰﾄの設定不可
                With vsfFlowList1
                    If ptypEN01X7.strProcFlag = "1" Then
                        '@ﾘﾜｰｸ、特殊関連非表示
                        .Cols(CPlngvsfFlowReworkRouteID).Visible = False
                        .Cols(CPlngvsfFlowReworkReturnOpID).Visible = False
                        .Cols(CPlngvsfFlowReworkReturnStepID).Visible = False
                        .Cols(CPlngvsfFlowSPRouteID).Visible = False
                        .Cols(CPlngvsfFlowSPReturnOpID).Visible = False
                        .Cols(CPlngvsfFlowSPReturnStepID).Visible = False
                    
                    Else
                        '@ﾘﾜｰｸ、特殊関連表示
                        .Cols(CPlngvsfFlowReworkRouteID).Visible = True
                        .Cols(CPlngvsfFlowReworkReturnOpID).Visible = True
                        .Cols(CPlngvsfFlowReworkReturnStepID).Visible = True
                        .Cols(CPlngvsfFlowSPRouteID).Visible = True
                        .Cols(CPlngvsfFlowSPReturnOpID).Visible = True
                        .Cols(CPlngvsfFlowSPReturnStepID).Visible = True
                    End If
                End With
                
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If
            
            '@----------------
            '@処理条件詳細
            '@----------------
            '@MSG【LOT処理条件詳細取得】
            lblnAns = pubblnProcCondDetailList_Sel(pstrSBID, _
                                                  CMstrprocconddetaillistVer, _
                                                  ptypEN01X7.strLotID, CMTravelerTypeReal, _
                                                  ltypCondDetailListCp)
            '@結果判定
            If lblnAns = True Then
                '@LOT処理条件詳細情報を保持
                ptypCondDetailListCp = ltypCondDetailListCp
                
                '@個別処理条件が存在する場合
                If ptypCondDetailListCp.lngProcCondDetailCnt > 0 Then
                    '@構造体格納数分検索
                    For llngCnt = 0 To ptypCondDetailListCp.lngProcCondDetailCnt -1
                        '@ﾌﾛｰﾘｽﾄ検索
                        With vsfFlowList1
                            For llngRow = 1 To .Rows.Count - 1
                                Dim typProcCondDetailTmp As ProcCondDetail = ptypCondDetailListCp.typProcCondDetail(llngCnt)
                                If ptypCondDetailListCp.typProcCondDetail(llngCnt).strOpID = .GetData(llngRow, CPlngvsfFlowOpID) And _
                                    ptypCondDetailListCp.typProcCondDetail(llngCnt).strStepID = .GetData(llngRow, CPlngvsfFlowStepID) Then
                                    
                                    '@工順番号ｾｯﾄ
                                    '@以降はこの工順番号をkeyとする。
                                    typProcCondDetailTmp.strAbsNo = .GetData(llngRow, CPlngvsfFlowAbsNo)
                                    typProcCondDetailTmp.blnEnableFlag = True    '有効ﾃﾞｰﾀ
                                    ptypCondDetailListCp.typProcCondDetail(llngCnt) = typProcCondDetailTmp

                                    Exit For
                                End If
                            Next
                        End With
                    Next
                End If
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If
            
            '@ﾚｽﾎﾟﾝｽ取得終了
            Call publngResponseEnd(Me.Name, lstrEventName)
            
            With vsfFlowList1
                '@ﾃﾞｰﾀが存在
                If .Rows.Count > 1 Then
                    '@ﾌｫｰｶｽ制御
                    .Row = 1
                    .Col = CPlngvsfFlowOpID
                    .ShowCell(.Row, .Col)
                    
                    Call pubSetFocus(vsfFlowList1)
                    
                End If
            End With
            
            '@画面ﾘｻｲｽﾞ
            Call Form_Resize(Me, e)
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "cmdEntryDisp_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Sub

    '関数名：cmdMstEntry_Click

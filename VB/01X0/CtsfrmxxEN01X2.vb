                    '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                    If llngMsgAns = vbNo Then       '「いいえ」を選択
                        Exit Function
                    End If
                     
                    '-----------------------
                    '@APC設定の削除
                    '-----------------------
                    
                    '@APC設定を削除
                    Call pubApc_Del(.GetData(.Row, CPlngvsfFlowApc))
                    
                    '@APC設定ﾎﾞﾀﾝ制御

    '------------------------------------------------------------------------------
    '関数名：SetApcTeosData
    '機　能：APC TEOSに関する情報を画面上に設定
    '引　数：nListIndex     ：処理対象のリスト番号
    '　　　：nTargetRow     ：処理対象の行数
    '　　　：oData          ：APC TEOSに関する情報
    '　　　：nKeepRow       ：保存データ(行数)
    '　　　：strKeepGroupNo ：保存データ(グループ番号)
    '戻り値：
    '作成日：2012/02/20 (Mon) 10:00:00 M.Sakka
    '更新日：2012/02/20 (Mon) 10:00:00 M.Sakka
    '備　考：
    '------------------------------------------------------------------------------
    Private Sub SetApcTeosData( _
        ByRef lvsfFlowList As C1FlexGrid, _
        ByRef nTargetRow As Integer, _
        ByRef oData As TypeApcTeos, _
        ByRef nKeepRow As Integer, _
        ByRef strKeepGroupNo As String)
        
        '常に選択不可能
        Dim newStyle As CellStyle
        Dim cellRange As CellRange
        newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray_ApcTeosGroupNo")
        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
        newStyle.TextAlign = TextAlignEnum.CenterCenter
        cellRange = lvsfFlowList.GetCellRange(nTargetRow, CPlngvsfFlowApcTeosGroupNo)
        cellRange.Style = newStyle
        newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray_ApcTeosNoInGroup")
        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
        newStyle.TextAlign = TextAlignEnum.CenterCenter
        cellRange = lvsfFlowList.GetCellRange(nTargetRow, CPlngvsfFlowApcTeosNoInGroup)
        cellRange.Style = newStyle
        newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray_ApcTeosCalcSkipFlag")
        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
        newStyle.TextAlign = TextAlignEnum.CenterCenter
        cellRange = lvsfFlowList.GetCellRange(nTargetRow, CPlngvsfFlowApcTeosCalcSkipFlag)
        cellRange.Style = newStyle
        
        'グループ番号
        'データが存在しない場合は何もしない
        If oData.strGroupNo <> vbNullString Then
            '表示はG-xxx
             lvsfFlowList.SetData(nTargetRow, CPlngvsfFlowApcTeosGroupNo, "G-" + Format(CInt(oData.strGroupNo), "000"))
        Else
            lvsfFlowList.SetData( nTargetRow, CPlngvsfFlowApcTeosGroupNo, "")
        End If
            
        'グループ内番号
        'データが存在しない場合は何もしない
        If oData.strNoInGroup <> vbNullString Then
            '表示はFB-XXX-YY
            lvsfFlowList.SetData(nTargetRow, CPlngvsfFlowApcTeosNoInGroup, "FB-" + Format(CInt(oData.strNoInGroup), "000-") + oData.strApcType)
        Else
            lvsfFlowList.SetData(nTargetRow, CPlngvsfFlowApcTeosNoInGroup, "")
        End If
                
        '工程タイプを設定
         lvsfFlowList.SetData(nTargetRow, CPlngvsfFlowApcTeosFbType, oData.strApcType)
        
        '計測工程の場合はそのグループ番号をキープ
        If oData.strApcType = "M" Then
            If strKeepGroupNo <> oData.strGroupNo Then
                If strKeepGroupNo <> vbNullString Then
                    'グループ番号が変化した場合は前の設定可能が確定する
                    newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_vbWhite")
                    newStyle.BackColor = Color.White
                    cellRange = lvsfFlowList.GetCellRange(nKeepRow, CPlngvsfFlowApcTeosCalcSkipFlag)
                    cellRange.Style = newStyle
                End If
            End If
            
            '値を保持
            nKeepRow = nTargetRow
            strKeepGroupNo = oData.strGroupNo
        End If
                
        '設定状態を画面に反映
        If oData.strCalcSkipFlag <> "0" Then
            lvsfFlowList.SetData(nTargetRow, CPlngvsfFlowApcTeosCalcSkipFlag, CMstrFlgOn)
        Else
            lvsfFlowList.SetData(nTargetRow, CPlngvsfFlowApcTeosCalcSkipFlag, CMstrFlgOff)
        End If
        
        
    End Sub


    '機　能：ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【TPAL設定】
    '引　数：なし
    '戻り値：なし
    '作成日：2009/05/19 (Tue) 19:05:37 Y.Yoneyama
    '更新日：2012/03/14 (Wed) 11:22:43 Y.Yoneyama
    '備　考：2012/03/14 (Wed) 11:22:43 Y.Yoneyama   表面処理ﾊﾞｯﾁ制限対応
    Private Sub mnu8_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu8.Opening
        
        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            With vsfFlowList0
            
                '@大工程、小工程、処理条件が未設定の場合は設定させない。
                If .GetData(mlngWkRow, CPlngvsfFlowOpID) = vbNullString Or _
                    .GetData(mlngWkRow, CPlngvsfFlowStepID) = vbNullString Or _
                    .GetData(mlngWkRow, CPlngvsfFlowConditionID) = vbNullString Then
                    
                    '@ﾒﾆｭｰ制限
                    mnu81.Enabled = False       '蒸着ﾊﾞｯﾁ貼合
                    mnu82.Enabled = False       '蒸着左貼合
                    mnu83.Enabled = False       '蒸着右貼合
                    mnu84.Enabled = False       '蒸着ﾊﾞｯﾁ+左貼合
                    mnu85.Enabled = False       '蒸着ﾊﾞｯﾁ+右貼合
                    mnu86.Enabled = False       '設定なし
                    mnu87.Enabled = False       '表面ﾊﾞｯﾁ貼合
            
                    Exit Sub
                End If
                
                '@ﾒﾆｭｰ制限
                mnu81.Enabled = True            '蒸着ﾊﾞｯﾁ貼合
                mnu82.Enabled = True            '蒸着左貼合
                mnu83.Enabled = True            '蒸着右貼合
                mnu84.Enabled = True            '蒸着ﾊﾞｯﾁ+左貼合
                mnu85.Enabled = True            '蒸着ﾊﾞｯﾁ+右貼合
                mnu86.Enabled = True            '設定なし
                mnu87.Enabled = True            '表面ﾊﾞｯﾁ貼合
                
                '@選択ｾﾙの入力状態をﾁｪｯｸ
                Select Case .GetData(mlngWkRow, mlngWkCol)
                
                    Case CPstrTpalJBatchName
                        mnu81.Enabled = False   '蒸着ﾊﾞｯﾁ貼合
                    
                    Case CPstrTpalJLeftName
                        mnu82.Enabled = False   '蒸着左貼合
                    
                    Case CPstrTpalJRightName
                        mnu83.Enabled = False   '蒸着右貼合
                    
                    Case CPstrTpalJBatchLeftName
                        mnu84.Enabled = False   '蒸着ﾊﾞｯﾁ+左貼合
                    
                    Case CPstrTpalJBatchRightName
                        mnu85.Enabled = False   '蒸着ﾊﾞｯﾁ+右貼合
                    
                    Case vbNullString
                        mnu86.Enabled = False   '設定なし
                        
                    Case CPstrTpalHBatchName
                        mnu87.Enabled = False   '表面ﾊﾞｯﾁ貼合
                        
                End Select
                
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu8_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Sub


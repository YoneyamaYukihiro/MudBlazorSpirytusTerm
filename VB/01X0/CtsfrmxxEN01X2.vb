    '関数名：cmdApcSet_Click
    '機　能：APC設定画面の表示
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/22 (Mon) 12:39:19 N.Kasai
    '更新日：2017/02/17 (Fri) 15:28:50 T.Oide
    '備　考：
    Private Sub cmdApcSet_Click(ByVal sender As Object, ByVal e As EventArgs) Handles cmdApcSet.Click

        Dim llngCnt                 As Integer          'ｶｳﾝﾀ
        Dim llngCnt2                As Integer          'ｶｳﾝﾀ

        Dim ltypApcOpStepInfo       As ApcOpStepInfo    'APC設定引渡し格納構造体
        Dim llngFBcnt               As Integer          'FBｶｳﾝﾄ
        Dim llngFFcnt               As Integer          'FFｶｳﾝﾄ
        Dim llngAns                 As Integer          '戻り値
        Dim llngAryCount            As Integer          '配列ｶｳﾝﾀ
        Dim lstrAry()               As String           'ｾﾙ内配列
        Dim llngAryCount2           As Integer          '配列ｶｳﾝﾀ
        Dim lstrAry2()              As String           'ｾﾙ内配列
    '@↓2017/02/17 (Fri) 15:28:44 T.Oide **************************************************
        Dim lblnPatchDivFlag        As Boolean  'ﾌｫﾄFB(合わせ)のpatch分割ありﾌﾗｸﾞ
        Dim llngCntPatchDiv         As Integer
        Dim lstrTmpOpID             As String
        Dim lstrTmpStepId           As String
        Dim lstrSearchString        As String
        Dim llngFindRow             As Integer
    '@↑2017/02/17 (Fri) 15:28:44 T.Oide **************************************************
        
        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            '@編集中工順変更ﾘｽﾄより全件検索
            With vsfFlowList0

                '@選択行が見出しの場合
                If .Row < 1 Then
                    Exit Sub
                End If
            
                '@工順変更編集で削除する場合がある。
                '@構造体を都度再取得する必要がある。（初期化）
                ptypApcOpStepInfo = ltypApcOpStepInfo
                
                llngFBcnt = 0   'FBｶｳﾝﾄ
                llngFFcnt = 0   'FFｶｳﾝﾄ
                '@----------------------------------------------------------
                '@現在(2006/06/02)
                '@APC設定は2種類（index=1:ﾌｫﾄ/index=2:ｺﾝﾀｸﾄｴｯﾁｬｰ）
                '@当面追加となることはないらしい。
                '@もし追加となる場合は「.lngApcTypeCnt = 2」を変更してね。
                '@----------------------------------------------------------
                With ptypApcOpStepInfo
                    '@格納ｴﾘｱ確保
                    .lngApcTypeCnt = 2
                    If .typApcTypeList Is Nothing Then
                        .typApcTypeList = New List(Of ApcTypeList)
                    Else
                        .typApcTypeList.Clear
                    End If
                    Do While (.typApcTypeList.Count < .lngApcTypeCnt)
                        .typApcTypeList.Add(New ApcTypeList)
                    Loop
                End With
            
                Dim typApcTypeListTmp As New ApcTypeList
                Dim typApcTypeListTmp2 As New ApcTypeList

                '@全行検索開始
                For llngCnt = 1 To .Rows.Count - 1
                
                    '@APC設定が設定済み
                    If .GetData(llngCnt, CPlngvsfFlowApc) <> vbNullString Then
                    
                        '@現在のｾﾙの値を配列に格納
                        lstrAry = Split(.GetData(llngCnt, CPlngvsfFlowApc), CMstrComma)
                        For llngAryCount = 0 To UBound(lstrAry)
                            
                            '@APCﾀｲﾌﾟを判定
                            Select Case Strings.Left$(lstrAry(llngAryCount), 2)
                            
                                '@ﾌｫﾄの場合（FB)
                                Case CMstrFBMark
                            
                                    '@最終文字列が処理ﾏｰｸ（P)
                                    '@開始工程取得
        '@↓2017/02/17 (Fri) 15:00:34 T.Oide **************************************************
        '@                            If Right$(lstrAry(llngAryCount), 1) = CPstrProcessMark Then
        '@-------------------------------------------------------------------------------------
                                    If Mid$(lstrAry(llngAryCount), 8, 1) = CPstrProcessMark Then
        '@↑2017/02/17 (Fri) 15:00:34 T.Oide **************************************************
                                           
                                        '@件数ｶｳﾝﾄ
                                        llngFBcnt = llngFBcnt + 1

                                        '@格納数
                                        typApcTypeListTmp.lngApcOpStepListCnt = llngFBcnt

                                        If typApcTypeListTmp.typApcOpStepList Is Nothing Then
                                            typApcTypeListTmp.typApcOpStepList = New List(Of ApcOpStepList)
                                        End If
                                        Dim typApcOpStepListTmp As New ApcOpStepList

                                        '@listOrder
                                        typApcOpStepListTmp.strListOrder = _
                                            Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo3)
                                        '@fromOpId
                                        typApcOpStepListTmp.strFromOpId = _
                                            .GetData(llngCnt, CPlngvsfFlowOpID)
                                        '@fromStepId
                                        typApcOpStepListTmp.strFromStepId = _
                                            .GetData(llngCnt, CPlngvsfFlowStepID)
                                        
        '@↓2017/02/17 (Fri) 15:26:03 T.Oide **************************************************
                                        '@ﾌｫﾄF/B(合せ)Patch分割ありの設定かを格納しておく
                                        '@設定が9文字か(FB-XXX-PN)
                                        If Len(lstrAry(llngAryCount)) = CPlngFotoFBAwasePatchDivMaxNum Then
                                            lblnPatchDivFlag = True
                                        Else
                                            lblnPatchDivFlag = False
                                        End If
        '@↑2017/02/17 (Fri) 15:26:03 T.Oide **************************************************
                                        
        '@↓2017/02/17 (Fri) 15:31:43 T.Oide **************************************************
        '@                                '@最終文字列が測定ﾏｰｸ（M)
        '@                                '@測定工程に複数の測定Mは存在しない。（2007/09/26　現仕様）
        '@                                '@終了工程取得
        '@                                llngAns = .FindRow(Left$(lstrAry(llngAryCount), 7) & CPstrMeasureMark, , CPlngvsfFlowApc)
        '@                                '@検索結果判定
        '@                                If llngAns <> -1 Then
        '@                                    '@toOpId
        '@                                    ptypApcOpStepInfo.typApcTypeList(1).typApcOpStepList(llngFBcnt).strToOpID = _
        '@                                        .Cell(flexcpText, llngAns, CPlngvsfFlowOpID)
        '@                                    '@toStepId
        '@                                    ptypApcOpStepInfo.typApcTypeList(1).typApcOpStepList(llngFBcnt).strToStepID = _
        '@                                        .Cell(flexcpText, llngAns, CPlngvsfFlowStepID)
        '@                                End If
        '@------------------------------------------------------------------------------------

                                        '@ﾌｫﾄF/B(合わせ)Patch分割なしか
                                        If lblnPatchDivFlag = False Then
                                            '@通常のAPC設定の場合
                                            
                                            '@検索文字と一致する文字列を検索("FF(FB)-XXX-M")
                                            llngFindRow = .FindRow(Strings.Left$(lstrAry(llngAryCount), 7) & CPstrMeasureMark, .Rows.Fixed, CPlngvsfFlowApc, False)
                                            
                                            '@一致行があったか
                                            If llngFindRow <> -1 Then
                                                '@あった場合
                                                
                                                '@測定大工程、測定小工程を格納
                                                typApcOpStepListTmp.strToOpId = _
                                                    .GetData(llngFindRow, CPlngvsfFlowOpID)                                '測定大工程
                                                typApcOpStepListTmp.strToStepId = _
                                                    .GetData(llngFindRow, CPlngvsfFlowStepID)                              '測定小工程
                                            End If

                                            typApcTypeListTmp.typApcOpStepList.Add(typApcOpStepListTmp)

                                             ptypApcOpStepInfo.typApcTypeList(0) = typApcTypeListTmp
                                        Else
                                            '@ﾌｫﾄF/B(合わせ)Patch分割あり設定
                                            
                                            '@ﾊﾟｯﾁ分割ﾌﾗｸﾞｾｯﾄ
                                            typApcOpStepListTmp.blnPatchFlag = True

                                            typApcTypeListTmp.typApcOpStepList.Add(typApcOpStepListTmp)

                                             ptypApcOpStepInfo.typApcTypeList(0) = typApcTypeListTmp

                                            '@Patch分割の設定のMax9まで測定行程があるか探す
                                            For llngCntPatchDiv = 1 To CPlngFotoFBAwasePatchDivMaxNum

                                                '@対応する測定行程を検索するため検索文字の作成("FF(FB)-XXX-MN")
                                                lstrSearchString = Strings.Left$(lstrAry(llngAryCount), 7) & CPstrMeasureMark & llngCntPatchDiv

                                                '@検索文字と一致する文字列を検索
                                                llngFindRow = .FindRow(lstrSearchString, .Rows.Fixed, CPlngvsfFlowApc, False)

                                                '@一致行があったか
                                                If llngFindRow <> -1 Then
                                                    '@あった場合

                                                    lstrTmpOpID = .GetData(llngFindRow, CPlngvsfFlowOpID)
                                                    lstrTmpStepId = .GetData(llngFindRow, CPlngvsfFlowStepID)

                                                    '@測定行程の値をｾｯﾄ
                                                    Call setPtypApcOpStepListMesureVal(llngFBcnt -1, llngCntPatchDiv, lstrTmpOpID, lstrTmpStepId)

                                                End If
                                            Next
                                        End If
        '@↑2017/02/17 (Fri) 15:31:43 T.Oide **************************************************
                                        
                                                                                
                                    End If
                                                                      

                                '@ｺﾝﾀｸﾄｴｯﾁｬｰの場合
                                Case CMstrFFMark
                            
                                    '@最終文字列が測定ﾏｰｸ（M)
                                    '@開始工程取得
                                    If Strings.Right$(lstrAry(llngAryCount), 1) = CPstrMeasureMark Then
                                                 
                                        '@件数ｶｳﾝﾄ
                                        llngFFcnt = llngFFcnt + 1

                                        '@格納数
                                        typApcTypeListTmp2.lngApcOpStepListCnt = llngFFcnt
                                        If typApcTypeListTmp2.typApcOpStepList Is Nothing Then
                                            typApcTypeListTmp2.typApcOpStepList = New List(Of ApcOpStepList)
                                        End If
                                        Dim typApcOpStepListTmp As New ApcOpStepList
                                        
                                        typApcOpStepListTmp.strListOrder = _
                                            Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo3)
                                        
                                        typApcOpStepListTmp.strFromOpId = _
                                            .GetData(llngCnt, CPlngvsfFlowOpID)
                                        
                                        typApcOpStepListTmp.strFromStepId = _
                                            .GetData(llngCnt, CPlngvsfFlowStepID)
                                    
                                        '@最終文字列が処理ﾏｰｸ（P)
                                        '@終了工程取得
                                        llngAns = .FindRow(Strings.Left$(.GetData(llngCnt, CPlngvsfFlowApc), 7) & CPstrProcessMark, .Rows.Fixed, CPlngvsfFlowApc, False)
                                        
                                        llngAns = -1
                                        
                                        For llngCnt2 = 1 To .Rows.Count - 1
                                            If .GetData(llngCnt2, CPlngvsfFlowApc) <> vbNullString Then
                                                '@現在のｾﾙの値を配列に格納
                                                lstrAry2 = Split(.GetData(llngCnt2, CPlngvsfFlowApc), CMstrComma)
                                                For llngAryCount2 = 0 To UBound(lstrAry2)
                                                
                                                    If Strings.Left$(.GetData(llngCnt, CPlngvsfFlowApc), 7) & CPstrProcessMark _
                                                        = lstrAry2(llngAryCount2) Then
                                                        llngAns = llngCnt2
                                                        Exit For
                                                    End If
                                                
                                                Next
                                                
                                            
                                            End If
                                        Next
                                        
                                        Erase lstrAry2
                                        
                                        '@検索結果判定
                                        If llngAns <> -1 Then
                                        
                                            typApcOpStepListTmp.strToOpId = _
                                                .GetData(llngAns, CPlngvsfFlowOpID)
                                            
                                            typApcOpStepListTmp.strToStepId = _
                                                .GetData(llngAns, CPlngvsfFlowStepID)
                                        End If
                                        typApcTypeListTmp2.typApcOpStepList.Add(typApcOpStepListTmp)
                                        
                                    End If

                                    ptypApcOpStepInfo.typApcTypeList(1) = typApcTypeListTmp2
                            End Select
                            
                        Next
                        Erase lstrAry
                    End If
                    
                Next
                If ptypApcOpStepInfo.strListOrderNow Is Nothing Then
                    ptypApcOpStepInfo.strListOrderNow = New List(Of String)
                Else
                    ptypApcOpStepInfo.strListOrderNow.Clear
                End If
                

                
                '@該当工程指定の場合
                If .GetData(.Row, CPlngvsfFlowApc) <> vbNullString Then
                
                    '@現在のｾﾙの値を配列に格納
                    lstrAry = Split(.GetData(.Row, CPlngvsfFlowApc), CMstrComma)
                    For llngAryCount = 0 To UBound(lstrAry)
                        ptypApcOpStepInfo.strListOrderNow.Add(
                            Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo3))
                    Next
                               
                    '@現在選択中のAPCﾀｲﾌﾟを判定
                    Select Case Strings.Left$(.GetData(.Row, CPlngvsfFlowApc), 2)
                    
                        Case CMstrFBMark
                            ptypApcOpStepInfo.strApcTypeNow = CMstrApcTypeFB    '1
                        
                        Case CMstrFFMark
                            ptypApcOpStepInfo.strApcTypeNow = CMstrApcTypeFF    '2
                     
                    End Select
                    
                    Erase lstrAry
                Else
                    ptypApcOpStepInfo.strApcTypeNow = vbNullString
                End If
                
            End With
            
            '@APC設定画面の表示
            frmxxEN01X6.Instance.ShowDialog(Me)
            frmxxEN01X6.Instance = Nothing

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "cmdApcSet_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


            '@引継ぎ構造体のｸﾘｱ
            ptypEN01X7 = ltypEN01X7
            
            '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞ表示
            vsfFlowList1.Visible = True
            cmbResize.Visible = True
            cmdEntryDisp.Enabled = True
            
            '@ﾚｽﾎﾟﾝｽ取得ｽﾀｰﾄ
            lstrEventName = "cmdMstEntry_Click"
            Call pubResponseStart(Me.Name, lstrEventName)
            
            '@要求格納
            With ltypMstFlowListReq
                .strSbID = pstrSBID
                .strMsgVer = CMstrmas_procflowlistVer
                .strPdId = ptypEN01X4.strPdId
                .strEntryID = ptypEN01X4.strEntryID
            End With
            
            '@----------------
            '@ﾏｽﾀ工順ﾌﾛｰ
            '@----------------
            '@MSG【ﾏｽﾀ工程ﾌﾛｰ取得】
            lblnAns = pubblnMasProcFlowList_Sel(ltypMstFlowListReq, ltypMstFlowListAns)
            
            '@結果判定
            If lblnAns = True Then
                '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞ表示
                Call prvvsfMstFlowList_Disp(ltypMstFlowListAns)
                '@見出しの表示
                lblFlowList1.Text = "【コピー元工順　機種：" & ptypEN01X4.strPdId & " 適用日時：" & ptypEN01X4.strEntryTime & " エントリ:" & ptypEN01X4.strEntryID & "】"
                lblFlowList1.Visible = True
                
                With vsfFlowList1
                    '@見出しのﾊﾞｯｸｶﾗｰ、文字色を初期値へ
                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CPlngBlueColor")
                    newStyle.BackColor = ColorTranslator.FromWin32(CPlngBlueColor)
                    newStyle.ForeColor = Color.Yellow
                    Dim cellRange As CellRange = .GetCellRange(CMlngvsfListRowTitle, CPlngvsfFlowReworkRouteID, CMlngvsfListRowTitle, CPlngvsfFlowReworkRouteID)
                    cellRange.Style = newStyle

                    Dim newStyle2 As CellStyle = .Styles.Add("CustomStyle_BackColor_CPlngBlueColor")
                    newStyle2.BackColor = ColorTranslator.FromWin32(CPlngBlueColor)
                    newStyle2.ForeColor = Color.Yellow
                    Dim cellRange2 As CellRange = .GetCellRange(CMlngvsfListRowTitle, CPlngvsfFlowSPRouteID, CMlngvsfListRowTitle, CPlngvsfFlowSPRouteID)
                    cellRange2.Style = newStyle2

                End With
                
            Else
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Sub
            End If
               
            '@ﾚｽﾎﾟﾝｽ終了
            Call publngResponseEnd(Me.Name, lstrEventName)
            
            With vsfFlowList1
                '@ﾃﾞｰﾀが存在
                If .Rows.Count > 1 Then
                    '@ﾌｫｰｶｽ制御
                    .Row = 1
                    .Col = CPlngvsfFlowOpID
                    .ShowCell(.Row, .Col)
                    
                    Call pubSetFocus(vsfFlowList1)
                    
                End If
            End With
            
            '@画面ﾘｻｲｽﾞ
            Call Form_Resize(Me, e)
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "cmdMstEntry_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：Form_Resize
    '機　能：画面ﾘｻｲｽﾞ
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/09 (Tue) 14:59:06 N.Kasai
    '更新日：2018/03/16 (Fri) 13:42:29 T.Oide
    '備　考：
    Private Sub Form_Resize(ByVal sender As Object, ByVal e As EventArgs) Handles MyBase.Resize

        Dim llngCmdLeft                 As Integer  'ﾎﾞﾀﾝの左位置(確定)
        Dim llngCmdSave1Left            As Integer  'ﾎﾞﾀﾝの左位置(一時保存)
        Dim llngCmdEditStartLeft        As Integer  'ﾎﾞﾀﾝの左位置(編集開始)
        Dim llngCmdTop                  As Integer  'ﾎﾞﾀﾝの上位置
        Dim llngvsfPCWidth              As Integer  'ﾌﾟﾛｾｽﾌﾛｰの幅
        Dim llngvsfPCHeight             As Integer  'ﾌﾟﾛｾｽﾌﾛｰの高さ
        Dim llnginPanelfraHeight        As Integer  '設定画面内ﾌﾚｰﾑの高さ
        Dim llnginPanelonCatvsfHeight   As Integer  '設定画面内ﾘｽﾄの高さ（ｶﾃｺﾞﾘあり）
        Dim llnginPanelvsfHeight        As Integer  '設定画面内ﾘｽﾄの高さ（ｶﾃｺﾞﾘなし）
        Dim llngChangeWidth             As Integer  'ﾘｻｲｽﾞ幅
        Dim llngChangeHeight            As Integer  'ﾘｻｲｽﾞ高さ
    '@↓2018/03/16 (Fri) 13:06:42 T.Oide **************************************************
        Dim llngCmdSpcSkipChkLeft       As Integer  'ﾎﾞﾀﾝの左位置(SPCｽｷｯﾌﾟ)
        Dim llngCmdserchSettingLeft     As Integer  'ﾎﾞﾀﾝの左位置(設定値検索)
    '@↑2018/03/16 (Fri) 13:06:42 T.Oide **************************************************
        
        Try
            If Me.WindowState = FormWindowState.Normal Then
                '@ﾌｫｰﾑの幅が標準より小さくされたら元に戻す
                If Me.Width < CMlngFormWidth Then
                    Me.Width = CMlngFormWidth
                    Exit Sub
                End If
            
                '@ﾌｫｰﾑの高さが標準より小さくされたら元に戻す
                If Me.Height < CMlngFormHeight Then
                    Me.Height = CMlngFormHeight
                    Exit Sub
                End If
            End If

            '@ﾎﾞﾀﾝの左位置を取得
        '@↓2018/03/16 (Fri) 13:04:46 T.Oide **************************************************

    '関数名：cmbOpCategory_Validate
    '機　能：大工程ｶﾃｺﾞﾘ処理
    '引　数：Cancel：未使用
    '戻り値：なし
    '作成日：2006/05/26 (Fri) 09:19:34 N.Kasai
    '更新日：2006/05/26 (Fri) 09:19:34
    '備　考：
    Private Sub cmbOpCategory_Validate(ByVal sender As Object, ByVal e As CancelEventArgs) Handles cmbOpCategory.Validating
        
        Dim ltypMasOpList   As MasOpList    '取得情報格納
        Dim lblnAns         As Boolean      '戻り値
        Dim lstrEventName   As String       'ｲﾍﾞﾝﾄ名格納（ﾚｽﾎﾟﾝｽ用）
        
        Try

            'NSYS 画面を閉じる場合は処理を抜ける
            If mblnWindowClose = True Then
                Exit Sub
            End If

            '@--------------------------------------------------------------
            '@大工程ｶﾃｺﾞﾘ変更なし
            '@--------------------------------------------------------------
            If mstrOpCategory = cmbOpCategory.Text Then
                If ActiveControl.Name = cmbOpCategory.Name Then
                    '@ﾌｫｰｶｽ制御
                    If vsfOpList.Rows.Count > 1 Then
                        '@ﾘｽﾄが存在する場合
                        '@ﾌｫｰｶｽｾｯﾄ
                        Call pubSetFocus(vsfOpList)
                    Else
                        '@ﾘｽﾄが存在しない場合
                        Call pubSetFocus(cmbOpCategory)
                    End If
                End If

                Exit Sub
                
            End If
            '@--------------------------------------------------------------
            '@大工程ｶﾃｺﾞﾘが変更されていたら
            '@--------------------------------------------------------------

            '@ﾚｽﾎﾟﾝｽ取得開始
            lstrEventName = "cmbOpCategory_Validate"
            Call pubResponseStart(Me.Name, lstrEventName)
            
            '@現在の大工程ｶﾃｺﾞﾘを格納
            mstrOpCategory = cmbOpCategory.Text

            '@大工程ｶﾃｺﾞﾘ/大工程名の選択処理
            With vsfOpList
                '@初期化
                .Rows.Count = .Rows.Fixed
                
                '@ｺﾝﾎﾞ選択条件の判定
                If cmbOpCategory.Text = CMstrAllCategory Then
                    '@（すべて）の場合
                    '@MSG【大工程ﾏｽﾀ取得】（CPstrCD02：全件）
                    lblnAns = pubblnMasUseOpList_Sel(pstrSBID, CMstrmas_useoplistVer, CPstrCD02, ltypMasOpList)
                Else
                    '@ｶﾃｺﾞﾘ指定の場合
                    '@MSG【大工程ﾏｽﾀ取得】（CPstrCD2M：ｶﾃｺﾞﾘID指定）
                    lblnAns = pubblnMasUseOpList_Sel(pstrSBID, CMstrmas_useoplistVer, CPstrCD2M, ltypMasOpList, , mstrOpCategory)
                End If
                
                '@MSG[大工程取得]の結果判定
                If lblnAns = False Then
                '@大工程取得に失敗
                    '@ﾚｽﾎﾟﾝｽｷｬﾝｾﾙ
                    Call pubResponseCancel(Me.Name, lstrEventName)
                    
                    Exit Sub
                End If

                '@MSG[大工程取得]での取得情報を表示
                Call prvvsfOpList_Disp(ltypMasOpList, cmbOpCategory.Text)
            
                '@有効ﾁｪｯｸによる処理判別
                If chkValidOpID.Checked = True Then
                    '@有効の場合
                    Call prvvsfEditLsit_Proc(vsfOpList, True)
                Else
                    '@無効の場合
                    Call prvvsfEditLsit_Proc(vsfOpList, False)
                End If
            
                '@ﾌｫｰｶｽの制御
                If .Rows.Count > 1 Then
                    If ActiveControl.Name = cmbOpCategory.Name Then
                        '@ﾘｽﾄが存在する場合
                        Call pubSetFocus(vsfOpList)
                    End If
                    .Col = 0
                    .Row = 1
                    '@1行目を選択状態
                    .ShowCell(.Row, .Col)           '@ﾌｫｰｶｽｾｯﾄ
                Else
                    If ActiveControl.Name = cmbOpCategory.Name Then
                        '@ﾘｽﾄが存在しない場合
                        Call pubSetFocus(cmbOpCategory)
                    End If
                End If
            
            End With

            '@ﾚｽﾎﾟﾝｽ取得終了
            Call publngResponseEnd(Me.Name, lstrEventName)
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "cmbOpCategory_Validate"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：chkValidOpID_Click
    '機　能：大工程　有効のみﾁｪｯｸ
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/26 (Fri) 09:56:22 N.Kasai
    '更新日：2006/05/26 (Fri) 09:56:22
    '備　考：
    Private Sub chkValidOpID_Click(ByVal sender As Object, ByVal e As EventArgs) Handles chkValidOpID.CheckedChanged

        Dim llngCnt         As Integer      '汎用ｶｳﾝﾀ
        
        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            '@ｶﾃｺﾞﾘｺﾝﾎﾞが未選択の場合
            If cmbOpCategory.ListIndex = -1 Then
                Exit Sub
            End If
            
            With vsfOpList
                
                '@大工程ﾘｽﾄが存在しない場合
                If .Rows.Count < 1 Then
                    Exit Sub
                End If
                        
                '@有効ﾁｪｯｸによる処理判別
                If chkValidOpID.Checked = CMlngValid Then
                '@有効の場合
                    Call prvvsfEditLsit_Proc(vsfOpList, True)
                Else
                '@無効の場合
                    Call prvvsfEditLsit_Proc(vsfOpList, False)
                End If
                
                '@ﾁｪｯｸを切り替えることで,選択行を表示されている1行目へ
                If .Rows.Fixed <> .Rows.Count Then
                    
                    '@選択行を初期化
                    .Row = .Rows.Fixed
                    
                    For llngCnt = .Rows.Fixed To .Rows.Count - 1
                        '@隠し行でない場合
                        If .Rows(llngCnt).Visible = True Then
                            '@選択状態にして,表示
                            .Row = llngCnt
                            .ShowCell(llngCnt, .LeftCol)
                            
                            Exit For
                        End If
                    Next llngCnt
                End If
            
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "chkValidOpID_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：vsfOpList_DblClick
    '機　能：大工程　ﾀﾞﾌﾞﾙｸﾘｯｸ処理
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/25 (Thu) 15:37:33 N.Kasai
    '更新日：2006/05/25 (Thu) 15:37:33
    '備　考：
    Private Sub vsfOpList_DblClick(ByVal sender As Object, ByVal e As EventArgs) Handles vsfOpList.DoubleClick

        Dim lstrSendId              As String       'ﾜｰｸ文字列
        Dim lblnRtn                 As Boolean      '汎用戻り値
        Dim lstrNowOpID             As String       '変更前大工程
    '@↓2014/01/14 (Tue) 18:54:59 T.Oide **************************************************
        Dim llngMsgAns              As Integer
    '@↑2014/01/14 (Tue) 18:54:59 T.Oide **************************************************

        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            'NSYS データ行がない場合は処理を抜ける
            If vsfOpList.Rows.Count <= vsfOpList.Rows.Fixed Then
                Return
            End If
            
            With vsfOpList
            
                '@ﾍｯﾀﾞｰﾀﾞﾌﾞﾙｸﾘｯｸの場合
                If .MouseRow = 0 Then
                    Exit Sub
                End If
                
                '@一覧が存在しない場合には処理抜け
                If .Rows.Count = 1 Then
                    Exit Sub
                End If
                
                '@内容を変数に代入
                lstrSendId = .GetData(.Row, CMlngvsfOpListOpID)

                '@変数の内容ﾁｪｯｸ
                If lstrSendId = vbNullString Then
                    '@空白の場合
                    Exit Sub
                End If
                
                '@有効無効ﾁｪｯｸ：無効ﾌﾗｸﾞが立っている場合：処理を中断
                lblnRtn = prvblnvsfEditListInValid_Chk(vsfOpList, vsfOpList.Row)
                
                '@結果判定
                If lblnRtn = False Then
                    '@無効の場合
                    Exit Sub
                End If
                
                
            End With
                
            With vsfFlowList0
                
                '@編集不可工程の場合
                If .GetData(.Row, CPlngvsfFlowPermit) <> CMstrPermit1 Then
                    Exit Sub
                End If
                
                '@ﾌﾛｰﾘｽﾄ大工程と選択した大工程が同じ場合
                If .GetData(.Row, CPlngvsfFlowOpID) = lstrSendId Then
                    Exit Sub
                End If

                '@現在の大工程を退避(重複ﾁｪｯｸで引っ掛かった場合の処理の為)
                lstrNowOpID = .GetData(.Row, CPlngvsfFlowOpID)
                
                'APC TEOS制御
                Call ControlApcTeosData(vsfFlowList0, CPlngvsfFlowOpID, lstrSendId, .Row)
               
               '@選択ｾﾙの内容をﾌﾛｰﾘｽﾄ画面に渡す
                .SetData(.Row, CPlngvsfFlowOpID, lstrSendId)
                .AutoSizeCol(CPlngvsfFlowOpID, 6) '列幅自動調整
                

                '@大工程・小工程の重複ﾁｪｯｸ
                lblnRtn = prvblnOpStepIDDouble_Chk
                '@重複ﾁｪｯｸ判定
                If lblnRtn = False Then
                    '@退避しておいた元大工程に戻す
                    .SetData(.Row, CPlngvsfFlowOpID, lstrNowOpID)
                    Exit Sub
                End If
                
        '@↓2014/01/14 (Tue) 18:35:12 T.Oide **************************************************
                '@実績報告工程チェック
                lblnRtn = prvblnReportpoint_Chk(.Row)
                
                '@判定
                If lblnRtn = True Then
                
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar0126, CMstrChangAction, Me.Text)
                    '@"<TRM126W>$$実績報告工程(赤字工程)を[%1]すると在庫の差異が発生します。 "
                    '　　　　　　 [%1]する場合は必ず生産管理担当者と調整のうえ実行してください。"
                    llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                    
                    '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                    If llngMsgAns = vbNo Then       '「いいえ」を選択(削除処理ｷｬﾝｾﾙ)
                    
                        '@退避しておいた元大工程に戻す
                        .SetData(.Row, CPlngvsfFlowOpID, lstrNowOpID)
                        Exit Sub
                    End If
                End If
        '@↑2014/01/14 (Tue) 18:35:12 T.Oide **************************************************
                
                '@APC削除ﾁｪｯｸ
                lblnRtn = prvblnApcClear_Chk
                '@ﾁｪｯｸ判定
                If lblnRtn = False Then
                    '@退避しておいた元大工程に戻す
                    .SetData(.Row, CPlngvsfFlowOpID, lstrNowOpID)
                    Exit Sub
                End If
            
                '@ﾊﾞｯｸｶﾗｰを変更
                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                Dim cellRange As CellRange = .GetCellRange(.Row, CPlngvsfFlowOpID)
                cellRange.Style = newStyle
                .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                
                '@Discon情報反映
                If vsfOpList.GetData(vsfOpList.Row, CMlngvsfOpListStatus) = CMstrValid Then    '状態（有効）
                    .SetData(.Row, CPlngvsfFlowOpValid, CMlngValid)       '有効
                Else
                    .SetData(.Row, CPlngvsfFlowOpValid, CMlngInValid)     '無効
                End If
                
                If vsfFlowList1.Visible = True Then
                    .HighLight = HighLightEnum.Always
                     vsfFlowList1.HighLight = HighLightEnum.Never
                End If
                
                
                '@ｾﾙの移動
                .Col = CPlngvsfFlowOpID
                .ShowCell(.Row, CPlngvsfFlowOpID)

                '@変更ﾌﾗｸﾞｵﾝ
                pblnEN01X2Edit = True
             
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "vsfOpList_DblClick"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


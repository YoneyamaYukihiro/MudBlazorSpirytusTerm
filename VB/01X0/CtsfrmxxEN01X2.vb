        '@                                       ltypProcRegistAns, lstApcTeosStep, lstTeosPrismAPCStep)
            lblnAns = pubblnProcProcRegist_Ins(ltypProcRegistReq, ltypProcChgCollectRecp, ltypProcTimeLimitInfo, _
                                               ltypProcRegistAns, lstApcTeosStep, lstTeosPrismAPCStep, ltypRecipSelApc)
        '@↑2018/03/14 (Wed) 14:11:56 T.Oide **************************************************
            
            
            '@結果判定
            If lblnAns = False Then
                '@ﾌﾟﾛｾｽ登録に失敗

    '関数名：prvNo_Set
    '機　能：Noを振りなおす
    '引　数：なし
    '戻り値：なし
    '作成日：2006/07/12 (Wed) 10:49:22 N.Kasai
    '更新日：2006/07/12 (Wed) 10:49:22
    '備　考：
    Private Sub prvNo_Set(ByRef lvsfGrid As C1FlexGrid)

        Dim llngRow     As Integer  'ｸﾞﾘｯﾄの行
        Dim llngSeqNo   As Integer  '№
        
        
        Try
            
            If lvsfGrid.Name = vsfFlowList0.Name Then
            
                llngSeqNo = 1
                
                With lvsfGrid
                    For llngRow = 1 To .Rows.Count - 1
                        
                        If .GetData(llngRow, CPlngvsfFlowAbsNo) > 0 Or IsNothing(.GetData(llngRow, CPlngvsfFlowAbsNo))  Then
                            .SetData(llngRow, CPlngvsfFlowNo, llngSeqNo)
                            llngSeqNo = llngSeqNo + 1
                        End If
                    Next
                End With
            Else
                With lvsfGrid
                    For llngRow = 1 To .Rows.Count - 1
                        .SetData(llngRow, CPlngvsfFlowNo, llngRow)
                    Next
                End With
            End If
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvNo_Set"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvCmdUpDownDelEnabled_Set
    '機　能：移動（↑）（↓）・編集・削除ﾎﾞﾀﾝの使用許可
    '引　数：なし
    '戻り値：なし
    '作成日：2006/06/22 (Thu) 17:41:22 N.Kasai
    '更新日：2014/01/14 (Tue) 19:11:29 T.Oide
    '備　考：
    Private Sub prvCmdUpDownDelEnabled_Set(ByVal lvsfFlowList As C1FlexGrid)
        
        Dim llngRowStart As Integer 'ｽﾀｰﾄ行
        Dim llngRowEnd   As Integer 'ｴﾝﾄﾞ行
        Dim llngColStart As Integer 'ｽﾀｰﾄ列
        Dim llngColEnd   As Integer 'ｴﾝﾄﾞ列
        Dim llngRow      As Integer '行ｶｳﾝﾀ

        Try
            
            '@ｺﾋﾟｰ元の場合は処理しない
            If lvsfFlowList Is vsfFlowList1 Then
                Exit Sub
            End If
            
            '@編集ﾌﾗｸﾞ（0/未編集　1/編集中　2/編集済 3/編集開始）
            If mlngEditFlag <> 1 Then
                Exit Sub
            End If
            
            With lvsfFlowList
                '@対象行がない
                If .Rows.Count = 1 Then
                    cmdUP.Enabled = False
                    cmdDown.Enabled = False
                    cmdDel.Enabled = False
                    cmdEdit.Enabled = False
                    
                    Exit Sub
                End If
                
                
                '@編集ﾎﾞﾀﾝ制御
                Select Case .Col

                    '@行編集ﾎﾞﾀﾝの使用許可
                    Case CPlngvsfFlowOpID, _
                         CPlngvsfFlowStepID, _
                         CPlngvsfFlowConditionID, _
                         CPlngvsfFlowConditionOne, _
                         CPlngvsfFlowSelectConditionID, _
                         CPlngvsfFlowCollectionID, _
                         CPlngvsfFlowLotScrapSetId

                        cmdEdit.Enabled = True

                    '@上記以外の場合
                    Case Else
                        cmdEdit.Enabled = False
                End Select

                
                '@選択範囲の取得
                llngRowStart = .Selection.TopRow
                llngColStart = .Selection.LeftCol
                llngRowEnd = .Selection.BottomRow
                llngColEnd = .Selection.RightCol

                If llngRowStart = 0 Then
                    Exit Sub
                End If
                
                '@移動（↑）ﾎﾞﾀﾝの使用許可
                If llngRowStart = 1 Then
                    cmdUP.Enabled = False
                Else
                    '@選択範囲の直前の行が、編集可能工程以外の場合
                    If .GetData(llngRowStart - 1, CPlngvsfFlowPermit) = CMstrPermit2 Or _
                            .GetData(llngRowStart - 1, CPlngvsfFlowPermit) = CMstrPermit3 Then
                        cmdUP.Enabled = False
                    Else
                        '@R,Aﾛｯﾄの場合最終工程は変更、削除、移動不可
                        If .GetData(llngRowEnd, CPlngvsfFlowPermit) = CMstrPermit3 Then
                            cmdUP.Enabled = False
                        Else
                            cmdUP.Enabled = True
                        End If
                    End If
                    
                    '@TEOS F/B移動可否確認
                    Call prvTeosRowMoveChk(lvsfFlowList, llngRowStart, llngRowEnd, CPlngvsfFlowApcTeosGroupNo, cmdUP)

                    '@TEOS PrismAPC移動可否確認
                    Call prvTeosRowMoveChk(lvsfFlowList, llngRowStart, llngRowEnd, CPlngvsfFlowTeosPrismAPC, cmdUP)
                
        '@↓2014/01/14 (Tue) 19:10:41 T.Oide **************************************************
                    '@実績報告工程の工程跨ぎ確認
                    Call prvTeosRowMoveChk(lvsfFlowList, llngRowStart, llngRowEnd, CPlngvsfFlowReportPointFlag, cmdUP)
        '@↑2014/01/14 (Tue) 19:10:41 T.Oide **************************************************
                
                
                    'MとPの順番逆転チェック入れる (開発メモ)
                
                
                End If
                
                '@移動（↓）ﾎﾞﾀﾝの使用許可
                If llngRowEnd = .Rows.Count - 1 Then
                    cmdDown.Enabled = False
                Else
                    '@R,Aﾛｯﾄの場合最終工程は変更、削除、移動不可
                    If .GetData(llngRowEnd + 1, CPlngvsfFlowPermit) = CMstrPermit3 Then
                        cmdDown.Enabled = False
                    Else
                        '@選択範囲に編集可能工程以外が混じっていたら
                        If .GetData(llngRowStart, CPlngvsfFlowPermit) = CMstrPermit2 Or _
                                .GetData(llngRowStart, CPlngvsfFlowPermit) = CMstrPermit3 Then
                        
                            cmdDown.Enabled = False
                        Else
                            cmdDown.Enabled = True
                        End If
                    End If

                    '@TEOS F/B移動可否確認
                    Call prvTeosRowMoveChk(lvsfFlowList, llngRowStart, llngRowEnd, CPlngvsfFlowApcTeosGroupNo, cmdDown)
                    
                    '@TEOS PrismAPC移動可否確認
                    Call prvTeosRowMoveChk(lvsfFlowList, llngRowStart, llngRowEnd, CPlngvsfFlowTeosPrismAPC, cmdDown)
                    
        '@↓2014/01/14 (Tue) 19:10:41 T.Oide **************************************************
                    '@実績報告工程の工程跨ぎ確認
                    Call prvTeosRowMoveChk(lvsfFlowList, llngRowStart, llngRowEnd, CPlngvsfFlowReportPointFlag, cmdDown)
        '@↑2014/01/14 (Tue) 19:10:41 T.Oide **************************************************

                    'MとPの順番逆転チェック入れる (開発メモ)
                            
                End If
                
                '@行削除ﾎﾞﾀﾝの使用許可
                For llngRow = llngRowStart To llngRowEnd
                    '@現工程以前の場合、削除ﾎﾞﾀﾝ使用不可
                    If .GetCellRange(llngRow, CPlngvsfFlowAbsNo).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray) Then
                        cmdDel.Enabled = False
                        Exit Sub
                    End If
                Next
                cmdDel.Enabled = True
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvCmdUpDownDelEnabled_Set"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvvsfCollectionPara_Disp
    '機　能：収集項目詳細ﾘｽﾄの表示
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/26 (Fri) 15:08:16 N.Kasai
    '更新日：2006/05/26 (Fri) 15:08:16
    '備　考：
    Private Sub prvvsfCollectionPara_Disp()
        
        Dim lstrCollectionID    As String '収集項目ｾｯﾄID
        Dim lstrCollectionVer   As String '収集項目ｾｯﾄVer

        Dim llngCnt             As Integer'ｶｳﾝﾀ
        Dim llngRow             As Integer'ｶｳﾝﾀ

        Try
            
            '@収集項目一覧の場合
            With vsfCollectionList
            
                '@選択ｾﾙの内容を変数に代入
                lstrCollectionID = .GetData(.Row, CMlngvsfCollectionColID)     '収集項目ｾｯﾄID
                lstrCollectionVer = .GetData(.Row, CMlngvsfCollectionVer)      '収集項目Ver
                
                '@収集項目ﾊﾟﾗﾒｰﾀ配列から収集項目ｾｯﾄIDを検索
                For llngCnt = 0 To mtypMasProcCollectionList.lngMasProcCollectionCnt -1
                
                    '@ﾊﾟﾗﾒｰﾀを表示
                    With mtypMasProcCollectionList.typMasProcCollection(llngCnt)
                        
                        '@収集項目ｾｯﾄID&Verと一致したら
                        If .strCollectionID = lstrCollectionID And .strCollectionVersion = lstrCollectionVer Then
                            '@初期化
                            vsfCollectionPara.Rows.Count = 1
                            
                            '@件数分の行を設定
                            vsfCollectionPara.Rows.Count = .lngMasProcCollectionParaCnt + 1
                            
                            '@表示件数が0件の場合
                            If .lngMasProcCollectionParaCnt = 0 Then
                                '@ﾛｯｸ
                                vsfCollectionPara.Enabled = False
                                Exit Sub
                            End If
                            
                            '@ﾛｯｸ解除
                            vsfCollectionPara.Enabled = True
                            
                            '@描画なし
                            vsfCollectionPara.Redraw = False
                            
                            '@取得件数分だけﾙｰﾌﾟ
                            For llngRow = 1 To .lngMasProcCollectionParaCnt
                                vsfCollectionPara.SetData(llngRow, CMlngvsfCollectionDetailNo, llngRow)   '№
                                vsfCollectionPara.SetData(llngRow, CMlngvsfCollectionDetailParaID, _
                                                        .typMasProcCollectionPara(llngRow -1).strParameterID)           'ﾊﾟﾗﾒｰﾀID
                            Next

                            '@直接描画
                            vsfCollectionPara.Redraw = True
                            
                        End If
                    End With
                    
                Next
                
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvColPara_Sel"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvblnUpdate_Chk
    '機　能：一時保存・確定時ﾁｪｯｸ
    '引　数：llngIndex：ｲﾝﾃﾞｯｸｽ(1/一時保存 2/確定)
    '戻り値：True:ｴﾗｰなし　False:ｴﾗｰあり
    '作成日：2006/07/12 (Wed) 10:49:52 N.Kasai
    '更新日：2018/03/15 (Thu) 15:26:40 T.Oide
    '備　考：
    Private Function prvblnUpdate_Chk(ByVal llngIndex As Integer) As Boolean

        Dim llngCnt                 As Integer  'ｶｳﾝﾀ
        Dim llngRow                 As Integer  '行番号
        Dim llngAryCount            As Integer  '配列ｶｳﾝﾀ
        Dim lblnMatch               As Boolean  '時間制限開始・終了一致/ﾘﾜｰｸﾙｰﾄ大工程・小工程一致ﾌﾗｸﾞ
        Dim lstrSearchString        As String   '検索文字
        Dim lstrAry()               As String   'ｾﾙ内時間制限配列
        Dim lstrStartEnd            As String   '開始・終了ﾌﾗｸﾞ
        Dim lstrType                As String   '時間制限ﾀｲﾌﾟ
        Dim llngMsgAns              As Integer  'ﾒｯｾｰｼﾞ戻り値
        Dim llngFindRow             As Integer  'APC設定ﾁｪｯｸ
        Dim lstrSwapIndicator       As String   '入替設定
        Dim lblnDelFlg              As Boolean  '入替設定ﾁｪｯｸ
        Dim lblnAns                 As Boolean  '汎用戻り値
        Dim llngAryCount2           As Integer  '配列ｶｳﾝﾀ(APC)
        Dim lstrAry2()              As String   '配列(APC)
        Dim llngProcRow             As Integer  'ﾚｼﾋﾟ選択APCの設定検索用

        Try

            '@初期化
            prvblnUpdate_Chk = False

            '@ｸﾞﾘｯﾄの入力ﾁｪｯｸ
            With vsfFlowList0
            
                For llngCnt = 1 To .Rows.Count - 1
                    
                    '@共通ﾁｪｯｸ-----------------------------------------------------------------------------------------↓
                    '@大工程、小工程必須ﾁｪｯｸ
                    '@大工程、小工程重複ﾁｪｯｸ
                    
                    '@大工程名が未入力の場合
                    If .GetData(llngCnt, CPlngvsfFlowOpID) = vbNullString Then
                        '@表示ﾒｯｾｰｼﾞ変換
                        pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001L)
                        '@"<TRM1LW>$$大工程を入力してください。"
                        Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                        '@ﾌｫｰｶｽの移動
                        .Row = llngCnt
                        .Col = CPlngvsfFlowOpID
                        .ShowCell(.Row, .Col)
                        Exit Function
                    End If
                    
                    '@小工程名が未入力の場合
                    If .GetData(llngCnt, CPlngvsfFlowStepID) = vbNullString Then
                        '@表示ﾒｯｾｰｼﾞ変換
                        pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001M)
                        '@"<TRM1MW>$$小工程を入力してください。"
                        Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                        '@ﾌｫｰｶｽの移動
                        .Row = llngCnt
                        .Col = CPlngvsfFlowStepID
                        .ShowCell(.Row, .Col)
                        Exit Function
                    End If
                    
                    '@判定ﾌﾗｸﾞ初期化
                    lblnMatch = False
                    
                    '@ﾌﾟﾛｾｽｸﾞﾘｯﾄ分、以下の処理を繰り返す
                    For llngRow = 1 To .Rows.Count - 1
                        If llngRow <> llngCnt Then
                            '@大工程・小工程の組み合わせがﾌﾟﾛｾｽｸﾞﾘｯﾄ内の大工程・小工程と一致するかﾁｪｯｸ
                            If .GetData(llngCnt, CPlngvsfFlowOpID) = _
                               .GetData(llngRow, CPlngvsfFlowOpID) And _
                               .GetData(llngCnt, CPlngvsfFlowStepID) = _
                               .GetData(llngRow, CPlngvsfFlowStepID) Then
                               '@一致
                               lblnMatch = True
                               Exit For
                            End If
                        End If
                    Next
                     
                    '@一致した場合
                    If lblnMatch = True Then
                        '@重複項目に背景色をｾｯﾄ(ﾗｲﾄｸﾞﾘｰﾝ)
                        Dim cellRange As CellRange
                        Dim newStyle As CellStyle
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorLGreen")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorLGreen)
                        cellRange = .GetCellRange(llngCnt, CPlngvsfFlowOpID, llngCnt, CPlngvsfFlowStepID)
                        cellRange.Style = newStyle
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorLGreen")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorLGreen)
                        cellRange = .GetCellRange(llngRow, CPlngvsfFlowOpID, llngRow, CPlngvsfFlowStepID)
                        cellRange.Style = newStyle
                           
                        '@表示ﾒｯｾｰｼﾞ変換
                        pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar008A)
                        '@"<TRM8AW>$$大工程、小工程の組み合わせが重複しています。$設定を見直してください。（該当個所：緑色）"
                        Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                        
                        '@ﾌｫｰｶｽの移動
                        .Row = llngCnt
                        .Col = CPlngvsfFlowOpID
                        .ShowCell(.Row, .Col)
                        
                        Exit Function
                    End If
                    
                    '@特殊ﾛｯﾄの場合は時間制限のﾁｪｯｸは不可
                    If pstrEN01X0ProcFlag <> "1" Then
                    
                        '@時間制限未編集ﾁｪｯｸ
                        If .GetData(llngCnt, CPlngvsfFlowTimeLimit) <> vbNullString Then
                            
                            '@現在のｾﾙの値を配列に格納
                            lstrAry = Split(.GetData(llngCnt, CPlngvsfFlowTimeLimit), CMstrComma)
            
                            '@配列数分、以下の処理を繰り返す
                            For llngAryCount = 0 To UBound(lstrAry)
                                
                                lstrType = Strings.Left$(lstrAry(llngAryCount), 2)
                                
                                Select Case lstrType
                                
                                    '@ﾀｲﾌﾟﾌﾗｸﾞを判定
                                    Case "制1", "制2", "制3", "引1", "引2", "引3"
                                        '@ｴﾗｰなし
                                    Case Else
                                        '@未編集中の時間制限を発見
                                        '@表示ﾒｯｾｰｼﾞ変換
                                        pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005T)
                                        '@"<TRM5TI>$$終了が未設定の時間制限が存在します。$未設定の時間制限はクリアされますがよろしいですか？"
                                        llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                                        '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                                        If llngMsgAns = vbNo Then       '「いいえ」を選択(削除処理ｷｬﾝｾﾙ)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowTimeLimit
                                            .ShowCell(.Row, .Col)
                                            Exit Function
                                        End If
                                        
                                        '@設定中ﾌﾗｸﾞのﾁｪｯｸ(初期化）
                                        mlngTimeLimitFlg = 0
                                        '@時間制限の削除
                                        Call pubTimeLimitDisp_Del(Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo3))
                                        
                                End Select
                                
                            Next
                        
                            '@配列の初期化
                            Erase lstrAry
            
                        End If
                        
                    End If
                    
                    '@単独で入替え工程が設定されていないか
                    '@入替工程が設定されていたら
                    If .GetData(llngCnt, CPlngvsfFlowSwapIndictor) <> vbNullString Then
                        
                        '@既流動ではない
                        If .GetData(llngCnt, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                        
                            '@検索する入替工程を取得
                            lstrSwapIndicator = .GetData(llngCnt, CPlngvsfFlowSwapIndictor)
                            '@削除ﾌﾗｸﾞ初期化
                            lblnDelFlg = True  '削除する
                            Select Case llngCnt
                                Case 2 To .Rows.Count - 2
                                    '@入替工程が連続範囲に設定されていたら
                                    If .GetData(llngCnt - 1, CPlngvsfFlowSwapIndictor) = lstrSwapIndicator Or _
                                       .GetData(llngCnt + 1, CPlngvsfFlowSwapIndictor) = lstrSwapIndicator Then
                                        lblnDelFlg = False  '削除しない
                                    End If
                                Case 1
                                    If .Rows.Count = 2 Then
                                        '@最終行に入替え設定ありで、最終行のみ残して全行削除した場合は
                                        '@削除する。
                                    Else
                                        '@入替工程が連続範囲に設定されていたら
                                        If .GetData(llngCnt + 1, CPlngvsfFlowSwapIndictor) = lstrSwapIndicator Then
                                            lblnDelFlg = False  '削除しない
                                        End If
                                    End If
                                Case .Rows.Count - 1
                                    '@入替工程が連続範囲に設定されていたら
                                    If .GetData(llngCnt - 1, CPlngvsfFlowSwapIndictor) = lstrSwapIndicator Then
                                        lblnDelFlg = False  '削除しない
                                    End If
                            End Select
                            
                            '@削除ﾌﾗｸﾞｵﾝの場合
                            If lblnDelFlg = True Then
                               '@表示ﾒｯｾｰｼﾞ変換
                                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar008L)
                                '@"<TRM8LW>$$単独工程の入替設定はできません。$設定を見直してください。"
                                Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                '@ﾌｫｰｶｽの移動
                                .Row = llngCnt
                                .Col = CPlngvsfFlowSwapIndictor
                                .ShowCell(.Row, .Col)
                                Exit Function
                            End If
                        End If
                    End If
                    
                    
                    '@共通ﾁｪｯｸ-----------------------------------------------------------------------------------------↑
                    
                    '@登録時のみﾁｪｯｸ
                    If llngIndex = 2 Then
                    
                        '@既流動ではない
                        If .GetData(llngCnt, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                            
                            '@ﾘﾜｰｸ、特殊ﾛｯﾄの場合はﾘﾜｰｸ、特殊ﾙｰﾄの設定は行わない
                            Select Case pstrEN01X0ProcFlag
                                
                                '@ﾘﾜｰｸ、特殊流動
                                Case "1"
                                    '@ﾁｪｯｸなし
                                
                                Case Else
                                    '@ﾘﾜｰｸﾙｰﾄID、ﾘﾜｰｸﾙｰﾄ戻り大工程、ﾘﾜｰｸﾙｰﾄ戻り小工程の入力ﾁｪｯｸ
                                    If Trim(.GetData(llngCnt, CPlngvsfFlowReworkRouteID)) <> vbNullString Or _
                                       Trim(.GetData(llngCnt, CPlngvsfFlowReworkReturnOpID)) <> vbNullString Or _
                                       Trim(.GetData(llngCnt, CPlngvsfFlowReworkReturnStepID)) <> vbNullString Then
                                        
                                        '@ﾘﾜｰｸﾙｰﾄID、ﾘﾜｰｸﾙｰﾄ戻り大工程、ﾘﾜｰｸﾙｰﾄ戻り小工程のいずれかに入力がある場合
                                        '@ﾘﾜｰｸﾙｰﾄIDが未入力の場合
                                        If Trim(.GetData(llngCnt, CPlngvsfFlowReworkRouteID)) = vbNullString Then
                                            '@表示ﾒｯｾｰｼﾞ変換
                                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar006U)
                                            '@"<TRM6UW>$$リワークルートIDを選択して下さい。"
                                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowReworkRouteID
                                            .ShowCell(.Row, .Col)
                                            Exit Function
                                        End If
                        
                                        '@ﾘﾜｰｸﾙｰﾄ戻り大工程が未入力の場合
                                        If Trim(.GetData(llngCnt, CPlngvsfFlowReworkReturnOpID)) = vbNullString Then
                                            '@表示ﾒｯｾｰｼﾞ変換
                                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar006S)
                                            '@"<TRM6SW>$$リワーク戻り大工程を選択して下さい。"
                                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowReworkReturnOpID
                                            .ShowCell(.Row, .Col)
                                            Exit Function
                                        End If
                        
                                        '@ﾘﾜｰｸﾙｰﾄ戻り小工程が未入力の場合
                                        If Trim(.GetData(llngCnt, CPlngvsfFlowReworkReturnStepID)) = vbNullString Then
                                            '@表示ﾒｯｾｰｼﾞ変換
                                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar006T)
                                            '@"<TRM6TW>$$リワーク戻り小工程を選択して下さい。"
                                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowReworkReturnStepID
                                            .ShowCell(.Row, .Col)
                                            Exit Function
                                        End If
                                    End If
                                
                                    '@ﾘﾜｰｸ戻り大工程（現在行より下の工程の場合）
                                    If .GetData(llngCnt, CPlngvsfFlowReworkReturnOpID) <> vbNullString Then
                                        llngRow = .FindRow(.GetData(llngCnt, CPlngvsfFlowReworkReturnOpID), .Rows.Fixed, CPlngvsfFlowOpID, False)
                                        If llngRow > llngCnt Then

                                            '@表示ﾒｯｾｰｼﾞ変換
                                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar006Y)
                                            '@"<TRM6YW>$$このリワーク戻り大工程は指定できません。$設定を見直してください。"
                                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowReworkReturnOpID
                                            .ShowCell(.Row, .Col)
                                            Exit Function
                                        End If
                                    End If
                    
                                    '@ﾘﾜｰｸ戻り小工程（存在ﾁｪｯｸ）
                                    If Trim$(.GetData(llngCnt, CPlngvsfFlowReworkReturnStepID)) <> vbNullString Then
                                        llngRow = .FindRow(.GetData(llngCnt, CPlngvsfFlowReworkReturnStepID), .Rows.Fixed, CPlngvsfFlowStepID, False)
                                        '@小工程が存在しない場合
                                        If llngRow = -1 Then
                                            '@表示ﾒｯｾｰｼﾞ変換
                                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar006Z)
                                            '@"<TRM6YW>$$このリワーク戻り小工程は指定できません。$設定を見直してください。"
                                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowReworkReturnStepID
                                            .ShowCell(.Row, .Col)
                                            Exit Function
                                        End If
                                    End If
                                    
                                    
                                    '@ﾘﾜｰｸ戻り大工程・小工程（組み合わせﾁｪｯｸ）
                                    If Trim$(.GetData(llngCnt, CPlngvsfFlowReworkReturnOpID)) <> vbNullString Then
                                        lblnMatch = False
                                        '@ﾌﾟﾛｾｽｸﾞﾘｯﾄ分、以下の処理を繰り返す
                                        For llngRow = 1 To .Rows.Count - 1
                                            '@ﾘﾜｰｸ戻り大工程・小工程の組み合わせがﾌﾟﾛｾｽｸﾞﾘｯﾄ内の大工程・小工程と一致するかﾁｪｯｸ
                                            If .GetData(llngCnt, CPlngvsfFlowReworkReturnOpID) = _
                                               .GetData(llngRow, CPlngvsfFlowOpID) And _
                                               .GetData(llngCnt, CPlngvsfFlowReworkReturnStepID) = _
                                               .GetData(llngRow, CPlngvsfFlowStepID) Then
                                               '@一致
                                               lblnMatch = True
                                               Exit For
                                            End If
                                        Next
                                        '@一致した場合
                                        If lblnMatch = True Then
                                            '@*** ﾘﾜｰｸ戻り小工程には現在行までの小工程しか登録できない(一時対応、あとで戻すらしい) ***
                                            '@ﾘﾜｰｸ戻り大工程・小工程が現工程より下の工程の場合
                                            If llngRow > llngCnt Then
                                                '@表示ﾒｯｾｰｼﾞ変換
                                                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar007A)
                                                '@"<TRM7AW>$$リワーク戻り大工程・小工程の組み合わせが正しくありません。$設定を見直してください。"
                                                Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                                '@ﾌｫｰｶｽの移動
                                                .Row = llngCnt
                                                .Col = CPlngvsfFlowReworkReturnOpID
                                                .ShowCell(.Row, .Col)
                                                Exit Function
                                            Else
                                                
                                                '@戻り工程に入替設定がある場合
                                                If .GetData(llngRow, CPlngvsfFlowSwapIndictor) <> vbNullString Then
                                                    '@表示ﾒｯｾｰｼﾞ変換
                                                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar008J)
                                                    '@"<TRM8JW>$$入替可能工程が設定されている工程をリワーク(特殊)ルート戻り工程に指定することはできません。$設定を見直してください。"
                                                    Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                                    '@ﾌｫｰｶｽの移動
                                                    .Row = llngCnt
                                                    .Col = CPlngvsfFlowReworkReturnOpID
                                                    .ShowCell(.Row, .Col)
                                                    Exit Function
                                                End If
                                            End If
                                            
                                            '@ｻﾝﾌﾟﾘﾝｸﾞﾌﾗｸﾞは考慮しない。（概要設計に記述あり）
                                            '@ﾏｽﾀﾌﾟﾛｾｽにはILM工程ありの工順を作成しておき､工順変更で工程を削除するという運用も考えられるが
                                            '@その場合の頻度を考慮すると､実運用には即していない｡
                        
                                        '@一致しない場合
                                        Else
                                            '@表示ﾒｯｾｰｼﾞ変換
                                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar007A)
                                            '@"<TRM7AW>$$リワーク戻り大工程・小工程の組み合わせが正しくありません。$設定を見直してください。"
                                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowReworkReturnOpID
                                            .ShowCell(.Row, .Col)
                                            Exit Function
                                        End If
                                    End If
                                    
                                    '@特殊ﾙｰﾄID、特殊ﾙｰﾄ戻り大工程、特殊ﾙｰﾄ戻り小工程の入力ﾁｪｯｸ
                                    If Trim(.GetData(llngCnt, CPlngvsfFlowSPRouteID)) <> vbNullString Or _
                                       Trim(.GetData(llngCnt, CPlngvsfFlowSPReturnOpID)) <> vbNullString Or _
                                       Trim(.GetData(llngCnt, CPlngvsfFlowSPReturnStepID)) <> vbNullString Then
                                        
                                        '@特殊ﾙｰﾄID、特殊ﾙｰﾄ戻り大工程、特殊ﾙｰﾄ戻り小工程のいずれかに入力がある場合
                                        '@特殊ﾙｰﾄIDが未入力の場合
                                        If Trim(.GetData(llngCnt, CPlngvsfFlowSPRouteID)) = vbNullString Then
                                            '@表示ﾒｯｾｰｼﾞ変換
                                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar006V)
                                            '@"<TRM6VW>$$特殊ルートIDを選択して下さい。"
                                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowSPRouteID
                                            .ShowCell(.Row, .Col)
                                            Exit Function
                                        End If
                        
                                        '@特殊ﾙｰﾄ戻り大工程が未入力の場合
                                        If Trim(.GetData(llngCnt, CPlngvsfFlowSPReturnOpID)) = vbNullString Then
                                            '@表示ﾒｯｾｰｼﾞ変換
                                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar006W)
                                            '@"<TRM6WW>$$特殊ルート戻り大工程を選択して下さい。"
                                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowSPReturnOpID
                                            .ShowCell(.Row, .Col)
                                            Exit Function
                                        End If
                        
                                        '@特殊ﾙｰﾄ戻り小工程が未入力の場合
                                        If Trim(.GetData(llngCnt, CPlngvsfFlowSPReturnStepID)) = vbNullString Then
                                            '@表示ﾒｯｾｰｼﾞ変換
                                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar006X)
                                            '@"<TRM6XW>$$特殊ルート戻り小工程を選択して下さい。"
                                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowSPReturnStepID
                                            .ShowCell(.Row, .Col)
                                            Exit Function
                                        End If
                                    End If
                    
                                    '@特殊ﾙｰﾄ戻り大工程
                                    If Trim(.GetData(llngCnt, CPlngvsfFlowSPReturnOpID)) <> vbNullString Then
                                        llngRow = .FindRow(.GetData(llngCnt, CPlngvsfFlowSPReturnOpID), .Rows.Fixed, CPlngvsfFlowOpID, False)
                                        If llngRow > llngCnt Then
                                            '@表示ﾒｯｾｰｼﾞ変換
                                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar007B)
                                            '@ "<TRM7BW>$$この特殊ルート戻り大工程は指定できません｡$ 設定を見直してください｡"
                                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowSPReturnOpID
                                            .ShowCell(.Row, .Col)
                                            Exit Function
                                        End If
                                    End If
                                    
                                    '@特殊ﾙｰﾄ戻り小工程(存在ﾁｪｯｸ）
                                    If Trim(.GetData(llngCnt, CPlngvsfFlowSPReturnStepID)) <> vbNullString Then
                                        llngRow = .FindRow(.GetData(llngCnt, CPlngvsfFlowSPReturnStepID), .Rows.Fixed, CPlngvsfFlowStepID, False)
                                        If llngRow = -1 Then
                                            '@表示ﾒｯｾｰｼﾞ変換
                                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar007C)
                                            '@"<TRM7CW>$$この特殊ルート戻り小工程は指定できません｡$ 設定を見直してください｡"
                                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowSPReturnStepID
                                            .ShowCell(.Row, .Col)
                                            Exit Function
                                        End If
                                    End If
                                
                                    '@特殊ﾙｰﾄ戻り大工程・小工程
                                    If Trim(.GetData(llngCnt, CPlngvsfFlowSPReturnOpID)) <> vbNullString Then
                                        lblnMatch = False
                                        '@ﾌﾟﾛｾｽｸﾞﾘｯﾄ分、以下の処理を繰り返す
                                        For llngRow = 1 To .Rows.Count - 1
                                            '@特殊ﾙｰﾄ戻り大工程・小工程の組み合わせがﾌﾟﾛｾｽｸﾞﾘｯﾄ内の大工程・小工程と一致するかﾁｪｯｸ
                                            If .GetData(llngCnt, CPlngvsfFlowSPReturnOpID) = _
                                               .GetData(llngRow, CPlngvsfFlowOpID) And _
                                               .GetData(llngCnt, CPlngvsfFlowSPReturnStepID) = _
                                               .GetData(llngRow, CPlngvsfFlowStepID) Then
                                                '@一致
                                                lblnMatch = True
                                                Exit For
                                            End If
                                        Next
                                        '@一致した場合
                                        If lblnMatch = True Then
                                            '@特殊ﾙｰﾄ戻り大工程・小工程が現工程より下の工程の場合
                                            If llngRow > llngCnt Then
                                                '@表示ﾒｯｾｰｼﾞ変換
                                                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar007D)
                                                '@ "<TRM7DW>$$特殊ルート戻り大工程・小工程の組み合わせが正しくありません。$設定を見直してください。"
                                                Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                                '@ﾌｫｰｶｽの移動
                                                .Row = llngCnt
                                                .Col = CPlngvsfFlowSPReturnOpID
                                                .ShowCell(.Row, .Col)
                                                Exit Function
                                            Else
                                                '@戻り工程に入替設定がある場合
                                                If .GetData(llngRow, CPlngvsfFlowSwapIndictor) <> vbNullString Then
                                                    '@表示ﾒｯｾｰｼﾞ変換
                                                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar008J)
                                                    '@"<TRM8JW>$$入替可能工程が設定されている工程をリワーク(特殊)ルート戻り工程に指定することはできません。$設定を見直してください。"
                                                    Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                                    '@ﾌｫｰｶｽの移動
                                                    .Row = llngCnt
                                                    .Col = CPlngvsfFlowSPReturnOpID
                                                    .ShowCell(.Row, .Col)
                                                    Exit Function
                                                End If
                                            End If
                                            
                                            '@ｻﾝﾌﾟﾘﾝｸﾞﾌﾗｸﾞは考慮しない。（概要設計に記述あり）
                                            '@ﾏｽﾀﾌﾟﾛｾｽにはILM工程ありの工順を作成しておき､工順変更で工程を削除するという運用も考えられるが
                                            '@その場合の頻度を考慮すると､実運用には即していない｡
                                            
                                        '@一致しない場合
                                        Else
                                            '@表示ﾒｯｾｰｼﾞ変換
                                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar007D)
                                            '@ "<TRM7DW>$$特殊ルート戻り大工程・小工程の組み合わせが正しくありません。$設定を見直してください。"
                                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, Me.Text, True, 16, False)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowSPReturnOpID
                                            .ShowCell(.Row, .Col)
                                            Exit Function
                                        End If
                                    End If
                            End Select
                        
                            '@処理条件IDが未入力の場合
                            If .GetData(llngCnt, CPlngvsfFlowConditionID) = vbNullString Then
                                '@表示ﾒｯｾｰｼﾞ変換
                                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001N)
                                '@"<TRM1NW>$$処理条件セットIDを入力してください。"
                                Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                                  Me.Text, True, 16, False)
                                '@ﾌｫｰｶｽの移動
                                .Row = llngCnt
                                .Col = CPlngvsfFlowConditionID
                                .ShowCell(.Row, .Col)
                                
                                Exit Function
                            End If
                            
                            '@個別処理条件が「未設定」の場合
                            If .GetData(llngCnt, CPlngvsfFlowConditionOne) = CPstrRecpNot Then
                                '@表示ﾒｯｾｰｼﾞ変換
                                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar008F)
                                '@"<TRM8FW>$$個別処理条件の設定に未設定のレシピが存在します。設定を見直してください。"
                                Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                                  Me.Text, True, 16, False)
                                '@ﾌｫｰｶｽの移動
                                .Row = llngCnt
                                .Col = CPlngvsfFlowConditionOne
                                .ShowCell(.Row, .Col)
                                
                                Exit Function
                            End If
                            
                            '@APC設定の場合
                            If .GetData(llngCnt, CPlngvsfFlowApc) <> vbNullString Then
                                
                                '@APC設定により分岐
                                Select Case Strings.Left$(.GetData(llngCnt, CPlngvsfFlowApc), 2)
                                
                                    '@F/B
                                    Case CMstrFBMark
                                    
                                        '@ﾌﾟﾛｾｽﾏｰｸの"P"か
                                        If Mid$(.GetData(llngCnt, CPlngvsfFlowApc), 8, 1) = CPstrProcessMark Then
                                                                               
                                            '@検索結果初期化
                                            llngFindRow = -1
                                            '@現在のｾﾙの値を配列に格納
                                            lstrAry2 = Split(.GetData(llngCnt, CPlngvsfFlowApc), CMstrComma)
                            
                                            '@配列数分、以下の処理を繰り返す
                                            For llngAryCount2 = 0 To UBound(lstrAry2)
                                                '@ﾌﾟﾛｾｽｸﾞﾘｯﾄ分、以下の処理を繰り返す
                                                For llngRow = 1 To .Rows.Count - 1
                                                    '@同じ行は除く
                                                    If llngCnt <> llngRow Then
                                                    
                                                        '@測定を検索(先頭8文字まで同じで+Mの行程か)
                                                        If InStr(.GetData(llngRow, CPlngvsfFlowApc), _
                                                            Mid$(lstrAry2(llngAryCount2), 1, 7) & CPstrMeasureMark) <> 0 Then
                                                            
                                                            llngFindRow = llngRow
                                                            Exit For
                                                        End If
                                                    End If
                                                Next
                                                '@結果判定
                                                If llngFindRow <> -1 Then
                                                    '@大小比較
                                                    If llngCnt > llngFindRow Then
                                                        '@表示ﾒｯｾｰｼﾞ変換
                                                        pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar008G)
                                                        '@"<TRM8GW>$$APC設定(F/B)は処理工程(P)、測定工程(M)順に設定して下さい。"
                                                        Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                                                  Me.Text, True, 16, False)
                                                        '@ﾌｫｰｶｽの移動
                                                        .Row = llngCnt
                                                        .Col = CPlngvsfFlowApc
                                                        .ShowCell(.Row, .Col)
                                                        
                                                        Exit Function
                                                    End If
                                                End If
                                            Next
                                            '@配列の初期化
                                            Erase lstrAry2
                                        End If
                                        
                                    '@F/F
                                    Case CMstrFFMark
                                    
                                        If Strings.Right$(.GetData(llngCnt, CPlngvsfFlowApc), 1) = "P" Then
                                        
                                            llngFindRow = .FindRow(Replace(.GetData(llngCnt, CPlngvsfFlowApc), CPstrProcessMark, CPstrMeasureMark),  .Rows.Fixed, CPlngvsfFlowApc, False)
                                            
                                            If llngFindRow <> -1 Then
                                            
                                                '@大小比較
                                                If llngCnt < llngFindRow Then
                                                    '@表示ﾒｯｾｰｼﾞ変換
                                                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar008H)
                                                    '@"<TRM8HW>$$APC設定(F/F)は測定工程(M)、処理工程(P)順に設定して下さい。"
                                                    Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                                              Me.Text, True, 16, False)
                                                    '@ﾌｫｰｶｽの移動
                                                    .Row = llngCnt
                                                    .Col = CPlngvsfFlowApc
                                                    .ShowCell(.Row, .Col)
                                                    
                                                    Exit Function
                                                End If
                                            End If
                                        End If
                                End Select
                            End If
                            
                            '@WF選択条件/WFﾚｼﾋﾟ設定不可装置のﾁｪｯｸ
                            lblnAns = prvblnLotRecipeSave_Chk(llngCnt)
                            '@ｴﾗｰありの場合
                            If lblnAns = False Then
                            
                                '@ﾌｫｰｶｽの移動
                                .Row = llngCnt
                                .Col = CPlngvsfFlowSelectConditionID
                                .ShowCell(.Row, .Col)
                                Exit Function
                            End If
                            
                            
                        
                        End If  '(既流動ではない)
                        
                        '@時間制限開始・終了一致ﾁｪｯｸ
                        If .GetData(llngCnt, CPlngvsfFlowTimeLimit) <> vbNullString Then
                        
                            '@現在のｾﾙの値を配列に格納
                            lstrAry = Split(.GetData(llngCnt, CPlngvsfFlowTimeLimit), CMstrComma)
            
                            '@配列数分、以下の処理を繰り返す
                            For llngAryCount = 0 To UBound(lstrAry)
                                '@一致ﾌﾗｸﾞｸﾘｱ
                                lblnMatch = False
                                lstrSearchString = Strings.Left$(lstrAry(llngAryCount), CMlngLeftGetStringNo6)
                                lstrStartEnd = Strings.Right$(lstrAry(llngAryCount), 1)
                                lstrType = Strings.Left$(lstrAry(llngAryCount), 2)
                                
                                '@ﾌﾟﾛｾｽｸﾞﾘｯﾄ分、以下の処理を繰り返す
                                For llngRow = 1 To .Rows.Count - 1
                                    '@同じ行は除く
                                    If llngCnt <> llngRow Then
                                        '@時間制限の開始・終了が一致しているかﾁｪｯｸ
                                        If InStr(.GetData(llngRow, CPlngvsfFlowTimeLimit), lstrSearchString) <> 0 Then
                                            '@一致
                                            lblnMatch = True
                                            
                                            Exit For
                                        End If
                                    End If
                                Next
                                
                                '@存在する時間制限が"処理時間制限"の場合には処理抜け
                                Select Case lstrType
                                    '@「制1」、「制2」の場合
                                    Case CMstrTimeLimitMark & "1", CMstrTimeLimitMark & "2"
                                    
                                        '@一致しない場合
                                        If lblnMatch = False Then
                                           
                                            '@開始の場合
                                            If lstrStartEnd = CMstrStartMark Then
                                                '@表示ﾒｯｾｰｼﾞ変換
                                                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001P, CMstrMsgStringEnd)
                                            Else
                                                '@表示ﾒｯｾｰｼﾞ変換
                                                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001P, CMstrMsgStringStart)
                                            End If
                                            '@<TRM1PW>$$時間制約%1を入力してください。
                                            Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                                              Me.Text, True, 16, False)
                                            '@ﾌｫｰｶｽの移動
                                            .Row = llngCnt
                                            .Col = CPlngvsfFlowTimeLimit
                                            .ShowCell(.Row, .Col)
                                            
                                            Exit Function
                                        Else
                                            '@一致した場合開始-終了の大小ﾁｪｯｸを行なう。
                                            '@開始の場合
                                            If lstrStartEnd = CMstrStartMark Then
                                                '@大小比較
                                                If llngCnt > llngRow Then
                                                    '@表示ﾒｯｾｰｼﾞ変換
                                                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar001K)
                                                    '@"<TRM1KW>$$時間制限は開始・終了順に入力してください。"
                                                    Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                                              Me.Text, True, 16, False)
                                                    '@ﾌｫｰｶｽの移動
                                                    .Row = llngCnt
                                                    .Col = CPlngvsfFlowTimeLimit
                                                    .ShowCell(.Row, .Col)
                                                    
                                                    Exit Function
                                                End If
                                            
                                            
                                                '@Start-Endに同じ入替え番号が設定されている場合はNG
                                                '入替でSとEが逆転する恐れがある為
                                                If .GetData(llngCnt, CPlngvsfFlowSwapIndictor) <> vbNullString Then
                                            
                                                    If .GetData(llngCnt, CPlngvsfFlowSwapIndictor) = _
                                                        .GetData(llngRow, CPlngvsfFlowSwapIndictor) Then
                                                        
                                                        '@表示ﾒｯｾｰｼﾞ変換
                                                        pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar008M)
                                                        '@"<TRM8MW>$$時間制限開始、終了に入替設定が設定されています。$設定を見直してください。"
                                                        Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                                                  Me.Text, True, 16, False)
                                                        '@ﾌｫｰｶｽの移動
                                                        .Row = llngCnt
                                                        .Col = CPlngvsfFlowTimeLimit
                                                        .ShowCell(.Row, .Col)
                                                        
                                                        Exit Function
                                                        
                                                    End If
                                                End If
                                            End If
                                        
                                        End If
                                    
                                    '@「制3」、「制」「引」の場合はﾁｪｯｸの対象外
                                    Case Else
                                        '@ﾁｪｯｸなし
                                
                                End Select
                            Next
                        End If  '(時間制限）
                    
        '@↓2018/03/15 (Thu) 15:24:40 T.Oide **************************************************
                        '@ﾚｼﾋﾟ選択APCのM→Pの順番ﾁｪｯｸ
                        '@ﾚｼﾋﾟ選択APC設定があるか
                        If .GetData(llngCnt, CPlngvsfFlowRecpSelApc) <> vbNullString Then
                        
                            '@測定工程の設定か
                            If Mid$(.GetData(llngCnt, CPlngvsfFlowRecpSelApc), 8, 1) = CPstrMeasureMark Then
                            
                                '@処理行程を探す
                                llngProcRow = .FindRow( _
                                                    Mid$(.GetData(llngCnt, CPlngvsfFlowRecpSelApc), 1, 7) + _
                                                    CPstrProcessMark, .Rows.Fixed, CPlngvsfFlowRecpSelApc, False, False,False)
                                
                                '@測定工程 > 処理工程 か(M→Pがっ逆転していないか)
                                If llngCnt > llngProcRow Then
                                    '@"<TRM149W>$$「ﾚｼﾋﾟ選択APC」の設定[%1]で、測定行程と処理工程の順番が逆転しています。$設定を見直してください。"
                                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar0149, Mid$(.GetData(llngCnt, CPlngvsfFlowRecpSelApc), 1, 6))
                                    Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                              Me.Text, True, 16, False)
                                    
                                    '@ﾌｫｰｶｽの移動
                                    .Row = llngCnt
                                    .Col = CPlngvsfFlowRecpSelApc
                                    .ShowCell(.Row, .Col)
                                    
                                    Exit Function
                                End If
                            End If
                        End If
        '@↑2018/03/15 (Thu) 15:24:40 T.Oide **************************************************
                    
                    
                        '通常工程の場合のみﾁｪｯｸ
                        If pstrEN01X0ProcFlag = "0" Then
                            '@処理号機ﾁｪｯｸ
                            If .GetData(llngCnt, CPlngvsfFlowWpRestrict) <> vbNullString Then
                                '@処理号機ﾁｪｯｸ
                                lblnAns = prvblnWpRestrictSave_Chk(llngCnt)
                                '@ｴﾗｰありの場合
                                If lblnAns = False Then
                                    '@ﾌｫｰｶｽの移動
                                    .Row = llngCnt
                                    .Col = CPlngvsfFlowWpRestrict
                                    .ShowCell(.Row, .Col)
                                    Exit Function
                                End If
                            End If
                        End If
                    
                    End If  '(登録のみ）
                Next
                
                '@登録時のみﾁｪｯｸ
                If llngIndex = 2 Then
                
                    '@ﾘﾜｰｸ、特殊ﾛｯﾄの場合はﾘﾜｰｸ、特殊ﾙｰﾄの設定は行わない
                    Select Case pstrEN01X0ProcFlag
                                
                        '@ﾘﾜｰｸ、特殊流動
                        Case "1"
                            
                            '@今のところﾁｪｯｸなし
                            
                        Case Else
                            '@最終工程にﾘﾜｰｸ（特殊）設定は不可
                            If .GetData(.Rows.Count - 1, CPlngvsfFlowReworkRouteID) <> vbNullString Or _
                                .GetData(.Rows.Count - 1, CPlngvsfFlowSPRouteID) <> vbNullString Then
                                
                                '@表示ﾒｯｾｰｼﾞ変換
                                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar008N)
                                '@"<TRM8NW>$$最終工程にリワーク(特殊)ルートを設定することはできません。$設定を見直してください。"
                                Call publngMsgBoxInfo(pstrDMsg & vbCrLf, vbExclamation, _
                                          Me.Text, True, 16, False)
                                          
                                '@ﾌｫｰｶｽ場所を判定
                                If .GetData(.Rows.Count - 1, CPlngvsfFlowReworkRouteID) <> vbNullString Then
                                    .Col = CPlngvsfFlowReworkRouteID
                                Else
                                    .Col = CPlngvsfFlowSPRouteID
                                End If
                                
                                '@ﾌｫｰｶｽの移動
                                .Row = .Rows.Count - 1
                                .ShowCell(.Row, .Col)
                                
                                Exit Function
                            End If
                    End Select
                
                End If
            
            End With

            '@ｴﾗｰなし
            prvblnUpdate_Chk = True

            Exit Function

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvblnUpdate_Chk"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Function

    '関数名：prvAryTimeLimitDataOpStep_Set
    '機　能：時間制限配列の大工程・小工程を設定する。
    '引　数：なし
    '戻り値：なし
    '作成日：2006/06/19 (Mon) 14:28:12 N.Kasai
    '更新日：2006/06/19 (Mon) 14:28:12
    '備　考：
    Private Sub prvAryTimeLimitDataOpStep_Set()

        Dim lstrListOrder       As String   '時間制限番号
        Dim lstrAry()           As String   'ｾﾙ内時間制限配列
        Dim llngRow             As Integer  '行数
        Dim llngAryCount        As Integer  '配列ｶｳﾝﾀ
        Dim llngCount           As Integer  'ｶｳﾝﾀ
        Dim llngIndex           As Integer  '格納ｲﾝﾃﾞｯｸｽ
        
        Try


            With vsfFlowList0
            
                '@時間制限配列がない場合、処理中止
                If ptypProcTimeLimitInfo.lngProcTimeLimitCnt = 0 Then
                    Exit Sub
                End If

        '        '@全ての時間制限配列の大工程・小工程をクリア
        '        For llngCount = 1 To ptypProcTimeLimitInfo.lngProcTimeLimitCnt
        '            ptypProcTimeLimitInfo.typProcTimeLimit(llngCount).strToOpID = vbNullString            '先大工程
        '            ptypProcTimeLimitInfo.typProcTimeLimit(llngCount).strToStepID = vbNullString          '先小工程
        '            ptypProcTimeLimitInfo.typProcTimeLimit(llngCount).strFromOpID = vbNullString          '元大工程
        '            ptypProcTimeLimitInfo.typProcTimeLimit(llngCount).strFromStepID = vbNullString        '元小工程
        '        Next

                For llngRow = 1 To .Rows.Count - 1
                    '@時間制限が設定されている場合
                    If .GetData(llngRow, CPlngvsfFlowTimeLimit) <> vbNullString Then
                    
                        '@現在のｾﾙの値を配列に格納
                        lstrAry = Split(.GetData(llngRow, CPlngvsfFlowTimeLimit), CMstrComma)

                        '@配列数分、以下の処理を繰り返す
                        For llngAryCount = 0 To UBound(lstrAry)
                            
                            '@処理時間制限の場合
                            If Strings.Left$(lstrAry(llngAryCount), 2) = CMstrTimeLimitMark & "3" Then
                            
                                '@順番の取得
                                lstrListOrder = Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo3)

                                llngIndex = -1
                                
                                For llngCount = 0 To ptypProcTimeLimitInfo.lngProcTimeLimitCnt -1
                                    '@格納場所を特定
                                    If Format$(CInt(ptypProcTimeLimitInfo.typProcTimeLimit(llngCount).strListOrder), CMstrNoFormat) = lstrListOrder Then
                                        llngIndex = llngCount
                                    End If
                                Next
                                '@格納場所が存在する場合
                                If llngIndex <> -1 Then
                                    
                                    '@格納構造体情報再設定
                                    Dim ltypProcTimeLimitTmp As New ProcTimeLimit
                                    ltypProcTimeLimitTmp = ptypProcTimeLimitInfo.typProcTimeLimit(llngIndex)

                                    ltypProcTimeLimitTmp.strToOpId = _
                                                .GetData(llngRow, CPlngvsfFlowOpID)                    '先大工程
                                    ltypProcTimeLimitTmp.strToStepId = _
                                                .GetData(llngRow, CPlngvsfFlowStepID)                  '先小工程
                                    ltypProcTimeLimitTmp.strFromOpId = _
                                                .GetData(llngRow, CPlngvsfFlowOpID)                    '元大工程
                                    ltypProcTimeLimitTmp.strFromStepId = _
                                                .GetData(llngRow, CPlngvsfFlowStepID)                  '元小工程

                                    ptypProcTimeLimitInfo.typProcTimeLimit(llngIndex) = ltypProcTimeLimitTmp 
                                End If
                            Else
                            
                                '@順番の取得
                                lstrListOrder = Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo3)
                                
                                llngIndex = -1
                            
                                For llngCount = 0 To ptypProcTimeLimitInfo.lngProcTimeLimitCnt -1
                                    '@格納場所を特定
                                    If Format$(CInt(ptypProcTimeLimitInfo.typProcTimeLimit(llngCount).strListOrder), CMstrNoFormat) = lstrListOrder Then
                                        llngIndex = llngCount
                                    End If
                                Next
                            
                                '@時間制限終了の場合
                                If Strings.Right$(lstrAry(llngAryCount), 1) = CMstrEndMark Then
                                    '@格納場所が存在する場合
                                    If llngIndex <> -1 Then
                                    
                                        '@大工程・小工程を設定する。
                                        '@時間制限終了の場合
                                        Dim ltypProcTimeLimitTmp As ProcTimeLimit = New ProcTimeLimit
                                        ltypProcTimeLimitTmp = ptypProcTimeLimitInfo.typProcTimeLimit(llngIndex)

                                        ltypProcTimeLimitTmp.strToOpId = _
                                            .GetData(llngRow, CPlngvsfFlowOpID)              '先大工程
                                        ltypProcTimeLimitTmp.strToStepId = _
                                            .GetData(llngRow, CPlngvsfFlowStepID)            '先小工程

                                        ptypProcTimeLimitInfo.typProcTimeLimit(llngIndex) = ltypProcTimeLimitTmp
                                    End If
                                End If
                                
                                '@時間制限開始の場合
                                If Strings.Right$(lstrAry(llngAryCount), 1) = CMstrStartMark Then
                                    '@格納場所が存在する場合
                                    If llngIndex <> -1 Then
                                        '@大工程・小工程を設定する。
                                        '@時間制限開始の場合
                                        Dim ltypProcTimeLimitTmp As ProcTimeLimit = New ProcTimeLimit
                                        ltypProcTimeLimitTmp = ptypProcTimeLimitInfo.typProcTimeLimit(llngIndex)

                                        ltypProcTimeLimitTmp.strFromOpId = _
                                            .GetData(llngRow, CPlngvsfFlowOpID)          '元大工程
                                        ltypProcTimeLimitTmp.strFromStepId = _
                                            .GetData(llngRow, CPlngvsfFlowStepID)        '元小工程

                                        ptypProcTimeLimitInfo.typProcTimeLimit(llngIndex) = ltypProcTimeLimitTmp
                                    End If
                               End If
                            End If
                        Next
                    End If
                Next
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvAryTimeLimitDataOpStep_Set"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


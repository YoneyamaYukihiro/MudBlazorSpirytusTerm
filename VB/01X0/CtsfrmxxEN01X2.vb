                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "cmdSpcSkipChkOn_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Sub

    '関数名：cmdEditStart_Click
    '機　能：編集開始ﾎﾞﾀﾝ
    '引　数：なし
    '戻り値：なし
    '作成日：2006/06/22 (Thu) 16:00:10 N.Kasai
    '更新日：2006/06/22 (Thu) 16:00:10
    '備　考：
    Private Sub cmdEditStart_Click(ByVal sender As Object, ByVal e As EventArgs) Handles cmdEditStart.Click
        
        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            Dim llngMsgAns              As Integer          'ﾒｯｾｰｼﾞ戻り値
            Dim lstrMsgString           As String           'ﾒｯｾｰｼﾞ文字
            Dim llngCnt                 As Integer          'ｶｳﾝﾀ
            Dim lstrEventName           As String           'ｲﾍﾞﾝﾄ名格納（ﾚｽﾎﾟﾝｽ用）
            Dim ltypproceditstartReq    As proceditstartReq 'ﾌﾟﾛｾｽ開始要求格納
            Dim lblnAns                 As Boolean          '汎用戻り値
            
            With vsfFlowList0
            
                '@該当ﾃﾞｰﾀが存在しない場合は処理なし
                If .Rows.Count = .Rows.Fixed Then
                    Exit Sub
                End If
                
                '@編集不可工程の場合
                If .GetData(.Row, CPlngvsfFlowPermit) = CMstrPermit2 Then
                    
                    '@Sﾛｯﾄ最終工程ｽﾍﾟｼｬﾙ
                    If .Row = .Rows.Count - 1 Then
                        '@状態判定
                        Select Case .GetData(.Rows.Count - 1, CPlngvsfFlowState)
                        
                            '@Sﾛｯﾄ最終工程で前処理～作業終了
                            Case CMstrState2
                                    
                                '@ﾛｯﾄ種別ﾌﾗｸﾞ(0:通常ﾛｯﾄ、1:特殊ﾛｯﾄ）
                                If pstrEN01X0ProcFlag = "1" Then
                                    '@表示ﾒｯｾｰｼﾞ変換
                                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar008C, Me.Text)
                                    '@"<TRM8CW>$$編集不可の工程が選択されています。$選択を見直してください。"
                                    Call publngMsgBox(pstrDMsg, vbExclamation, Me.Text, True, 16, False)
                                     Exit Sub
                                End If
                        
                            '@Sﾛｯﾄ最終工程で作業待ち
                            Case CMstrState3
                                '@編集可
                               
                            '@代替工程突入中
                            Case CMstrState10
                                '@編集可
                                
                            '@入替工程突入中
                            Case CMstrState11
                                '@編集可
                                
                            Case Else
                                '@表示ﾒｯｾｰｼﾞ変換
                                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar008C, Me.Text)
                                '@"<TRM8CW>$$編集不可の工程が選択されています。$選択を見直してください。"
                                Call publngMsgBox(pstrDMsg, vbExclamation, Me.Text, True, 16, False)
                                 Exit Sub
                            End Select
                    
                    
                    Else
                        '@表示ﾒｯｾｰｼﾞ変換
                        pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar008C, Me.Text)
                        '@"<TRM8CW>$$編集不可の工程が選択されています。$選択を見直してください。"
                        Call publngMsgBox(pstrDMsg, vbExclamation, Me.Text, True, 16, False)
                         Exit Sub
                    End If
                End If
                
                lstrMsgString = .GetData(.Row, CPlngvsfFlowOpID)                       '大工程名取得
                lstrMsgString = lstrMsgString & "/"
                lstrMsgString = lstrMsgString & .GetData(.Row, CPlngvsfFlowStepID)     '小工程名取得
                
                '@表示ﾒｯｾｰｼﾞ変換
                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005P, lstrMsgString)
            
                '@"<TRM5PI>$$%1より$編集を開始します。$開始指定された前工程への編集は不可となります。$よろしいですか？"
                llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                If llngMsgAns = vbNo Then       '「いいえ」を選択(削除処理ｷｬﾝｾﾙ)
                    Exit Sub
                End If
                
            End With
            
            '@ﾚｽﾎﾟﾝｽ取得開始
            lstrEventName = "cmdEditStart_Click"
            Call pubResponseStart(Me.Name, lstrEventName)

            '@要求構造体格納(Action=1:保留 2:保留予約 3:保留予約(作業開始)
            With ltypproceditstartReq
                .strMsgVer = CMstrprocproceditstartVer      'Msgﾊﾞｰｼﾞｮﾝ
                .strSbID = pstrSBID                         'ｼｽﾃﾑﾌﾞﾛｯｸ
                .strLotID = lblLotID.Text                'ﾛｯﾄID
                .strEmpID = pstrUserID                      '作業者ID

                '@注意
                '@選択済みの直前の工程をｾｯﾄする。
                If vsfFlowList0.Row = 1 Then
                    '@先頭行を選択した場合
                    
                    '@SVより返却された編集可否を判定します。
                    Select Case vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowPermit)
                        
                        '@投入前
                        Case CMstrPermit1
                            .strOpID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowOpID)
                            .strStepID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowStepID)
                            .strAction = "5"                                                                            '1:投入前保留
                            mstrCurrentHoldFlag = "1"                                                                   '保留ﾌﾗｸﾞON
                        '@投入後作業待ち
                        Case Else
                
                            '@SVより返却された状態を判定します。
                            Select Case vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowState)
                        
                                '@先頭工程だけど最終工程で前処理～作業終了までを選択された場合ｽﾍﾟｼｬﾙ（１工程しかない）
                                Case CMstrState2
                                    .strOpID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowOpID)
                                    .strStepID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowStepID)
                                    .strAction = "4"                                                                    '4:通常ﾛｯﾄ最終工程保留
                                    mstrCurrentHoldFlag = "1"                                                           '保留ﾌﾗｸﾞON
                        
                                Case Else
                                    '@先頭工程作業待ち
                                    .strOpID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowOpID)
                                    .strStepID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowStepID)
                                    .strAction = "1"                                                                    '1:保留
                                    mstrCurrentHoldFlag = "1"                                                           '保留ﾌﾗｸﾞON
                            End Select
                    End Select
            
                Else
            
                    '@SVより返却された状態を判定します。
                    Select Case vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowState)
                
                        '@最終工程で前処理～作業終了までを選択された場合ｽﾍﾟｼｬﾙ
                        Case CMstrState2
                            .strOpID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowOpID)
                            .strStepID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowStepID)
                            .strAction = "4"                                                                            '4:通常ﾛｯﾄ最終工程保留
                            mstrCurrentHoldFlag = "1"                                                                   '保留ﾌﾗｸﾞON
                        
                        '@流動中で現工程を指定した場合
                        Case CMstrState3
                            .strOpID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowOpID)
                            .strStepID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowStepID)
                            .strAction = "1"                                                                            '1:保留
                            mstrCurrentHoldFlag = "1"                                                                   '保留ﾌﾗｸﾞON
                        
                        '@流動中で前工程が停止の場合
                        Case CMstrState12
                            .strOpID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowOpID)
                            .strStepID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowStepID)
                            .strAction = "3"                                                                            '3:保留予約(作業開始)
                            mstrCurrentHoldFlag = "0"                                                                   '保留ﾌﾗｸﾞOFF

                        '@現工程がR,Aﾛｯﾄの最終工程作業待ちの場合
                        Case CMstrState14
                            .strOpID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowOpID)
                            .strStepID = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowStepID)
                            .strAction = "1"                                                                            '1:保留
                            mstrCurrentHoldFlag = "1"                                                                   '保留ﾌﾗｸﾞON

                        '@未来工程を指定した場合
                        Case Else
                            .strOpID = vsfFlowList0.GetData(vsfFlowList0.Row - 1, CPlngvsfFlowOpID)                     '前大工程
                            .strStepID = vsfFlowList0.GetData(vsfFlowList0.Row - 1, CPlngvsfFlowStepID)                 '前小工程
                            .strAction = "2"                                                                            '2:保留予約
                            '@編集不可を設定する。
                            For llngCnt = vsfFlowList0.Row - 1 To 1 Step -1
                                vsfFlowList0.SetData(llngCnt, CPlngvsfFlowPermit, CMstrPermit2)                         '変更可否（変更不可）
                            Next
                            mstrCurrentHoldFlag = "0"                                                                   '保留ﾌﾗｸﾞOFF
                    End Select
                End If
            
                '@絶対工順番号（編集開始）
                .strAbsNo = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowAbsNo)
                
                '@現在大工程
                .strCurrentOpID = lblOpID.Text
                
                '@現在小工程
                .strCurrentStepID = lblStepID.Text
            
            End With

            '@MSG【ﾌﾟﾛｾｽ編集開始】
            lblnAns = pubblnProcProcEditStart_Upd(ltypproceditstartReq)
            '@結果判定
            If lblnAns = False Then
                '@ﾚｽﾎﾟﾝｽｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                cmdEditStart.Enabled = False
                Exit Sub
            Else
                cmdEditStart.Enabled = False
            
            End If

            '@ﾚｽﾎﾟﾝｽ取得終了
            Call publngResponseEnd(Me.Name, lstrEventName)
            
            '@編集ﾌﾗｸﾞ（0/未編集　1/編集中　2/編集済）
            mlngEditFlag = 1
            
            With vsfFlowList0
                '@ﾊﾞｯｸｶﾗｰの制御
                For llngCnt = .Row - 1 To 1 Step -1
                    '@背景色を変更
                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                    Dim cellRange As CellRange = .GetCellRange(1, 0, llngCnt, .Cols.Count - 1)
                    cellRange.Style = newStyle
                Next
                '@該当行にﾌｫｰｶｽｾｯﾄ
                .ShowCell(.Row - 1, CPlngvsfFlowOpID)
            End With
            
            '@時間制限ﾎﾞﾀﾝ使用許可
            Call prvcmdTimeLimitEnabled_Set()
            
            '@APC設定ﾎﾞﾀﾝ使用許可
            Call prvcmdApcEnabled_Set()
            
            '@登録ﾎﾞﾀﾝの使用許可
            Call prvCmdUpdateEnabled_Set()
            
            '@移動（↑）（↓）・編集・削除ﾎﾞﾀﾝの使用許可
            Call prvCmdUpDownDelEnabled_Set(vsfFlowList0)
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "cmdEditStart_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


                                Call publngMsgBox(pstrDMsg, vbInformation, Me.Text, True, 16, False)
                                
                                Exit Sub
                            End If
                            
                            pstrCategory = cmbOpCategory.Text
                            pstrDataCnt = vsfOpList.Rows.Count - 1
                            
                        '@小行程の場合
                        Case CMlngStepTabNo
                        
                            '@小工程のﾘｽﾄはあるか
                            If vsfStepList.Rows.Count <= 1 Then
                                '@表示ﾒｯｾｰｼﾞ変換
                                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf007M, Me.Text)
                                '@"<TRM7MI>$$選択リストが空の場合は検索できません。"
                                Call publngMsgBox(pstrDMsg, vbInformation, Me.Text, True, 16, False)
                                
                                Exit Sub
                            End If
                            
                            pstrCategory = cmbStepCategory.Text
                            pstrDataCnt = vsfStepList.Rows.Count - 1
                            
                        '@処理条件の場合
                        Case CMlngConditionTabNo
                        
                            '@処理条件のﾘｽﾄはあるか
                            If vsfConditionList1.Rows.Count <= 1 Then
                                '@表示ﾒｯｾｰｼﾞ変換
                                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf007M, Me.Text)
                                '@"<TRM7MI>$$選択リストが空の場合は検索できません。"
                                Call publngMsgBox(pstrDMsg, vbInformation, Me.Text, True, 16, False)
                                
                                Exit Sub
                            End If
                            
                            pstrCategory = cmbConditionCategory.Text
                            pstrDataCnt = vsfConditionList1.Rows.Count - 1
                    
                    End Select
                    
                    '@検索画面を表示
        '@↓2018/03/16 (Fri) 13:52:56 T.Oide **************************************************
        '            Call frmxxEN01X9.Show(vbModal)
                    frmxxGC0020.Instance.ShowDialog(Me)
                    frmxxGC0020.Instance = Nothing
        '@↑2018/03/16 (Fri) 13:52:56 T.Oide **************************************************
                
                '@以外
                Case Else
            
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf007L, Me.Text)
                    '@"<TRM7LI>$$[設定値検索]は、設定画面の[大行程]、[小行程]、[処理条件]で行ってください。"
                    Call publngMsgBox(pstrDMsg, vbInformation, Me.Text, True, 16, False)
                    

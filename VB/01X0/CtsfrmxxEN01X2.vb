     '↑NG装置組み合わせ判定機能作成に伴い不要となったためコメントアウト　2023/02/17 **************************************************


            '@ｴﾗｰ判定
            '@処理条件とAPC設定でEQ_TYPEにｴﾗｰがある場合
            '@ﾘﾜｰｸ、特殊ﾙｰﾄ内で小工程が重複する場合
            If ltypProcRegistAns.strMessageStr <> vbNullString Then
                '@表示ﾒｯｾｰｼﾞ変換
                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar000N, Replace(ltypProcRegistAns.strMessageStr, "$", vbCrLf))
                '@SVｴﾗｰﾒｯｾｰｼﾞを表示
                Call publngMsgBoxInfo(pstrDMsg, vbExclamation, Me.Text, True, 16, False)

                With vsfFlowList0
                    '@該当行検索
                    llngFindRow = .FindRow(ltypProcRegistAns.strErrorAbsNo, .Rows.Fixed, CPlngvsfFlowAbsNo, False)
                    '@該当行が存在する場合
                    If llngFindRow <> -1 Then
                        '@ﾌｫｰｶｽの移動
                        .Row = llngFindRow
                        .Col = CPlngvsfFlowNo
                        .ShowCell(.Row, .Col)
                    
                    Else
                        '@例外処理
                        '@ﾌｫｰｶｽの移動

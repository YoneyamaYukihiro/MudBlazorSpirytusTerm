    '関数名：prvblnProcWpRule_Chk
    '機　能：工順変更確定時ﾙｰﾙﾁｪｯｸ
    '引　数：なし
    '戻り値：True：ｴﾗｰなし、False：ｴﾗｰあり
    '作成日：2009/03/16 (Mon) 10:15:15 Y.Yoneyama
    '更新日：
    '備　考：
    Private Function prvblnProcWpRule_Chk() As Boolean
        
        Dim lblnAns                 As Boolean  '汎用戻り値
        Dim lstrEventName           As String   'ｲﾍﾞﾝﾄ名（ﾚｽﾎﾟﾝｽ）
        Dim llngCnt                 As Integer  'ｶｳﾝﾄ
        Dim lstrWrnMsg              As String   '表示ﾒｯｾｰｼﾞ作成用
        
        Try
            
            '@戻り値初期化
            prvblnProcWpRule_Chk = False

            '@使用変数の初期化
            mstrWpRuleJugeFlag = vbNullString
            'mtypRuleList = ltypRuleList

                        
            '@ﾚｽﾎﾟﾝｽ取得開始
            lstrEventName = "prvblnLotRecipeSave_Chk"
            Call pubResponseStart(Me.Name, lstrEventName)
             
            '@MSG【工順変更確定時ﾙｰﾙﾁｪｯｸ】
            lblnAns = pubblnProcWpRuleChk_Sel(CMstrprocwprulechkVer, _
                                              pstrSBID, _
                                              pstrLotID, _
                                              mstrWpRuleJugeFlag, _
                                              mtypRuleList)
            '@結果判定
            If lblnAns = True Then
                        
                '@ﾚｽﾎﾟﾝｽ取得終了
                Call publngResponseEnd(Me.Name, lstrEventName)
                
                '@ﾙｰﾙ違反がある場合は警告ﾒｯｾｰｼﾞ表示
                If mstrWpRuleJugeFlag = "1" Then
                    
                    '@ﾙｰﾙ違反表示(表示数は最大10件)
                    For llngCnt = 0 To mtypRuleList.typRuleList.Count -1
                        
                        '@最大表示件数のﾁｪｯｸ
                        If llngCnt > 10 Then
                            '@表示ﾒｯｾｰｼﾞの作成
                            lstrWrnMsg = lstrWrnMsg + _
                                         "他[" + CStr(mtypRuleList.typRuleList.Count - 10) + "]箇所あります。"
                            Exit For
                        End If
                        
                        '@表示ﾒｯｾｰｼﾞの作成
                        lstrWrnMsg = lstrWrnMsg + CStr(llngCnt +1) + _
                                     ".[" + mtypRuleList.typRuleList(llngCnt).strOpID + "/" + _
                                     mtypRuleList.typRuleList(llngCnt).strStepID + "][" + _
                                     mtypRuleList.typRuleList(llngCnt).strRuleName + "][" + _
                                     mtypRuleList.typRuleList(llngCnt).strJudgeMsg + "]" + vbCrLf
                    Next
                    
                    '@"<TRM9JK>$$処理条件設定ミス[%1箇所]の可能性があります。$%2"
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar009K, CStr(mtypRuleList.typRuleList.Count ), lstrWrnMsg)
                    '@警告ﾒｯｾｰｼﾞ
                    Call publngMsgBoxInfo(pstrDMsg, vbExclamation, Me.Text, True, 16)

                End If
            Else
                '@失敗の場合
                '@ﾚｽﾎﾟﾝｽ取得ｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                Exit Function
            End If
            
            '@ｴﾗｰなし
            prvblnProcWpRule_Chk = True
            
            Exit Function
            
        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey
                .strProcName = "prvblnProcWpRule_Chk"
                .strErrMessage = vbNullString
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Function


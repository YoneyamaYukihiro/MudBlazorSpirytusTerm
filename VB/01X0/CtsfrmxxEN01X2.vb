    '関数名：prvlngTimeLimit_Chk
    '機　能：時間制限開始・終了のもう一方の行番号を探す
    '引　数：なし
    '戻り値：時間制限開始・終了のもう一方の行番号
    '作成日：2006/06/05 (Mon) 10:05:16 N.Kasai
    '更新日：2006/06/05 (Mon) 10:05:16
    '備　考：
    Private Function prvlngTimeLimit_Chk() As Integer
        
        Dim lstrAry()    As String   'ｾﾙ内時間制限配列
        Dim lblnSameNo   As Boolean  '同番号ﾌﾗｸﾞ
        Dim llngAryCount As Integer  '配列ｶｳﾝﾀ
        Dim llngRow      As Integer  '行番号
        Dim lstrOrderNo     As String
        Try

            '@初期化
            prvlngTimeLimit_Chk = -1
            
            '@検索対象ｵｰﾀﾞｰ№格納
            lstrOrderNo = Format$(plngTimeLimitCnt, CMstrNoFormat)
           
            With vsfFlowList0
                '@同番号ﾌﾗｸﾞの初期化
                lblnSameNo = False
                '@ﾌﾟﾛｾｽﾌﾛｰｸﾞﾘｯﾄの行数分以下の処理を繰り返す
                For llngRow = 1 To .Rows.Count - 1
                    '@空白でない場合
                    If .GetData(llngRow, CPlngvsfFlowTimeLimit) <> vbNullString Then
                        '@現在のｾﾙの値を配列に格納
                        lstrAry = Split(.GetData(llngRow, CPlngvsfFlowTimeLimit), CMstrComma)
                        '@配列数分、以下の処理を繰り返す
                        For llngAryCount = 0 To UBound(lstrAry)
                            '@同じ番号の場合
                            If lstrOrderNo = Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo3) Then
                                '@同番号ﾌﾗｸﾞｵﾝ
                                lblnSameNo = True
                                Exit For
                            End If
                        Next
                        '@同番号ﾌﾗｸﾞｵﾝの場合
                        If lblnSameNo = True Then
                            '@行番号を返す
                            prvlngTimeLimit_Chk = llngRow
                            
                            '@配列のｸﾘｱ
                            Erase lstrAry
                            Exit Function
                        End If
                    End If
                Next
            End With
            
            '@配列のｸﾘｱ
            Erase lstrAry
            
            Exit Function

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvlngTimeLimit_Chk"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Function


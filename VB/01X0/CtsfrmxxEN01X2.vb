    '関数名：cmdUp_Click
    '機　能：移動（↑）処理
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/23 (Tue) 15:12:29 N.Kasai
    '更新日：2006/05/23 (Tue) 15:12:29
    '備　考：
    Private Sub cmdUp_Click(ByVal sender As Object, ByVal e As EventArgs) Handles cmdUp.Click

        Dim llngRowStart        As Integer'ｽﾀｰﾄ行
        Dim llngRowEnd          As Integer'ｴﾝﾄﾞ行
        Dim llngColStart        As Integer'ｽﾀｰﾄ列
        Dim llngColEnd          As Integer'ｴﾝﾄﾞ列
        Dim llngCnt             As Integer'ﾙｰﾌﾟｶｳﾝﾀ
        Dim nApcStepOver        As Integer
        Dim newStyle            As CellStyle    'NSYS セルスタイル
        Dim cellRange           As CellRange    'NSYS セルレンジ

        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            With vsfFlowList0
                '@選択範囲の取得
                llngRowStart = .Selection.TopRow
                llngColStart = .Selection.LeftCol
                llngRowEnd = .Selection.BottomRow
                llngColEnd = .Selection.RightCol
                
                nApcStepOver = APC_NO_OVER
                If .GetData(llngRowStart - 1, CPlngvsfFlowApcTeosGroupNo) <> vbNullString Then
                     nApcStepOver = APC_UP_OVER
                End If
                
                '@選択範囲の直前にある行を選択範囲直後に移動
                .Rows.Move(llngRowStart - 1, llngRowEnd)
                
                '@選択範囲を移動
                '@選択行全体をﾊｲﾗｲﾄ
                .Select(llngRowStart - 1, CPlngvsfFlowNo, llngRowEnd - 1, .Cols.Count - 1)
                .ShowCell(llngRowStart - 1, llngColStart)
                
                For llngCnt = 1 To .Rows.Count - 1
                    '@選択範囲内の場合には,背景色を戻す
                    If llngCnt >= llngRowStart And llngCnt <= llngRowEnd Then
                        newStyle = .Styles.Add("CustomStyle_BackColor_vbWhite")
                        newStyle.BackColor = Color.White
                        cellRange = .GetCellRange(llngCnt, CPlngvsfFlowNo)
                        cellRange.Style = newStyle
                    End If
                Next llngCnt
                
                '@№のﾊﾞｯｸｶﾗｰを編集処理色へ変更
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                cellRange = .GetCellRange(llngRowStart - 1, CPlngvsfFlowNo, _
                                       llngRowEnd - 1, CPlngvsfFlowAbsNo)
                cellRange.Style = newStyle
                                
                                
                For llngCnt = llngRowStart - 1 To llngRowEnd - 1
                    '@行移動対象が行挿入以外の場合
                    If .GetData(llngCnt, CPlngvsfFlowState) <> CMstrState8 Then
                        .SetData(llngCnt, CPlngvsfFlowState, CMstrState9)         '状態（行移動）
                    End If
                    .SetData(llngCnt, CPlngvsfFlowPermit, CMstrPermit1)       '変更可否（変更可）
                    .SetData(llngCnt, CPlngvsfFlowChange, CMstrChange1)       '変更区分（変更あり）
                
                    '移動された行に対してスキップフラグ＝ＯＮ処理
                    Call UpdateApcTeosSkip(vsfFlowList0, llngCnt, nApcStepOver)
                Next
            End With
                
            '@Noの再ｾｯﾄ
            Call prvNo_Set(vsfFlowList0)
            
            '@変更ﾌﾗｸﾞｵﾝ
            pblnEN01X2Edit = True
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "cmdUp_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


                        End If
                        
                        '@-------------------------------------------------
                        '@CdenClass
                        '@-------------------------------------------------
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowCdenClass, .strCdenClass)
                        
                        '@-------------------------------------------------
                        '@GRB設定
                        '@-------------------------------------------------
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowGrbClass, .strGrbClass)
                        
                        '@-------------------------------------------------
                        '@TPAL設定
                        '@-------------------------------------------------
                        Select Case .strTpalClass
                            
                            '@蒸着ﾊﾞｯﾁ貼合
                            Case CPstrTpalJBatch
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, CPstrTpalJBatchName)
                            
                            '@蒸着左貼合
                            Case CPstrTpalJLeft
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, CPstrTpalJLeftName)
                            

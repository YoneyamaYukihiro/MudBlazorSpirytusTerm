    '関数名：prvvsfFlowList_Edit
    '機　能：ﾌﾛｰﾘｽﾄ編集処理(ｺﾝﾎﾞ動作)
    '引　数：llngSelectCol：選択列
    '戻り値：なし
    '作成日：2006/07/03 (Mon) 15:10:11 N.Kasai
    '更新日：2006/07/03 (Mon) 15:10:11
    '備　考：
    Private Sub prvvsfFlowList_Edit(ByVal llngSelectCol As Integer)
        
        Dim llngCnt         As Integer          'ﾙｰﾌﾟｶｳﾝﾀ
        Dim llngCnt2        As Integer          'ﾙｰﾌﾟｶｳﾝﾀ2
        Dim llngWkCol       As Integer          '列
        Dim llngWkRow       As Integer          '行
        Dim lstrWkString    As List(Of String)  'ｺﾝﾎﾞ用文字列格納
        Dim lstrAddString   As String           'ｺﾝﾎﾞ用文字列格納2
        Dim lblnFlg         As Boolean          '重複項目有無ﾌﾗｸﾞ
        Dim lstrOpString    As String           '戻り大工程格納


        Try
            
            With vsfFlowList0
                '@列選択
                Select Case llngSelectCol
                    Case CPlngvsfFlowReworkRouteID
                    '@ﾘﾜｰｸﾙｰﾄID
                        '@ﾘﾜｰｸﾙｰﾄをｺﾝﾎﾞﾘｽﾄへｾｯﾄ
                        .Cols(CPlngvsfFlowReworkRouteID).ComboList = mstrReworkCmbList
                        
                        '@編集許可
                        .StartEditing()
                        
                    Case CPlngvsfFlowSPRouteID
                    '@特殊流動ID
                        '@ﾘﾜｰｸﾙｰﾄをｺﾝﾎﾞﾘｽﾄへｾｯﾄ
                        .Cols(CPlngvsfFlowSPRouteID).ComboList = mstrSpecialCmbList
                        
                        '@編集許可
                        .StartEditing()
                    
                    Case CPlngvsfFlowReworkReturnOpID, CPlngvsfFlowSPReturnOpID
                    '@ﾘﾜｰｸﾙｰﾄ大工程/特殊ﾙｰﾄ大工程
                    
                       '@ｶﾚﾝﾄ列/行を取得
                        llngWkCol = .Col       '列
                        llngWkRow = .Row       '行
                
                        '@初期値設定
                        lstrAddString = CPstrComboBrank & CMstrPipeString
                        
                        '@配列定義
                        lstrWkString = New List(Of String)(.Row - 1)
                        For llngCnt = 0 To .Row - 1
                            lstrWkString.Add(vbNullString)
                        Next
                                
                        '@ｺﾝﾎﾞﾎﾞｯｸｽに文字列を設定
                        For llngCnt = 0 To .Row -1

                            For llngCnt2 = 0 To llngCnt -1
                            '@取得した値が既に配列に存在するかﾁｪｯｸする
                                If lstrWkString(llngCnt2) = .GetData(llngWkRow, CPlngvsfFlowOpID) Then
                                    '@配列に存在する場合
                                    lblnFlg = True              'ﾌﾗｸﾞをON
                                    Exit For
                                End If
                            Next llngCnt2
                            
                            '@重複項目有無ﾌﾗｸﾞのﾁｪｯｸ
                            If lblnFlg = False Then
                                '@いんちき大工程ではない場合のみ格納する。
                                If Mid$(.GetData(llngWkRow, CPlngvsfFlowOpID), 1, 1) <> CPstrAtMark Then
                                    '@重複項目なしの場合
                                    lstrWkString(llngCnt) = .GetData(llngWkRow, CPlngvsfFlowOpID)         '指定した行列にあるｾﾙの値を配列に入れる
                                End If
                            End If
                            
                            '@配列をｺﾝﾎﾞﾎﾞｯｸｽ格納用に整形する
                            '@結合文字列ﾁｪｯｸ
                            If llngCnt = 0 Then
                                '@最初の文字列の場合
                                lstrAddString = lstrAddString & lstrWkString(llngCnt)
                            Else
                                '@２番目以降の場合
                                
                                '@結合文字列の空白ﾁｪｯｸ
                                If lstrWkString(llngCnt) <> vbNullString Then
                                    '@結合文字列が空白ではない場合
                                    lstrAddString = lstrAddString & CMstrPipeString & lstrWkString(llngCnt)        '前回文字列に"|"を付加して結合
                                End If
                            End If
                            '@ｶｳﾝﾄﾀﾞｳﾝ
                            llngWkRow = llngWkRow - 1
                        
                        '@ﾌﾗｸﾞの初期化
                        lblnFlg = False
                            
                        Next llngCnt
               
                        '@配列のｸﾘｱ
                        lstrWkString = Nothing
                        
                        If llngSelectCol = CPlngvsfFlowReworkReturnOpID Then
                        
                            '@ｺﾝﾎﾞｾｯﾄ
                            .Cols(CPlngvsfFlowReworkReturnOpID).ComboList = lstrAddString
                        Else
                            '@ｺﾝﾎﾞｾｯﾄ
                            .Cols(CPlngvsfFlowSPReturnOpID).ComboList = lstrAddString
                        
                        End If
                       
                        '@編集許可
                        .StartEditing()
                    
                    Case CPlngvsfFlowReworkReturnStepID, CPlngvsfFlowSPReturnStepID
                    '@ﾘﾜｰｸﾙｰﾄ小工程/特殊ﾙｰﾄ小工程
                                    
                        '@初期化
                        lstrAddString = vbNullString
            
                        '@ｶﾚﾝﾄ列/行を取得
                        llngWkCol = .Col       '列
                        llngWkRow = .Row       '行
                
                        '@ﾘﾜｰｸ戻り大工程が入力済の場合
                        
                        '**  選択済みの大工程に紐づく小工程のみ表示する  **
                       
                        If llngSelectCol = CPlngvsfFlowReworkReturnStepID Then
                        
                            '@ﾘﾜｰｸ戻り大工程を退避
                            lstrOpString = .GetData(llngWkRow, CPlngvsfFlowReworkReturnOpID)
                            
                            If lstrOpString = CPstrComboBrank Then
                                '@編集不可
                                .AllowEditing = False
                                Exit Sub
                            End If
                        Else
                             '@特殊ﾙｰﾄ戻り大工程を退避
                            lstrOpString = .GetData(llngWkRow, CPlngvsfFlowSPReturnOpID)
                            
                            If lstrOpString = CPstrComboBrank Then
                                '@編集不可
                                .AllowEditing = False
                                Exit Sub
                            End If
                            
                        
                        End If
                            
                        '@初期化
                        llngCnt2 = 0
                        lblnFlg = False
                        lstrWkString = New List(Of String)

                        '@ﾌﾟﾛｾｽﾌﾛｰを検索
                         For llngCnt = 1 To llngWkRow
                         
                            If .GetData(llngCnt, CPlngvsfFlowOpID) = lstrOpString Then
                                '@配列定義
                                '@一致した大工程に紐づく小工程を配列に格納
                                lstrWkString.Add(.GetData(llngCnt, CPlngvsfFlowStepID))
                                '@ｶｳﾝﾄｱｯﾌﾟ
                                llngCnt2 = llngCnt2 + 1
                            End If
                         Next
                             
                        '@配列が存在する場合
                        If llngCnt2 > 0 Then
                           '@取得した小工程名ﾘｽﾄを結合
                           For llngCnt = 0 To lstrWkString.Count -1
                               '@結合文字列ﾁｪｯｸ
                               If llngCnt = 0 Then
                                   '@最初の文字列の場合
                                   lstrAddString = lstrWkString(llngCnt)
                               Else
                                   '@２番目以降の場合
                                   lstrAddString = lstrAddString & CMstrPipeString & lstrWkString(llngCnt)     '前回文字列に"|"を付加して結合
                               End If
                           Next
                        End If
                             
                        '@取得件数ﾁｪｯｸ
                        If llngCnt2 - 1 = 0 Then
                            '@取得件数が１件のみの場合
                            '@文字列を変数に代入
                            lstrAddString = lstrWkString(llngCnt2 - 1)
                        End If
                        
                        '@対象小工程が存在有無
                        If lstrAddString = vbNullString Then
                            lstrAddString = CPstrComboBrank
                        End If
                        
                        '@配列のｸﾘｱ
                        lstrWkString = Nothing
                        
                        '@ﾘﾜｰｸ戻り小工程/特殊ﾙｰﾄ戻り小工程
                        If llngSelectCol = CPlngvsfFlowReworkReturnStepID Then
                            '@ｺﾝﾎﾞｾｯﾄ
                            .Cols(CPlngvsfFlowReworkReturnStepID).ComboList = lstrAddString
                        Else
                            '@ｺﾝﾎﾞｾｯﾄ
                            .Cols(CPlngvsfFlowSPReturnStepID).ComboList = lstrAddString
                        End If
                        
                        '@編集許可
                        .StartEditing()
                    
                    Case Else
                        '@編集不可
                        .AllowEditing = False
                End Select
            End With
            
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvvsfFlowList_Edit"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvvsfEditLsit_Proc
    '機　能：編集用ﾘｽﾄ有効無効制御
    '引　数：lctlcontrol：編集用ｸﾞﾘｯﾄﾞ名称
    '　　　：lblnValidFlag：True：有効のみ/False：全て
    '戻り値：なし
    '作成日：2006/06/20 (Tue) 14:30:11 N.Kasai
    '更新日：2006/06/20 (Tue) 14:30:11
    '備　考：
    Private Sub prvvsfEditLsit_Proc(ByRef lctlControl As C1FlexGrid, ByVal lblnValidFlag As Boolean)

        Dim llngCol             As Integer      '有効無効列
        Dim llngCnt             As Integer      '汎用ｶｳﾝﾀ
        Dim llngNo              As Integer      'ﾘｽﾄ№採番

        Try
            
            '@ｸﾞﾘｯﾄﾞ制御
            With lctlControl
                '@情報が存在する場合
                If .Rows.Count > 1 Then

                    .Redraw = False

                    '@検索ｷｰ(Col)取得
                    For llngCnt = 1 To .Cols.Count - 1
                        '@有効・無効/適用済・廃止の行を検索する
                        If .GetData(1, llngCnt) = CMstrValid Or _
                           .GetData(1, llngCnt) = CMstrInValid Or _
                           .GetData(1, llngCnt) = CMstrApplyJ Or _
                           .GetData(1, llngCnt) = CMstrDisconJ Then
                            '@列数を退避
                            llngCol = llngCnt
                            
                            '@ﾙｰﾌﾟ抜け
                            Exit For
                        End If
                    Next llngCnt
                    
                    '@ﾁｪｯｸﾎﾞｯｸｽの状況によるﾘｽﾄの再編成
                    Select Case lblnValidFlag
                        Case True
                        '@有効のみの場合
                            '@無効のﾃﾞｰﾀを隠す
                            For llngCnt = 1 To .Rows.Count - 1
                                '@有効/無効ﾃﾞｰﾀによる処理判別
                                If .GetData(llngCnt, llngCol) = CMstrInValid Or _
                                   .GetData(llngCnt, llngCol) = CMstrDisconJ Then
                                '@無効の場合
                                    '@無効の場合：隠す
                                    .Rows(llngCnt).Visible = False
                                Else
                                '@有効の場合
                                    '@有効の場合：表示
                                    .Rows(llngCnt).Visible = True
                                End If
                            Next llngCnt
                        
                        Case False
                        '@全て
                            '@ﾃﾞｰﾀ表示する
                            For llngCnt = 1 To .Rows.Count - 1
                                If .GetData(llngCnt, llngCol) = CMstrInValid Or _
                                   .GetData(llngCnt, llngCol) = CMstrDisconJ Then
                                '@無効の場合
                                    '@ｾﾙの背景色をｸﾞﾚｰ表記にする
                                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CPlngGridDarkGray")
                                    newStyle.BackColor = ColorTranslator.FromWin32(CPlngGridDarkGray)
                                    Dim cellRange As CellRange = .GetCellRange(llngCnt, CPlngvsfFlowNo, _
                                                           llngCnt, .Cols.Count - 1)
                                    cellRange.Style = newStyle              '背景色:濃いｸﾞﾚｰ
                                Else
                                '@有効の場合
                                    '@ｾﾙの背景色を白表記にする
                                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_vbWhite")
                                    newStyle.BackColor = Color.White
                                    Dim cellRange As CellRange = .GetCellRange(llngCnt, CPlngvsfFlowNo, _
                                                           llngCnt, .Cols.Count - 1)
                                    cellRange.Style = newStyle                        '背景色:白
                                End If
                                '@有効の場合：表示
                                .Rows(llngCnt).Visible = True
                            Next llngCnt
                    End Select
                    
                    '@番号を振りなおす
                    llngNo = 1
                    For llngCnt = 1 To .Rows.Count - 1
                        '@表示状態の場合
                        If .Rows(llngCnt).Visible = True Then
                            '@番号を振りなおす
                            .SetData(llngCnt, CPlngvsfFlowNo, llngNo)
                            
                            '@ｶｳﾝﾄｱｯﾌﾟ
                            llngNo = llngNo + 1
                        End If
                    Next llngCnt

                    .Redraw = True
                End If
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvvsfEditLsit_Proc"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvvsfEditLsitCondition_Proc
    '機　能：編集用ﾘｽﾄ有効無効制御(prvvsfEditLsit_Procを処理条件専用に分離)
    '引　数：なし
    '戻り値：なし
    '作成日：2018/06/26 (Tue) 11:12:07 T.Oide
    '更新日：2018/06/26 (Tue) 11:12:07
    '備　考：
    Private Sub prvvsfEditLsitCondition_Proc()

        Dim llngCnt             As Integer      '汎用ｶｳﾝﾀ
        Dim llngNo              As Integer      'ﾘｽﾄ№採番
        Dim lngDispMode         As Integer      '表示モード

        Try
            
            '@ｸﾞﾘｯﾄﾞ制御
            With vsfConditionList1
                
                '@情報が存在する場合
                If .Rows.Count > 1 Then

                    '@有効のみOFF、最新のみOFF
                    If chkValidCondition.Checked = False And _
                       chkMaxVer.Checked = False Then
                       
                        '@全て表示
                        lngDispMode = CMlngCondDispMode0
                    
                    End If
                    
                    '@有効のみOFF、最新のみON
                    If chkValidCondition.Checked = False And _
                       chkMaxVer.Checked = True Then
                       
                        '@有効+無効で最新を表示
                        lngDispMode = CMlngCondDispMode1
                    
                    End If
                    
                    '@有効のみON、最新のみOFF
                    If chkValidCondition.Checked = True And _
                       chkMaxVer.Checked = False Then
                       
                        '@有効全て表示
                        lngDispMode = CMlngCondDispMode2
                    
                    End If
                    
                    '@有効のみON、最新のみON
                    If chkValidCondition.Checked = True And _
                       chkMaxVer.Checked = True Then
                       
                        '@有効最新
                        lngDispMode = CMlngCondDispMode3
                    
                    End If
                    
                    .Redraw = False

                    '@行で回す
                    For llngCnt = 1 To .Rows.Count - 1
                    
                        '@表示ﾓｰﾄﾞで分岐
                        Select Case lngDispMode
                        
                            '@0：全て表示
                            Case CMlngCondDispMode0
                            
                                '@行表示
                                .Rows(llngCnt).Visible = True
                                
                            '@1：有効+無効で最新のみ表示
                            Case CMlngCondDispMode1
                            
                                If .GetData(llngCnt, CPlngvsfConListMaxVerFlag) = CMlngValid Then
                                
                                    '@行表示
                                    .Rows(llngCnt).Visible = True
                                Else
                                    '@行非表示
                                    .Rows(llngCnt).Visible = False
                                End If
                                
                            '@2：有効なものを全て表示
                            Case CMlngCondDispMode2
                            
                                If .GetData(llngCnt, CPlngvsfConListStatID) = CMstrApplyJ Then
                                    '@行表示
                                    .Rows(llngCnt).Visible = True
                                Else
                                    '@行非表示
                                    .Rows(llngCnt).Visible = False
                                End If
                            
                            '@3：有効で最新Verのみ表示
                            Case CMlngCondDispMode3
                            
                                If .GetData(llngCnt, CPlngvsfConListStatID) = CMstrApplyJ And _
                                   .GetData(llngCnt, CPlngvsfConListMaxVerFlag) = CMlngValid Then
                                    '@行表示
                                    .Rows(llngCnt).Visible = True
                                Else
                                    '@行非表示
                                    .Rows(llngCnt).Visible = False
                                End If
                        
                        End Select
                        
                        '@処理条件のステータスでｸﾞﾘｯﾄﾞ背景色設定
                        '@有効最新か
                        If .GetData(llngCnt, CPlngvsfConListStatID) = CMstrApplyJ And _
                           .GetData(llngCnt, CPlngvsfConListMaxVerFlag) = CMlngValid Then
                            
                            '@背景色を白表示
                            Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_vbWhite")
                            newStyle.BackColor = Color.White
                            Dim cellRange As CellRange = .GetCellRange(llngCnt, CPlngvsfFlowNo, _
                                                   llngCnt, .Cols.Count - 1)
                            cellRange.Style = newStyle
                        
                        '@有効旧Verか
                        ElseIf .GetData(llngCnt, CPlngvsfConListStatID) = CMstrApplyJ And _
                               .GetData(llngCnt, CPlngvsfConListMaxVerFlag) = vbNullString Then
                                        
                            '@背景色をｸﾞﾚｰ表示
                            Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CPlngGridGray")
                            newStyle.BackColor = ColorTranslator.FromWin32(CPlngGridGray)
                            Dim cellRange As CellRange = .GetCellRange(llngCnt, CPlngvsfFlowNo, _
                                                   llngCnt, .Cols.Count - 1)
                            cellRange.Style = newStyle
                                  
                        '@無効か
                        ElseIf .GetData(llngCnt, CPlngvsfConListStatID) = CMstrInValid Or _
                               .GetData(llngCnt, CPlngvsfConListStatID) = CMstrDisconJ Then
                                        
                            '@背景色をｸﾞﾚｰ、文字を赤表示
                            Dim newStyle As CellStyle
                            Dim cellRange As CellRange
                            newStyle = .Styles.Add("CustomStyle_BackColor_CPlngGridGray_ForeColor_Red")
                            newStyle.BackColor = ColorTranslator.FromWin32(CPlngGridGray)
                            newStyle.ForeColor = Color.Red
                            cellRange = .GetCellRange(llngCnt, CPlngvsfFlowNo, _
                                                   llngCnt, .Cols.Count - 1)
                            cellRange.Style = newStyle
                                  
                        End If
                    
                    Next llngCnt

                    
                    '@番号を振りなおす
                    llngNo = 1
                    For llngCnt = 1 To .Rows.Count - 1
                        '@表示状態の場合
                        If .Rows(llngCnt).Visible = True Then
                            '@番号を振りなおす
                            .SetData(llngCnt, CPlngvsfFlowNo, llngNo)
                            
                            '@ｶｳﾝﾄｱｯﾌﾟ
                            llngNo = llngNo + 1
                        End If
                    Next llngCnt

                    .Redraw = True

                End If
                
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvvsfEditLsitCondition_Proc"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvblnvsfEditListInValid_Chk
    '機　能：編集用ﾘｽﾄ有効無効ﾁｪｯｸ
    '引　数：lctlControl：編集用ｸﾞﾘｯﾄﾞ名称
    '　　　：llngSelectRow：選択行
    '戻り値：True：貼り付けOK/False：貼り付けNG
    '作成日：2006/06/20 (Tue) 17:03:11 N.Kasai
    '更新日：2006/06/20 (Tue) 17:03:11
    '備　考：
    Private Function prvblnvsfEditListInValid_Chk(ByRef lctlControl As C1FlexGrid, ByVal llngSelectRow As Integer) As Boolean

        Dim llngCol             As Integer      '有効無効列
        Dim llngCnt             As Integer      '汎用ｶｳﾝﾀ
        Dim llngMsgAns          As Integer
        Try
            
            '@初期化
            prvblnvsfEditListInValid_Chk = False
            
            '@ｸﾞﾘｯﾄﾞ制御
            With lctlControl
                '@情報が存在する場合
                If llngSelectRow > 0 Then
                    '@検索ｷｰ(Col)取得
                    For llngCnt = 1 To .Cols.Count - 1
                        '@有効・無効/適用済・廃止の行を検索する
                        If .GetData(1, llngCnt) = CMstrValid Or _
                           .GetData(1, llngCnt) = CMstrInValid Or _
                           .GetData(1, llngCnt) = CMstrApplyJ Or _
                           .GetData(1, llngCnt) = CMstrDisconJ Then
                            '@列数を退避
                            llngCol = llngCnt
                            
                            '@ﾙｰﾌﾟ抜け
                            Exit For
                        End If
                    Next llngCnt
                    
                    '@選択行が有効の場合
                    If .GetData(llngSelectRow, llngCol) = CMstrValid Or _
                       .GetData(llngSelectRow, llngCol) = CMstrApplyJ Then
                        '@成功を返す
                        prvblnvsfEditListInValid_Chk = True
                    End If
                End If
            End With
            
            '@ﾁｪｯｸ判定
            If prvblnvsfEditListInValid_Chk = False Then

                '@表示ﾒｯｾｰｼﾞ変換
                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005M)

                '@"<TRM5MI>$$選択された内容は無効データです。処理を続行しますか？"
                llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)

                '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                If llngMsgAns = vbNo Then       '「いいえ」を選択(削除処理ｷｬﾝｾﾙ)
                    Exit Function
                Else
                    '@成功を返す
                    prvblnvsfEditListInValid_Chk = True
                End If
                
            End If
            
            Exit Function

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvblnvsfEditListInValid_Chk"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Function

    '関数名：prvblnvsfEditListInValidCnd_Chk
    '機　能：編集用ﾘｽﾄ有効無効ﾁｪｯｸ
    '引　数：llngSelectRow：選択行
    '戻り値：True：貼り付けOK/False：貼り付けNG
    '作成日：2018/06/28 (Thu) 17:05:07 T.Oide
    '更新日：2018/06/28 (Thu) 17:05:07
    '備　考：
    Private Function prvblnvsfEditListInValidCnd_Chk(ByVal llngSelectRow As Integer) As Boolean
        
        Try
            
            '@結果初期化
            prvblnvsfEditListInValidCnd_Chk = False
            
            '@ｸﾞﾘｯﾄﾞ制御
            With vsfConditionList1
            
                '@情報が存在する場合
                If llngSelectRow > 0 Then
                            
                    '@選択行が有効の場合
                    If .GetData(llngSelectRow, CPlngvsfConListStatID) = CMstrValid Or _
                       .GetData(llngSelectRow, CPlngvsfConListStatID) = CMstrApplyJ Then
                        '@成功を返す
                        prvblnvsfEditListInValidCnd_Chk = True
                    End If
                End If
                
            End With
            
            '@結果判定
            If prvblnvsfEditListInValidCnd_Chk = False Then
            
                '@"<TRM7OI>$$選択された内容は無効データです。選択できません。"
                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf007O)
                Call publngMsgBox(pstrDMsg & vbCrLf, vbInformation, Me.Text, True, 16, False)
                
            End If
            
            Exit Function

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvblnvsfEditListInValidCnd_Chk"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Function

    '関数名：prvblnDisconCellCopy_Chk
    '機　能：単一ｺﾋﾟｰDisconﾁｪｯｸ
    '引　数：llngIndex：ﾌﾛｰﾘｽﾄｸﾞﾘｯﾄﾞｲﾝﾃﾞｯｸｽ
    '　　　：llngRow：該当行
    '　　　：llngCol：該当列
    '戻り値：True：貼り付け可、Flase：貼り付け不可
    '作成日：2006/08/29 (Tue) 13:28:11 N.Kasai
    '更新日：2006/08/29 (Tue) 13:28:11
    '備　考：
    Private Function prvblnDisconCellCopy_Chk(ByVal lvsfFlowList As C1FlexGrid, ByVal llngRow As Integer, ByVal llngCol As Integer) As Boolean

        Dim llngMsgAns  As Integer  'ﾒｯｾｰｼﾞ戻り値
        
        Try
            
            '@戻り値初期化
            prvblnDisconCellCopy_Chk = True
            
            With lvsfFlowList
            
                Select Case llngCol
                    
                    '@処理条件ID
                    Case CPlngvsfFlowConditionID
                        '@処理条件有効ﾌﾗｸﾞ
                        If .GetData(.Row, CPlngvsfFlowConditionValid) <> CMlngValid Then
                            '@廃止の場合
                                                    
                            '@表示ﾒｯｾｰｼﾞ変換
                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005M)
                
                            '@"<TRM5MI>$$選択された内容は無効データです。処理を続行しますか？"
                            llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                            '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                            If llngMsgAns = vbNo Then       '「いいえ」を選択(削除処理ｷｬﾝｾﾙ)
                                '@貼り付け不可
                                prvblnDisconCellCopy_Chk = False
                                
                                Exit Function
                            End If
                        
                        End If
                        
                    '@収集項目
                    Case CPlngvsfFlowCollectionID
                        '@収集項目有効ﾌﾗｸﾞ
                        If .GetData(.Row, CPlngvsfFlowCollectionValid) <> CMlngValid Then
                            '@廃止の場合
                                                    
                            '@表示ﾒｯｾｰｼﾞ変換
                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005M)
                
                            '@"<TRM5MI>$$選択された内容は無効データです。処理を続行しますか？"
                            llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                            '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                            If llngMsgAns = vbNo Then       '「いいえ」を選択(削除処理ｷｬﾝｾﾙ)
                                '@貼り付け不可
                                prvblnDisconCellCopy_Chk = False
                                
                                Exit Function
                            End If
                        End If
                
                End Select
            End With
            
            Exit Function

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey
                .strProcName = "prvblnDisconCellCopy_Chk"
                .strErrMessage = vbNullString
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
        End Try
    End Function

    '関数名：prvblnDisconRowCopy_Chk
    '機　能：行ｺﾋﾟｰ時のDisconﾁｪｯｸ
    '引　数：llngRow：該当行
    '戻り値：True:disconあり、False:Disconなし
    '作成日：2006/08/29 (Tue) 10:28:46 N.Kasai
    '更新日：2006/08/29 (Tue) 10:28:46
    '備　考：
    Private Function prvblnDisconRowCopy_Chk(ByVal llngRow As Integer) As Boolean

        Try
            
            '@初期化
            prvblnDisconRowCopy_Chk = False
            
            '@必要情報を内部変数へ退避
            With vsfFlowList0
            
                '@処理条件ｾｯﾄID/Ver
                Dim newStyle As CellStyle
                Dim cellRange As CellRange
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                cellRange = .GetCellRange(llngRow, CPlngvsfFlowConditionVer, _
                                       llngRow, CPlngvsfFlowConditionVer)
                cellRange.Style = newStyle
                '@収集項目ｾｯﾄIDVerのﾊﾞｯｸｶﾗｰを変更不可色へ変更
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                cellRange = .GetCellRange(llngRow, CPlngvsfFlowCollectionVer, _
                                       llngRow, CPlngvsfFlowCollectionVer)
                cellRange.Style = newStyle
                '@代替工程部分のﾊﾞｯｸｶﾗｰを変更
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                cellRange = .GetCellRange(llngRow, CPlngvsfFlowAltSet, _
                                       llngRow, CPlngvsfFlowAltEndFlag)
                cellRange.Style = newStyle

            
                '@大工程情報
                If .GetData(llngRow, CPlngvsfFlowOpID) <> vbNullString Then
                    '@ﾌﾗｸﾞ判定
                    If .GetData(llngRow, CPlngvsfFlowOpValid) <> "1" Then              '大工程有効ﾌﾗｸﾞ
                        '@ﾊﾞｯｸｶﾗｰを変更
                        .Row = llngRow
                        .Col = CPlngvsfFlowOpID
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorYellow")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorYellow)
                        cellRange = .GetCellRange(.Row, .Col)
                        cellRange.Style = newStyle
                                            
                        prvblnDisconRowCopy_Chk = True
                        
                    End If
                End If
                
                
                '@小工程情報
                If .GetData(llngRow, CPlngvsfFlowStepID) <> vbNullString Then
                    '@ﾌﾗｸﾞ判定
                    If .GetData(llngRow, CPlngvsfFlowStepValid) <> "1" Then            '小工程有効ﾌﾗｸﾞ
                        '@ﾊﾞｯｸｶﾗｰを変更
                        .Row = llngRow
                        .Col = CPlngvsfFlowStepID
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorYellow")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorYellow)
                        cellRange = .GetCellRange(.Row, .Col)
                        cellRange.Style = newStyle
                                            
                        prvblnDisconRowCopy_Chk = True
                        
                    End If
                End If
                
                
                '@処理条件情報
                If .GetData(llngRow, CPlngvsfFlowConditionID) <> vbNullString Then
                    '@ﾌﾗｸﾞ判定
                    If .GetData(llngRow, CPlngvsfFlowConditionValid) <> "1" Then       '処理条件有効ﾌﾗｸﾞ
                        '@ﾊﾞｯｸｶﾗｰを変更
                        .Row = llngRow
                        .Col = CPlngvsfFlowConditionID
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorYellow")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorYellow)
                        cellRange = .GetCellRange(.Row, .Col)
                        cellRange.Style = newStyle
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorYellow")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorYellow)
                        cellRange = .GetCellRange(.Row, CPlngvsfFlowConditionVer)
                        cellRange.Style = newStyle
                        
                        prvblnDisconRowCopy_Chk = True
                        
                    End If
                End If
                
                '@収集項目
                 If .GetData(llngRow, CPlngvsfFlowCollectionID) <> vbNullString Then
                    '@ﾌﾗｸﾞ判定
                    If .GetData(llngRow, CPlngvsfFlowCollectionValid) <> "1" Then      '収集項目有効ﾌﾗｸﾞ
                        '@ﾊﾞｯｸｶﾗｰを変更
                        .Row = llngRow
                        .Col = CPlngvsfFlowCollectionID
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorYellow")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorYellow)
                        cellRange = .GetCellRange(.Row, .Col)
                        cellRange.Style = newStyle
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorYellow")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorYellow)
                        cellRange = .GetCellRange(.Row, CPlngvsfFlowCollectionVer)
                        cellRange.Style = newStyle
                        
                        prvblnDisconRowCopy_Chk = True
                        
                    End If
                End If
                
                
                '@ﾘﾜｰｸﾙｰﾄ
                If .GetData(llngRow, CPlngvsfFlowReworkRouteID) <> vbNullString Then
                    '@ﾌﾗｸﾞ判定
                    If .GetData(llngRow, CPlngvsfFlowReworkRouteValid) <> "1" Then     'ﾘﾜｰｸﾙｰﾄ有効ﾌﾗｸﾞ
                        '@空ﾘﾜｰｸの場合はﾁｪｯｸしない
                        If .GetData(llngRow, CPlngvsfFlowReworkRouteID) <> CMstrEmptyRework Then
                            '@ﾊﾞｯｸｶﾗｰを変更
                            .Row = llngRow
                            .Col = CPlngvsfFlowReworkRouteID
                            newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorYellow")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorYellow)
                            cellRange = .GetCellRange(.Row, .Col)
                            cellRange.Style = newStyle
                                    
                            prvblnDisconRowCopy_Chk = True
                        End If
                    End If
                End If
                
                '@特殊ﾙｰﾄ
                If .GetData(llngRow, CPlngvsfFlowSPRouteID) <> vbNullString Then
                    'ﾌﾗｸﾞ判定
                    If .GetData(llngRow, CPlngvsfFlowSPRouteValid) <> "1" Then         '特殊ﾙｰﾄ有効ﾌﾗｸﾞ
                        '@空ﾘﾜｰｸの場合はﾁｪｯｸしない
                        If .GetData(llngRow, CPlngvsfFlowSPRouteID) <> CMstrAddFlowNo Then
                            '@ﾊﾞｯｸｶﾗｰを変更
                            .Row = llngRow
                            .Col = CPlngvsfFlowSPRouteID
                            newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorYellow")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorYellow)
                            cellRange = .GetCellRange(.Row, .Col)
                            cellRange.Style = newStyle
                                    
                            prvblnDisconRowCopy_Chk = True
                        End If
                    End If
                End If
            
            End With
            
            Exit Function

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey
                .strProcName = "prvblnDisconRowCopy_Chk"
                .strErrMessage = vbNullString
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Function

    '関数名：prvPasteCopyLine_Exec
    '機　能：行挿入処理
    '引　数：なし
    '戻り値：なし
    '作成日：2006/07/06 (Thu) 14:26:48 N.Kasai
    '更新日：2017/11/01 (Wed) 15:00:40 T.Oide
    '　　　：2009/02/13 (Fri) 10:10:18 T.Oide   Chip電特対応(CDEN_CLASS追加)
    '備　考：
    '      ：2016/02/08 (Mon) 22:54:20 H.Hayashi    GRB対応(R12-04)
    Private Sub prvPasteCopyLine_Exec()

        Dim llngCnt         As Integer      'ｶｳﾝﾀ
        Dim llngCnt2        As Integer      'ｶｳﾝﾀ2
        Dim llngRowPos      As Integer      'ｺﾋﾟｰ行挿入位置
        Dim lblnAns         As Boolean      '汎用戻り値
        Dim llngIndex       As Integer      '現在行
        Dim llbnCK          As Boolean      'ｴﾗｰﾌﾗｸﾞ（True:ｴﾗｰあり、False：ｴﾗｰなし）
        Dim nKeepRow        As Integer
        Dim strKeepGroup    As String
        Dim oApcTeosData    As TypeApcTeos
        
        Try
            
            nKeepRow = -1
            strKeepGroup = ""
            oApcTeosData.strCalcSkipFlag = "0"
            oApcTeosData.strApcType = ""
            oApcTeosData.strGroupNo = ""
            oApcTeosData.strNoInGroup = ""
            
            '@ｴﾗｰ判定ﾌﾗｸﾞ初期化
            llbnCK = False
            
            With vsfFlowList0
                
                '@選択行が見出し行も含めた場合
                If mlngWkRow = -1 Then
                    '@例外処理
                    mlngWkRow = 1
                End If
                
                '@ｲﾝﾌｫﾒｰｼｮﾝ画面起動
                frmxxCM00X0.Instance = New frmxxCM00X0()

                '@ﾌｫｰﾑのｷｬﾌﾟｼｮﾝ設定
                frmxxCM00X0.Instance.Text = Me.Text
                                                
                '@ｺﾋﾟｰ行挿入位置
                llngRowPos = mlngWkRow
                .Col = CPlngvsfFlowOpID
                
                frmxxCM00X0.Instance.lblInfomation1.Text = "工順コピー中です。"
                    
                '@ｲﾝﾌｫﾒｰｼｮﾝﾌｫｰﾑを先行して描画する為、記述しています。
                frmxxCM00X0.Instance.Show(Me)
                frmxxCM00X0.Instance.Refresh
                Me.Refresh

                '@描画なし
                .Redraw = False

                '@ｺﾋﾟｰ内容挿入
                For llngCnt = 0 To mtypCopyFlowList.lngLotProcFlowCnt -1
                                                   
                    '@空行追加
                    .AddItem(vbNullString, llngRowPos)
                    
                    '@実ﾃﾞｰﾀ追加
                    .SetData(llngRowPos, CPlngvsfFlowAbsNo, plngSeqNoCnt)                                                             '絶対工順番号
                    .SetData(llngRowPos, CPlngvsfFlowOpID, mtypCopyFlowList.typLotProcFlow(llngCnt).strOpID)                          '大工程名
                    .SetData(llngRowPos, CPlngvsfFlowStepID, mtypCopyFlowList.typLotProcFlow(llngCnt).strStepID)                      '小工程名
                    .SetData(llngRowPos, CPlngvsfFlowConditionID, mtypCopyFlowList.typLotProcFlow(llngCnt).strConditionId)            '処理条件ｾｯﾄ
                    .SetData(llngRowPos, CPlngvsfFlowConditionVer, mtypCopyFlowList.typLotProcFlow(llngCnt).strConditionVersion)      '処理条件Ver
                    .SetData(llngRowPos, CPlngvsfFlowConditionOne, mtypCopyFlowList.typLotProcFlow(llngCnt).strConditionOne)          '処理条件（個別）
                    
                    '@個別処理条件が設定済み
                    If .GetData(llngRowPos, CPlngvsfFlowConditionOne) <> vbNullString Then
                        '@ｲﾝﾃﾞｯｸｽ初期化
                        llngIndex = -1

                        '@個別処理条件構造体検索
                        '　「ｺﾋﾟｰ元のSeq_No」と「ｺﾋﾟｰ用に確保した構造体」のstrAbsNoが一致しているところを
                        '　　探してｺﾋﾟｰしてあげるﾃﾞｰﾀとする
                        For llngCnt2 = 0 To ptypCopyCondDetailList.lngProcCondDetailCnt -1
                            '@「ｺﾋﾟｰ元のSeq_No」と「ｺﾋﾟｰ用に確保した構造体」のstrAbsNoが一致しているか
                            If mtypCopyFlowList.typLotProcFlow(llngCnt).strAbsNo = ptypCopyCondDetailList.typProcCondDetail(llngCnt2).strAbsNo Then
                                llngIndex = llngCnt2
                                Exit For
                            End If
                        Next
                        
                        '@ｲﾝﾃﾞｯｸｽが存在する場合
                        If llngIndex <> -1 Then
                        
                            With ptypProcCondDetailList
                                '@個別処理設定配列を再定義(新しい列の追加なので要素をﾌﾟﾗｽする)
                                .lngProcCondDetailCnt = .lngProcCondDetailCnt + 1
                                If .typProcCondDetail Is Nothing Then
                                    .typProcCondDetail = New List(Of ProcCondDetail)
                                End If
                                Dim ltypProcCondDetailTmp As New ProcCondDetail
                                '@個別処理条件反映
                                ltypProcCondDetailTmp = ptypCopyCondDetailList.typProcCondDetail(llngIndex)
                                If ptypCopyCondDetailList.typProcCondDetail(llngIndex).typProcCond IsNot Nothing Then
                                    ltypProcCondDetailTmp.typProcCond = _
                                        New List(Of ProcCond)(ptypCopyCondDetailList.typProcCondDetail(llngIndex).typProcCond)
                                End If
                                ltypProcCondDetailTmp.strAbsNo = plngSeqNoCnt   '工順番号ｾｯﾄ
                                .typProcCondDetail.Add(ltypProcCondDetailTmp)

                                '@ｲﾝﾃﾞｯｸｽを設定
                                plngLotCondDetailIndex = .lngProcCondDetailCnt
                            End With

                        End If
                        '@絶対工順番号採番
                        plngSeqNoCnt = plngSeqNoCnt + 1
                        
                        '@個別処理条件「未設定」の場合
                        Dim newStyle1 As CellStyle
                        Dim cellRange1 As CellRange
                        If .GetData(llngRowPos, CPlngvsfFlowConditionOne) = CPstrRecpNot Then
                            newStyle1 = .Styles.Add("CustomStyle_ForeColor_vbRed")
                            newStyle1.ForeColor = Color.Red
                            cellRange1 = .GetCellRange(llngRowPos, CPlngvsfFlowConditionOne)
                            cellRange1.Style = newStyle1
                        Else
                            newStyle1 = .Styles.Add("CustomStyle_ForeColor_vbBlack")
                            newStyle1.ForeColor = Color.Black
                            cellRange1 = .GetCellRange(llngRowPos, CPlngvsfFlowConditionOne)
                            cellRange1.Style = newStyle1
                        End If
                    Else
                        '@絶対工順番号採番
                        plngSeqNoCnt = plngSeqNoCnt + 1
                    End If
                    
                    .SetData(llngRowPos, CPlngvsfFlowSelectConditionID, mtypCopyFlowList.typLotProcFlow(llngCnt).strSelectConditionID)    'WF選択条件ｾｯﾄID
                    .SetData(llngRowPos, CPlngvsfFlowCollectionID, mtypCopyFlowList.typLotProcFlow(llngCnt).strCollectionID)              '収集項目ｾｯﾄID
                    .SetData(llngRowPos, CPlngvsfFlowCollectionVer, mtypCopyFlowList.typLotProcFlow(llngCnt).strCollectionVersion)        '収集項目Ver
                    .SetData(llngRowPos, CPlngvsfFlowLotScrapSetId, mtypCopyFlowList.typLotProcFlow(llngCnt).strLotScrapSetID)            '不良項目ｾｯﾄID
                    .SetData(llngRowPos, CPlngvsfFlowReworkRouteID, mtypCopyFlowList.typLotProcFlow(llngCnt).strReworkRouteID)            'ﾘﾜｰｸﾙｰﾄID
                    .SetData(llngRowPos, CPlngvsfFlowSPRouteID, mtypCopyFlowList.typLotProcFlow(llngCnt).strSpecialRouteID)               '特殊ﾙｰﾄID
                    .SetData(llngRowPos, CPlngvsfFlowLotRecipeFlag, mtypCopyFlowList.typLotProcFlow(llngCnt).strLotRecipeFlag)            'ﾛｯﾄﾚｼﾋﾟﾌﾗｸﾞ
                    .SetData(llngRowPos, CPlngvsfFlowWFRecipeFlag, mtypCopyFlowList.typLotProcFlow(llngCnt).strWfRecipeFlag)              '枚葉ﾚｼﾋﾟﾌﾗｸﾞ
                    .SetData(llngRowPos, CPlngvsfFlowSFlag, mtypCopyFlowList.typLotProcFlow(llngCnt).strSFlag)                            '特殊特性
                    .SetData(llngRowPos, CPlngvsfFlowEntryID, mtypCopyFlowList.typLotProcFlow(llngCnt).strEntryID)                        'ｴﾝﾄﾘID
                    .SetData(llngRowPos, CPlngvsfFlowRecipeChgFlg, mtypCopyFlowList.typLotProcFlow(llngCnt).strProcChangeRecipeFlag)      '工順変更ﾚｼﾋﾟ変更ﾌﾗｸﾞ
                    .SetData(llngRowPos, CPlngvsfFlowWorkCondition, mtypCopyFlowList.typLotProcFlow(llngCnt).strWorkCondition)            '作業条件
                    .SetData(llngRowPos, CPlngvsfFlowCommitFlag, mtypCopyFlowList.typLotProcFlow(llngCnt).strCommitFlag)                  '号機指定
                    .SetData(llngRowPos, CPlngvsfFlowJudgeSkipFlag, mtypCopyFlowList.typLotProcFlow(llngCnt).strJudgeSkipFlag)            'SPC判定ｽｷｯﾌﾟﾌﾗｸﾞ( 0: SKIP不可、1:SKIP可）
                    
                    '@編集ﾌﾗｸﾞ
                    .SetData(llngRowPos, CPlngvsfFlowState, mtypCopyFlowList.typLotProcFlow(llngCnt).strState)                            '状態（追加挿入）
                    .SetData(llngRowPos, CPlngvsfFlowPermit, mtypCopyFlowList.typLotProcFlow(llngCnt).strPermit)                          '変更可否（変更可）
                    .SetData(llngRowPos, CPlngvsfFlowChange, mtypCopyFlowList.typLotProcFlow(llngCnt).strChange)                          '変更区分（変更あり）
                    
                    '@Discon情報
                    .SetData(llngRowPos, CPlngvsfFlowOpValid, mtypCopyFlowList.typLotProcFlow(llngCnt).strOpValid)                        '大工程有効ﾌﾗｸﾞ
                    .SetData(llngRowPos, CPlngvsfFlowStepValid, mtypCopyFlowList.typLotProcFlow(llngCnt).strStepValid)                    '小工程有効ﾌﾗｸﾞ
                    .SetData(llngRowPos, CPlngvsfFlowConditionValid, mtypCopyFlowList.typLotProcFlow(llngCnt).strConditionValid)          '処理条件ｾｯﾄID有効ﾌﾗｸﾞ
                    .SetData(llngRowPos, CPlngvsfFlowCollectionValid, mtypCopyFlowList.typLotProcFlow(llngCnt).strCollectionValid)        '収集項目ｾｯﾄID有効ﾌﾗｸﾞ
                    .SetData(llngRowPos, CPlngvsfFlowReworkRouteValid, mtypCopyFlowList.typLotProcFlow(llngCnt).strReworkRouteValid)      'ﾘﾜｰｸﾙｰﾄID有効ﾌﾗｸﾞ
                    .SetData(llngRowPos, CPlngvsfFlowSPRouteValid, mtypCopyFlowList.typLotProcFlow(llngCnt).strSpecialRouteValid)         '特殊ﾙｰﾄID有効ﾌﾗｸﾞ
                    
                    .SetData(llngRowPos, CPlngvsfFlowCdenClass, mtypCopyFlowList.typLotProcFlow(llngCnt).strCdenClass)                    'CDEN_CLASS
                    .SetData(llngRowPos, CPlngvsfFlowTpalClass, mtypCopyFlowList.typLotProcFlow(llngCnt).strTpalClass)                    'TPAL設定
                    .SetData(llngRowPos, CPlngvsfFlowCarrierCategoryID, mtypCopyFlowList.typLotProcFlow(llngCnt).strCarrierCategoryId)    'ｷｬﾘｱｶﾃｺﾞﾘ
                    .SetData(llngRowPos, CPlngvsfFlowGrbClass, mtypCopyFlowList.typLotProcFlow(llngCnt).strGrbClass)                      'GRB限定工程設定

                    '@右ｸﾘｯｸの場合Rowの値が取れない為、挿入行の値を代入する。
                    .Row = llngRowPos
                    
                    '@Disconﾁｪｯｸ
                    lblnAns = prvblnDisconRowCopy_Chk(llngRowPos)
                    '@判定
                    If lblnAns = True Then
                        llbnCK = True
                    End If
                    
                    
                    '----------------------
                    '@ｺﾋﾟｰ不可項目のｸﾘｱ
                    '----------------------
                    '@ﾘﾜｰｸﾙｰﾄ戻り大工程-小工程
                    .SetData(llngRowPos, CPlngvsfFlowReworkReturnOpID, vbNullString)
                    .SetData(llngRowPos, CPlngvsfFlowReworkReturnStepID, vbNullString)
                    
                    '@特殊ﾙｰﾄ戻り大工程-小工程
                    .SetData(llngRowPos, CPlngvsfFlowSPReturnOpID, vbNullString)
                    .SetData(llngRowPos, CPlngvsfFlowSPReturnStepID, vbNullString)
                    
                    '@入替工程
                    .SetData(llngRowPos, CPlngvsfFlowSwapIndictor, vbNullString)
                    .SetData(llngRowPos, CPlngvsfFlowSwapIndictorCopy, vbNullString)
                    
                    '@代替工程
                    .SetData(llngRowPos, CPlngvsfFlowAltSet, vbNullString)
                    .SetData(llngRowPos, CPlngvsfFlowAltStartFlag, "0")
                    .SetData(llngRowPos, CPlngvsfFlowAltEndFlag, "0")
                    
                    '@時間制限
                    .SetData(llngRowPos, CPlngvsfFlowTimeLimit, vbNullString)
                    .SetData(llngRowPos, CPlngvsfFlowTimeLimitFlag, "0")

                    
                    '@APC設定
                    .SetData(llngRowPos, CPlngvsfFlowApc, vbNullString)                 'APC設定
                    .SetData(llngRowPos, CPlngvsfFlowApcSkipFlag, CMstrFlgOff)          'F/B適用外
                    .SetData(llngRowPos, CPlngvsfFlowApcCalcSkipFlag, CMstrFlgOff)
                    
                    'APC設定解除：APC枚葉設定も不可(FF-Pにしか設定できないため)
                    .SetCellCheck(llngRowPos, CPlngvsfFlowApcWfUnitFlgSetable, CheckEnum.Unchecked)
                    Call ControlApcWfUnitFlg(vsfFlowList0, llngRowPos)
                    
                    '@APC設定のﾊﾞｯｸｶﾗｰを変更
                    Dim newStyle As CellStyle
                    Dim cellRange As CellRange
                    newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                    cellRange = .GetCellRange(llngRowPos, CPlngvsfFlowApc, llngRowPos, _
                                                CPlngvsfFlowApcCalcSkipFlag)
                    cellRange.Style = newStyle
                                                
                    '@処理号機設定
                    .SetData(llngRowPos, CPlngvsfFlowWpRestrict, vbNullString)        '処理号機
                    .SetData(llngRowPos, CPlngvsfFlowWpRestrictFlag, "0")             '処理号機ﾌﾗｸﾞ(変更なし)

                    '@ﾏｯﾌﾟ適用ﾌﾗｸﾞ
                    .SetData(llngRowPos, CPlngvsfFlowMapUseFlag, CMstrFlgOff)          '非自動適用
                    '組立(2A0)以外無効化
                    If pstrSBID <> CPstrSBID2A0 Then
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                        cellRange = .GetCellRange(llngRowPos, CPlngvsfFlowMapUseFlag, _
                                                llngRowPos, CPlngvsfFlowMapUseFlag)
                        cellRange.Style = newStyle
                    End If

                    '@TEOS F/B設定
                    Call SetApcTeosData(vsfFlowList0, llngRowPos, oApcTeosData, nKeepRow, strKeepGroup)
                    Call UpdateApcTeosSkip(vsfFlowList0, llngRowPos)

                    '@TEOS PrismAPC設定
                    .SetData(llngRowPos, CPlngvsfFlowTeosPrismAPC, vbNullString)
                    newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                    cellRange = .GetCellRange(llngRowPos, CPlngvsfFlowTeosPrismAPC, _
                                           llngRowPos, CPlngvsfFlowTeosPrismAPC)
                    cellRange.Style = newStyle

        '@↓2018/04/05 (Thu) 10:59:58 T.Oide **************************************************
                    '@「ﾚｼﾋﾟ選択APC」設定
                    .SetData(llngRowPos, CPlngvsfFlowRecpSelApc, vbNullString)
                    newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                    cellRange = .GetCellRange(llngRowPos, CPlngvsfFlowRecpSelApc, _
                                           llngRowPos, CPlngvsfFlowRecpSelApc)
                    cellRange.Style = newStyle
        '@↑2018/04/05 (Thu) 10:59:58 T.Oide **************************************************



                    '@ﾘﾜｰｸ、特殊ﾛｯﾄの場合はﾘﾜｰｸ、特殊ﾙｰﾄの設定は行わない
                    Select Case pstrEN01X0ProcFlag
                        
                        '@ﾘﾜｰｸ、特殊流動
                        Case "1"
                            '@ﾘﾜｰｸ～特殊ﾙｰﾄ部分のﾊﾞｯｸｶﾗｰを変更
                            newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                            cellRange = .GetCellRange(llngRowPos, CPlngvsfFlowReworkRouteID, _
                                                    llngRowPos, CPlngvsfFlowSPReturnStepID)
                            cellRange.Style = newStyle
                            
                            .SetData(llngRowPos, CPlngvsfFlowReworkRouteID, vbNullString)            'ﾘﾜｰｸﾙｰﾄID
                            .SetData(llngRowPos, CPlngvsfFlowSPRouteID, vbNullString)                '特殊ﾙｰﾄID
                            
                            
                            '@時間制限部分のﾊﾞｯｸｶﾗｰを変更
                            newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                            cellRange = .GetCellRange(llngRowPos, CPlngvsfFlowTimeLimit, _
                                                    llngRowPos, CPlngvsfFlowTimeLimitFlag)
                            cellRange.Style = newStyle
                            
                            
                            '@処理号機部分のﾊﾞｯｸｶﾗｰを変更
                            newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                            cellRange = .GetCellRange(llngRowPos, CPlngvsfFlowWpRestrict, _
                                                    llngRowPos, CPlngvsfFlowWpRestrict)
                            cellRange.Style = newStyle
                            
                        Case Else
                            '@今のところなし
                    End Select
                    
                    '@№のﾊﾞｯｸｶﾗｰを編集処理色へ変更
                    newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                    cellRange = .GetCellRange(llngRowPos, CPlngvsfFlowNo, llngRowPos, CPlngvsfFlowAbsNo)
                    cellRange.Style = newStyle
                    
        '@↓2016/02/06 (Sat) 16:49:49 H.Hayashi **************************************************
                    '@GRB限定工程設定時
                    If .GetData(llngRowPos, CPlngvsfFlowGrbClass) <> vbNullString Then
                        '@背景色を変更
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorPink")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorPink)
                        cellRange = .GetCellRange(llngRowPos, CPlngvsfFlowOpID, llngRowPos, CPlngvsfFlowStepID)
                        cellRange.Style = newStyle
                    End If
        '@↑2016/02/06 (Sat) 16:49:49 H.Hayashi **************************************************
                    
                    '@挿入位置の変更
                    llngRowPos = llngRowPos + 1
                Next
                
                '@選択行全体をﾊｲﾗｲﾄ
                .Select(mlngWkRow, CPlngvsfFlowNo, llngRowPos - 1, .Cols.Count - 1)
                
                '@移動（↑）（↓）・削除ﾎﾞﾀﾝの使用可否ﾁｪｯｸ
                Call prvCmdUpDownDelEnabled_Set(vsfFlowList0)
                
                '@Noの再ｾｯﾄ
                Call prvNo_Set(vsfFlowList0)
                
                '@列幅を自動調整
                .AutoSizeCols(.Cols.Fixed, .Cols.Count - 1, 6)
                
                '@直接描画
                .Redraw = True
                
                '@ｲﾝﾌｫﾒｰｼｮﾝ画面終了
                frmxxCM00X0.Instance = Nothing
                
                If llbnCK = True Then
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005N)

                    '@"<TRM5NI>$$貼り付けされた内容に無効データが存在します。$（該当個所：黄色）"
                    Call publngMsgBox(pstrDMsg & vbCrLf, vbInformation, Me.Text, True, 16, False)
                Else
                    '@処理条件ｾｯﾄIDVerのﾊﾞｯｸｶﾗｰを変更不可色へ変更
                    Dim newStyle As CellStyle
                    Dim cellRange As CellRange
                    newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                    cellRange = .GetCellRange(1, CPlngvsfFlowConditionVer, _
                                           .Rows.Count - 1, CPlngvsfFlowConditionVer)
                    cellRange.Style = newStyle
                    '@収集項目ｾｯﾄIDVerのﾊﾞｯｸｶﾗｰを変更不可色へ変更
                    newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                    cellRange = .GetCellRange(1, CPlngvsfFlowCollectionVer, _
                                           .Rows.Count - 1, CPlngvsfFlowCollectionVer)
                    cellRange.Style = newStyle
                End If
                
            End With
            
               
            '@変更ﾌﾗｸﾞｵﾝ
            pblnEN01X2Edit = True
            
            Exit Sub

        Catch ex As Exception
            
            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu12_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：pubblnTimeLimitBeforeCur_Chk
    '機　能：時間制限が現工程以前に設定されているものかﾁｪｯｸする
    '引　数：lstrSearchString：検索文字列
    '戻り値：なし
    '作成日：2006/06/15 (Thu) 14:00:13 N.Kasai
    '更新日：2006/06/15 (Thu) 14:00:13
    '備　考：
    Public Function pubblnTimeLimitBeforeCur_Chk(ByVal lstrSearchString As String) As Boolean

        Dim llngCnt             As Integer  'ｶｳﾝﾀ
        Dim llngAryCount        As Integer  '配列ｶｳﾝﾀ
        Dim lstrAry()           As String   'ｾﾙ内時間制限配列

        Try

            With vsfFlowList0
                '@ｸﾘｱ
                pubblnTimeLimitBeforeCur_Chk = False
                
                '@ﾌﾟﾛｾｽｸﾞﾘｯﾄ分、検索文字列を検索
                For llngCnt = 1 To .Rows.Count - 1
                    '@空白でない場合
                    If .GetData(llngCnt, CPlngvsfFlowTimeLimit) <> vbNullString Then
                        '@現在のｾﾙの値を配列に格納
                        lstrAry = Split(.GetData(llngCnt, CPlngvsfFlowTimeLimit), CMstrComma)

                        '@配列数分、以下の処理を繰り返す
                        For llngAryCount = 0 To UBound(lstrAry)
                            '@検索文字列でない場合、ｾﾙ内容文字列に設定
                            If lstrSearchString = Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo5) Then
                                '@現工程以前の場合
                                If .GetData(llngCnt, CPlngvsfFlowPermit) = CMstrPermit2 Then

                                    pubblnTimeLimitBeforeCur_Chk = True '現工程に存在
                                    Exit Function
                                End If
                            End If
                        Next
                    End If
                Next
            End With

            Exit Function

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "pubblnTimeLimitBeforeCur_Chk"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Function

    '関数名：prvvsfMstFlowList_Disp
    '機　能：ﾏｽﾀ工順ｺﾋﾟｰ表示
    '引　数：ltypMstFlowList：ﾃﾞｰﾀ格納構造体
    '戻り値：なし
    '作成日：2006/07/04 (Tue) 09:52:27 N.Kasai
    '更新日：2018/04/05 (Thu) 13:44:35 T.Oide
    '備　考：
    Private Sub prvvsfMstFlowList_Disp(ByRef ltypMstFlowList As ProcFlowListAns)

        Dim llngCnt         As Integer  'ｶｳﾝﾀ
        Dim llngAltCnt      As Integer  '代替工程ｶｳﾝﾀ
        Dim llngTimeLimit   As Integer  '時間制限ｶｳﾝﾀ
        Dim lstrTimeLimit   As String   '時間制限文字列
        Dim lblnSeqFlag     As Boolean
        Dim lstrStart       As String
        Dim llngApcCnt      As Integer  'APCﾘｽﾄｶｳﾝﾄ
        Dim llngCateCnt     As Integer  'ｷｬﾘｱｶﾃｺﾞﾘｶｳﾝﾄ
        Dim llngIndex       As Integer
        Dim nKeepRow        As Integer  '行数保持用変数
        Dim strKeepGroup    As String   'グループ番号保持用変数
        Dim lstrStatus      As String

        Dim lvsfFlowList    As C1FlexGrid   'NSYS イベント元グリッド
        Dim llngRow         As Integer      'NSYS 行ｶｳﾝﾀ

        Try
            
            '@初期化
            llngCnt = 0
            mlngSwapCnt = 1
            
            llngIndex = 1
            
            nKeepRow = -1
            strKeepGroup = ""
            
            lvsfFlowList = CType(vsfFlowList1, C1FlexGrid)

            lblnSeqFlag = False
            
            With lvsfFlowList
                '@描画ﾛｯｸ
                .Redraw = False
                '@初期化
                If .Rows.Count > .Rows.Fixed Then
                    .Clear(ClearFlags.Content, .Rows.Fixed, 0, .Rows.Count - 1, .Cols.Count - 1)      'ﾌﾟﾛｾｽﾌﾛｰ画面
                End If
                '@ﾌﾟﾛｾｽﾌﾛｰ画面のｻｲｽﾞ指定
                .Height = mlngvsfPcTabOnHeight  '高さ

                '@有効行数を設定
                .Rows.Count = ltypMstFlowList.lngLotProcFlowCnt + 1
                
                '@ﾏｽﾀ工順表示
                For llngCnt = 0 To ltypMstFlowList.lngLotProcFlowCnt -1
                    llngRow = llngCnt + 1
                    With ltypMstFlowList.typLotProcFlow(llngCnt)
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowNo, llngRow)                                  '№
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowAbsNo, llngRow)                               '工順絶対番号
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowOpID, .strOpID)                               '大工程
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowOpValid, .strOpValid)                         '大工程有効ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowStepID, .strStepID)                           '小工程
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowStepValid, .strStepValid)                     '小工程有効ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowConditionVer, .strConditionVersion)           '処理条件ｾｯﾄIDﾊﾞｰｼﾞｮﾝ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowConditionID, .strConditionId)                 '処理条件ｾｯﾄID
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowConditionValid, .strConditionValid)           '処理条件ｾｯﾄID有効ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowLotRecipeFlag, "0")                           'ﾛｯﾄ個別ﾚｼﾋﾟ設定ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowWFRecipeFlag, "0")                            'WF個別ﾚｼﾋﾟ設定ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowConditionOne, vbNullString)                   '個別設定なし
                        
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowSelectConditionID, .strSelectConditionID)     'WF選択条件ｾｯﾄID
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowCollectionID, .strCollectionID)               '収集項目ｾｯﾄID
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowCollectionVer, .strCollectionVersion)         '収集項目ｾｯﾄIDﾊﾞｰｼﾞｮﾝ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowCollectionValid, .strCollectionValid)         '収集項目ｾｯﾄID有効ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowLotScrapSetId, .strLotScrapSetID)             '不良項目ｾｯﾄID
                        
                        '@ﾘﾜｰｸﾙｰﾄID//(空ﾘﾜｰｸ) or ReworkRouteID
                        If .strReworkRouteID = CMstrRouteIDEmpty Then
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowReworkRouteID, CMstrEmptyRework)
                        Else
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowReworkRouteID, .strReworkRouteID)
                        End If
                        
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowReworkRouteValid, .strReworkRouteValid)       'ﾘﾜｰｸﾙｰﾄ有効ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowReworkReturnOpID, .strReworkReturnOpID)       'ﾘﾜｰｸﾙｰﾄ戻り先大工程ID
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowReworkReturnStepID, .strReworkReturnStepID)   'ﾘﾜｰｸﾙｰﾄ戻り先小工程ID
                        
                        '@特殊ﾙｰﾄID//(追加流動なし) or strSpecialRouteID
                        If .strSpecialRouteID = CMstrRouteIDEmpty Then
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowSPRouteID, CMstrAddFlowNo)
                        Else
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowSPRouteID, .strSpecialRouteID)
                        End If
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowSPRouteValid, .strSpecialRouteValid)          '特殊ﾙｰﾄ有効ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowSPReturnOpID, .strSpecialReturnOpID)          '特殊ﾙｰﾄ戻り先大工程ID
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowSPReturnStepID, .strSpecialReturnStepID)      '特殊ﾙｰﾄ戻り先小工程ID

                        '@SPCｽｷｯﾌﾟﾁｪｯｸ欄(CMstrSpcSkipOK = 1)
                        '@SPC判定ｽｷｯﾌﾟﾌﾗｸﾞ( 0: SKIP不可、1:SKIP可）
                        If .strJudgeSkipFlag = CMstrSpcSkipOK Then
                            lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowJudgeSkipFlag, CheckEnum.Checked)
                        Else
                            lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowJudgeSkipFlag, CheckEnum.Unchecked)
                        End If
                        
                        '@APC設定表示
                        If .lngApcOrderCnt > 0 Then
                            
                            For llngApcCnt = 0 To .lngApcOrderCnt -1
                            
                                With .typApcOrder(llngApcCnt)
                                    '@APCﾀｲﾌﾟ判定
                                    Select Case .strApcType
                                        '@ﾌｫﾄ
                                        Case CMstrApcTypeFB
                                            lstrStart = CMstrFBMark & CMstrHyphen
                                        '@ｺﾝﾀｸﾄｴｯﾁｬｰ
                                        Case CMstrApcTypeFF
                                            lstrStart = CMstrFFMark & CMstrHyphen
                                        '@例外
                                        Case Else
                                            lstrStart = vbNullString
                                    End Select
                                    
                                    '@先頭1文字を格納
                                    lstrStatus = Mid$(.strStatusFlag, 1, 1)
                                    
                                    '@ｽﾃｰﾀｽを判定して表示切替
                                    Select Case lstrStatus
                                    
                                        Case CPstrProcessMark
                                        
                                            '@FB-ﾘｽﾄｵｰﾀﾞ№(000)-P/FF-ﾘｽﾄｵｰﾀﾞ№(000)-P、またはPn(「ﾌｫﾄF/B(合せ)」のﾊﾟｯﾁ分割ありの場合P1～P9が来る)
                                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowApc, _
                                                lvsfFlowList.GetData(llngRow, CPlngvsfFlowApc) & _
                                                    lstrStart & _
                                                    Format(CInt(.strListOrder), CMstrNoFormat) & _
                                                    CMstrHyphen & .strStatusFlag & CMstrComma) 'FB-[連番（三桁）]-P（n)

                                                    '@F/B適用外ﾁｪｯｸ欄(CMstrFlgOn = 1)
                                                    '@F/B適用外ﾌﾗｸﾞ( 0: 適用、1:適用外）
                                                    If ltypMstFlowList.typLotProcFlow(llngCnt).strApcSkipFlag = CMstrFlgOn Then
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcSkipFlag, CheckEnum.Checked)
                                                    Else
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcSkipFlag, CheckEnum.Unchecked)
                                                    End If
                                        Case CPstrMeasureMark
                                        
                                            '@FB-ﾘｽﾄｵｰﾀﾞ№(000)-M/FF-ﾘｽﾄｵｰﾀﾞ№(000)-M、またはMn(「ﾌｫﾄF/B(合せ)」のﾊﾟｯﾁ分割ありの場合M1～M9が来る)
                                             lvsfFlowList.SetData(llngRow, CPlngvsfFlowApc, _
                                                lvsfFlowList.GetData(llngRow, CPlngvsfFlowApc) & _
                                                    lstrStart & _
                                                    Format(CInt(.strListOrder), CMstrNoFormat) & _
                                                    CMstrHyphen & .strStatusFlag & CMstrComma)  'FB-[連番（三桁）]-M（n)
                
                                                    '@F/B計算除外ﾁｪｯｸ欄(CMstrFlgOn = 1)
                                                    '@F/B計算除外ﾌﾗｸﾞ( 0: 対象、1:除外）
                                                    If ltypMstFlowList.typLotProcFlow(llngCnt).strApcCalcSkipFlag = CMstrFlgOn Then
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcCalcSkipFlag, CheckEnum.Checked)
                                                    Else
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcCalcSkipFlag, CheckEnum.Unchecked)
                                                    End If
                                        Case Else
                                            '@ﾃﾞｰﾀ例外
                                            '@FB-ﾘｽﾄｵｰﾀﾞ№(000)-/FF-ﾘｽﾄｵｰﾀﾞ№(000)-
                                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowApc, _
                                                lvsfFlowList.GetData(llngRow, CPlngvsfFlowApc) & _
                                                    lstrStart & _
                                                    Format(CInt(.strListOrder), CMstrNoFormat) & CMstrHyphen & CMstrComma)
                
                                                    '@F/B適用外ﾁｪｯｸ欄(CMstrFlgOn = 1)
                                                    '@F/B適用外ﾌﾗｸﾞ( 0: 適用、1:適用外）
                                                    If ltypMstFlowList.typLotProcFlow(llngCnt).strApcSkipFlag = CMstrFlgOn Then
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcSkipFlag, CheckEnum.Checked)
                                                    Else
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcSkipFlag, CheckEnum.Unchecked)
                                                    End If
                
                                                    '@F/B計算除外ﾁｪｯｸ欄(CMstrFlgOn = 1)
                                                    '@F/B計算除外ﾌﾗｸﾞ( 0: 対象、1:除外）
                                                    If ltypMstFlowList.typLotProcFlow(llngCnt).strApcCalcSkipFlag = CMstrFlgOn Then
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcCalcSkipFlag, CheckEnum.Checked)
                                                    Else
                                                        lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcCalcSkipFlag, CheckEnum.Unchecked)
                                                    End If
                                    End Select
                                End With
                            Next
                            
                            '@最後にｶﾝﾏがついていたら
                            If Strings.Right$(lvsfFlowList.GetData(llngRow, CPlngvsfFlowApc), 1) = CMstrComma Then
                                '@ｶﾝﾏを削除
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowApc, _
                                    Strings.Left$(lvsfFlowList.GetData(llngRow, CPlngvsfFlowApc), Len(lvsfFlowList.GetData(llngRow, CPlngvsfFlowApc)) - 1))
                            End If
                            
                        Else
                            '@ﾃﾞｰﾀなしの場合
                            lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcSkipFlag, CheckEnum.Unchecked)
                            lvsfFlowList.SetCellCheck(llngRow, CPlngvsfFlowApcCalcSkipFlag, CheckEnum.Unchecked)
                        End If

                        '@入替工程
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowSwapIndictorCopy, .strSwapIndicator) '入替可能ｲﾝｼﾞｹｰﾀ退避
                        '@取得した値が空白の場合は表示処理を行わない
                        If .strSwapIndicator <> vbNullString Then
                            '@選択ｾﾙに文字列をｾｯﾄ
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowSwapIndictor, _
                                CMstrSwapIndictorMark & CMstrHyphen & Format(mlngSwapCnt, CMstrNoFormat))      '入替可能ｲﾝｼﾞｹｰﾀ
                            '@今回と前回の入替可能工程の値をﾁｪｯｸ
                            If .strSwapIndicator = 1 Then
                                '@ｶｳﾝﾄｱｯﾌﾟ
                                mlngSwapCnt = mlngSwapCnt + 1
                            End If
                        End If

                        '@代替工程
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowAltPointer, .strAltPointer)     '代替ﾎﾟｲﾝﾀ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowAltStartFlag, .strAltStartFlag) '代替開始ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowAltEndFlag, .strAltEndFlag)     '代替終了ﾌﾗｸﾞ
                        '@開始・終了の場合[S/E]
                        If .strAltStartFlag = CMstrFlgOn And .strAltEndFlag = CMstrFlgOn Then
                            '@代替番号が数値の場合のみ
                            If IsNumeric(Strings.Right(.strAltPointer, 3)) = True Then
                                '@代替番号の取得
                                llngAltCnt = CLng(Strings.Right(.strAltPointer, 3))
            
                                '@選択ｾﾙに文字列をｾｯﾄ
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowAltSet, _
                                    CMstrAltMark & CMstrHyphen & Format(llngAltCnt, CMstrNoFormat) & _
                                    CMstrHyphen & CMstrStartEndMark)  '代-[連番（三桁）]-S/E
                            End If
                        Else
                            '@代替工程の編集
                            '@開始の場合[S]
                            If .strAltStartFlag = CMstrFlgOn Then
                                
                                '@代替番号が数値の場合のみ
                                If IsNumeric(Strings.Right(.strAltPointer, 3)) = True Then
                                    '@代替番号の取得
                                    llngAltCnt = CLng(Strings.Right(.strAltPointer, 3))
            
                                    '@選択ｾﾙに文字列をｾｯﾄ
                                    lvsfFlowList.SetData(llngRow, CPlngvsfFlowAltSet, _
                                        CMstrAltMark & CMstrHyphen & Format(llngAltCnt, CMstrNoFormat) & _
                                        CMstrHyphen & CMstrStartMark) '代-[連番（三桁）]-S
                                End If
                            End If
                            '@代替工程の編集
                            '@終了の場合[E]
                            If .strAltEndFlag = CMstrFlgOn Then
                                '@代替番号が数値の場合のみ
                                If IsNumeric(Strings.Right(.strAltPointer, 3)) = True Then
                                    '@代替番号の取得
                                    llngAltCnt = CLng(Strings.Right(.strAltPointer, 3))
                                    '@選択ｾﾙに文字列をｾｯﾄ
                                    lvsfFlowList.SetData(llngRow, CPlngvsfFlowAltSet, _
                                        CMstrAltMark & CMstrHyphen & Format(llngAltCnt, CMstrNoFormat) & _
                                        CMstrHyphen & CMstrEndMark) '代-[連番（三桁）]-E
                                End If
                            End If
                        End If

                        '@時間制限
                        lstrTimeLimit = vbNullString
                        
                        For llngTimeLimit = 0 To .lngTimeOrderCnt -1
                        
                            lstrTimeLimit = lstrTimeLimit & CMstrTimeLimitMark & _
                                            .typTimeOrder(llngTimeLimit).strRestrictTypeID & _
                                            CMstrHyphen & _
                                            Format$(CInt(.typTimeOrder(llngTimeLimit).strListOrder), CMstrNoFormat) & _
                                            CMstrHyphen & _
                                            .typTimeOrder(llngTimeLimit).strStatusFlag & CMstrComma
                        Next
                        '@最後にｶﾝﾏがついていたら
                        If Strings.Right$(lstrTimeLimit, 1) = CMstrComma Then
                            '@ｶﾝﾏを削除
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowTimeLimit, _
                                Strings.Left$(lstrTimeLimit, Len(lstrTimeLimit) - 1))
                        End If
                        '@時間制限ﾌﾗｸﾞ//(非表示設定):0:ﾌﾗｸﾞOFF(未編集)/1:ﾌﾗｸﾞON(編集中)
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowTimeLimitFlag, CMstrFlgOff)

                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowSFlag, .strSFlag)                         '特殊特性ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowEntryID, ptypEN01X4.strEntryID)           'ｴﾝﾄﾘID
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowRecipeChgFlg, "0")                        '工順ﾚｼﾋﾟ変更ﾌﾗｸﾞ
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowWorkCondition, .strWorkCondition)         '作業条件

                        '@号機指定
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowCommitFlag, "0")                          '号機指定
                
                        '@ｽﾃｰﾀｽを判定して表示切替
                        Select Case .strWpRestrictKind
                            '@記憶
                            Case "1"
                                '@限-号機限定番号(000)-M
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowWpRestrict, _
                                        CMstrWpRestrictMark & CMstrHyphen & _
                                        Format$(CInt(.strWpRestrictNum), CMstrNoFormat) & _
                                        CMstrHyphen & CMstrWpMarkMark)  '限-[連番（三桁）]-M
                            '@限定
                            Case "2"
                                '@限-号機限定番号(000)-U
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowWpRestrict, _
                                        CMstrWpRestrictMark & CMstrHyphen & _
                                        Format$(CInt(.strWpRestrictNum), CMstrNoFormat) & _
                                        CMstrHyphen & CMstrWpUseMark)  '限-[連番（三桁）]-U
                        End Select
                
                        '@TPAL設定
                        Select Case .strTpalClass
                        
                            '@蒸着ﾊﾞｯﾁ貼合
                            Case CPstrTpalJBatch
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, CPstrTpalJBatchName)
                        
                            '@蒸着左貼合
                            Case CPstrTpalJLeft
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, CPstrTpalJLeftName)
                        
                            '@蒸着右貼合
                            Case CPstrTpalJRight
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, CPstrTpalJRightName)
                        
                            '@蒸着ﾊﾞｯﾁ+左貼合
                            Case CPstrTpalJBatchLeft
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, CPstrTpalJBatchLeftName)
                        
                            '@蒸着ﾊﾞｯﾁ+右貼合
                            Case CPstrTpalJBatchRight
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, CPstrTpalJBatchRightName)
                        
                            '@表面ﾊﾞｯﾁ貼合
                            Case CPstrTpalHBatch
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, CPstrTpalHBatchName)
                        
                            '該当項目なしは空
                            Case Else
                                lvsfFlowList.SetData(llngRow, CPlngvsfFlowTpalClass, vbNullString)
                        
                        End Select
                    
                        '@ｷｬﾘｱｶﾃｺﾞﾘ
                        If .strCarrierCategoryId <> vbNullString Then
                        
                            '@ｷｬﾘｱｶﾃｺﾞﾘﾘｽﾄを検索して該当ｷｬﾘｱｶﾃｺﾞﾘIDを探す
                            For llngCateCnt = 0 To mtypCarrierCategoryList.typCarrierCategory.Count -1
                        
                                '@ｷｬﾘｱｶﾃｺﾞﾘIDをｷｬﾘｱｶﾃｺﾞﾘ名にして表示
                                If mtypCarrierCategoryList.typCarrierCategory(llngCateCnt).strCategoryID = .strCarrierCategoryId Then
                                
                                    lvsfFlowList.SetData(llngRow, CPlngvsfFlowCarrierCategoryID, _
                                        mtypCarrierCategoryList.typCarrierCategory(llngCateCnt).strCategoryName)
                                    Exit For
                            
                                '@ｷｬﾘｱｶﾃｺﾞﾘIDがﾘｽﾄにない場合はｷｬﾘｱｶﾃｺﾞﾘIDをそのまま表示
                                Else
                                    lvsfFlowList.SetData(llngRow, CPlngvsfFlowCarrierCategoryID, .strCarrierCategoryId)
                                End If
                            Next llngCateCnt
                        Else
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowCarrierCategoryID, vbNullString)
                        End If
                
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowMapUseFlag, .strMapUseFlag)          'ﾏｯﾌﾟ適用ﾌﾗｸﾞ
                        
                        '@TEOS F/B設定表示
                        Call SetApcTeosData(lvsfFlowList, llngRow, .typApcTeos, nKeepRow, strKeepGroup)
                            
                        '@TEOS PrismAPC設定表示
                        If .typTeosPrismApc.strGroupNo <> vbNullString Then
                            lvsfFlowList.SetData(llngRow, CPlngvsfFlowTeosPrismAPC, _
                                                            Format$(CInt(.typTeosPrismApc.strGroupNo), CMstrTeosAPCFormat) & _
                                                            CMstrCaptionHyphen & .typTeosPrismApc.strApcType)
                        End If

                        '@GRB工程限定設定表示
                        lvsfFlowList.SetData(llngRow, CPlngvsfFlowGrbClass, .strGrbClass)               'GRB限定工程設定

        '@↓2018/04/05 (Thu) 13:43:32 T.Oide **************************************************
                        '@ﾚｼﾋﾟ選択APC設定
                        Call prvReciSelApc_Disp(lvsfFlowList, llngRow, ltypMstFlowList.typLotProcFlow(llngCnt))
        '@↑2018/04/05 (Thu) 13:43:32 T.Oide **************************************************


                    End With
                
                    '@ﾊﾞｯｸｶﾗｰの設定
                    Dim newStyle    As CellStyle
                    Dim cellRange   As CellRange
                    newStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                    cellRange = lvsfFlowList.GetCellRange(1, 0, llngRow, lvsfFlowList.Cols.Count - 1)
                    cellRange.Style = newStyle

                Next llngCnt
                
                '@非表示列
                lvsfFlowList.Cols(CPlngvsfFlowConditionOne).Visible = False           '個別処理条件
                lvsfFlowList.Cols(CPlngvsfFlowApcSkipFlag).Visible = False            'APCｽｷｯﾌﾟ
                lvsfFlowList.Cols(CPlngvsfFlowApcCalcSkipFlag).Visible = False        'APC計算対象外


                '@ﾛｯｸ解除
                .Enabled = True
                '@描画ﾛｯｸ解除
                .Redraw = True
                '@列幅を自動調整
                .AutoSizeCols(CPlngvsfFlowNo, .Cols.Count - 1, 6)
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvvsfMstFlowList_Disp"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvvsfFlowChgList_Disp
    '機　能：変更点ﾊﾞｯｸｶﾗｰ表示
    '引　数：ltypFlowChgList：ﾃﾞｰﾀ格納構造体
    '戻り値：なし
    '作成日：2006/07/05 (Wed) 15:29:19 N.Kasai
    '更新日：2006/07/05 (Wed) 15:29:19
    '備　考：
    Private Sub prvvsfFlowChgList_Disp(ByRef ltypFlowChgList As ProcFlowListAns)

        Dim llngCnt         As Integer  'ｶｳﾝﾀ
        Dim llngCnt2        As Integer  'ｶｳﾝﾀ2
        Dim lblnTimeLimit   As String   '時間制限変更の有無
        Dim llngRow         As Integer  'NSYS 行ｶｳﾝﾀ

        Try
            
            '@-------------------------------------------
            '@戻り値 0: 変更なし､1: 変更有り､2: 比較対象外
            '@-------------------------------------------
            
            '@初期化
            llngCnt = 0
            
            With vsfFlowList0
                '@描画ﾛｯｸ
                .Redraw = False
            End With
            
            '@変更点の表示
            For llngCnt = 0 To ltypFlowChgList.lngLotProcFlowCnt -1
                llngRow = llngCnt + 1

                With ltypFlowChgList.typLotProcFlow(llngCnt)
                    
                    '@行挿入OR行移動の場合
                    If .strState = CMstrState8 Or .strState = CMstrState9 Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowAbsNo)
                        cellRange.Style = newStyle              '工順絶対番号
                        
                        '@編集色が初回ﾌｫｰｶｽ位置の場合は色を乗せない
                        If vsfFlowList0.Row <> llngRow Then
                            newStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                            cellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowNo)
                            cellRange.Style = newStyle             '№
                        End If
                    
                    
                    End If
                    
                    If .strOpID = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue" & llngRow)
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        newStyle.ForeColor = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowOpID).StyleDisplay.ForeColor
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowOpID)
                        cellRange.Style = newStyle               '大工程
                    End If
                    
                    If .strStepID = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue" & llngRow)
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        newStyle.ForeColor = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowStepID).StyleDisplay.ForeColor
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowStepID)
                        cellRange.Style = newStyle             '小工程
                    End If
                    
                    If .strConditionId = "1" Or .strConditionVersion = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowConditionID)
                        cellRange.Style = newStyle        '処理条件ｾｯﾄID
                        newStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        cellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowConditionVer)
                        cellRange.Style = newStyle       '処理条件ｾｯﾄIDﾊﾞｰｼﾞｮﾝ
                    End If
                    
                    If .strSelectConditionID = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowSelectConditionID)
                        cellRange.Style = newStyle  'WF選択条件ｾｯﾄID
                    End If
                    
                    If .strCollectionID = "1" Or .strCollectionVersion = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowCollectionID)
                        cellRange.Style = newStyle       '収集項目ｾｯﾄID
                        newStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        cellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowCollectionVer)
                        cellRange.Style = newStyle      '収集項目ｾｯﾄIDﾊﾞｰｼﾞｮﾝ
                    End If
                                
                    If .strLotScrapSetID = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowLotScrapSetId)
                        cellRange.Style = newStyle      '不良項目ｾｯﾄID
                    End If
                    
                    If .strReworkRouteID = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowReworkRouteID)
                        cellRange.Style = newStyle      'ﾘﾜｰｸﾙｰﾄID
                    End If
                                
                    If .strReworkReturnOpID = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowReworkReturnOpID)
                        cellRange.Style = newStyle   'ﾘﾜｰｸﾙｰﾄ戻り先大工程ID
                    End If
                    
                    If .strReworkReturnStepID = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowReworkReturnStepID)
                        cellRange.Style = newStyle 'ﾘﾜｰｸﾙｰﾄ戻り先小工程ID
                    End If
                    
                    If .strSpecialRouteID = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowSPRouteID)
                        cellRange.Style = newStyle          '特殊ﾙｰﾄID
                    End If
                    
                    If .strSpecialReturnOpID = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowSPReturnOpID)
                        cellRange.Style = newStyle       '特殊ﾙｰﾄ戻り先大工程ID
                    End If
                    
                    If .strSpecialReturnStepID = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowSPReturnStepID)
                        cellRange.Style = newStyle     '特殊ﾙｰﾄ戻り先小工程ID
                    End If
                    
                    If .strSwapIndicator = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowSwapIndictor)
                        cellRange.Style = newStyle       '入替可能ｲﾝｼﾞｹｰﾀ
                    End If
                    
                    If .strAltPointer = "1" Or .strAltStartFlag = "1" Or .strAltEndFlag = "1" Then
                        Dim newStyle As CellStyle = vsfFlowList0.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                        Dim cellRange As CellRange = vsfFlowList0.GetCellRange(llngRow, CPlngvsfFlowAltSet)
                        cellRange.Style = newStyle             '代替ﾎﾟｲﾝﾀ
                    End If
                    
                    lblnTimeLimit = False
                    
                    If .lngTimeOrderCnt > 0 Then
                        For llngCnt2 = 0 To .lngTimeOrderCnt -1

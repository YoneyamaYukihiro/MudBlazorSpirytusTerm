            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey
                .strProcName = "prvCarrierCategoryComboList_Set"
                .strErrMessage = vbNullString
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '------------------------------------------------------------------------------
    '関数名：ControlApcWfUnitFlg
    '機　能：APC枚葉設定の可否状態を判断し、状態にあったGUIを構築する
    '引　数：nListIndex     ：処理対象のリスト番号(０以外は非サポート)
    '　　　：nTargetRow     ：処理対象の行数
    '　　　：bMsgSkipFlg    ：メッセージ表示スキップフラグ
    '戻り値：
    '作成日：2011/07/01 (Fri) 15:17:40 M.Sakka
    '更新日：2011/07/01 (Fri) 15:17:40
    '備　考：
    '------------------------------------------------------------------------------
    '①FF-P工程以外はAPC枚葉設定できない
    '  隠しカラムCPlngvsfFlowApcWfUnitFlgSetableに情報が格納されている
    '②ロット個別レシピが設定されている工程はAPC枚葉設定できない
    '  CPlngvsfFlowLotRecipeFlagにONが設定されいるか否か
    '③枚葉レシピが設定されている工程はAPC枚葉設定をONに設定する
    '  CPlngvsfFlowWFRecipeFlagにONが設定されいるか否か
    '④デフォルトレシピが設定されている工程はAPC枚葉設定はON/OFFに設定可能
    '  CPlngvsfFlowLotRecipeFlag/CPlngvsfFlowWFRecipeFlagが何れもOFFが
    '  デフォルトレシピ
    '
    '本関数では自動的にGUIの設定を変更する.
    'その際、以下のメッセージを表示する
    'メッセージの表示が不必要な場合は呼び出し側から第三引数にTrueを設定することで
    'メッセージ表示を抑止する事ができる(画面表示時などメッセージ表示が不要な場合)
    '  APC枚葉設定 ON  -> OFF ：CPstrMsgInf0075
    '  APC枚葉設定 OFF -> ON　：CPstrMsgInf0076
    '------------------------------------------------------------------------------
    Private Sub ControlApcWfUnitFlg(ByVal lvsfFlowList As C1FlexGrid, _
                                    ByVal nTargetRow As Integer, _
                                    Optional ByVal bMsgSkipFlg As Boolean = False)
        Dim llngBackColor   As Color    '背景色
        Dim llngCheck       As Integer  'チェック状態
        Dim lstrMsg         As String   '表示メッセージ
        
        'コピー先リストのみサポート(コピー元リストは非サポート)
        If lvsfFlowList IsNot vsfFlowList0 Then
            Exit Sub
        End If
        
        'バックグランドをグレイ（設定不可能）に設定
        llngBackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
        'チェックをOFF
        llngCheck = CheckEnum.Unchecked
        'メッセージ初期化
        lstrMsg = ""
     
        With lvsfFlowList
            '列番号の補正
            If nTargetRow < 0 Then
                nTargetRow = .Row
            End If
            
            'そもそもAPC枚葉設定可能か判断(FFでP工程)
            If .GetCellCheck(nTargetRow, CPlngvsfFlowApcWfUnitFlgSetable) = CheckEnum.Unchecked Then
                GoTo EndThisSub
            End If
            
            'ロット個別レシピの設定を判断
            If .GetData(nTargetRow, CPlngvsfFlowLotRecipeFlag) <> CMstrFlgOff Then
                '個別ロットレシピが設定されている場合はAPC枚葉設定が不可能
                
                '現在の設定がONの場合は設定が変わったことをメッセージで通知
                If .GetCellCheck(nTargetRow, CPlngvsfFlowApcWfUnitFlg) <> CheckEnum.Unchecked Then
                    lstrMsg = pubstrMsgReplace_Set(CPstrMsgInf0075, CMstrComments)
                End If
                
                GoTo EndThisSub
            End If
            
            '枚葉レシピの設定を判断
            If .GetData(nTargetRow, CPlngvsfFlowWFRecipeFlag) <> CMstrFlgOff Then
                '枚葉レシピが設定されている場合はAPC枚葉設定を自動的にONに設定
                llngCheck = CheckEnum.Checked
                
                '現在の設定がOFFの場合は設定が変わることをメッセージで通知
                If .GetCellCheck(nTargetRow, CPlngvsfFlowApcWfUnitFlg) = CheckEnum.Unchecked Then
                    lstrMsg = pubstrMsgReplace_Set(CPstrMsgInf0076, CMstrComments)
                End If
                
                'チェックが変更できないように色はグレーをキープ
                GoTo EndThisSub
            End If
            
            'デフォルトレシピの判断
            If (.GetData(nTargetRow, CPlngvsfFlowLotRecipeFlag) = CMstrFlgOff) _
                And (.GetData(nTargetRow, CPlngvsfFlowWFRecipeFlag) = CMstrFlgOff) Then
                'GUIに設定されているチェック状態をキープ
                llngCheck = .GetCellCheck(nTargetRow, CPlngvsfFlowApcWfUnitFlg)
            End If
            
            'バックグランドを白(選択可能）に設定
            llngBackColor = Color.White
            
        EndThisSub:
            '呼び出し側がメッセージボックスの表示を求めている場合で
            '且つ、メッセージ表示が必要な場合だけメッセージを表示します
            If (lstrMsg <> vbNullString) And (bMsgSkipFlg = False) Then
                Call publngMsgBoxInfo(lstrMsg, vbExclamation, Me.Text, True, 16)
            End If
            
            'バックグランドを変更
            Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_llngBackColor")
            newStyle.BackColor = llngBackColor
            Dim cellRange As CellRange = .GetCellRange(nTargetRow, CPlngvsfFlowApcWfUnitFlg)
            cellRange.Style = newStyle
            'チェックマークを変更
            .SetCellCheck(nTargetRow, CPlngvsfFlowApcWfUnitFlg, llngCheck)
            '区分変更あり
            .SetData(nTargetRow, CPlngvsfFlowChange, CMstrChange1)
        End With
    End Sub


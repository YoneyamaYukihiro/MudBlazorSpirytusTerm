                .strProcName = "vsfFlowList_LostFocus"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：vsfFlowList_DblClick
    '機　能：ﾌﾛｰﾘｽﾄ　ﾀﾞﾌﾞﾙｸﾘｯｸ処理
    '引　数：なし
    '戻り値：なし
    '作成日：2006/07/06 (Thu) 10:11:29 N.Kasai
    '更新日：2006/07/06 (Thu) 10:11:29
    '備　考：
    Private Sub vsfFlowList_DblClick(ByVal sender As Object, ByVal e As EventArgs) Handles vsfFlowList0.DoubleClick, vsfFlowList1.DoubleClick

        Dim llngRow                     As Integer                  '検索行
        Dim llngCnt                     As Integer                  '行ｶｳﾝﾀ
        Dim lstrID                      As String                   '条件ID
        Dim lstrVER                     As String                   '条件Ver
        Dim lblnAns                     As Boolean                  '戻り値
        Dim ltypMasOpList               As MasOpList                '大工程ﾘｽﾄ
        Dim ltypMasStepList             As MasStepList              '小工程ﾘｽﾄ
        Dim ltypMasConditionList        As MasConditionList         '処理条件ﾘｽﾄ
        Dim ltypMasProcCollectionList   As MasProcCollectionList    '収集項目ﾘｽﾄ
        Dim lstrEventName               As String                   'ｲﾍﾞﾝﾄ名格納（ﾚｽﾎﾟﾝｽ用）
        Dim lvsfFlowList                As C1FlexGrid               'NSYS イベント元グリッド

        Try
            
            lvsfFlowList = CType(sender, C1FlexGrid)

            'NSYS データ行がない場合は処理を抜ける
            If lvsfFlowList.Rows.Count <= lvsfFlowList.Rows.Fixed Then
                Return
            End If
            
            '@編集ﾓｰﾄﾞを判定
            '@編集ﾌﾗｸﾞ（0/未編集　1/編集中　2/編集済　3/編集開始前）
            If mlngEditFlag <> 1 Then
                Exit Sub
            End If
             
            '@ﾍｯﾀﾞｰをｸﾘｯｸされた場合は処理中止
            If lvsfFlowList.MouseRow = 0 Then
                Exit Sub
            End If
            
            '@選択行が見出しの場合は処理中止
            If lvsfFlowList.Row < 0 Then
                Exit Sub
            End If
            
            '@------------------------------------------------------
            '@ﾀﾞﾌﾞﾙｸﾘｯｸ対象列
            '@大工程
            '@小工程
            '@処理条件/個別処理条件
            '@WF選択条件
            '@収集項目
            '@不良項目
            '@時間制限
            '@ﾘﾜｰｸﾙｰﾄID
            '@特殊ﾙｰﾄID
            '@ﾘﾜｰｸﾙｰﾄ戻り大工程
            '@ﾘﾜｰｸﾙｰﾄ戻り小工程
            '@特殊ﾙｰﾄ戻り大工程
            '@特殊ﾙｰﾄ戻り小工程
            '@時間制限
            '@APC設定
            '@ｷｬﾘｱｶﾃｺﾞﾘ
            '@------------------------------------------------------
            
            '@ﾚｽﾎﾟﾝｽ用ｲﾍﾞﾝﾄ名取得
            lstrEventName = "vsfFlowList_DblClick"
            
            '@ﾀﾞﾌﾞﾙｸﾘｯｸ機能
            With lvsfFlowList
            
                Select Case .Col
                    
                    Case CPlngvsfFlowOpID               '大工程
                        
                        '@ﾌﾟﾛｾｽﾌﾛｰの高さを変更
                        .Height = mlngvsfPcTabOnHeight
                        
                        '@編集画面の表示
                        With stbSetPanel
                            .Visible = True
                            .SelectedIndex = CMlngOpTabNo     '大工程ﾀﾌﾞを表示
                            .Top = lvsfFlowList.Top + mlngvsfPcTabOnHeight
                        End With
                        cmdSetPanel.Enabled = True  '設定画面表示ﾎﾞﾀﾝ使用可
                        fraCondition2.Visible = False
                        
                        '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞが表示されている場合
                        If vsfFlowList1.Visible = True Then
                            If sender Is vsfFlowList0 Then
                                With lblFlowList0
                                    .Font = New Font(.Font, .Font.Style Or FontStyle.Bold)
                                End With
                                lblFlowList0.ForeColor = Color.Red
                                With lblFlowList1
                                    .Font = New Font(.Font, .Font.Style And Not FontStyle.Bold)
                                End With
                                lblFlowList1.ForeColor = Color.Black
                                
                                vsfFlowList0.HighLight = HighLightEnum.Always
                                vsfFlowList1.HighLight = HighLightEnum.Never
                            Else
                                With lblFlowList1
                                    .Font = New Font(.Font, .Font.Style Or FontStyle.Bold)
                                End With
                                lblFlowList1.ForeColor = Color.Red
                                With lblFlowList0
                                    .Font = New Font(.Font, .Font.Style And Not FontStyle.Bold)
                                End With
                                lblFlowList0.ForeColor = Color.Black
                                
                                vsfFlowList1.HighLight = HighLightEnum.Always
                                vsfFlowList0.HighLight = HighLightEnum.Never
                            End If
                        End If
                        
                        '@退避領域の値をｸﾘｱ
                        mstrOpCategory = vbNullString

                        '@大工程を取得
                        lstrID = .GetData(.Row, CPlngvsfFlowOpID)
                            
                        With vsfOpList
                            
                            '@ﾚｽﾎﾟﾝｽ取得開始
                            Call pubResponseStart(Me.Name, lstrEventName)
                            
                            '@MSG【大工程ﾏｽﾀ取得】
                            lblnAns = pubblnMasUseOpList_Sel(pstrSBID, CMstrmas_useoplistVer, CPstrCD28, ltypMasOpList, lstrID)
                            
                            '@結果判定
                            If lblnAns = False Then
                                '@ﾚｽﾎﾟﾝｽｷｬﾝｾﾙ
                                Call pubResponseCancel(Me.Name, lstrEventName)
                                
                                .Redraw = False
                                .Rows.Count = .Rows.Fixed                  '行
                                .Redraw = True
                                Exit Sub
                            End If
                    
                            '@大工程名から大工程ｶﾃｺﾞﾘを取得する
                            '@大工程一覧表示
                            Call prvvsfOpList_Disp(ltypMasOpList)
                            
                            '@選択された大工程名の行を検索
                            llngRow = .FindRow(lstrID, .Rows.Fixed, CMlngvsfOpListOpID, False)
                            '@検索結果
                            If llngRow > -1 Then
                                '@選択された大工程が有効か無効か判断
                                If .GetData(llngRow, CMlngvsfOpListStatus) = CMstrValid Then
                                    chkValidOpID.Checked = True     '有効
                                Else
                                    chkValidOpID.Checked = False   '無効
                                End If
                            
                                '@その行を表示
                                .Row = llngRow
                                .ShowCell(.Row, CMlngvsfOpListOpID)
                                '@ﾌｫｰｶｽ設定
                                Call pubSetFocus(vsfOpList)
                            End If
                            '@ﾚｽﾎﾟﾝｽ取得終了
                            Call publngResponseEnd(Me.Name, lstrEventName)
                        End With
                        
                    Case CPlngvsfFlowStepID             '小工程
                    
                        '@ﾌﾟﾛｾｽﾌﾛｰの高さを変更
                        .Height = mlngvsfPcTabOnHeight
                        
                        '@編集画面の表示
                        With stbSetPanel
                            .Visible = True
                            .SelectedIndex = CMlngStepTabNo       '小工程ﾀﾌﾞを表示
                            .Top = lvsfFlowList.Top + mlngvsfPcTabOnHeight
                        End With
                        cmdSetPanel.Enabled = True      '設定画面表示ﾎﾞﾀﾝ使用可
                        fraCondition2.Visible = False
                        
                        '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞが表示されている場合
                        If vsfFlowList1.Visible = True Then
                            If sender Is vsfFlowList0 Then
                                With lblFlowList0
                                    .Font = New Font(.Font, .Font.Style Or FontStyle.Bold) 
                                End With
                                lblFlowList0.ForeColor = Color.Red
                                With lblFlowList1
                                    .Font = New Font(.Font, .Font.Style And Not FontStyle.Bold)      
                                End With
                                lblFlowList1.ForeColor = Color.Black
                                
                                vsfFlowList0.HighLight = HighLightEnum.Always
                                vsfFlowList1.HighLight = HighLightEnum.Never
                            Else
                                With lblFlowList1
                                    .Font = New Font(.Font, .Font.Style Or FontStyle.Bold)   
                                End With
                                lblFlowList1.ForeColor = Color.Red
                                With lblFlowList0
                                    .Font = New Font(.Font, .Font.Style And Not FontStyle.Bold)    
                                End With
                                lblFlowList0.ForeColor = Color.Black
                                
                                vsfFlowList0.HighLight = HighLightEnum.Never
                                vsfFlowList1.HighLight = HighLightEnum.Always
                            End If
                        End If
                        
                        '@退避領域の値をｸﾘｱ
                        mstrStepCategory = vbNullString

                        '@小工程を取得
                        lstrID = .GetData(.Row, CPlngvsfFlowStepID)
                            
                        With vsfStepList
                        
                            '@ﾚｽﾎﾟﾝｽ取得開始
                            Call pubResponseStart(Me.Name, lstrEventName)
                            
                            '@MSG【小工程ﾏｽﾀ取得】
                            lblnAns = pubblnMasUseStepList_Sel(pstrSBID, CMstrmas_usesteplistVer, CPstrCD29, ltypMasStepList, lstrID)
                            
                            '@結果判定
                            If lblnAns = False Then
                                '@ﾚｽﾎﾟﾝｽｷｬﾝｾﾙ
                                Call pubResponseCancel(Me.Name, lstrEventName)
                                
                                .Redraw = False
                                .Rows.Count = .Rows.Fixed                  '行
                                .Redraw = True
                                Exit Sub
                            End If
                    
                            '@小工程名から小工程ｶﾃｺﾞﾘを取得する
                            '@小工程一覧表示
                            Call prvvsfStepList_Disp(ltypMasStepList)
                            
                            '@選択された大工程名の行を検索
                            llngRow = .FindRow(lstrID, .Rows.Fixed, CMlngvsfStepListStepID, False)
                            '@検索結果
                            If llngRow > -1 Then
                                '@選択された大工程が有効か無効か判断
                                If .GetData(llngRow, CMlngvsfStepListStatus) = CMstrValid Then
                                    chkValidStepID.Checked = True     '有効
                                Else
                                    chkValidStepID.Checked = False   '無効
                                End If
                            
                                '@その行を表示
                                .Row = llngRow
                                .ShowCell(.Row, CMlngvsfStepListStepID)
                                '@ﾌｫｰｶｽ設定
                                Call pubSetFocus(vsfStepList)
                            End If
                            
                            '@ﾚｽﾎﾟﾝｽ取得終了
                            Call publngResponseEnd(Me.Name, lstrEventName)
                        End With
                    
                    Case CPlngvsfFlowConditionID, CPlngvsfFlowConditionOne        '処理条件/個別処理条件
                    
                        '@ﾌﾟﾛｾｽﾌﾛｰ画面の高さ設定
                        .Height = mlngvsfPcTabOnHeight
                        '@編集画面の表示
                        With stbSetPanel
                            .Visible = True
                            .SelectedIndex = CMlngConditionTabNo  '処理条件ﾀﾌﾞを表示
                            .Top = lvsfFlowList.Top + mlngvsfPcTabOnHeight
                        End With
                        cmdSetPanel.Enabled = True      '詳細表示ﾎﾞﾀﾝ使用可
                        fraCondition2.Visible = True
                        
                        '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞが表示されている場合
                        If vsfFlowList1.Visible = True Then
                            If sender Is vsfFlowList0 Then
                                With lblFlowList0
                                    .Font = New Font(.Font, .Font.Style Or FontStyle.Bold)
                                End With
                                lblFlowList0.ForeColor = Color.Red
                                With lblFlowList1
                                    .Font = New Font(.Font, .Font.Style And Not FontStyle.Bold) 
                                End With
                                lblFlowList1.ForeColor = Color.Black
                                
                                vsfFlowList0.HighLight = HighLightEnum.Always
                                vsfFlowList1.HighLight = HighLightEnum.Never
                            Else
                                With lblFlowList1
                                    .Font = New Font(.Font, .Font.Style Or FontStyle.Bold)      
                                End With
                                lblFlowList1.ForeColor = Color.Red
                                With lblFlowList0
                                    .Font = New Font(.Font, .Font.Style And Not FontStyle.Bold)
                                End With
                                lblFlowList0.ForeColor = Color.Black
                                
                                vsfFlowList0.HighLight = HighLightEnum.Never
                                vsfFlowList1.HighLight = HighLightEnum.Always
                            End If
                        End If
                        
                        '@退避領域の値をｸﾘｱ
                        mstrCondition = vbNullString

                        '@処理条件名から処理条件ｶﾃｺﾞﾘを取得する
                        lstrID = .GetData(.Row, CPlngvsfFlowConditionID)
                        '@処理条件名から処理条件Verを取得する
                        lstrVER = .GetData(.Row, CPlngvsfFlowConditionVer)          

                        '@WF列は非表示
                        vsfConditionList2.Cols(CPlngvsfConDetailListWF).Visible = False
                        vsfConditionList3.Cols(CPlngvsfConDetailListWF).Visible = False
                        
                        '@ﾚｽﾎﾟﾝｽ取得開始
                        Call pubResponseStart(Me.Name, lstrEventName)
                        
                        '@MSG【処理条件ｾｯﾄIDﾘｽﾄ取得】
                        lblnAns = pubblnMasConditionList_Sel(pstrSBID, CMstrmas_conditionlistVer, CPstrCD1O, ltypMasConditionList, lstrID)
                        '@結果判定
                        If lblnAns = False Then
                        '@処理条件取得に失敗
                            '@ﾚｽﾎﾟﾝｽｷｬﾝｾﾙ
                            Call pubResponseCancel(Me.Name, lstrEventName)
                            vsfConditionList1.Redraw = False
                            vsfConditionList1.Rows.Count = 1                  '行
                            vsfConditionList1.Redraw = True

                            Exit Sub
                        End If
                        
                        '@処理条件ｾｯﾄID一覧を表示
                        Call prvvsfConditionList_Disp(ltypMasConditionList)
                        
                        If vsfConditionList1.Rows.Count = vsfConditionList1.Rows.Fixed
                            '@初期化
                            vsfConditionList2.Redraw = False
                            vsfConditionList2.Rows.Count = ltypMasConditionList.lngConditionCnt + 1 '行
                            vsfConditionList2.Redraw = True
                            vsfConditionList3.Redraw = False
                            vsfConditionList3.Rows.Count = ltypMasConditionList.lngConditionCnt + 1 '行
                            vsfConditionList3.Redraw = True
                            vsfConditionWP.Redraw = False
                            vsfConditionWP.Rows.Count = 1
                            vsfConditionWP.Redraw = True
                        End If

                        '@ﾚｽﾎﾟﾝｽ取得終了
                        Call publngResponseEnd(Me.Name, lstrEventName)
                        
                        '@処理条件ｾｯﾄID
                        With vsfConditionList1
                        
                            '@処理条件ｾｯﾄIDのｸﾞﾘｯﾄﾞを回す
                            For llngCnt = 1 To .Rows.Count - 1
                            
                                '@同じ処理条件ID、処理条件Verを検索する
                                If lstrID = .GetData(llngCnt, CPlngvsfConListConID) And _
                                   lstrVER = .GetData(llngCnt, CPlngvsfConListVer) Then
                                    
                                    
                                    

        '@↓2018/06/28 (Thu) 10:37:16 T.Oide **************************************************
        '@
        '@                            '@有効のみの場合
        '@                            '@選択された工程が有効か無効か判断
        '@                            If .Cell(flexcpText, llngCnt, CPlngvsfConListStatID) = CMstrApplyJ Then
        '@                                '@ﾁｪｯｸﾎﾞｯｸｽの設定：ﾁｪｯｸ付け
        '@                                chkValidCondition.Value = CMlngValid
        '@
        '@                                '@有効の場合
        '@                                Call prvvsfEditLsit_Proc(vsfConditionList(1), True)
        '@
        '@                            Else
        '@                                '@ﾁｪｯｸﾎﾞｯｸｽの設定：ﾁｪｯｸはずし
        '@                                chkValidCondition.Value = CMlngInValid
        '@
        '@                                '@無効の場合
        '@                                Call prvvsfEditLsit_Proc(vsfConditionList(1), False)
        '@
        '@                            End If
        '@------------------------------------------------------------------------------------
                                    RemoveHandler chkValidCondition.CheckedChanged,AddressOf chkValidCondition_Click
                                    '@選択された処理条件は有効か
                                    If .GetData(llngCnt, CPlngvsfConListStatID) = CMstrApplyJ Then
                                        '@ﾁｪｯｸﾎﾞｯｸｽの設定：ﾁｪｯｸ付け
                                        chkValidCondition.Checked = True
                                    Else
                                        '@ﾁｪｯｸﾎﾞｯｸｽの設定：ﾁｪｯｸはずし
                                        chkValidCondition.Checked = False
                                    End If
                                    AddHandler chkValidCondition.CheckedChanged,AddressOf chkValidCondition_Click

                                    RemoveHandler chkMaxVer.CheckedChanged,AddressOf chkMaxVer_Click
                                    '@最新Verﾌﾗｸﾞは1か
                                    If .GetData(llngCnt, CPlngvsfConListMaxVerFlag) = CMlngValid Then
                                        '@最新Verﾁｪｯｸ設定：ON
                                        chkMaxVer.Checked = True
                                    Else
                                        '@最新Verﾁｪｯｸ設定：OFF
                                        chkMaxVer.Checked = False
                                    End If
                                    AddHandler chkMaxVer.CheckedChanged,AddressOf chkMaxVer_Click

                                    '@処理条件のｸﾞﾘｯﾄﾞ再表示(行の表示/非表示設定）
                                    Call prvvsfEditLsitCondition_Proc()
        '@↑2018/06/28 (Thu) 10:37:16 T.Oide **************************************************
                                                                                 
                                    '@その行を表示
                                    .Row = llngCnt
                                    .ShowCell(llngCnt, CPlngvsfConListConID)

                                    '@ﾌｫｰｶｽ設定
                                    Call pubSetFocus(vsfConditionList1)
                                    
                                    Exit For
                                End If
                            Next
                        End With
                        
                        '@「個別処理条件」の場合
                        If .GetData(.Row, CPlngvsfFlowConditionOne) <> vbNullString Then
                            '@個別処理条件の表示
                            Call prvPersonalCondition_Disp(lvsfFlowList)
                        End If
                         
                        If sender Is vsfFlowList0 Then
                            '@個別処理条件設定ﾎﾞﾀﾝ処理
                            Call prvcmdParConditionEnabled_Set()
                        Else
                            '@個別処理条件使用不可
                            cmdParCondition.Enabled = False
                        End If
                    
                    Case CPlngvsfFlowSelectConditionID  'WF選択条件
                    
                        '@ﾌﾟﾛｾｽﾌﾛｰ画面の高さ設定
                        .Height = mlngvsfPcTabOnHeight
                        
                        With stbSetPanel
                            '@編集画面の表示
                            .Visible = True
                            .SelectedIndex = CMlngSelectConTabNo  '測定条件ﾀﾌﾞを表示
                            .Top = lvsfFlowList.Top + mlngvsfPcTabOnHeight
                        End With
                        cmdSetPanel.Enabled = True      '詳細表示ﾎﾞﾀﾝ使用可
                        fraCondition2.Visible = False
                        
                        '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞが表示されている場合
                        If vsfFlowList1.Visible = True Then
                            If sender Is vsfFlowList0 Then
                                With lblFlowList0
                                    .Font = New Font(.Font, .Font.Style Or FontStyle.Bold)      
                                End With
                                lblFlowList0.ForeColor = Color.Red
                                With lblFlowList1
                                    .Font = New Font(.Font, .Font.Style And Not FontStyle.Bold) 
                                End With
                                lblFlowList1.ForeColor = Color.Black
                                
                                vsfFlowList0.HighLight = HighLightEnum.Always
                                vsfFlowList1.HighLight = HighLightEnum.Never
                            Else
                                With lblFlowList1
                                    .Font = New Font(.Font, .Font.Style Or FontStyle.Bold)      
                                End With
                                lblFlowList1.ForeColor = Color.Red
                                With lblFlowList0
                                    .Font = New Font(.Font, .Font.Style And Not FontStyle.Bold)
                                End With
                                lblFlowList0.ForeColor = Color.Black
                                
                                vsfFlowList0.HighLight = HighLightEnum.Always
                                vsfFlowList1.HighLight = HighLightEnum.Never
                            End If
                        End If
                        
                        '@WF選択条件ｾｯﾄIDを取得する
                        lstrID = .GetData(.Row, CPlngvsfFlowSelectConditionID)
                        
                        With vsfSelectCondition
                            '@測定条件ｾｯﾄIDﾘｽﾄの中に存在する場合
                            llngRow = .FindRow(lstrID, .Rows.Fixed, CMlngvsfSelectConditionID, False)
                            If llngRow > -1 Then
                                '@その行を表示
                                .Row = llngRow
                                .ShowCell(.Row, CMlngvsfSelectConditionID)
                                
                                Call pubSetFocus(vsfSelectCondition)
                            End If
                        End With
                    
                    Case CPlngvsfFlowCollectionID       '収集項目
                    
                        '@退避領域の値をｸﾘｱ
                        mstrCollection = vbNullString
                        
                        '@ﾌﾟﾛｾｽﾌﾛｰの画面ｻｲｽﾞを変更
                        .Height = mlngvsfPcTabOnHeight
                        
                        '@編集画面の表示
                        With stbSetPanel
                            .Visible = True
                            .SelectedIndex = CMlngCollectionTabNo '収集項目ﾀﾌﾞを表示
                            .Top = lvsfFlowList.Top + mlngvsfPcTabOnHeight
                        End With
                        cmdSetPanel.Enabled = True      '詳細表示ﾎﾞﾀﾝ使用可
                        
                        '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞが表示されている場合
                        If vsfFlowList1.Visible = True Then
                            If sender Is vsfFlowList0 Then
                                With lblFlowList0
                                    .Font = New Font(.Font, .Font.Style Or FontStyle.Bold)  
                                End With

    '関数名：cmbCollectionCategory_Validate
    '機　能：収集項目ｶﾃｺﾞﾘ処理
    '引　数：Cancel：未使用
    '戻り値：なし
    '作成日：2006/05/26 (Fri) 15:49:02 N.Kasai
    '更新日：2006/05/26 (Fri) 15:49:02
    '備　考：
    Private Sub cmbCollectionCategory_Validate(ByVal sender As Object, ByVal e As CancelEventArgs) Handles cmbCollectionCategory.Validating

        Dim lblnAns                     As Boolean                  '戻り値
        Dim ltypMasProcCollectionList   As MasProcCollectionList    '取得情報格納
        Dim lstrEventName               As String                   'ｲﾍﾞﾝﾄ名格納（ﾚｽﾎﾟﾝｽ用）

        Try

            'NSYS 画面を閉じる場合は処理を抜ける
            If mblnWindowClose = True Then
                Exit Sub
            End If
            
            '@収集項目ｶﾃｺﾞﾘが未選択の場合、処理中止
            If cmbCollectionCategory.ListIndex = -1 Then
                Exit Sub
            End If
            
            '@退避領域と比較して同じ場合には処理抜け
            If mstrCollection = cmbCollectionCategory.Text Then
                
                '@ﾌｫｰｶｽ制御
                If ActiveControl.Name = cmbCollectionCategory.Name Then
                    If vsfCollectionList.Rows.Count > 1 Then
                    '@ﾘｽﾄが存在する場合
                        '@ﾌｫｰｶｽｾｯﾄ
                        Call pubSetFocus(vsfCollectionList)
                    Else
                        '@ﾘｽﾄが存在しない場合
                        Call pubSetFocus(cmbCollectionCategory)
                    End If
                End If

                Exit Sub
            End If
                
            '@ﾚｽﾎﾟﾝｽ取得開始
            lstrEventName = "cmbCollectionCategory_Validate"
            Call pubResponseStart(Me.Name, lstrEventName)
            
            '@初期化
            vsfCollectionList.Redraw = False
            vsfCollectionList.Rows.Count = 1
            vsfCollectionList.Redraw = True
            vsfCollectionPara.Redraw = False
            vsfCollectionPara.Rows.Count = 1
            vsfCollectionPara.Redraw = True

            '@現在の収集項目ｶﾃｺﾞﾘを格納
            mstrCollection = cmbCollectionCategory.Text

            If cmbCollectionCategory.Text = CMstrAllCategory Then
                '@すべての場合
                '@MSG【収集項目取得】（CPstrCD02：全件）
                lblnAns = pubblnMasProcCollectionList_Sel(pstrSBID, _
                                                          CMstrmas_proccollectionlistVer, _
                                                          CPstrCD02, _
                                                          ltypMasProcCollectionList)
            Else
                '@ｶﾃｺﾞﾘ指定の場合
                '@MSG【収集項目取得】（CPstrCD2M：ｶﾃｺﾞﾘID指定）
                lblnAns = pubblnMasProcCollectionList_Sel(pstrSBID, _
                                                          CMstrmas_proccollectionlistVer, _
                                                          CPstrCD2M, _
                                                          ltypMasProcCollectionList, , _
                                                          mstrCollection)
            End If
            
            '@MSG[収集項目取得]の結果判定
            If lblnAns = False Then
                '@収集項目取得に失敗
                '@ﾚｽﾎﾟﾝｽｷｬﾝｾﾙ
                Call pubResponseCancel(Me.Name, lstrEventName)
                
                Exit Sub
            End If
            
            '@収集項目ﾊﾟﾗﾒｰﾀ配列を保持
            mtypMasProcCollectionList = ltypMasProcCollectionList
            
            '@MSG[処理条件取得]での取得情報を表示
            Call prvvsfCollectionList_Disp(ltypMasProcCollectionList)
            
            '@有効ﾁｪｯｸによる処理判別
            If chkValidCollection.Checked = True Then
                '@有効の場合
                Call prvvsfEditLsit_Proc(vsfCollectionList, True)
            Else
                '@無効の場合
                Call prvvsfEditLsit_Proc(vsfCollectionList, False)
            End If
            
            '@ﾌｫｰｶｽ制御
            With vsfCollectionList
                If .Rows.Count > 1 Then
                '@ﾘｽﾄが存在する場合
                    '@ﾌｫｰｶｽｾｯﾄ
                    If ActiveControl.Name = cmbCollectionCategory.Name Then
                        Call pubSetFocus(vsfCollectionList)
                    End If
                    '@1行目を選択状態
                    .Row = 1
                    .Col = 0
                    .ShowCell(.Row, .Col)
                Else
                    '@ﾘｽﾄが存在しない場合
                    If ActiveControl.Name = cmbCollectionCategory.Name Then
                        Call pubSetFocus(cmbCollectionCategory)
                    End If
                End If
            End With
            
            '@ﾚｽﾎﾟﾝｽ取得終了
            Call publngResponseEnd(Me.Name, lstrEventName)
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "cmbCollectionCategory_Validate"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


                        serchSetting.Enabled = False               '設定値検索
        '@↑2016/07/22 (Fri) 13:43:56 T.Oide **************************************************

                    Else
                        '@使用可
                        cmdSave1.Enabled = True                     '一時保存
                        cmdSave2.Enabled = True                     '確定
        '@↓2016/07/22 (Fri) 13:43:56 T.Oide **************************************************
                        serchSetting.Enabled = True                 '設定値検索
                        cmdSpcSkipChkOn.Enabled = True              'SPCｽｷｯﾌﾟ全On
        '@↑2016/07/22 (Fri) 13:43:56 T.Oide **************************************************
                        

    '作成日：2006/07/03 (Mon) 15:40:12 N.Kasai
    '更新日：2007/11/28 (Wed) 19:38:10 N.Kasai
    '備　考：
    '　　　：2007/11/28 (Wed) 19:38:10 N.Kasai  編集不可工程はSVに返却しない。
    Private Sub prvAryConDetailData_Set(ByRef ltypProcChgCollectRecp As ProcChgCollectRecp)
        
        Dim llngColCnt  As Integer  'ｶｳﾝﾀ
        Dim llngConDel  As Integer  '詳細ｶｳﾝﾀ
        Dim llngCnt     As Integer  'ｶｳﾝﾀ
        Dim llngRow     As Integer  '行ｶｳﾝﾀ
        Dim lblnErrFlag As Boolean  'ｴﾗｰﾌﾗｸﾞ（True:ｴﾗｰなし、False:ｴﾗｰあり）
        
        Try
            
            '@大工程/小工程再設定
            With ptypProcCondDetailList
                '@件数が存在
                If .lngProcCondDetailCnt > 0 Then
                    '@構造体分再設定
                    For llngCnt = 0 To .lngProcCondDetailCnt -1
                        '@有効ﾃﾞｰﾀのみ
                        If .typProcCondDetail(llngCnt).blnEnableFlag = True Then
                            
                            '@ｴﾗｰﾌﾗｸﾞ初期化
                            lblnErrFlag = False
            
                            '@ﾌﾛｰﾘｽﾄを検索
                            For llngRow = 1 To vsfFlowList0.Rows.Count - 1
                                '@絶対工順番号をkeyに検索
                                If .typProcCondDetail(llngCnt).strAbsNo = _
                                    vsfFlowList0.GetData(llngRow, CPlngvsfFlowAbsNo) Then
                                    
                                    Dim ltypProcCondDetailTmp As ProcCondDetail = New ProcCondDetail
                                    ltypProcCondDetailTmp = ptypProcCondDetailList.typProcCondDetail(llngCnt)
                                    '@大工程再ｾｯﾄ
                                    ltypProcCondDetailTmp.strOpID = _
                                        vsfFlowList0.GetData(llngRow, CPlngvsfFlowOpID)
                                    '@小工程再ｾｯﾄ
                                    ltypProcCondDetailTmp.strStepID = _
                                        vsfFlowList0.GetData(llngRow, CPlngvsfFlowStepID)
                                    
                                    ptypProcCondDetailList.typProcCondDetail(llngCnt) = ltypProcCondDetailTmp

                                    '@ｴﾗｰなし
                                    lblnErrFlag = True
                                    Exit For
                                End If
                            Next
                            
                            '@例外処理
                            If lblnErrFlag = False Then
                                '@keyが発見できない場合
                                '@机上論ではありえません。
                                Dim ltypProcCondDetailTmp As ProcCondDetail = New ProcCondDetail
                                ltypProcCondDetailTmp = .typProcCondDetail(llngCnt)
                                ltypProcCondDetailTmp.blnEnableFlag = False
                                .typProcCondDetail(llngCnt) = ltypProcCondDetailTmp
                            End If
                        End If
                    Next
                End If
            End With
                
            '@登録用構造体格納処理
            '@初期化
            llngColCnt = 0
            
            With vsfFlowList0
                '@ﾌﾛｰﾘｽﾄを検索
                For llngRow = 1 To .Rows.Count - 1
                    '@処理条件ｾｯﾄID＝「個別処理条件」の場合
                    If .GetData(llngRow, CPlngvsfFlowConditionOne) <> vbNullString Then
                    
                        With ptypProcCondDetailList
                            '@個別処理条件退避ﾃﾞｰﾀを検索
                            For llngCnt = 0 To .lngProcCondDetailCnt -1
                                '@有効ﾃﾞｰﾀのみ
                                If .typProcCondDetail(llngCnt).blnEnableFlag = True Then
                            
                                    '@大工程・小工程が一致するﾃﾞｰﾀを検索
                                    If .typProcCondDetail(llngCnt).strOpID _
                                        = vsfFlowList0.GetData(llngRow, CPlngvsfFlowOpID) And _
                                       .typProcCondDetail(llngCnt).strStepID _
                                        = vsfFlowList0.GetData(llngRow, CPlngvsfFlowStepID) Then
                                    
                                        '@編集不可工程はSVへ返却しない
                                        If vsfFlowList0.GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then

                                            '@ﾚｼﾋﾟ一括変更要求ﾃﾞｰﾀｶｳﾝﾄｱｯﾌﾟ
                                            llngColCnt = llngColCnt + 1
                                            '@ﾚｼﾋﾟ一括変更要求ﾃﾞｰﾀの再定義
                                            Dim ltypProcRecpListTmp As ProcRecpList = New ProcRecpList

                                            '@ﾚｼﾋﾟ一括変更要求ﾃﾞｰﾀの設定
                                            ltypProcChgCollectRecp.lngProcRecpListCnt = llngColCnt
                                            
                                            ltypProcRecpListTmp.strOpID _
                                                = .typProcCondDetail(llngCnt).strOpID
                                                
                                            ltypProcRecpListTmp.strStepID _
                                                = .typProcCondDetail(llngCnt).strStepID
                                                
                                            ltypProcRecpListTmp.lngProcCondListCnt _
                                                = .typProcCondDetail(llngCnt).lngCondDetailCnt
                            
                                            ltypProcRecpListTmp.typProcCondList _
                                                = New List(Of ProcCond)(ltypProcRecpListTmp.lngProcCondListCnt)

                                            With ptypProcCondDetailList.typProcCondDetail(llngCnt)
                                                '@処理条件詳細情報の検索
                                                For llngConDel = 0 To .lngCondDetailCnt -1
                                                    '@ﾚｼﾋﾟ一括変更要求ﾃﾞｰﾀ/ﾚｼﾋﾟ一括変更ﾘｽﾄの再定義
                                                    Dim ltypProcCondTmp As ProcCond = New ProcCond

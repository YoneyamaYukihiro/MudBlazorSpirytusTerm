    '関数名：pubTimeLimitDisp_Del
    '機　能：時間制限表示削除処理
    '引　数：lstrListOrder：時間制限番号
    '戻り値：なし
    '作成日：2006/06/19 (Mon) 08:55:01 N.Kasai
    '更新日：2006/06/19 (Mon) 08:55:01
    '備　考：
    Public Sub pubTimeLimitDisp_Del(ByVal lstrListOrder As String)
        
        Dim llngCnt             As Integer  'ｶｳﾝﾀ
        Dim llngAryCount        As Integer  '配列ｶｳﾝﾀ
        Dim lstrAry()           As String   'ｾﾙ内時間制限配列
        Dim lstrCellItem        As String   'ｾﾙ内容
        Dim lblnMatch           As Boolean  '一致ﾌﾗｸﾞ
        Dim lblnEditDataFlag    As Boolean  '既存ﾃﾞｰﾀ判定ﾌﾗｸﾞ（true:既存、false:新規）
        
        Try
            
            lblnEditDataFlag = False
            
            '@構造体内の時間制限を削除
            '@時間制限配列が存在する場合
            If ptypProcTimeLimitInfo.lngProcTimeLimitCnt > 0 Then
                For llngCnt = 0 To ptypProcTimeLimitInfo.lngProcTimeLimitCnt -1
                    If Format$(CInt(ptypProcTimeLimitInfo.typProcTimeLimit(llngCnt).strListOrder), CMstrNoFormat) = Format$(CInt(lstrListOrder), CMstrNoFormat) Then
                        '@時間制限配列をｸﾘｱ
                        Dim ltypProcTimeLimitTmp As ProcTimeLimit = New ProcTimeLimit
                        ltypProcTimeLimitTmp = ptypProcTimeLimitInfo.typProcTimeLimit(llngCnt)
                        ltypProcTimeLimitTmp.blnEnableFlag = False
                        ptypProcTimeLimitInfo.typProcTimeLimit(llngCnt) = ltypProcTimeLimitTmp 

                        lblnEditDataFlag = True
                    End If
                Next
            End If

            With vsfFlowList0
            
                '@ﾌﾟﾛｾｽｸﾞﾘｯﾄ分、検索文字列を検索
                For llngCnt = 1 To .Rows.Count - 1
                    
                    '@空白でない場合
                    If .GetData(llngCnt, CPlngvsfFlowTimeLimit) <> vbNullString Then
                        
                        '一致ﾌﾗｸﾞｸﾘｱ
                        lblnMatch = False
                        
                        '@現在のｾﾙの値を配列に格納
                        lstrAry = Split(.GetData(llngCnt, CPlngvsfFlowTimeLimit), CMstrComma)
                        lstrCellItem = vbNullString

                        '@配列数分、以下の処理を繰り返す
                        For llngAryCount = 0 To UBound(lstrAry)
                            '@検索文字列でない場合、ｾﾙ内容文字列に設定
                            If Format$(CInt(lstrListOrder), CMstrNoFormat) = Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo3) Then
                                lblnMatch = True '一致
                            Else
                                lstrCellItem = lstrCellItem & lstrAry(llngAryCount) & CMstrComma
                            End If
                        Next
                        
                        '@一致した場合
                        If lblnMatch = True Then
                            If lstrCellItem = vbNullString Then
                                '@検索文字列を削除
                                .SetData(llngCnt, CPlngvsfFlowTimeLimit, vbNullString)
                            Else
                                '@検索文字列を削除(ｶﾝﾏ削除）
                                .SetData(llngCnt, CPlngvsfFlowTimeLimit, Strings.Left$(lstrCellItem, Len(lstrCellItem) - 1))
                            End If
                            
                            '@新規ﾃﾞｰﾀの場合はﾊﾞｯｸｶﾗｰを変更しない
                            If lblnEditDataFlag = True Then
                                '@検索文字列ｾﾙの背景色を変更
                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                Dim cellRange As CellRange = .GetCellRange(llngCnt, CPlngvsfFlowTimeLimit)
                                cellRange.Style = newStyle
                                .SetData(llngCnt, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                                .SetData(llngCnt, CPlngvsfFlowTimeLimitFlag, CMstrFlgOn)

                            End If
                            
                            '@列幅自動調整
                            .AutoSizeCol(CPlngvsfFlowTimeLimit, 6)
                            
                            '@変更ﾌﾗｸﾞｵﾝ
                            pblnEN01X2Edit = True
                           
                        End If
                    End If
                Next
            End With
            
            '@時間制限ﾎﾞﾀﾝの使用許可
             Call prvcmdTimeLimitEnabled_Set()
            
            '@配列の初期化
            Erase lstrAry
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "pubTimeLimitDisp_Del"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：pubTimeLimitDisp_Set
    '機　能：時間制限表示設定
    '引　数：lstrListOrder：時間制限番号
    '　　　：lstrRestrictTypeID：制約ﾀｲﾌﾟ
    '戻り値：なし
    '作成日：2006/06/19 (Mon) 08:47:10 N.Kasai
    '更新日：2006/06/19 (Mon) 08:47:10
    '備　考：
    Public Sub pubTimeLimitDisp_Set(ByVal lstrListOrder As String, ByVal lstrRestrictTypeID As String)
        
        Dim llngCnt             As Integer  'ｶｳﾝﾀ
        Dim llngAryCount        As Integer  '配列ｶｳﾝﾀ
        Dim lstrAry()           As String   'ｾﾙ内時間制限配列
        Dim lstrCellItem        As String   'ｾﾙ内容
        Dim lblnMatch           As Boolean  '一致ﾌﾗｸﾞ
        
        Try

            With vsfFlowList0
            
                '@ﾌﾟﾛｾｽｸﾞﾘｯﾄ分、検索文字列を検索
                For llngCnt = 1 To .Rows.Count - 1
                
                    '@空白でない場合
                    If .GetData(llngCnt, CPlngvsfFlowTimeLimit) <> vbNullString Then
                        
                        '一致ﾌﾗｸﾞｸﾘｱ
                        lblnMatch = False
                        
                        '@現在のｾﾙの値を配列に格納
                        lstrAry = Split(.GetData(llngCnt, CPlngvsfFlowTimeLimit), CMstrComma)
                        lstrCellItem = vbNullString
                        
                        '@配列数分、以下の処理を繰り返す
                        For llngAryCount = 0 To UBound(lstrAry)
                            '@検索文字列でない場合、ｾﾙ内容文字列に設定
                            If Format$(CInt(lstrListOrder), CMstrNoFormat) = Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo3) Then
                                lblnMatch = True '一致
                                lstrCellItem = lstrCellItem & CMstrTimeLimitMark & lstrRestrictTypeID & Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen), Len(lstrAry(llngAryCount))) & CMstrComma
                            Else
                                lstrCellItem = lstrCellItem & lstrAry(llngAryCount) & CMstrComma
                            End If
                        Next
                        
                        '@一致した場合
                        If lblnMatch = True Then
                            '@最終文字列を判定
                            If Strings.Right$(lstrCellItem, 1) = CMstrComma Then
                                '@検索文字列を削除(ｶﾝﾏ削除）
                                .SetData(llngCnt, CPlngvsfFlowTimeLimit, Strings.Left$(lstrCellItem, Len(lstrCellItem) - 1))
                            Else
                                .SetData(llngCnt, CPlngvsfFlowTimeLimit, lstrCellItem)
                            End If
                                
                            '@検索文字列ｾﾙの背景色を変更
                            Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                            Dim cellRange As CellRange = .GetCellRange(llngCnt, CPlngvsfFlowTimeLimit)
                            cellRange.Style = newStyle
                            .SetData(llngCnt, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                            .SetData(llngCnt, CPlngvsfFlowTimeLimitFlag, CMstrFlgOn)
                            
                            
                            '@列幅自動調整
                            .AutoSizeCol(CPlngvsfFlowTimeLimit, 6)
                            
                            '@変更ﾌﾗｸﾞｵﾝ
                            pblnEN01X2Edit = True
                        End If
                    End If
                Next
                
            End With
            
            '@時間制限ﾎﾞﾀﾝの使用許可
             Call prvcmdTimeLimitEnabled_Set()
            
            '@配列の初期化
            Erase lstrAry
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "pubTimeLimitDisp_Set"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：pubApc_Del
    '機　能：APC設定削除処理
    '引　数：lstrSearchString：検索文字列
    '　　　：lstrListOrder：ﾘｽﾄ番号
    '戻り値：なし
    '作成日：2006/03/14 (Tue) 16:26:34 N.Kasai
    '更新日：2011/07/01 (Fri) 15:41:30 M.Sakka
    '備　考：
    Public Sub pubApc_Del(ByVal lstrSearchString As String)
        
        Dim llngCnt                 As Integer  'ｶｳﾝﾀ
        Dim llngAryCount            As Integer  '配列ｶｳﾝﾀ
        Dim lstrAry()               As String   '配列
        Dim llngSearchAryCount      As Integer  '配列ｶｳﾝﾀ
        Dim lstrSearchAry()         As String   '配列
        Dim lstrSearch              As String   '検索文字
        Dim lblnMatch               As Boolean  '一致ﾌﾗｸﾞ
        Dim lstrCellItem            As String   '削除後文字列

        Try

            '@検索値を配列に格納
            lstrSearchAry = Split(lstrSearchString, CMstrComma)
            
            For llngSearchAryCount = 0 To UBound(lstrSearchAry)
            
                '@検索文字列格納
                lstrSearch = Strings.Left$(lstrSearchAry(llngSearchAryCount), 6)
                
                With vsfFlowList0
                    '@ﾌﾟﾛｾｽｸﾞﾘｯﾄ分、検索文字列を検索
                    For llngCnt = 1 To .Rows.Count - 1
                        '@空白でない場合
                        If .GetData(llngCnt, CPlngvsfFlowApc) <> vbNullString Then
                            
                            lblnMatch = False
                            lstrCellItem = vbNullString
                            
                            '@現在のｾﾙの値を配列に格納
                            lstrAry = Split(.GetData(llngCnt, CPlngvsfFlowApc), CMstrComma)
            
                            '@配列数分、以下の処理を繰り返す
                            For llngAryCount = 0 To UBound(lstrAry)
                                If Strings.Left$(lstrAry(llngAryCount), 6) = lstrSearch Then
                                    lblnMatch = True
                                Else
                                    lstrCellItem = lstrCellItem & lstrAry(llngAryCount) & CMstrComma
                                End If
                            Next
                            
                            '@一致した場合
                            If lblnMatch = True Then
                                If lstrCellItem = vbNullString Then
                                    '@検索文字列を削除
                                    .SetData(llngCnt, CPlngvsfFlowApc, vbNullString)
                                    '@ﾁｪｯｸも連動してｸﾘｱ
                                    .SetCellCheck(llngCnt, CPlngvsfFlowApcSkipFlag, CheckEnum.Unchecked)
                                    .SetCellCheck(llngCnt, CPlngvsfFlowApcCalcSkipFlag, CheckEnum.Unchecked)
                                    
                                    '@ﾊﾞｯｸｶﾗｰの変更
                                    If .GetCellRange(llngCnt, CPlngvsfFlowApcSkipFlag).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorSBlue) Then
                                        Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                        Dim cellRange As CellRange = .GetCellRange(llngCnt, CPlngvsfFlowApcSkipFlag)
                                        cellRange.Style = newStyle
                                    End If

                                    '@ﾊﾞｯｸｶﾗｰの変更
                                    If .GetCellRange(llngCnt, CPlngvsfFlowApcCalcSkipFlag).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorSBlue) Then
                                        Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                        Dim cellRange As CellRange = .GetCellRange(llngCnt, CPlngvsfFlowApcCalcSkipFlag)
                                        cellRange.Style = newStyle
                                    End If
                                    
                                    'APC設定可否情報を設定する
                                    'APC枚葉設定の制御
                                     .SetCellCheck(llngCnt, CPlngvsfFlowApcWfUnitFlgSetable, CheckEnum.Unchecked)
                                     'GUIの制御を実行
                                     Call ControlApcWfUnitFlg(vsfFlowList0, llngCnt)
                                Else
                                    '@検索文字列を削除(ｶﾝﾏ削除）
                                    .SetData(llngCnt, CPlngvsfFlowApc, Strings.Left$(lstrCellItem, Len(lstrCellItem) - 1))
                                End If
                            End If
                        End If
                    Next
                            
                    '@列幅自動調整
                    .AutoSizeCol(CPlngvsfFlowApc, 6)
                End With
            
            Next
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "pubApc_Del"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：pubConditionOneCopy_Set
    '機　能：ﾛｯﾄ間個別処理条件ｺﾋﾟｰ処理
    '引　数：llngRow：該当行
    '戻り値：True:ﾚｼﾋﾟ未設定あり、False：ｴﾗｰなし
    '作成日：2006/06/29 (Thu) 10:06:40 N.Kasai
    '更新日：2006/06/29 (Thu) 10:06:40
    '備　考：
    Public Function pubblnConditionOneCopy_Set(ByVal llngRow As Integer) As Boolean
        
        Dim llngCnt         As Integer      '汎用ｶｳﾝﾀ
        Dim llngCnt2        As Integer      '汎用ｶｳﾝﾀ2
        Dim llngIndex       As Integer      '該当ｲﾝﾃﾞｯｸｽ
        Dim llngIndexCnt    As Integer      '格納ｲﾝﾃﾞｯｸｽ
        Dim llngAryCnt      As Integer      'Aryｶｳﾝﾄ
        Dim llngAryCnt2     As Integer      'Aryｶｳﾝﾄ2
        Dim lblnFlag        As Boolean      '同一ｽﾛｯﾄ№判定ﾌﾗｸﾞ（True:あり,False：なし）
        Dim lstrWpId        As String       'WPID退避（比較用）
        Dim lstrSeekWord    As String       '該当WPID格納文字
        Dim llngAryWpCnt    As Integer      'WPID配列ｶｳﾝﾄ
        Dim lstrAryWp()     As String       'WPID格納用配列
        
        Dim lstrWorkWPID    As String       'WPID退避
        Dim lstrWorkWPNAME  As String       'WP名退避
        
        Try
            
            '@戻り値初期化
            pubblnConditionOneCopy_Set = False
            
            '@ｲﾝﾃﾞｯｸｽ初期化
            llngIndex = -1
            
            '@該当行に紐付く個別処理条件のｲﾝﾃﾞｯｸｽを検索する。
            For llngCnt2 = 0 To ptypCondDetailListCp.lngProcCondDetailCnt -1
                
                '@該当行のSeqNoが同一の場合
                If vsfFlowList1.GetData(llngRow, CPlngvsfFlowAbsNo) = ptypCondDetailListCp.typProcCondDetail(llngCnt2).strAbsNo Then
                    '@ｲﾝﾃﾞｯｸｽ退避
                    llngIndex = llngCnt2
                    Exit For
                End If
            Next
            
            '@ｲﾝﾃﾞｯｸｽ判定
            If llngIndex <> -1 Then
            
                '@ｺﾋﾟｰ格納構造体定義
                If ptypCopyCondDetailList.typProcCondDetail Is Nothing Then
                    ptypCopyCondDetailList.typProcCondDetail = New List(Of ProcCondDetail)
                End If

                Dim ltypProcCondDetailTmp As ProcCondDetail = New ProcCondDetail
                ltypProcCondDetailTmp.typProcCond = New List(Of ProcCond)
                
                '@該当行が個別枚葉ﾚｼﾋﾟ設定の場合
                If vsfFlowList1.GetData(llngRow, CPlngvsfFlowWFRecipeFlag) = "1" Then
                    
                    '@ｺﾋﾟｰ元個別処理条件構造体より該当するが装置IDが複数存在する場合がある
                    '@装置ID分値を取得
                    With ptypCondDetailListCp.typProcCondDetail(llngIndex)
                        '@格納数分
                        For llngCnt = 0 To .lngCondDetailCnt -1
                            '@1件目の場合
                            If llngCnt = 0 Then
                                '@WPIDを格納（比較用）
                                lstrWpId = .typProcCond(llngCnt).strWpID
                                '@WPIDを格納（表示用）
                                lstrSeekWord = .typProcCond(llngCnt).strWpID & CMstrComma
                            End If
                            
                            '@退避WPIDと取得したWPIDを比較
                            If lstrWpId <> .typProcCond(llngCnt).strWpID Then
                                '@WPIDを格納（比較用）
                                lstrWpId = .typProcCond(llngCnt).strWpID
                                '@WPIDを格納（表示用）
                                lstrSeekWord = lstrSeekWord & .typProcCond(llngCnt).strWpID & CMstrComma
                            End If
                        Next
                    End With
                    
                    '@最終文字列がｶﾝﾏの場合
                    If Strings.Right$(lstrSeekWord, 1) = CMstrComma Then
                        '@ｶﾝﾏを切り取り
                        lstrSeekWord = Strings.Left$(lstrSeekWord, Len(lstrSeekWord) - 1)
                    End If
                    
                    '@取得したWPIDを配列に格納する。
                    lstrAryWp = Split(lstrSeekWord, CMstrComma)
            
                
                    '@枚葉ﾚｼﾋﾟの場合
                    With ltypProcCondDetailTmp
                        .blnEnableFlag = True
                        .strOpID = vbNullString
                        .strStepID = vbNullString
                        .strWpCommonRecipeFlag = ptypCondDetailListCp.typProcCondDetail(llngIndex).strWpCommonRecipeFlag
                        .strAbsNo = ptypCondDetailListCp.typProcCondDetail(llngIndex).strAbsNo
                        
                        '@ｺﾋﾟｰ先のﾛｯﾄIDのWF枚数がある場合
                        If ptypWaferListCp.lngProcWFListCnt > 0 Then
                            
                            '@ｲﾝﾃﾞｯｸｽを初期化
                            llngIndexCnt = 0
                            
                            '@配列数分、以下の処理を繰り返す（装置が複数存在する場合を考慮）
                            For llngAryWpCnt = 0 To UBound(lstrAryWp)
                                
                                '@ﾌﾗｸﾞ初期化
                                lblnFlag = False
                                
                                lstrWorkWPID = vbNullString
                                lstrWorkWPNAME = vbNullString
                                
                                '@ｺﾋﾟｰ先のWF枚数分ﾙｰﾌﾟ
                                For llngAryCnt = 0 To ptypWaferListCp.lngProcWFListCnt -1
                                    
                                    '@同一ｽﾛｯﾄ№ﾌﾗｸﾞ初期化
                                    lblnFlag = False
                                    
                                    '@ｺﾋﾟｰ元の個別処理条件WF枚数分ﾙｰﾌﾟ（装置が複数存在する場合がある）
                                    For llngAryCnt2 = 0 To ptypCondDetailListCp.typProcCondDetail(llngIndex).lngCondDetailCnt -1
                                    
                                        '@ｽﾛｯﾄﾎﾟｼﾞｼｮﾝ判定
                                        If ptypWaferListCp.typProcWFList(llngAryCnt).strSlotPosition = _
                                            ptypCondDetailListCp.typProcCondDetail(llngIndex).typProcCond(llngAryCnt2).strSlotPosition _
                                            And lstrAryWp(llngAryWpCnt) = ptypCondDetailListCp.typProcCondDetail(llngIndex).typProcCond(llngAryCnt2).strWpID Then
                                            
                                            '@同一ｽﾛｯﾄ№同一ｽﾛｯﾄ№あり
                                            lblnFlag = True
                                            
                                            '@ﾃﾞｰﾀｶｳﾝﾄｱｯﾌﾟ
                                            llngIndexCnt = llngIndexCnt + 1
                                            '@ｺﾋﾟｰ格納構造体再定義
                                            Dim typProcCondTmp As New ProcCond

                                            '@ﾃﾞｰﾀを格納
                                            typProcCondTmp.strWfId = ptypWaferListCp.typProcWFList(llngAryCnt).strWfId
                                            typProcCondTmp.strWpID = ptypCondDetailListCp.typProcCondDetail(llngIndex).typProcCond(llngAryCnt2).strWpID
                                            typProcCondTmp.strWpName = ptypCondDetailListCp.typProcCondDetail(llngIndex).typProcCond(llngAryCnt2).strWpName
                                            typProcCondTmp.strRecipeId = ptypCondDetailListCp.typProcCondDetail(llngIndex).typProcCond(llngAryCnt2).strRecipeId
                                            typProcCondTmp.strRecipeVersion = ptypCondDetailListCp.typProcCondDetail(llngIndex).typProcCond(llngAryCnt2).strRecipeVersion
                                            typProcCondTmp.strDefaultFlag = ptypCondDetailListCp.typProcCondDetail(llngIndex).typProcCond(llngAryCnt2).strDefaultFlag
                                            typProcCondTmp.strComments = ptypCondDetailListCp.typProcCondDetail(llngIndex).typProcCond(llngAryCnt2).strComments

                                            .typProcCond.Add(typProcCondTmp)
                                        End If
                                    
                                    
                                        '@WPID、装置名を退避
                                        If lstrAryWp(llngAryWpCnt) = ptypCondDetailListCp.typProcCondDetail(llngIndex).typProcCond(llngAryCnt2).strWpID Then
                                            
                                            lstrWorkWPID = ptypCondDetailListCp.typProcCondDetail(llngIndex).typProcCond(llngAryCnt2).strWpID
                                            lstrWorkWPNAME = ptypCondDetailListCp.typProcCondDetail(llngIndex).typProcCond(llngAryCnt2).strWpName
                                        
                                        End If
                                    
                                    
                                    Next
                                    
                                    '@同一ｽﾛｯﾄ№同一ｽﾛｯﾄ№なし
                                    If lblnFlag = False Then
                                        
                                        If llngAryCnt2 > ptypCondDetailListCp.typProcCondDetail(llngIndex).lngCondDetailCnt Then
                                        
                                            llngAryCnt2 = llngAryCnt2 - 1
                                            '@ﾚｼﾋﾟ未設定あり
                                            pubblnConditionOneCopy_Set = True
                                        End If
                                        
                                        '@ﾃﾞｰﾀｶｳﾝﾄｱｯﾌﾟ
                                        llngIndexCnt = llngIndexCnt + 1
                                        '@ｺﾋﾟｰ格納構造体再定義
                                        Dim ltypProcCondTmp As ProcCond = New ProcCond

                                        '@ﾃﾞｰﾀを格納
                                        ltypProcCondTmp.strWfId = ptypWaferListCp.typProcWFList(llngAryCnt).strWfId
                                        ltypProcCondTmp.strWpID = lstrWorkWPID
                                        ltypProcCondTmp.strWpName = lstrWorkWPNAME
                                        ltypProcCondTmp.strRecipeId = CPstrRecpNotID
                                        ltypProcCondTmp.strRecipeVersion = "0"
                                        ltypProcCondTmp.strDefaultFlag = vbNullString
                                        ltypProcCondTmp.strComments = vbNullString

                                        .typProcCond.Add(ltypProcCondTmp)
                                    End If
                                    
                                Next
                            Next
                        End If
                        
                        '@WFIDの件数取得（装置が複数存在する場合を考慮）
                        .lngCondDetailCnt = llngIndexCnt

                        ptypCopyCondDetailList.typProcCondDetail.Add(ltypProcCondDetailTmp)

                    End With
                Else
                    '@ﾛｯﾄﾚｼﾋﾟの場合
                    ptypCopyCondDetailList.typProcCondDetail.Add(ptypCondDetailListCp.typProcCondDetail(llngIndex))
                End If
            Else
                '@ﾃﾞｰﾀ例外
                ptypCopyCondDetailList.lngProcCondDetailCnt = 0
            End If
            
            '@配列の初期化
            Erase lstrAryWp
            
            Exit Function

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "pubConditionOneCopy_Set"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Function


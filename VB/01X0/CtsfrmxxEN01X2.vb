    '関数名：prvlngWpRestrictMark_Chk
    '機　能：処理号機設定（記憶設定ﾁｪｯｸ）
    '引　数：なし
    '戻り値：0：記憶設定なし、-1:ﾁｪｯｸ不要
    '作成日：2007/05/30 (Wed) 08:49:46 N.Kasai
    '更新日：2007/05/30 (Wed) 08:49:46
    '備　考：
    Private Function prvlngWpRestrictMark_Chk() As Integer

        Dim llngCnt         As Integer  '汎用ｶｳﾝﾀ
        Dim llngData        As Integer  '該当ﾃﾞｰﾀ数
        Dim llngRow         As Integer  '該当行
        
        Try
            
            '@初期化
            llngData = 0
            llngRow = 0
            prvlngWpRestrictMark_Chk = -1
            
            With vsfFlowList0
                For llngCnt = 1 To .Rows.Count - 1
                    If Strings.Right$(.GetData(llngCnt, CPlngvsfFlowWpRestrict), 1) = CMstrWpMarkMark Then
                        llngData = llngData + 1
                                                
                        '@先頭の記憶行を退避
                        If llngData = 1 Then
                            llngRow = llngCnt
                        End If
                    End If
                Next
                
                If llngData = 0 Then
                    prvlngWpRestrictMark_Chk = 0
                    Exit Function
                End If
                
                If llngRow > mlngWkRow Then
                    prvlngWpRestrictMark_Chk = 0
                Else
                    prvlngWpRestrictMark_Chk = -1
                End If
                    
            End With
            
            
            Exit Function
            
        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvlngWpRestrictMark_Chk"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Function


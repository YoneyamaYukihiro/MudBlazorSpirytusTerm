    '関数名：prvcmdParConditionEnabled_Set
    '機　能：個別処理条件設定ﾎﾞﾀﾝ処理
    '引　数：なし
    '戻り値：なし
    '作成日：2006/06/20 (Tue) 12:26:49 N.Kasai
    '更新日：2006/09/08 (Fri) 14:21:58 N.Kasai
    '備　考：
    '　　　：2006/09/08 (Fri) 14:21:58 N.Kasai  仕様変更投入前でも個別処理条件の設定可
    Private Sub prvcmdParConditionEnabled_Set()

        Try
            
            '@選択されているﾀﾌﾞを判定する。「処理条件」以外は処理なし
            If stbSetPanel.SelectedIndex <> CMlngConditionTabNo Then
                Exit Sub
            End If
            
            '@pstrEN01X0KindFlag:種別（1:ﾛｯﾄ工順変更、2:組立工順一時保存）
            '@ﾛｯﾄ状態が「投入待ち」の場合は個別処理条件の編集不可
            '@ﾛｯﾄ状態が空白の場合（工順なし）は個別処理条件の編集不可
            
            '@個別処理条件ﾎﾞﾀﾝ制御条件判定
            With vsfFlowList0
                '@工順ﾘｽﾄで該当行に「WF選択条件」が設定済みの場合
                If .GetData(.Row, CPlngvsfFlowSelectConditionID) <> vbNullString Then
                    '@個別処理条件設定ﾎﾞﾀﾝを使用不可
                    cmdParCondition.Enabled = False
                    Exit Sub
                End If
                
                '@編集不可工程の場合
                If .GetData(.Row, CPlngvsfFlowPermit) = CMstrPermit2 Then
                   '@個別処理条件設定ﾎﾞﾀﾝを使用不可
                    cmdParCondition.Enabled = False
                    Exit Sub
                End If
                
                '@流動票の処理条件と処理条件一覧で選択されている処理条件が異なる場合
                If vsfConditionList1.Row < vsfConditionList1.Rows.Fixed OrElse _
                    .GetData(.Row, CPlngvsfFlowConditionID) <> vsfConditionList1.GetData(vsfConditionList1.Row, CPlngvsfConListConID) Then
                    '@個別処理条件設定ﾎﾞﾀﾝを使用不可
                    cmdParCondition.Enabled = False
                    Exit Sub
                End If
                
                '@流動票の処理条件Verと処理条件一覧で選択されている処理条件Verが異なる場合
                If vsfConditionList1.Row < vsfConditionList1.Rows.Fixed OrElse _
                    .GetData(.Row, CPlngvsfFlowConditionVer) <> vsfConditionList1.GetData(vsfConditionList1.Row, CPlngvsfConListVer) Then
                    '@個別処理条件設定ﾎﾞﾀﾝを使用不可
                    cmdParCondition.Enabled = False
                    Exit Sub
                End If
            End With
            
            '@処理条件一覧が空欄の場合
            If vsfConditionList2.Rows.Count < 1 Then
                '@個別処理条件設定ﾎﾞﾀﾝを使用不可
                cmdParCondition.Enabled = False
                Exit Sub
            End If
            
            '@個別処理条件設定"ﾎﾞﾀﾝを使用可
            cmdParCondition.Enabled = True

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvcmdParConditionEnabled_Set"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


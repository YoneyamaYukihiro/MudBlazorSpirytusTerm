                                                    ltypProcCondTmp = .typProcCond(llngConDel)
                                                    ltypProcRecpListTmp.typProcCondList.Add(ltypProcCondTmp)
                                                Next
                                            End With
                                            ltypProcChgCollectRecp.typProcRecpList.Add(ltypProcRecpListTmp)
                                        End If
                                    End If
                                End If
                            Next
                        End With
                    
                    End If
                Next
            End With
                   
            Exit Sub

        Catch ex As Exception


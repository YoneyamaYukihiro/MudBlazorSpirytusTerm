    '備　考：
    Private Sub prvAryFlowListData_Set(ByRef ltypProcRegistReq As ProcRegistReq, _
                                       ByRef lstApcTeosStep As List(Of TypeApcTeosStep), _
                                       ByRef lstTeosPrismAPCStep As List(Of TypeApcTeosStep))

        Dim llngCnt                 As Integer  'ｶｳﾝﾀ
        Dim llngRow                 As Integer  '行
        Dim llngSwapIndicatorNo     As Integer  '入替工程No
        Dim lblnMatch               As Boolean  '一致ﾌﾗｸﾞ
        Dim lstrListOrder           As String   'ﾘｽﾄｵｰﾀﾞ退避
        Dim lstrWpRestrictNum       As String   '処理号機番号退避
        Dim llngAryCount            As Integer  '配列ｶｳﾝﾀ
        Dim lstrAry()               As String   'ｾﾙ内配列
        Dim lblnStartSeqNum         As Boolean  '編集開始工程判定ﾌﾗｸﾞ
        Dim lstrWkString            As String   '作業用変数
        Dim llngCateCnt             As Integer  'ｷｬﾘｱｶﾃｺﾞﾘ用
        Dim llngPriorityStartNo     As Integer  '区間優先度開始No
        Dim llngPriorityEndNo       As Integer  '区間優先度終了No
        Dim lstrPriority            As String   '区間優先度
        
        Try

            '@ﾌﾟﾛｾｽﾃﾞｰﾀを格納する
            With ltypProcRegistReq
            
                '@初期化
                .lngProcFlowCnt = 0
                .strSbID = pstrSBID                             'ｼｽﾃﾑﾌﾞﾛｯｸ
                .strMsgVer = CMstrprocprocregistVer             'ﾒｯｾｰｼﾞﾊﾞｰｼﾞｮﾝ
                .strLotID = pstrLotID                           'ﾛｯﾄID
                .strComments = txtComments.Text                 'ｺﾒﾝﾄ
                .strEmpID = pstrUserID                          'ﾕｰｻﾞID
                .strStartSeqNum = 1                             '変更開始工順/初期値先頭行
                .strVerUpProhibitedFlag = pstrVerUpProhibited   'ﾊﾞｰｼﾞｮﾝｱｯﾌﾟ禁止設定（1:禁止）
              
                '@変更ﾌﾗｸﾞｵﾝ
                If pblnEN01X2Edit = True Then
                    .strChange = CMstrChange1
                Else
                    .strChange = CMstrChange0
                End If
                
                '@判定ﾌﾗｸﾞ初期化
                lblnStartSeqNum = False
                
                '@区間優先度関連初期化
                llngPriorityStartNo = 0
                llngPriorityEndNo = 0
                lstrPriority = vbNullString
                
                'NSYS リスト初期化
                If .typProcFlow Is Nothing Then
                    .typProcFlow = New List(Of FlowList)
                Else 
                    .typProcFlow.Clear
                End If

                '@ﾌﾛｰﾘｽﾄを検索
                For llngCnt = 1 To vsfFlowList0.Rows.Count - 1
                
                    '@TEOS F/Bデータ格納
                    Call GetApcTeosData(vsfFlowList0, llngCnt, lstApcTeosStep)
                    
                    '@TEOS PrismAPCデータ格納
                    Call prvGetTeosPrismApcData(llngCnt, lstTeosPrismAPCStep)
                    
                    If vsfFlowList0.GetData(llngCnt, CPlngvsfFlowPermit) <> CMstrPermit2 Or _
                       (vsfFlowList0.GetData(llngCnt, CPlngvsfFlowPermit) = CMstrPermit2 And _
                        vsfFlowList0.GetCellRange(llngCnt, CPlngvsfFlowSwapIndictor).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)) Then
                    
                        '@開始工程の判定
                        '@先頭行から検索し、初回編集不可以外の状態を格納する。
                        If vsfFlowList0.GetData(llngCnt, CPlngvsfFlowPermit) <> CMstrPermit2 And _
                           lblnStartSeqNum = False Then
                            .strStartSeqNum = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowNo) '開始工程№を設定
                            '@判定ﾌﾗｸﾞ（判定済み）
                            lblnStartSeqNum = True
                        End If
                    
                        '@送信ﾃﾞｰﾀ配列の再定義
                        .lngProcFlowCnt = .lngProcFlowCnt + 1
                        Dim ltypFlowListTmp As  FlowList = New FlowList 
                                    
                        '@ﾌﾛｰﾘｽﾄ送信ﾃﾞｰﾀを作成
                        With ltypFlowListTmp
                        
                            .strState = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowState)                             '状態（追加挿入）
                            .strPermit = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowPermit)                           '変更可否（変更可）
                            .strChange = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowChange)                           '変更区分（変更あり）

                            .strAbsNo = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowAbsNo)                             '絶対工順番号
                            .strSeqNum = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowNo)                               '№
                            .strOpID = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowOpID)                               '大工程
                            .strStepID = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowStepID)                           '小工程
                            .strConditionId = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowConditionID)                 '処理条件ｾｯﾄID
                            .strConditionVersion = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowConditionVer)           'ﾊﾞｰｼﾞｮﾝ
                            .strSelectConditionID = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowSelectConditionID)     '測定条件ｾｯﾄID
                            .strCollectionID = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowCollectionID)               '収集項目ｾｯﾄID
                            .strCollectionVersion = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowCollectionVer)         'ﾊﾞｰｼﾞｮﾝ
                            .strLotScrapSetID = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowLotScrapSetId)             '不良項目ｾｯﾄID
                            
                            '@ﾘﾜｰｸﾙｰﾄID/"-1" or 一覧表記そのまま
                            If vsfFlowList0.GetData(llngCnt, CPlngvsfFlowReworkRouteID) = CMstrEmptyRework Then
                                .strReworkRouteID = CMstrRouteIDEmpty
                            Else
                                .strReworkRouteID = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowReworkRouteID)
                            End If
                            
                            .strReworkReturnOpID = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowReworkReturnOpID)       'ﾘﾜｰｸﾙｰﾄ先大工程
                            .strReworkReturnStepID = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowReworkReturnStepID)   'ﾘﾜｰｸﾙｰﾄ先小工程
            
                            '@特殊ﾙｰﾄID/"-1" or 一覧表記そのまま
                            If vsfFlowList0.GetData(llngCnt, CPlngvsfFlowSPRouteID) = CMstrAddFlowNo Then
                                .strSpecialRouteID = CMstrRouteIDEmpty
                            Else
                                .strSpecialRouteID = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowSPRouteID)
                            End If
                            
                            .strSpecialReturnOpID = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowSPReturnOpID)          '特殊ﾙｰﾄ先大工程
                            .strSpecialReturnStepID = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowSPReturnStepID)      '特殊ﾙｰﾄ先小工程
                            
                            '@ﾘﾜｰｸ（特殊）ｽﾍﾟｼｬﾙﾛｼﾞｯｸ
                            '@ﾘﾜｰｸ工順は全工程にﾙｰﾄID戻り工程が設定されている。
                            '@行挿入した場合空白の為、ここで再ｾｯﾄする。
                            
                            '@ﾘﾜｰｸ、特殊ﾛｯﾄの場合
                            Select Case pstrEN01X0ProcFlag
                                '@ﾘﾜｰｸ、特殊流動
                                Case "1"
                                    '@ﾘﾜｰｸ
                                    If .strReworkRouteID = vbNullString Then
                                        .strReworkRouteID = vsfFlowList0.GetData(vsfFlowList0.Rows.Count - 1, CPlngvsfFlowReworkRouteID)
                                        .strReworkReturnOpID = vsfFlowList0.GetData(vsfFlowList0.Rows.Count - 1, CPlngvsfFlowReworkReturnOpID)       'ﾘﾜｰｸﾙｰﾄ先大工程
                                        .strReworkReturnStepID = vsfFlowList0.GetData(vsfFlowList0.Rows.Count - 1, CPlngvsfFlowReworkReturnStepID)   'ﾘﾜｰｸﾙｰﾄ先小工程
                                    End If
                                    '@特殊
                                    If .strSpecialRouteID = vbNullString Then
                                        .strSpecialRouteID = vsfFlowList0.GetData(vsfFlowList0.Rows.Count - 1, CPlngvsfFlowSPRouteID)
                                        .strSpecialReturnOpID = vsfFlowList0.GetData(vsfFlowList0.Rows.Count - 1, CPlngvsfFlowSPReturnOpID)           '特殊ﾙｰﾄ先大工程
                                        .strSpecialReturnStepID = vsfFlowList0.GetData(vsfFlowList0.Rows.Count - 1, CPlngvsfFlowSPReturnStepID)       '特殊ﾙｰﾄ先小工程
                                    End If
                            End Select
                            
                            
                            '@//入替工程//
                            '@入替工程が入力されている場合
                            If vsfFlowList0.GetData(llngCnt, CPlngvsfFlowSwapIndictor) <> vbNullString Then
                                '@一致ﾌﾗｸﾞｸﾘｱ
                                lblnMatch = False
                                '@ﾌﾛｰﾘｽﾄの検索
                                For llngRow = llngCnt + 1 To vsfFlowList0.Rows.Count - 1
                                    '@現在の行と比べて内容が違う行があれば
                                    If vsfFlowList0.GetData(llngRow, CPlngvsfFlowSwapIndictor) <> _
                                       vsfFlowList0.GetData(llngCnt, CPlngvsfFlowSwapIndictor) Then
                                       '@その行までの差分をｾｯﾄ
                                       llngSwapIndicatorNo = llngRow - llngCnt
                                       lblnMatch = True  '一致
                                       Exit For
                                    End If
                                Next
                                '@一致した場合
                                If lblnMatch = True Then
                                    '@値のｾｯﾄ
                                    .strSwapIndicator = llngSwapIndicatorNo '入替可能ｲﾝｼﾞｹｰﾀ
                                Else
                                    '@差分を取得
                                    llngSwapIndicatorNo = vsfFlowList0.Rows.Count - llngCnt
                                    '@値のｾｯﾄ
                                    .strSwapIndicator = llngSwapIndicatorNo '入替可能ｲﾝｼﾞｹｰﾀ
                                End If
                            End If
            
                            '@代替工程
                            .strAltStartFlag = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowAltStartFlag)               '代替開始ﾌﾗｸﾞ
                            .strAltEndFlag = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowAltEndFlag)                   '代替終了ﾌﾗｸﾞ
                            .strAltPointer = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowAltPointer)                   '代替ﾎﾟｲﾝﾀ
            
                            .strLotRecipeFlag = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowLotRecipeFlag)             'ﾛｯﾄﾚｼﾋﾟﾌﾗｸﾞ
                            .strWfRecipeFlag = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowWFRecipeFlag)               'WFﾚｼﾋﾟﾌﾗｸﾞ
                            .strSFlag = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowSFlag)                             '特殊特性ﾌﾗｸﾞ
                            .strEntryID = mstrEntryID                                                                           'ｴﾝﾄﾘID(行追加で歯抜け考慮）
                            .strWorkCondition = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowWorkCondition)             '作業条件
                            .strProcChangeRecipeFlag = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowRecipeChgFlg)       '工程ﾚｼﾋﾟ変更ﾌﾗｸﾞ
                            
                            '@SPC判定ｽｷｯﾌﾟﾌﾗｸﾞ( 0: SKIP不可、1:SKIP可）
                            If vsfFlowList0.GetCellCheck(llngCnt, CPlngvsfFlowJudgeSkipFlag) = CheckEnum.Checked Then
                                .strJudgeSkipFlag = CMstrSpcSkipOK
                            Else
                                .strJudgeSkipFlag = CMstrSpcSkipNG
                            End If
                            
                            '@APC適用外( 0: 適用、1:適用外）
                            If vsfFlowList0.GetCellCheck(llngCnt, CPlngvsfFlowApcSkipFlag) = CheckEnum.Checked Then
                                .strApcSkipFlag = CMstrFlgOn
                            Else
                                .strApcSkipFlag = CMstrFlgOff
                            End If
            
                            '@APC計算除外( 0: 対象、1:除外）
                            If vsfFlowList0.GetCellCheck(llngCnt, CPlngvsfFlowApcCalcSkipFlag) = CheckEnum.Checked Then
                                .strApcCalcSkipFlag = CMstrFlgOn
                            Else
                                .strApcCalcSkipFlag = CMstrFlgOff
                            End If
                            
                            If .typApcOrder Is Nothing Then
                                .typApcOrder = New List(Of ApcOrder)
                            Else
                                .typApcOrder.Clear
                            End If
                            
                            '@「PH/CONT APC設定」情報格納
                            If vsfFlowList0.GetData(llngCnt, CPlngvsfFlowApc) <> vbNullString Then
                                '@現在のｾﾙの値を配列に格納
                                lstrAry = Split(vsfFlowList0.GetData(llngCnt, CPlngvsfFlowApc), CMstrComma)
                                .typApcOrder  = New List(Of ApcOrder)(lstrAry.Count)
                                For llngAryCount = 0 To UBound(lstrAry)
                                    
                                    .lngApcOrderCnt = llngAryCount + 1
                                    Dim ltypApcOrderTmp As ApcOrder = New ApcOrder
                                    
                                    Select Case Strings.Left$(lstrAry(llngAryCount), 2)
                                        '@F/B
                                        Case CMstrFBMark
                                            ltypApcOrderTmp.strApcType = CMstrApcTypeFB
                                        '@F/F
                                        Case CMstrFFMark
                                            ltypApcOrderTmp.strApcType = CMstrApcTypeFF
                                    End Select
                                    
                                    '@APCｽﾃｰﾀｽﾌﾗｸﾞ
                                    ltypApcOrderTmp.strStatusFlag = Mid$(lstrAry(llngAryCount), 8)
                                    
                                    '@APCﾘｽﾄｵｰﾀﾞ
                                    lstrListOrder = Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo3)
                                    If IsNumeric(lstrListOrder) = True Then
                                        ltypApcOrderTmp.strListOrder = CLng(lstrListOrder)
                                    Else
                                        ltypApcOrderTmp.strListOrder = vbNullString
                                    End If
                                    
                                    '@APC枚葉設定
                                    ltypApcOrderTmp.blnApcWfUnitFlg = CMstrFlgOff
                                    If vsfFlowList0.GetCellCheck(llngCnt, CPlngvsfFlowApcWfUnitFlg) = CheckEnum.Checked Then
                                        ltypApcOrderTmp.blnApcWfUnitFlg = CMstrFlgOn
                                    End If
                                    .typApcOrder.Add(ltypApcOrderTmp)
                                Next
                                
                                Erase lstrAry
                            Else
                                .lngApcOrderCnt = 0
                            End If
            
                            '@枚葉ﾚｼﾋﾟ設定 ﾌﾗｸﾞ(0：全数、1:部分、0:設定なし）
                            Select Case vsfFlowList0.GetData(llngCnt, CPlngvsfFlowConditionOne)
                                Case CPstrRecpAll       '全数
                                    .strWfPartialRecipeFlag = CMstrFlgOff
                                Case CPstrRecppartial   '部分
                                    .strWfPartialRecipeFlag = CMstrFlgOn
                                Case CPstrRecpNot       '未設定
                                    .strWfPartialRecipeFlag = CMstrFlgOn
                                Case Else
                                    .strWfPartialRecipeFlag = CMstrFlgOff
                            End Select
                        
                            '@処理号機設定
                            If vsfFlowList0.GetData(llngCnt, CPlngvsfFlowWpRestrict) <> vbNullString Then
                                
                                Select Case Strings.Right$(vsfFlowList0.GetData(llngCnt, CPlngvsfFlowWpRestrict), 1)
                                    '@記憶
                                    Case CMstrWpMarkMark
                                        .strWpRestrictKind = "1"
                                    '@限定
                                    Case CMstrWpUseMark
                                        .strWpRestrictKind = "2"
                                End Select
                                
                            
                                '@処理号機番号
                                lstrWpRestrictNum = vbNullString
                                lstrWpRestrictNum = Mid$(vsfFlowList0.GetData(llngCnt, CPlngvsfFlowWpRestrict), CMlngMidStart3, CMlngMidGetStringNo3)
                                If IsNumeric(lstrWpRestrictNum) = True Then
                                    .strWpRestrictNum = CLng(lstrWpRestrictNum)
                                Else
                                    .strWpRestrictNum = vbNullString
                                End If
                            Else
                                .strWpRestrictKind = vbNullString
                                .strWpRestrictNum = vbNullString
                            End If
                        
                            '@CDEN_CLASS
                            If vsfFlowList0.GetData(llngCnt, CPlngvsfFlowCdenClass) <> vbNullString Then
                                .strCdenClass = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowCdenClass)
                            Else
                                .strCdenClass = vbNullString
                            End If
                            
                            '@GRB限定工程設定
                            If vsfFlowList0.GetData(llngCnt, CPlngvsfFlowGrbClass) <> vbNullString Then
                                .strGrbClass = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowGrbClass)
                            Else
                                .strGrbClass = vbNullString
                            End If
                            
                            '@TPAL設定
                            If vsfFlowList0.GetData(llngCnt, CPlngvsfFlowTpalClass) <> vbNullString Then
                                
                                lstrWkString = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowTpalClass)
                            
                                Select Case lstrWkString
                                
                                    '@蒸着ﾊﾞｯﾁ貼合
                                    Case CPstrTpalJBatchName
                                        .strTpalClass = CPstrTpalJBatch
                            
                                    '@蒸着左貼合
                                    Case CPstrTpalJLeftName
                                        .strTpalClass = CPstrTpalJLeft
                            
                                    '@蒸着右貼合
                                    Case CPstrTpalJRightName
                                        .strTpalClass = CPstrTpalJRight
                            
                                    '@蒸着ﾊﾞｯﾁ+左貼合
                                    Case CPstrTpalJBatchLeftName
                                        .strTpalClass = CPstrTpalJBatchLeft
                            
                                    '@蒸着ﾊﾞｯﾁ+右貼合
                                    Case CPstrTpalJBatchRightName
                                        .strTpalClass = CPstrTpalJBatchRight
                            
                                    '@表面ﾊﾞｯﾁ貼合
                                    Case CPstrTpalHBatchName
                                        .strTpalClass = CPstrTpalHBatch
                                    
                                    '@設定なし
                                    Case Else
                                        .strTpalClass = vbNullString
                            
                                End Select
                                
                            Else
                                .strTpalClass = vbNullString
                            End If
                            
                            '@ｷｬﾘｱｶﾃｺﾞﾘ
                            If vsfFlowList0.GetData(llngCnt, CPlngvsfFlowCarrierCategoryID) <> vbNullString Then
                            
                                '@ｷｬﾘｱｶﾃｺﾞﾘﾘｽﾄを検索して該当ｷｬﾘｱｶﾃｺﾞﾘIDを探す
                                For llngCateCnt = 0 To mtypCarrierCategoryList.typCarrierCategory.Count -1
                                
                                    '@ｷｬﾘｱｶﾃｺﾞﾘ名をｷｬﾘｱｶﾃｺﾞﾘIDに変換
                                    If mtypCarrierCategoryList.typCarrierCategory(llngCateCnt).strCategoryName = _
                                        vsfFlowList0.GetData(llngCnt, CPlngvsfFlowCarrierCategoryID) Then
                                    
                                        .strCarrierCategoryId = mtypCarrierCategoryList.typCarrierCategory(llngCateCnt).strCategoryID
                                        Exit For
                                
                                    '@ｷｬﾘｱｶﾃｺﾞﾘ名がﾘｽﾄにない場合は空に変換
                                    Else
                                        .strCarrierCategoryId = vbNullString
                                    End If
                                Next llngCateCnt
                            Else
                                .strCarrierCategoryId = vbNullString
                            End If
                                                
                            '@ﾏｯﾌﾟ適用ﾌﾗｸﾞ(0:非自動適用、1:自動適用）
                            If vsfFlowList0.GetCellCheck(llngCnt, CPlngvsfFlowMapUseFlag) = CheckEnum.Checked Then
                                .strMapUseFlag = CMstrFlgOn
                            Else
                                .strMapUseFlag = CMstrFlgOff
                            End If
                            
                            '@区間優先度指定がある場合
                            If vsfFlowList0.GetData(llngCnt, CPlngvsfFlowPriority) <> vbNullString Then
                                '@区間優先度の始まり＆終わりを検出
                                If llngPriorityStartNo = 0 And llngPriorityEndNo = 0 Then
                                    llngPriorityStartNo = ltypProcRegistReq.lngProcFlowCnt
                                    llngPriorityEndNo = ltypProcRegistReq.lngProcFlowCnt
                                    lstrPriority = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowPriority)
                                ElseIf llngPriorityEndNo <> 0 Then
                                    llngPriorityEndNo = ltypProcRegistReq.lngProcFlowCnt
                                    lstrPriority = vsfFlowList0.GetData(llngCnt, CPlngvsfFlowPriority)
                                End If
                            End If

                        End With
                        .typProcFlow.Add(ltypFlowListTmp)
                    End If
                Next
                
                '@区間優先度指定の場合、工順変更で追加された工程に優先度を再設定
                If llngPriorityStartNo <> 0 And llngPriorityEndNo <> 0 And lstrPriority <> vbNullString Then
                    '@ﾌﾛｰﾘｽﾄを検索
                    For llngCnt = llngPriorityStartNo To llngPriorityEndNo
                        '@ﾌﾛｰﾘｽﾄ送信ﾃﾞｰﾀを作成
                        Dim ltypProcFlowTmp As FlowList = .typProcFlow(llngCnt)
                        With ltypProcFlowTmp
                            .strPriority = lstrPriority
                        End With
                        .typProcFlow.Add(ltypProcFlowTmp)
                    Next
                End If

            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvAryFlowListData_Set"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvAryTimeLimitData_Set
    '機　能：時間制限送信用配列の作成
    '引　数：ltypProcTimeLimitInfo：時間制限送信用配列
    '戻り値：なし
    '作成日：2006/07/12 (Wed) 10:58:47 N.Kasai
    '更新日：2006/07/12 (Wed) 10:58:47
    '備　考：
    Private Sub prvAryTimeLimitData_Set(ByRef ltypProcTimeLimitInfo As ProcTimeLimitInfo)
        
        Dim llngCount               As Integer              'ﾙｰﾌﾟｶｳﾝﾀ
        Dim llngCount1              As Integer              'ﾙｰﾌﾟｶｳﾝﾀ1
        Dim ltypLotTimeLimitTemp    As ProcTimeLimitInfo    '時間制限送信ﾃﾞｰﾀ作成用配列
        Dim lstrFromOpID            As String               '退避大工程(開始)
        Dim lstrFromStepID          As String               '退避小工程(終了)
        Dim lstrToOpID              As String               '退避大工程(終了)
        Dim lstrToStepID            As String               '退避小工程(終了)
        Dim lstrLimitNo             As String               '時間制限№
        Dim lblnChkFlag             As Boolean              '情報ﾁｪｯｸ

        Try
            
            '時間制限送信ﾃﾞｰﾀ作成用配列
            ltypLotTimeLimitTemp.lngProcTimeLimitCnt = 0
            ltypLotTimeLimitTemp.typProcTimeLimit = New List(Of ProcTimeLimit)

            '@時間制限情報を設定
            With ptypProcTimeLimitInfo
                '@時間制限保持配列から時間制限送信用配列を作成
                For llngCount = 0 To .lngProcTimeLimitCnt -1
                    '@ﾘｽﾄｵｰﾀﾞｰが設定されていたら
                    If .typProcTimeLimit(llngCount).strListOrder <> vbNullString Then
                        
                        '@有効ﾃﾞｰﾀの場合
                        If .typProcTimeLimit(llngCount).blnEnableFlag = True Then
                        
                            '@時間制限送信用配列をｶｳﾝﾄｱｯﾌﾟ
                            ltypLotTimeLimitTemp.lngProcTimeLimitCnt = ltypLotTimeLimitTemp.lngProcTimeLimitCnt + 1

                            '@時間制限送信用配列に値をｾｯﾄ
                            ltypLotTimeLimitTemp.typProcTimeLimit.Add(.typProcTimeLimit(llngCount))
                                
                        End If
                    End If
                Next
            End With
            
            '@作成ﾃﾞｰﾀﾁｪｯｸ
            With ltypLotTimeLimitTemp
                For llngCount = 0 To .lngProcTimeLimitCnt -1
                    '@開始・終了の大工程/小工程のいずれかが存在しない場合
                    If .typProcTimeLimit(llngCount).strFromOpId = vbNullString _
                       Or .typProcTimeLimit(llngCount).strFromStepId = vbNullString _
                       Or .typProcTimeLimit(llngCount).strToOpId = vbNullString _
                       Or .typProcTimeLimit(llngCount).strToStepId = vbNullString Then
                    
                        '@退避領域情報をｾｯﾄ
                        lstrFromOpID = .typProcTimeLimit(llngCount).strFromOpId
                        lstrFromStepID = .typProcTimeLimit(llngCount).strFromStepId
                        lstrToOpID = .typProcTimeLimit(llngCount).strToOpId
                        lstrToStepID = .typProcTimeLimit(llngCount).strToStepId
                        lstrLimitNo = .typProcTimeLimit(llngCount).strListOrder
                       
                        Select Case vbNullString
                            Case lstrFromOpID, lstrFromStepID
                            '@case1：開始大工程,小工程がNullの場合
                                '@初期化
                                lblnChkFlag = False
                                
                                '@FlowList取得時の情報と比較して同じ情報がある場合には,補完する
                                For llngCount1 = 0 To mtypProcTimeLimitInfo.lngProcTimeLimitCnt -1
                                    '@同じ終了大工程/小工程が存在する場合
                                    If mtypProcTimeLimitInfo.typProcTimeLimit(llngCount1).strToOpId = lstrToOpID And _
                                       mtypProcTimeLimitInfo.typProcTimeLimit(llngCount1).strToStepId = lstrToStepID And _
                                       mtypProcTimeLimitInfo.typProcTimeLimit(llngCount1).strListOrder = lstrLimitNo Then
                                    
                                        '@情報を補完する
                                        Dim ltypProcTimeLimitTmp As ProcTimeLimit = New ProcTimeLimit
                                        ltypProcTimeLimitTmp = .typProcTimeLimit(llngCount)
                                        ltypProcTimeLimitTmp.strFromOpId = _
                                            mtypProcTimeLimitInfo.typProcTimeLimit(llngCount1).strFromOpId
                                        ltypProcTimeLimitTmp.strFromStepId = _
                                            mtypProcTimeLimitInfo.typProcTimeLimit(llngCount1).strFromStepId
                                        .typProcTimeLimit(llngCount) = ltypProcTimeLimitTmp

                                        '@ﾌﾗｸﾞ立てる
                                        lblnChkFlag = True
                                        
                                        '@退避領域ﾙｰﾌﾟから抜ける
                                        Exit For
                                    End If
                                Next llngCount1
                                
                                '@ﾌﾗｸﾞﾁｪｯｸ
                                If lblnChkFlag = False Then
                                    '@情報をｸﾘｱする
                                    Dim ltypProcTimeLimitTmp As ProcTimeLimit = New ProcTimeLimit
                                    ltypProcTimeLimitTmp.strFromOpId = vbNullString
                                    ltypProcTimeLimitTmp.strFromStepId = vbNullString
                                    ltypProcTimeLimitTmp.strLimitTime = vbNullString
                                    ltypProcTimeLimitTmp.strListOrder = vbNullString
                                    ltypProcTimeLimitTmp.strRestrictTypeID = vbNullString
                                    ltypProcTimeLimitTmp.strToOpId = vbNullString
                                    ltypProcTimeLimitTmp.strToStepId = vbNullString
                                    ltypProcTimeLimitTmp.strWarnTime = vbNullString
                                    .typProcTimeLimit(llngCount) = ltypProcTimeLimitTmp
                                End If
                            
                            Case lstrToOpID, lstrToStepID
                            '@case1：終了大工程,小工程がNullの場合
                                '@補完はしない：この前の段階でﾁｪｯｸではじかれるので
                        End Select
                    End If
                Next llngCount
                
                '@時間制限送信用配列のｸﾘｱ
                ltypProcTimeLimitInfo.lngProcTimeLimitCnt = 0
                ltypProcTimeLimitInfo.typProcTimeLimit = New List(Of ProcTimeLimit)
            
                '@時間制限保持配列から時間制限送信用配列を作成
                For llngCount = 0 To .lngProcTimeLimitCnt -1
                    '@ﾘｽﾄｵｰﾀﾞｰが設定されていたら
                    If .typProcTimeLimit(llngCount).strListOrder <> vbNullString Then
                        '@時間制限送信用配列をｶｳﾝﾄｱｯﾌﾟ
                        ltypProcTimeLimitInfo.lngProcTimeLimitCnt = ltypProcTimeLimitInfo.lngProcTimeLimitCnt + 1
                        
                        '@時間制限送信用配列に値をｾｯﾄ
                        ltypProcTimeLimitInfo.typProcTimeLimit.Add _
                            (.typProcTimeLimit(llngCount))
                    End If
                Next
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvAryTimeLimitData_Set"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvLotCondDetailList_Del
    '機　能：個別処理設定配列を削除
    '引　数：llngAbsNo：絶対工順番号
    '戻り値：なし
    '作成日：2006/07/12 (Wed) 11:10:43 N.Kasai
    '更新日：2006/07/12 (Wed) 11:10:43
    '備　考：
    Private Sub prvLotCondDetailList_Del(ByVal llngAbsNo As Integer)

        Dim llngCnt     As Integer  'ｶｳﾝﾀ

        Try
            
            '@構造体新規追加
            With ptypProcCondDetailList
                
                '@構造体全件検索
                For llngCnt = 0 To .lngProcCondDetailCnt -1
                    If IsNumeric(.typProcCondDetail(llngCnt).strAbsNo) = True Then
                        '@工順番号と格納構造体の工順番号を比較し一致した場合
                        If llngAbsNo = .typProcCondDetail(llngCnt).strAbsNo Then
                            '有効/無効ﾌﾗｸﾞ更新
                            Dim ltypProcCondDetailTmp As ProcCondDetail = New ProcCondDetail
                            ltypProcCondDetailTmp = .typProcCondDetail(llngCnt)
                            ltypProcCondDetailTmp.blnEnableFlag = False
                            .typProcCondDetail(llngCnt) = ltypProcCondDetailTmp
                        End If
                    End If
                Next
                
            End With

            Exit Sub


        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvLotCondDetailList_Del"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


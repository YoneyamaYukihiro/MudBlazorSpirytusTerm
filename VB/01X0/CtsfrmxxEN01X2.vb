    Private Sub prvvsfCollectionList_Disp(ByRef ltypMasProcCollectionList As MasProcCollectionList)

        Dim llngCnt     As Integer  'ｶｳﾝﾀ
        Dim llngRow     As Integer  'NSYS 行ｶｳﾝﾀ

        Try
            
            '@ｶﾃｺﾞﾘが「（すべて）」以外の場合
            If cmbCollectionCategory.Text <> CMstrAllCategory Then
                If ltypMasProcCollectionList.strCategoryID <> vbNullString Then
                    '@収集項目ｶﾃｺﾞﾘIDの表示
                    cmbCollectionCategory.Text = ltypMasProcCollectionList.strCategoryID
                End If
            End If
            
            With vsfCollectionList
                '@ﾛｯｸ解除
                .Enabled = True
                
                '@描画ﾛｯｸ
                .Redraw = False
                
                .Rows.Count = .Rows.Fixed                  '行初期化
                
                '@有効行数を設定
                .Rows.Count = ltypMasProcCollectionList.lngMasProcCollectionCnt + 1

                '@取得件数分ﾙｰﾌﾟ
                For llngCnt = 0 To ltypMasProcCollectionList.lngMasProcCollectionCnt -1
                    llngRow = llngCnt + 1
                    .SetData(llngRow, CMlngvsfCollectionNo, llngRow)                          '№
                    
                    .SetData(llngRow, CMlngvsfCollectionColID, _
                        ltypMasProcCollectionList.typMasProcCollection(llngCnt).strCollectionID)         '収集項目ｾｯﾄID
                    
                    .SetData(llngRow, CMlngvsfCollectionVer, _
                        ltypMasProcCollectionList.typMasProcCollection(llngCnt).strCollectionVersion)    'Ver
                
                    '@状態判定
                    Select Case ltypMasProcCollectionList.typMasProcCollection(llngCnt).strStatId
                        Case CMstrApply
                            .SetData(llngRow, CMlngvsfCollectionStatus, CMstrApplyJ)          '状態（適用済み）
                        Case CMstrDiscon
                            .SetData(llngRow, CMlngvsfCollectionStatus, CMstrDisconJ)         '状態（廃止）
                        Case Else
                            .SetData(llngRow, CMlngvsfCollectionStatus, vbNullString)         '状態（空白）
                    End Select
                Next llngCnt
                
                .Row = 0

                '@再描画
                .Redraw = True
                
                '@取得件数が0件の場合
                If ltypMasProcCollectionList.lngMasProcCollectionCnt = 0 Then
                    '@ﾛｯｸ
                    .Enabled = False
                Else
                    '@ｵｰﾄｻｲｽﾞ設定
                    If .Cols(CMlngvsfCollectionColID).Width > CMlngvsfwConColID + CMlngvsfwConColVer Then
                        '@処理条件ｾｯﾄID
                        .AutoSizeCol(CMlngvsfCollectionColID, 6)
                    End If

                End If
                
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvvsfCollectionList_Disp"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


        Dim ltypMstFlowListAns      As ProcFlowListAns      'ｺｽﾀ工順（応答）
        Dim ltypMstFlowListReq      As MstFlowListReq       'ﾏｽﾀ工順（要求）
        Dim lstrEventName           As String               'ﾚｽﾎﾟﾝｽ用
        Dim lblnAns                 As Boolean              '汎用戻り値
        Dim ltypEN01X7              As EN01X7               '引継ぎ構造体
        
        Try

            'NSYS クリック処理中は処理を抜ける

    '機　能：spcｽｷｯﾌﾟの設定をすべてONにする
    '引　数：なし
    '戻り値：なし
    '作成日：2016/07/22 (Fri) 11:36:47 T.Oide
    '更新日：2016/07/22 (Fri) 11:36:47
    '備　考：
    Private Sub cmdSpcSkipChkOn_Click(ByVal sender As Object, ByVal e As EventArgs) Handles cmdSpcSkipChkOn.Click

        Dim llngRow             As Integer
        Dim llngChk             As Integer

        Try
            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            '@ﾁｪｯｸOFFモードか
            If mblnSpcCheckOFF = True Then
                '@OFFﾓｰﾄﾞ
                llngChk = CheckEnum.Unchecked
                '@次のためにOFFﾓｰﾄﾞをFlaseにしておく
                mblnSpcCheckOFF = False
            Else
                '@ONﾓｰﾄﾞ
                llngChk = CheckEnum.Checked
                '@次のためにOFFﾓｰﾄﾞをTrueにしておく
                mblnSpcCheckOFF = True
            End If
            
            With vsfFlowList0
                
                '@「SPCｽｷｯﾌﾟ」列を見えるようにする
                Call .ShowCell(.Row, CPlngvsfFlowJudgeSkipFlag)
            
                '@工順ﾘｽﾄの全行繰り返し
                For llngRow = 1 To .Rows.Count - 1
                    '@SPCｽｷｯﾌﾟは編集可か
                    If .GetCellRange(llngRow, CPlngvsfFlowJudgeSkipFlag).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorGray) Then
                        '@ﾁｪｯｸをONする
                        .SetCellCheck(llngRow, CPlngvsfFlowJudgeSkipFlag, llngChk)
                    End If
                Next
                
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)

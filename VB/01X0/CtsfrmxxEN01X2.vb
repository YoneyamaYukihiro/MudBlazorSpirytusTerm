    '関数名：cmdTimeLimitSet_Click
    '機　能：時間制限設定ﾎﾞﾀﾝｸﾘｯｸ時
    '引　数：なし
    '戻り値：なし
    '作成日：2006/07/12 (Wed) 10:10:48 N.Kasai
    '更新日：2006/07/12 (Wed) 10:10:48
    '備　考：
    Private Sub cmdTimeLimitSet_Click(ByVal sender As Object, ByVal e As EventArgs) Handles cmdTimeLimitSet.Click

        Dim llngAryCount        As Integer  '配列ｶｳﾝﾀ
        Dim lstrAry()           As String   'ｾﾙ内時間制限配列

        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            '@特殊ﾛｯﾄの場合は時間制限の新規設定は不可
            If pstrEN01X0ProcFlag = "1" Then
                Exit Sub
            End If
            
            With vsfFlowList0
                
                '@選択行が見出しの場合
                If .Row < 1 Then
                    Exit Sub
                End If
            
                '@単一選択されているｾﾙの内容ﾁｪｯｸ
                If .GetData(.Row, CPlngvsfFlowTimeLimit) = vbNullString Then
                
                    '@格納構造体より表示する。
                    pblnEN01X5LockOn = False   '時間制限番号ﾛｯｸｵﾌ
                    pblnEN00X5SelectOn = False
                    pblnEN01X5NewData = False
                    
                    '@時間制限配列に大工程・小工程をｾｯﾄ
                    Call prvAryTimeLimitDataOpStep_Set()
                    
                    '@時間制限画面を開く
                    frmxxEN01X5.Instance.ShowDialog(Me)
                    frmxxEN01X5.Instance = Nothing
                
                    Exit Sub
                End If
                
                '@選択ｾﾙの内容が空白以外の場合
                '@大工程の入力ﾁｪｯｸ
                If .GetData(.Row, CPlngvsfFlowOpID) = vbNullString Then
                    '@大工程が未入力の場合
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar0068, Me.Text)
                    '@"<TRM68W>$$大工程が設定されていません。設定を見直してください。"
                    Call publngMsgBox(pstrDMsg, vbExclamation, Me.Text, True, 16, False)
                    Exit Sub
                End If

                '@大工程が入力済の場合
                '@小工程の入力ﾁｪｯｸ
                If .GetData(.Row, CPlngvsfFlowStepID) = vbNullString Then
                    '@小工程が未入力の場合
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar0069, Me.Text)
                    '@"<TRM69W>$$小工程が設定されていません。設定を見直してください。"
                    Call publngMsgBox(pstrDMsg, vbExclamation, Me.Text, True, 16, False)
                    Exit Sub
                End If
                
                '@新規編集中の場合
                If ptypProcTimeLimitInfo.lngProcTimeLimitCnt = 0 Then
                    Exit Sub
                End If
                
                pblnEN00X5SelectOn = True
                pblnEN01X5NewData = False

                '@時間制限配列に大工程・小工程をｾｯﾄ（1ｾﾙに複数設定を考慮）
                Call prvAryTimeLimitDataOpStep_Set()

                '@現在のｾﾙの値を配列に格納
                lstrAry = Split(.GetData(.Row, CPlngvsfFlowTimeLimit), CMstrComma)

                '@初期化
                If ptypLTSelectList.typLTSelectList Is Nothing Then
                    ptypLTSelectList.typLTSelectList = New List(Of TimeLimitSelectList)
                Else
                    ptypLTSelectList.typLTSelectList.Clear
                End If
                ptypLTSelectList.lngLTSelectListCnt = 0

                '@配列数分、以下の処理を繰り返す
                With ptypLTSelectList
                    For llngAryCount = 0 To UBound(lstrAry)
                        '@配列作成
                        Dim typLTSelectListTmp As New TimeLimitSelectList

                        '@情報を退避
                        typLTSelectListTmp.strListOrder = _
                            Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo3)
                        typLTSelectListTmp.strEnableFlag = "1"
                        
                        '@例外処理用に値を退避(Sのみ設定して画面を開こうとした場合）
                        typLTSelectListTmp.strFromOpId = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowOpID)
                        typLTSelectListTmp.strFromStepId = vsfFlowList0.GetData(vsfFlowList0.Row, CPlngvsfFlowStepID)
                        .typLTSelectList.Add(typLTSelectListTmp)

                        .lngLTSelectListCnt = .lngLTSelectListCnt + 1
                    Next
                End With
                
                '@時間制限画面を開く
                frmxxEN01X5.Instance.ShowDialog(Me)
                frmxxEN01X5.Instance = Nothing
                
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "cmdTimeLimitSet_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


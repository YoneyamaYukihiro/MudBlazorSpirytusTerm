                        lstrID = .GetData(.Row, CPlngvsfFlowCollectionID)            'ID
                        lstrVER = .GetData(.Row, CPlngvsfFlowCollectionVer)          'Ver.
                        
                        If lstrID <> vbNullString Then
                        
                            '@ﾚｽﾎﾟﾝｽ取得開始
                             Call pubResponseStart(Me.Name, lstrEventName)
                             
                             '@MSG【収集項目取得】
                             lblnAns = pubblnMasProcCollectionList_Sel(pstrSBID, CMstrmas_proccollectionlistVer, CPstrCD1P, ltypMasProcCollectionList, lstrID)
                             
                             '@結果判定
                             If lblnAns = False Then
                                 '@ﾚｽﾎﾟﾝｽｷｬﾝｾﾙ
                                 Call pubResponseCancel(Me.Name, lstrEventName)
                                 Exit Sub
                             End If
                             
                             '@収集項目ﾊﾟﾗﾒｰﾀ配列を保持
                             mtypMasProcCollectionList = ltypMasProcCollectionList
                             
                             '@MSG[収集項目取得]での取得情報を表示
                             Call prvvsfCollectionList_Disp(ltypMasProcCollectionList)
                             
                             With vsfCollectionList
                                 '@選択された収集項目ｾｯﾄIDとVerの行を選択
                                 For llngCnt = 1 To .Rows.Count - 1
                                         
                                     '@同じ処理条件ID、処理条件Verを検索する
                                     If lstrID = .GetData(llngCnt, CMlngvsfCollectionColID) And _
                                        lstrVER = .GetData(llngCnt, CMlngvsfCollectionVer) Then
                                             
                                         '@選択された収集項目の判定
                                         If .GetData(llngCnt, CMlngvsfCollectionStatus) = CMstrApplyJ Then
                                             '@ﾁｪｯｸﾎﾞｯｸｽの設定：ﾁｪｯｸ付け

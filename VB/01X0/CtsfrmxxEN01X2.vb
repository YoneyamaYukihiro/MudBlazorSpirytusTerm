    '戻り値：なし
    '作成日：2006/05/26 (Fri) 15:57:38 N.Kasai
    '更新日：2006/05/26 (Fri) 15:57:38
    '備　考：
    Private Sub chkValidCollection_Click(ByVal sender As Object, ByVal e As EventArgs) Handles chkValidCollection.CheckedChanged

        Dim llngCnt         As Integer      '汎用ｶｳﾝﾀ

        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            With vsfCollectionList
            
                '@収集項目ｶﾃｺﾞﾘが未選択の場合
                If cmbCollectionCategory.Text = vbNullString Then
                    Exit Sub
                End If
                
                '@収集項目ﾘｽﾄが存在しない場合
                If .Rows.Count < 1 Then
                    Exit Sub
                End If
                
                '@有効ﾁｪｯｸによる処理判別
                If chkValidCollection.Checked = CMlngValid Then
                '@有効の場合
                    Call prvvsfEditLsit_Proc(vsfCollectionList, True)
                Else
                '@無効の場合
                    Call prvvsfEditLsit_Proc(vsfCollectionList, False)
                End If
                        
                '@ﾁｪｯｸを切り替えることで,選択行を表示されている1行目へ
                If .Rows.Fixed <> .Rows.Count Then
                    '@選択行を初期化
                    .Row = .Rows.Fixed
                    For llngCnt = .Rows.Fixed To .Rows.Count - 1
                        '@隠し行でない場合
                        If .Rows(llngCnt).Visible = True Then
                            '@選択状態にして,表示
                            .Row = llngCnt
                            .ShowCell(llngCnt, .LeftCol)
                            Exit For
                        End If
                    Next llngCnt
                End If
                
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "chkValidCollection_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


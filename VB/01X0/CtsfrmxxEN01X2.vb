                                    .Font = New Font(.Font, .Font.Style And Not FontStyle.Bold)  
                                End With
                                lblFlowList1.ForeColor = Color.Black
                                
                                vsfFlowList0.HighLight = HighLightEnum.Always
                                vsfFlowList1.HighLight = HighLightEnum.Never
                            Else
                                With lblFlowList1
                                    .Font = New Font(.Font, .Font.Style Or FontStyle.Bold)  
                                End With
                                lblFlowList1.ForeColor = Color.Red
                                With lblFlowList0
                                    .Font = New Font(.Font, .Font.Style And Not FontStyle.Bold)  
                                End With
                                lblFlowList0.ForeColor = Color.Black
                                
                                vsfFlowList0.HighLight = HighLightEnum.Never
                                vsfFlowList1.HighLight = HighLightEnum.Always
                            End If
                        End If
                        
                        '@初期化
                        vsfCollectionList.Redraw = False
                        vsfCollectionList.Rows.Count = 1
                        vsfCollectionList.Redraw = True
                        vsfCollectionPara.Redraw = False
                        vsfCollectionPara.Rows.Count = 1
                        vsfCollectionPara.Redraw = True

    '関数名：prvvsfConditionList_Disp
    '機　能：処理条件情報表示
    '引　数：ltypCondition() ：取得情報
    '　　　：llngConditionCnt：取得件数
    '戻り値：なし
    '作成日：2006/05/18 (Thu) 12:53:28 N.Kasai
    '更新日：2018/06/26 (Tue) 10:52:39 T.Oide
    '備　考：
    Private Sub prvvsfConditionList_Disp(ByRef ltypMasConditionList As MasConditionList)

        Dim llngCnt As Integer 'ｶｳﾝﾀ
        Dim llngRow As Integer 'NSYS 行ｶｳﾝﾀ
        

        Try
            
            '@処理条件ｶﾃｺﾞﾘｺﾝﾎﾞ初期化
            cmbConditionCategory.ListIndex = -1
            
            '@ｶﾃｺﾞﾘが「（すべて）」以外の場合
            If cmbConditionCategory.Text <> CMstrAllCategory Then
                '@ｶﾃｺﾞﾘを表示
                cmbConditionCategory.Text = ltypMasConditionList.strCategoryID
            End If

            With vsfConditionList1
                
                '@ﾛｯｸ解除
                .Enabled = True
                
                '@描画ﾛｯｸ
                .Redraw = False
                RemoveHandler vsfConditionList1.EnterCell,AddressOf vsfConditionList_EnterCell
                .Row = -1
                AddHandler vsfConditionList1.EnterCell,AddressOf vsfConditionList_EnterCell     
                '@初期化
                .Rows.Count = .Rows.Fixed     '行
                
                '@有効行数を設定
                .Rows.Count = ltypMasConditionList.lngConditionCnt + 1

                '@取得件数分ﾙｰﾌﾟ
                For llngCnt = 0 To ltypMasConditionList.lngConditionCnt -1
                    llngRow = llngCnt + 1

                    .SetData(llngRow, CPlngvsfConListNo, llngRow)                                         '№
                    
                    .SetData(llngRow, CPlngvsfConListConID, _
                         ltypMasConditionList.typMasCondition(llngCnt).strConditionId)                    '処理条件ID
                        
                    .SetData(llngRow, CPlngvsfConListVer, _
                         ltypMasConditionList.typMasCondition(llngCnt).strConditionVersion)               'Ver
                
                    '@状態判定(適用済み/廃止）
                    Select Case ltypMasConditionList.typMasCondition(llngCnt).strStatId
                        Case CMstrApply
                            .SetData(llngRow, CPlngvsfConListStatID, CMstrApplyJ)                         '状態（適用済み）
                        Case CMstrDiscon
                            .SetData(llngRow, CPlngvsfConListStatID, CMstrDisconJ)                        '状態（廃止）
                        Case Else
                            .SetData(llngRow, CPlngvsfConListStatID, vbNullString)                        '状態（空白）
                    End Select
                    
                    .SetData(llngRow, CPlngvsfConListOptionText, _
                         ltypMasConditionList.typMasCondition(llngCnt).strOptionText)                     '作業条件
                
                    '@工程ｽｷｯﾌﾟ判定(あり/なし）
                    Select Case ltypMasConditionList.typMasCondition(llngCnt).strSkipFlag
                        Case CMstrFlgOn
                            .SetCellCheck(llngRow, CPlngvsfConListSkipFlag, CheckEnum.Checked)                    'ｽｷｯﾌﾟ（あり）
                        Case CMstrFlgOff
                            .SetCellCheck(llngRow, CPlngvsfConListSkipFlag, CheckEnum.Unchecked)                  'ｽｷｯﾌﾟ（なし）
                        Case Else
                            .SetCellCheck(llngRow, CPlngvsfConListSkipFlag, CheckEnum.Unchecked)                  'ｽｷｯﾌﾟ（なし）
                    End Select
                
                    '@ﾎﾟｰﾄ属性（UNI/LU)
                    Select Case ltypMasConditionList.typMasCondition(llngCnt).strLoaderUnloaderFlag
                        Case CMstrUniport
                            .SetData(llngRow, CPlngvsfConListLoaderUnloaderFlag, CMstrUniportJ)           'UNIPORT運用
                        Case CMstrLoaderUnloader
                            .SetData(llngRow, CPlngvsfConListLoaderUnloaderFlag, CMstrLoaderUnloaderJ)    'Loader/Unloader運用
                        Case Else
                            .SetData(llngRow, CPlngvsfConListLoaderUnloaderFlag, vbNullString)            '空白
                    End Select
                
                    .SetData(llngRow, CPlngvsfConListTransMode, _
                         ltypMasConditionList.typMasCondition(llngCnt).strTransMode)                       '移載ﾓｰﾄﾞ
                
        '@↓2018/06/26 (Tue) 09:53:58 T.Oide **************************************************
                    '@最新Verﾌﾗｸﾞ
                    .SetData(llngRow, CPlngvsfConListMaxVerFlag, _
                         ltypMasConditionList.typMasCondition(llngCnt).strMaxVerFlag)                      '最新Verﾌﾗｸﾞ
        '@↑2018/06/26 (Tue) 09:53:58 T.Oide **************************************************
                
                Next llngCnt
                
                '@ｵｰﾄｻｲｽﾞ設定
                .AutoSizeCols(CPlngvsfConListNo, .Cols.Count - 1, 6)
                
        '@↓2018/06/26 (Tue) 10:18:37 T.Oide **************************************************
                '@処理条件ｾｯﾄIDは、Verが必ず見えるように幅を固定する
                .Cols(CPlngvsfConListConID).Width = CMlnvsfConditionListWCondition
        '@↑2018/06/26 (Tue) 10:18:37 T.Oide **************************************************
                RemoveHandler vsfConditionList1.EnterCell,AddressOf vsfConditionList_EnterCell
                .Row = 0
                AddHandler vsfConditionList1.EnterCell,AddressOf vsfConditionList_EnterCell     
                '@再描画
                .Redraw = True

                 '@取得件数が0件の場合
                If ltypMasConditionList.lngConditionCnt = 0 Then
                    '@ﾛｯｸ
                    .Enabled = False
                End If
                
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvvsfConditionList_Disp"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


    Private Sub mnu42_Click(ByVal sender As Object, ByVal e As EventArgs) Handles mnu42.Click

        Dim llngRowStart        As Integer 'ｽﾀｰﾄ行
        Dim llngRowEnd          As Integer 'ｴﾝﾄﾞ行
        Dim llngColStart        As Integer 'ｽﾀｰﾄ列

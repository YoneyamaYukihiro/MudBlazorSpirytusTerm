    '関数名：vsfFlowList_SelChange
    '機　能：ﾌﾛｰﾘｽﾄ　選択範囲変更
    '引　数：Index：ｲﾝﾃﾞｯｸｽ
    '戻り値：なし
    '作成日：2006/07/13 (Thu) 09:25:02 N.Kasai
    '更新日：2006/07/13 (Thu) 09:25:02
    '備　考：
    Private Sub vsfFlowList_SelChange(ByVal sender As Object, ByVal e As EventArgs) Handles vsfFlowList0.SelChange, vsfFlowList1.SelChange
        Dim lvsfFlowList    As C1FlexGrid   'NSYS イベント元グリッド

        Try

            lvsfFlowList = CType(sender, C1FlexGrid)
            'NSYS データ行がない場合は処理を抜ける
            If lvsfFlowList.Rows.Count <= lvsfFlowList.Rows.Fixed Then
                Return
            End If

            '@移動ﾎﾞﾀﾝ(↑)(↓)・削除ﾎﾞﾀﾝ
            Call prvCmdUpDownDelEnabled_Set(lvsfFlowList)

            Exit Sub


        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "vsfFlowList_SelChange"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：vsfFlowList_BeforeRowColChange
    '機　能：ﾌﾛｰﾘｽﾄ　ｱｸﾃｨﾌﾞｾﾙ移動前処理
    '引　数：OldRow：移動前の行
    '　　　：OldCol：移動前の列
    '　　　：NewRow：移動後の行
    '　　　：NewCol：移動後の列
    '　　　：Cancel：ｷｬﾝｾﾙ
    '戻り値：なし
    '作成日：2006/05/19 (Fri) 13:14:18 N.Kasai
    '更新日：2018/04/05 (Thu) 10:47:40 T.Oide
    '備　考：ｾﾙ移動時、ﾊﾞｯｸｶﾗｰを元の色に変更する。
    Private Sub vsfFlowList_BeforeRowColChange(ByVal sender As Object, ByVal e As RangeEventArgs) Handles vsfFlowList0.BeforeRowColChange,vsfFlowList1.BeforeRowColChange

        Dim llngCnt         As Integer      'ﾙｰﾌﾟｶｳﾝﾀ
        Dim lvsfFlowList    As C1FlexGrid   'NSYS イベント元グリッド

        Try
            lvsfFlowList = CType(sender, C1FlexGrid)

            'NSYS データ行がない場合は処理を抜ける
            If lvsfFlowList.Rows.Count <= lvsfFlowList.Rows.Fixed Then
                Return
            End If
            
            '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞの場合は処理しない。
            If lvsfFlowList Is vsfFlowList1 Then
                Exit Sub
            End If
            
            With lvsfFlowList
            
                '@行削除された場合は処理しない。
                If .Rows.Count - 1 < e.OldRange.r1 Then
                    Exit Sub
                End If
                '@該当行が存在しない場合は処理しない。
                If .Rows.Count < 1 Then
                    Exit Sub
                End If
                
                '@代替工程
                '@時間制限
                '@ﾌｫﾄF/B、代替工程
                    
                '@移動前のｱｸﾃｨﾌﾞｾﾙを判定
                Select Case e.OldRange.c1
                
                    '@代替工程
                    Case CPlngvsfFlowAltSet
                        
                        '@ﾊﾞｯｸｶﾗｰの変更
                        For llngCnt = 1 To .Rows.Count - 1
                            If .GetCellRange(llngCnt, e.OldRange.c1).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorSBlue) Then
                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                Dim cellRange As CellRange = .GetCellRange(llngCnt, e.OldRange.c1)
                                cellRange.Style = newStyle      '背景色解除(次工程以降)
                            End If
                        Next
                        
                    '@時間制限
                    Case CPlngvsfFlowTimeLimit

                        '@ﾊﾞｯｸｶﾗｰの変更
                        For llngCnt = 1 To .Rows.Count - 1
                            If .GetCellRange(llngCnt, e.OldRange.c1).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorSBlue) Then
                            
                                If .GetData(llngCnt, CPlngvsfFlowPermit) = CMstrPermit2 Then
                            
                                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                    Dim cellRange As CellRange = .GetCellRange(llngCnt, e.OldRange.c1)
                                    cellRange.Style = newStyle
                                Else
                                    If .GetData(llngCnt, CPlngvsfFlowTimeLimitFlag) = "1" Then
                                        '@背景色編集色へ変更
                                        Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                        Dim cellRange As CellRange = .GetCellRange(llngCnt, e.OldRange.c1)
                                        cellRange.Style = newStyle
                                    Else
                                    
                                        '@特殊ﾛｯﾄの場合は時間制限の新規設定は不可
                                        If pstrEN01X0ProcFlag = "1" Then
                                            Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                            Dim cellRange As CellRange = .GetCellRange(llngCnt, e.OldRange.c1)
                                            cellRange.Style = newStyle
                                        Else
                                            '@背景色解除
                                            Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_vbWhite")
                                            newStyle.BackColor = Color.white
                                            Dim cellRange As CellRange = .GetCellRange(llngCnt, e.OldRange.c1)
                                            cellRange.Style = newStyle
                                        End If
                                    End If
                                
                                End If
                            End If
                        Next
                        
                    '@APC設定
                    Case CPlngvsfFlowApc
                        '@全ての行に対してﾊﾞｯｸｶﾗｰを設定する
                        For llngCnt = 1 To .Rows.Count - 1
                                If .GetCellRange(llngCnt, CPlngvsfFlowApc).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue) Then
                                    '@変更なし
                                Else
                                    '@背景色解除
                                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                    Dim cellRange As CellRange = .GetCellRange(llngCnt, CPlngvsfFlowApc)
                                    cellRange.Style = newStyle
                                End If
                        Next llngCnt
                        
                    
                    
                    '@処理号機限定
                    Case CPlngvsfFlowWpRestrict

                        '@ﾊﾞｯｸｶﾗｰの変更
                        For llngCnt = 1 To .Rows.Count - 1
                            If .GetCellRange(llngCnt, e.OldRange.c1).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorSBlue) Then
                            
                                If .GetData(llngCnt, CPlngvsfFlowPermit) = CMstrPermit2 Then
                            
                                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                    Dim cellRange As CellRange = .GetCellRange(llngCnt, e.OldRange.c1)
                                    cellRange.Style = newStyle
                                Else
                                    If .GetData(llngCnt, CPlngvsfFlowWpRestrictFlag) = "1" Then
                                        '@背景色編集色へ変更
                                        Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                        Dim cellRange As CellRange = .GetCellRange(llngCnt, e.OldRange.c1)
                                        cellRange.Style = newStyle
                                    Else
                                    
                                        '@特殊ﾛｯﾄの場合新規設定は不可
                                        If pstrEN01X0ProcFlag = "1" Then
                                            Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                            Dim cellRange As CellRange = .GetCellRange(llngCnt, e.OldRange.c1)
                                            cellRange.Style = newStyle
                                        Else
                                            '@背景色解除
                                            Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_vbWhite")
                                            newStyle.BackColor = Color.white
                                            Dim cellRange As CellRange = .GetCellRange(llngCnt, e.OldRange.c1)
                                            cellRange.Style = newStyle
                                        End If
                                    End If
                                
                                End If
                            End If
                        Next
                        
                    '@TEOS PrismAPC設定
                    Case CPlngvsfFlowTeosPrismAPC
                    
                        '@全行にﾊﾞｯｸｶﾗｰを設定する
                        For llngCnt = 1 To .Rows.Count - 1
                            If .GetCellRange(llngCnt, CPlngvsfFlowTeosPrismAPC).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorSBlue) Then
                                '@背景色解除
                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                                Dim cellRange As CellRange = .GetCellRange(llngCnt, CPlngvsfFlowTeosPrismAPC)
                                cellRange.Style = newStyle
                            End If
                        Next llngCnt
                        
        '@↓2018/04/05 (Thu) 10:53:41 T.Oide **************************************************
                    '@「ﾚｼﾋﾟ選択APC」設定
                    Case CPlngvsfFlowRecpSelApc
                    
                        '@全行にﾊﾞｯｸｶﾗｰを設定する

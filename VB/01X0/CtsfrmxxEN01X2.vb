    Private Sub serchSetting_Click(ByVal sender As Object, ByVal e As EventArgs) Handles serchSetting.Click

        Try
            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            '@設定画面は表示されているか
            If stbSetPanel.Visible = False Then
                
                '@表示ﾒｯｾｰｼﾞ変換
                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf007L, Me.Text)
                '@"<TRM7LI>$$[設定値検索]は、設定画面の[大行程]、[小行程]、[処理条件]で行ってください。"
                Call publngMsgBox(pstrDMsg, vbInformation, Me.Text, True, 16, False)
                    
                Exit Sub
            End If
            
            '選択中のTabで分岐
            Select Case stbSetPanel.SelectedIndex
            
                '@大工程,小行程,処理条件の場合
                Case CMlngOpTabNo, CMlngStepTabNo, CMlngConditionTabNo
                    
                    '@選択画面情報設定
                    plngSelectTabNo = stbSetPanel.SelectedIndex
                    
                    Select Case stbSetPanel.SelectedIndex
                    
                        '@大工程の場合
                        Case CMlngOpTabNo
                        
                            '@大工程のﾘｽﾄはあるか
                            If vsfOpList.Rows.Count <= 1 Then
                                '@表示ﾒｯｾｰｼﾞ変換
                                pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf007M, Me.Text)

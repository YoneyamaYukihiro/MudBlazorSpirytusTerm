    Private Sub prvCarrierCategoryComboList_Set(ByVal lstrSBID As String)
        
        Dim llngCnt                 As Integer                  'ｶｳﾝﾄ
        Dim lstrColComboList        As String                   'ｺﾝﾎﾞﾘｽﾄ
        
        Try

            '@初期化(空白：なしを初期値設定)
            lstrColComboList = vbNullString
            lstrColComboList = Space(1) & "|"
            
            '@ｷｬﾘｱｶﾃｺﾞﾘ情報ｾｯﾄ
            For llngCnt = 0 To mtypCarrierCategoryList.lngCarrierCategoryCnt -1
                
                If mtypCarrierCategoryList.typCarrierCategory(llngCnt).strSbID = lstrSBID Then
                
                    '@ｺﾝﾎﾞﾘｽﾄの設定(Name|Name|Name|…)
                    lstrColComboList = lstrColComboList & _
                                       mtypCarrierCategoryList.typCarrierCategory(llngCnt).strCategoryName & "|"
            
                End If
            Next
            
            '@ｷｬﾘｱｶﾃｺﾞﾘのｺﾝﾎﾞﾘｽﾄ設定
            vsfFlowList0.Cols(CPlngvsfFlowCarrierCategoryID).ComboList = lstrColComboList


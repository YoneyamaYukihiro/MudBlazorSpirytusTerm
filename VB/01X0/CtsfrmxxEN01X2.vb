    '関数名：vsfFlowList_EnterCell
    '機　能：ｸﾞﾘｯﾄﾞｾﾙ移動
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/19 (Fri) 13:26:01 N.Kasai
    '更新日：2006/05/19 (Fri) 13:26:01
    '備　考：工順変更中/ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞﾎﾞﾀﾝ制御
    Private Sub vsfFlowList_EnterCell(ByVal sender As Object, ByVal e As EventArgs) Handles vsfFlowList0.EnterCell,vsfFlowList1.EnterCell
        
        Dim llngCnt         As Integer 'ｶｳﾝﾀ
        Dim lvsfFlowList    As C1FlexGrid   'NSYS イベント元グリッド
        Dim newStyle        As CellStyle    'NSYS セルスタイル
        Dim cellRange       As CellRange    'NSYS セルレンジ

        Try
            lvsfFlowList = CType(sender, C1FlexGrid)

            'NSYS データ行がない場合は処理を抜ける
            If lvsfFlowList.Rows.Count <= lvsfFlowList.Rows.Fixed Then
                Return
            End If
            
            '@移動ﾎﾞﾀﾝ(↑)(↓)・削除ﾎﾞﾀﾝ
            Call prvCmdUpDownDelEnabled_Set(lvsfFlowList)

            With lvsfFlowList

                '@1行目以降に現在行がある場合
                If .Row < .Rows.Fixed Then
                    Exit Sub
                End If

                If lvsfFlowList Is vsfFlowList0 Then

                    '@個別処理条件設定ﾎﾞﾀﾝ処理へ
                    Call prvcmdParConditionEnabled_Set()

                    .HighLight = HighLightEnum.Always
                    '@№列の背景色を削除
                    For llngCnt = 1 To .Rows.Count - 1
                        .SetCellStyle(llngCnt, CPlngvsfFlowNo, .GetCellStyle(llngCnt, CPlngvsfFlowAbsNo))
                    Next

                    '@現在行の№列に選択ｾﾙと同じ色を設定
                    newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSel")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSel)
                    newStyle.ForeColor = Color.White
                    cellRange = .GetCellRange(.Row, CPlngvsfFlowNo)
                    cellRange.Style = newStyle
                    
                Else
                    '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞの場合
                    .HighLight = HighLightEnum.Always
                    '@№列の背景色を削除
                    newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                    newStyle.ForeColor = Color.Black
                    cellRange = .GetCellRange(1, CPlngvsfFlowNo, .Rows.Count - 1, CPlngvsfFlowNo)
                    cellRange.Style = newStyle

                    '@現在行の№列に選択ｾﾙと同じ色を設定
                    newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSel")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSel)
                    newStyle.ForeColor = Color.White
                    cellRange = .GetCellRange(.Row, CPlngvsfFlowNo)
                    cellRange.Style = newStyle

                End If

            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "vsfFlowList_EnterCell"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


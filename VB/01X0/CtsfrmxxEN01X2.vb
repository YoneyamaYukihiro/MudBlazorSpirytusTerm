        ByRef lvsfFlowList As C1FlexGrid, _
        ByRef nTargetRow As Integer, _
        ByRef lstApcTeosStep As List(Of TypeApcTeosStep))

        Dim strTmp      As String
        Dim nTmp        As Integer
        Dim nDataCount  As Integer
        
        'グループ番号
        strTmp = lvsfFlowList.GetData(nTargetRow, CPlngvsfFlowApcTeosGroupNo)
        'グループ番号が設定されてなければ何もしない
        If strTmp = vbNullString Then
            Exit Sub
        End If
        
        '要素数を取得
        lstApcTeosStep.Add(New TypeApcTeosStep)
        nDataCount = lstApcTeosStep.Count -1
        
        '要素数を拡張
        Dim lstApcTeosStepTmp As New TypeApcTeosStep
        
        '工程名を取得
         lstApcTeosStepTmp.strOpID = lvsfFlowList.GetData(nTargetRow, CPlngvsfFlowOpID)                                             '大工程
         lstApcTeosStepTmp.strStepID = lvsfFlowList.GetData(nTargetRow, CPlngvsfFlowStepID)                                         '小工程
        
        'データ初期化
        lstApcTeosStepTmp.typApcTeos.strGroupNo = ""
        lstApcTeosStepTmp.typApcTeos.strNoInGroup = ""
        lstApcTeosStepTmp.typApcTeos.strApcType = ""
        lstApcTeosStepTmp.typApcTeos.strCalcSkipFlag = "0"
        
        'グループ番号取得
        strTmp = Strings.Right(strTmp, 3)
        nTmp = Val(strTmp)
        lstApcTeosStepTmp.typApcTeos.strGroupNo = str(nTmp)

        'グループ内番号
        strTmp = lvsfFlowList.GetData(nTargetRow, CPlngvsfFlowApcTeosNoInGroup)
        If strTmp <> vbNullString Then
            strTmp = Mid(strTmp, 4, 3)
            nTmp = Val(strTmp)
            lstApcTeosStepTmp.typApcTeos.strNoInGroup = str(nTmp)
        End If

        'スキップ
        If lvsfFlowList.GetData(nTargetRow, CPlngvsfFlowApcTeosCalcSkipFlag) = CMstrFlgOn Then
            lstApcTeosStepTmp.typApcTeos.strCalcSkipFlag = "1"
        End If
        
        '工程タイプ
        lstApcTeosStepTmp.typApcTeos.strApcType = lvsfFlowList.GetData(nTargetRow, CPlngvsfFlowApcTeosFbType)

        lstApcTeosStep(nDataCount) = lstApcTeosStepTmp
    End Sub

    '関数名：ResetApcTeosData
    '機　能：引数で指定されたAPC TEOSグループを持つデータをリセットする
    '引　数：nListIndex         ：処理対象のリスト番号
    '　　　：lstApcTeosGroup    ：リセット対象のAPC TEOSグループ番号
    '戻り値：
    '作成日：2012/02/20 (Mon) 10:00:00 M.Sakka
    '更新日：2012/02/20 (Mon) 10:00:00 M.Sakka
    '備　考：
    Private Sub ResetApcTeosData( _
        ByRef lvsfFlowList As C1FlexGrid, _
        ByRef lstApcTeosGroup() As String)
        
        Dim nDeleteListCount    As Integer
        Dim nTotalListCount     As Integer
        Dim i                   As Integer
        Dim j                   As Integer
        Dim nKeepRow            As Integer
        Dim strKeepGroup        As String
        Dim oApcTeosData        As TypeApcTeos
        
        nKeepRow = -1
        strKeepGroup = ""
        oApcTeosData.strCalcSkipFlag = "0"
        oApcTeosData.strApcType = ""
        oApcTeosData.strGroupNo = ""
        oApcTeosData.strNoInGroup = ""
        
        '削除対象のデータ数を取得
        nDeleteListCount = UBound(lstApcTeosGroup)
        
        '削除対象の工程が存在しない場合は処理を終了
        If nDeleteListCount = 1 Then
            Exit Sub
        End If
        
        'リストの全行数を取得
        nTotalListCount = lvsfFlowList.Rows.Count
        
        '全リストを対象に繰り返す
        For i = 1 To nTotalListCount - 1
            'もともとAPC TEOSが設定されていない工程は何もしない
            If lvsfFlowList.GetData(i, CPlngvsfFlowApcTeosGroupNo) = vbNullString Then
                GoTo Next_i
            End If
            
            'APC TEOSが設定されている工程は情報をリセットする必要があるか確認する
            For j = 0 To nDeleteListCount
                'リスト中には同じ番号も含まれる可能性があるが気にしない
                If lvsfFlowList.GetData(i, CPlngvsfFlowApcTeosGroupNo) = lstApcTeosGroup(j) Then
                    'データをリセットする
                    Call SetApcTeosData(lvsfFlowList, i, oApcTeosData, nKeepRow, strKeepGroup)
                    Exit For
                End If
            Next

            Next_i:
        Next
    End Sub
        

    '関数名：ControlApcTeosData
    '機　能：画面の変更に伴い、APC TEOSの情報をリセットする必要があるか判定し、
    '        リセットが必要な場合はリセットを行う
    '引　数：nListIndex  ：処理対象のリスト番号
    '        nTargeCol   ：チェック対象の列
    '　　　：strNewId    ：新しい処理条件ID
    '　　　：strNewVer   ：新しい処理条件のバージョン
    '      ：nRow        ：処理対象の行数
    '
    '作成日：2012/02/20 (Mon) 10:00:00 M.Sakka
    '更新日：2012/02/20 (Mon) 10:00:00 M.Sakka
    '備　考：
    Private Sub ControlApcTeosData( _
        ByRef lvsfFlowList As C1FlexGrid, _
        ByRef nTargeCol As Integer, _
        ByRef strNewData As String, _
        ByRef nRow As Integer)

        Dim lstApcTeosGroup(2)  As String

        'もともとAPC TEOS情報が設定されているか?
        If lvsfFlowList.GetData(nRow, CPlngvsfFlowApcTeosGroupNo) <> vbNullString Then
            '内容が変更されたか？
            If lvsfFlowList.GetData(nRow, nTargeCol) <> strNewData Then
                'そこに紐づくAPC TEOS情報をクリアする
                lstApcTeosGroup(1) = lvsfFlowList.GetData(nRow, CPlngvsfFlowApcTeosGroupNo)
                Call ResetApcTeosData(lvsfFlowList, lstApcTeosGroup)
            End If
        Else
            '計算除外の必要性を判断し、必要な場合は適切な行のスキップフラグをONに設定する
            Call UpdateApcTeosSkip(lvsfFlowList, nRow)
        End If
        
        Erase lstApcTeosGroup
    End Sub

    '関数名：UpdateSkipApcTeos
    '機　能：指定された工程に対して、計算除外にする必要性があるか否かを判断し、
    '        除外にする必要がある工程はスキップフラグを設定する
    '引　数：nListIndex  ：処理対象のリスト番号
    '        nRow        ：チェック対象の基点
    '
    '作成日：2012/02/20 (Mon) 10:00:00 M.Sakka
    '更新日：2012/02/20 (Mon) 10:00:00 M.Sakka
    '備　考：
    Private Sub UpdateApcTeosSkip( _
        ByRef lvsfFlowList As C1FlexGrid, _
        ByRef nRow As Integer, _
        Optional ByVal nStepOver As Integer = APC_NO_OVER)
        
        Dim strAfNearApcTeos    As String
        Dim strBfNearApcTeos    As String
        
        If lvsfFlowList.GetData(nRow, CPlngvsfFlowOpID) = vbNullString Then
            If lvsfFlowList.GetData(nRow, CPlngvsfFlowStepID) = vbNullString Then
                Exit Sub
            End If
        End If

        '指定された行にAPC TEOS設定がされている場合は強制的にフラグON
        If lvsfFlowList.GetData(nRow, CPlngvsfFlowApcTeosGroupNo) <> vbNullString Then
            Call SetSkipApcTeos(lvsfFlowList, nRow)
            Exit Sub
        End If

        '一番近いAPC TEOS設定を探す(上方向)
        strBfNearApcTeos = SerchNearApcTeos(lvsfFlowList, nRow, (nRow - 1), 0, (-1))
            
        '一番近いAPC TEOS設定を探す(下方向)
        strAfNearApcTeos = SerchNearApcTeos(lvsfFlowList, nRow, (nRow + 1), lvsfFlowList.Rows.Count, (1))
            
        If (strBfNearApcTeos = vbNullString) And (strAfNearApcTeos = vbNullString) Then
            Exit Sub
        End If
            
        '値が異なれば問題なし
        If strBfNearApcTeos = strAfNearApcTeos Then
            '同じグループの間の工程に変更があった場合はスキップフラグを設定
            Call SetSkipApcTeos(lvsfFlowList, strBfNearApcTeos)
        Else
            If nStepOver = APC_UP_OVER Then
                Call SetSkipApcTeos(lvsfFlowList, strAfNearApcTeos)
            End If
                
            If nStepOver = APC_DOWN_OVER Then
                Call SetSkipApcTeos(lvsfFlowList, strBfNearApcTeos)
            End If
        End If
    End Sub

    '関数名：SerchNearApcTeos
    '機　能：指定された工程から一番近いAPC TEOS工程のグループ番号を取得する
    '引　数：nListIndex  ：処理対象のリスト番号
    '        nRow        ：チェック対象の基点
    '　　　：nStart      ：検索対象の始点
    '　　　：nEnd        ：検索対象の終点
    '      ：nStepUp     ：検索対象を更新する際の更新幅
    '
    '作成日：2012/02/20 (Mon) 10:00:00 M.Sakka
    '更新日：2012/02/20 (Mon) 10:00:00 M.Sakka
    '備　考：
    Private Function SerchNearApcTeos( _
        ByRef lvsfFlowList As C1FlexGrid, _
        ByRef nRow As Integer, _
        ByRef nStart As Integer, _
        ByRef nEnd As Integer, _
        ByRef nStepUp As Integer) As String
       
       Dim i As Integer
       Dim nRoopCount As Integer
       Dim nTargeRow As Integer
       
       '@戻り値初期化
        SerchNearApcTeos = ""
        
       'ループ回数を算出
       nRoopCount = Math.Abs(nEnd - nStart)
        
        '最初に参照する位置を設定
        nTargeRow = nStart
        
        '指定された範囲をループ
        For i = 1 To nRoopCount
            'APC TEOSに関する情報が設定されていますか？
            If lvsfFlowList.GetData(nTargeRow, CPlngvsfFlowApcTeosGroupNo) = vbNullString Then
                GoTo Next_i
            End If
            
            '設定されている場合はその値を取り出して終了
            SerchNearApcTeos = lvsfFlowList.GetData(nTargeRow, CPlngvsfFlowApcTeosGroupNo)
            Exit Function
            
            '処理対象の行を設定
            nTargeRow = nTargeRow + nStepUp
        
            Next_i:
        Next
        
        Exit Function
        
    End Function

    '関数名：SetSkipApcTeos
    '機　能：指定されたAPC TEOSグループのスキップフラグをONに設定する
    '引　数：nListIndex  ：処理対象のリスト番号
    '      ：strGroupName：計算除外にしたいグループ名
    '
    '作成日：2012/02/20 (Mon) 10:00:00 M.Sakka
    '更新日：2012/02/20 (Mon) 10:00:00 M.Sakka
    '備　考：
    Private Sub SetSkipApcTeos( _
        ByRef lvsfFlowList As C1FlexGrid, _
        ByRef strGroupName As String, _
        Optional ByVal nKeepRow As Integer = -1)
        
        Dim i As Integer
       
        For i = 1 To lvsfFlowList.Rows.Count - 1
            If lvsfFlowList.GetData(i, CPlngvsfFlowApcTeosGroupNo) = vbNullString Then
                '何もしない    
            Else
                If lvsfFlowList.GetData(i, CPlngvsfFlowApcTeosGroupNo) = strGroupName Then
                    '同じグループの場合は最終の計測工程か確認する
                    If lvsfFlowList.GetData(i, CPlngvsfFlowApcTeosFbType) = "M" Then
                        '値を保持
                        nKeepRow = i
                    End If
                Else
        '            Exit For
                End If
            End If
        Next
        
        '更新するべき行があったか？
        If nKeepRow <> -1 Then
            If lvsfFlowList.GetData(nKeepRow, CPlngvsfFlowApcTeosCalcSkipFlag) = CMstrFlgOff Then
                'その行のチェックをONに設定
                lvsfFlowList.SetData(nKeepRow, CPlngvsfFlowApcTeosCalcSkipFlag, CMstrFlgOn)
                
                'その行が編集可能行の場合は色を変更済みに設定
                If lvsfFlowList.GetCellRange(nKeepRow, CPlngvsfFlowApcTeosCalcSkipFlag).StyleDisplay.BackColor = Color.White Then
                    Dim newStyle As CellStyle = lvsfFlowList.Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                    Dim cellRange As CellRange = lvsfFlowList.GetCellRange(nKeepRow, CPlngvsfFlowApcTeosCalcSkipFlag)
                    cellRange.Style = newStyle
                End If
            End If
        End If
    End Sub

    '関数名：prvGetTeosPrismApcData
    '機　能：TEOS PrismAPCﾃﾞｰﾀ格納
    '引　数：lngCurrentRow          ：ｸﾞﾘｯﾄﾞのｶﾚﾝﾄ行
    '　　　：lｔypTeosPrismAPCStep()：TEOS PrismAPCﾃﾞｰﾀ
    '戻り値：なし
    '作成日：2013/08/06 (Tue) 10:58:16 T.Oide
    '更新日：2013/08/06 (Tue) 10:58:16
    '備　考：
    Private Sub prvGetTeosPrismApcData(ByRef lngCurrentRow As Integer, _
                                       ByRef ltypTeosPrismAPCStep As List(Of TypeApcTeosStep))

        Dim lstrGroupNo             As String   'ｸﾞﾙｰﾌﾟ№格納(文字)
        Dim llngGroupNo             As Integer  'ｸﾞﾙｰﾌﾟ№格納(数値)
        Dim llngDataCount           As Integer
        
        Try
            
            '@設定無ければ終了
            If vsfFlowList0.GetData(lngCurrentRow, CPlngvsfFlowTeosPrismAPC) = vbNullString Then
                Exit Sub
            End If
              
            '@要素数を取得
            ltypTeosPrismAPCStep.Add(New TypeApcTeosStep)
            llngDataCount = ltypTeosPrismAPCStep.Count -1
            
            '@要素数を拡張
            Dim ltypTeosPrismAPCStepTmp As New TypeApcTeosStep
            
            With ltypTeosPrismAPCStepTmp
                
                '@工程名を取得
                .strOpID = vsfFlowList0.GetData(lngCurrentRow, CPlngvsfFlowOpID)        '大工程
                .strStepID = vsfFlowList0.GetData(lngCurrentRow, CPlngvsfFlowStepID)    '小工程
                
                With .typApcTeos
                
                    '@データ初期化
                    .strGroupNo = ""                                'ｸﾞﾙｰﾌﾟ№
                    .strNoInGroup = ""                              'ｸﾞﾙｰﾌﾟ内№
                    .strApcType = ""                                'APCﾀｲﾌﾟ
                    .strCalcSkipFlag = CMstrSpcSkipNG               '計算ｽｷｯﾌﾟﾌﾗｸﾞ
                    
                    '@グループ№取得
                    lstrGroupNo = vsfFlowList0.GetData(lngCurrentRow, CPlngvsfFlowTeosPrismAPC)
                    llngGroupNo = CLng(Mid$(lstrGroupNo, 1, 3))     '数値として格納(先頭の00をとるため)
                    .strGroupNo = CStr(llngGroupNo)                 '文字として格納
                
                    '@グループ内№設定(TEOS PrismAPCの場合、ｸﾞﾙｰﾌﾟ内№はすべて1)
                    .strNoInGroup = CMstrFlgOn
                
                    '@計算ｽｷｯﾌﾟﾌﾗｸﾞ(TEOS PrismAPCの場合、ｽｷｯﾌﾟﾌﾗｸﾞは常に0)
                    .strCalcSkipFlag = CMstrSpcSkipNG
                    
                    '@APCタイプ
                    .strApcType = Mid$(vsfFlowList0.GetData(lngCurrentRow, CPlngvsfFlowTeosPrismAPC), _
                                       CMlngMidStart5, CMlngMidGetStringNo1)

                End With

            End With

            ltypTeosPrismAPCStep(llngDataCount) = ltypTeosPrismAPCStepTmp

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvGetTeosPrismApcData"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvTeosPrismAPC_Del
    '機　能：削除ボタン押下時、同一ｸﾞﾙｰﾌﾟのAPC設定を削除する
    '引　数：strSerchGroup：対象APCｸﾞﾙｰﾌﾟ
    '戻り値：なし
    '作成日：2013/07/23 (Tue) 14:34:57 T.Oide
    '更新日：2013/08/08 (Thu) 13:41:48 T.Oide
    '備　考：
    Private Sub prvTeosPrismAPC_Del(ByRef strSerchGroup() As String, ByVal lngTeosPrismAPCCnt As Integer)
        
        Dim llngRowCnt      As Integer
        Dim llngDataCnt     As Integer
        
        Try
            
            With vsfFlowList0
            
                '@ｸﾞﾘｯﾄﾞ行数ぶんループ
                For llngRowCnt = 1 To .Rows.Count - 1
                    
                    '@配列要素数ぶんループ
                    For llngDataCnt = 0 To lngTeosPrismAPCCnt -1
                        
                        '@TEOS PrismAPCの設定に削除した対象のｸﾞﾙｰﾌﾟはあるか
                        If strSerchGroup(llngDataCnt) = _
                           Mid$(.GetData(llngRowCnt, CPlngvsfFlowTeosPrismAPC), CMlngMidStart1, CMlngMidGetStringNo3) Then
                        
                            '@ｸﾞﾙｰﾌﾟが一致した場合設定ｸﾘｱ
                            .SetData(llngRowCnt, CPlngvsfFlowTeosPrismAPC, vbNullString)
                            
                        End If
                    Next
                Next

            End With
            
            Exit Sub
            
        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvTeosPrismAPC_Del"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()
            
        End Try
    End Sub

    '関数名：prvApcBackColerChg
    '機　能：APC設定を選択された場合、同一ｸﾞﾙｰﾌﾟの背景色を変更する
    '引　数：mlngWkRow  ：現在行
    '　　　：mlngWkCo   ：現在列
    '戻り値：なし
    '作成日：2013/08/08 (Thu) 15:23:08 T.Oide
    '更新日：2013/08/08 (Thu) 15:23:08
    '備　考：
    Private Sub prvApcBackColerChg(ByVal mlngWkRow As Integer, ByVal mlngWkCol As Integer)

        Dim lstrAry()           As String
        Dim llngAryCount        As Integer
        Dim llngRowCnt          As Integer
        Dim lstrSearchString    As String

        Try
            
            With vsfFlowList0
            
                '@設定は空以外か
                If .GetData(mlngWkRow, mlngWkCol) <> vbNullString Then
                    '@ｱｸﾃｨﾌﾞｾﾙが空白ではない場合
            
                    '@現在のｾﾙの値を配列に格納
                    lstrAry = Split(.GetData(mlngWkRow, mlngWkCol), CMstrComma)
            
                    '@配列数ぶんループ
                    For llngAryCount = 0 To UBound(lstrAry)
            
                        '@検索用文字列切出し
                        lstrSearchString = Mid$(lstrAry(llngAryCount), CMlngMidStart1, CMlngMidGetStringNo3)
                        
                        '@グリッドの行ループ
                        For llngRowCnt = 1 To .Rows.Count - 1
                        
                            '@自分の行以外か
                            If llngRowCnt <> mlngWkRow Then
                                '@セル内に検索文字列が存在するか
                                If InStr(.GetData(llngRowCnt, mlngWkCol), lstrSearchString) <> 0 Then
                                    '@存在する場合ピンクに変更
                                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorPink")
                                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorPink)
                                    Dim cellRange As CellRange = .GetCellRange(llngRowCnt, mlngWkCol)
                                    cellRange.Style = newStyle
                                    Exit For
                                End If
                            End If
                            
                        Next
                    Next
                    
                End If
            End With
            
            Exit Sub
            
        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvApcBackColerChg"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvTeosRowMoveChk
    '機　能：上下ボタンの有効無効設定(APCの設定の順番を逆転させないため、実績報告工程のﾁｪｯｸでも使用)
    '引　数：lngGridIndex   ：ｸﾞﾘｯﾄﾞｲﾝﾃﾞｯｸｽ
    '　　　：lngRowStart    ：ｽﾀｰﾄ行
    '　　　：lngRowEnd      ：ｴﾝﾄﾞ行
    '　　　：lngTargetCol   ：ﾀｰｹﾞｯﾄ列
    '　　　：cmdObject      ：ﾎﾞﾀﾝｵﾌﾞｼﾞｪｸﾄ
    '戻り値：なし
    '作成日：2013/08/09 (Fri) 13:25:51 T.Oide
    '更新日：2013/09/04 (Wed) 14:15:53 T.Oide
    '備　考：
    Private Sub prvTeosRowMoveChk(ByVal lvsfFlowList As C1FlexGrid, _
                                  ByVal lngRowStart As Integer, _
                                  ByVal lngRowEnd As Integer, _
                                  ByVal lngTargetCol As Integer, _
                                  ByRef cmdObject As Object)

        Dim llngRow         As Integer
        Dim llngUpDown      As Integer  '移動先を参照する為の変数(↑ﾎﾞﾀﾝの場合は-1、↓ﾎﾞﾀﾝの場合は+1）
        Dim llngEdgeRow     As Integer  '一番端の行(↑ならlngRowStart、↓ならlngRowEnd

        Try
            
            '@ﾎﾞﾀﾝが無効じゃないか
            If cmdObject.Enabled <> False Then
            
                '@↑ﾎﾞﾀﾝか↓ﾎﾞﾀﾝで分岐
                Select Case cmdObject.Name
                
                    '@↑ﾎﾞﾀﾝの場合
                    Case cmdUP.Name
                    
                        '1行上を参照するため-1を設定
                        llngUpDown = -1
                        llngEdgeRow = lngRowStart
                    
                    '@↓ﾎﾞﾀﾝの場合
                    Case cmdDown.Name
                    
                        '1行下を参照するため+1を設定
                        llngUpDown = 1
                        llngEdgeRow = lngRowEnd
                        
                    '@その他
                    Case Else
                        Exit Sub
                        
                End Select
                
                With lvsfFlowList
                
                    '@ｸﾞﾘｯﾄﾞのｽﾀｰﾄ行からｴﾝﾄﾞ行まで繰り返し
                    For llngRow = lngRowStart To lngRowEnd
                    
                        '@現在行に設定はあるか
                        If .GetData(llngRow, lngTargetCol) <> vbNullString Then

                            '移動先の行に設定はあるか
                            If .GetData((llngEdgeRow + llngUpDown), lngTargetCol) <> vbNullString Then
                            
                                '@ﾎﾞﾀﾝを無効化
                                cmdObject.Enabled = False
                            
                            End If
                            Exit For
                            
                        End If
                    Next
                    
                End With
            
            End If
            
            Exit Sub
            
        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvTeosRowMoveChk"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：prvReportPointFlagRaw
    '機　能：ｸﾞﾘｯﾄﾞに実績報告ﾌﾗｸﾞを書く
    '引　数：ltypeReportPoint：実績報告マスターを格納している
    '      ：lngRow：カレント行
    '戻り値：
    '作成日：2014/01/14 (Tue) 13:28:56 T.Oide
    '更新日：2014/01/14 (Tue)
    '備　考：
    Private Function prvReportPointFlagRaw(ByRef ltypeReportPoint As ReportPoint, _
                                           ByVal lngRow As Integer) As String

        Dim llngCnt1        As Integer  'PDのﾙｰﾌﾟ用
        Dim llngCnt2        As Integer  '1機種の報告ﾎﾟｲﾝﾄのﾙｰﾌﾟ用

        Dim nowBackColorOp    As Color    'NSYS 現在の大工程背景色
        Dim nowBackColorStep  As Color    'NSYS 現在の小工程背景色

        Try
            
            '@関数の初期値設定
            prvReportPointFlagRaw = vbNullString
            
            '@構造体の要素ぶん繰返し
            For llngCnt1 = 0 To ltypeReportPoint.lngPdListCnt -1
            
                '@1機種の報告ﾏｽﾀｰﾚｺｰﾄﾞ数のﾙｰﾌﾟ
                For llngCnt2 = 0 To ltypeReportPoint.typePdList(llngCnt1).lngPdReportPointCnt -1
            
                    With ltypeReportPoint.typePdList(llngCnt1).typeReportPointList(llngCnt2)
                        
                        '@パーツタイプは2(流動中)で現在工程と一致するか
                        If .strPrtsType = CPstrTwo And _
                           vsfFlowList0.GetData(lngRow, CPlngvsfFlowOpID) = .strOpID And _
                           vsfFlowList0.GetData(lngRow, CPlngvsfFlowStepID) = .strStepID Then

                            'NSYS 現在の背景色を退避
                            nowBackColorOp   = vsfFlowList0.GetCellRange(lngRow, CPlngvsfFlowOpID, lngRow, CPlngvsfFlowOpID).StyleDisplay.BackColor
                            nowBackColorStep = vsfFlowList0.GetCellRange(lngRow, CPlngvsfFlowStepID, lngRow, CPlngvsfFlowStepID).StyleDisplay.BackColor
                        
                            '@一致した場合(順番を書き込む)
                            prvReportPointFlagRaw = .strSeqNum
            
                            '@大工程、小工程行の文字を赤色に変更する
                            Dim newStyle  As CellStyle
                            Dim cellRange As CellRange 
                            newStyle = vsfFlowList0.Styles.Add("CustomStyle_ForeColor_vbRed_Op" & lngRow)
                            newStyle.BackColor = nowBackColorOp
                            newStyle.ForeColor = Color.Red
                            cellRange = vsfFlowList0.GetCellRange(lngRow, CPlngvsfFlowOpID)
                            cellRange.Style = newStyle
                            newStyle = vsfFlowList0.Styles.Add("CustomStyle_ForeColor_vbRed_Step" & lngRow)
                            newStyle.ForeColor = Color.Red
                            newStyle.BackColor = nowBackColorStep
                            cellRange = vsfFlowList0.GetCellRange(lngRow, CPlngvsfFlowStepID)
                            cellRange.Style = newStyle
                            
                            Exit For
                        End If
                    
                    End With
                    
                Next
                    
            Next
            
            Exit Function
            
        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "prvReportPointFlagRaw"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Function


                            End If
                            
                            '@一時保存領域をｸﾘｱ
                            mstrTempChangestring = vbNullString
                            '@一時保存領域に退避
                            mstrTempChangestring = .GetData(.Row, CPlngvsfFlowReworkRouteID)
                            
                            '@ﾘﾜｰｸﾙｰﾄｺﾝﾎﾞ設定
                            Call prvvsfFlowList_Edit(CPlngvsfFlowReworkRouteID)
                        End If
                    
                    Case CPlngvsfFlowSPRouteID          '特殊ﾙｰﾄID
                                
                        '@ｺﾋﾟｰ元の場合は処理不可
                        If lvsfFlowList Is vsfFlowList1 Then
                            Exit Sub
                        End If
                
                        '@既流動ではない場合
                        If .GetCellRange(.Row, CPlngvsfFlowSPRouteID).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorGray) Then
                            '@既にﾊﾞｯｸｶﾗｰが変更されている場合には,白にしない
                            If .GetCellRange(.Row, CPlngvsfFlowSPRouteID).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorSBlue) Then
                                '@ﾊﾞｯｸｶﾗｰを白へ変更
                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_vbWhite")
                                newStyle.BackColor = Color.White
                                Dim cellRange As CellRange = .GetCellRange(.Row, CPlngvsfFlowSPRouteID)
                                cellRange.Style = newStyle
                            End If
                            
                            '@一時保存領域をｸﾘｱ
                            mstrTempChangestring = vbNullString
                            '@一時保存領域に退避
                            mstrTempChangestring = .GetData(.Row, CPlngvsfFlowSPRouteID)
                            
                            '@特殊流動ｺﾝﾎﾞ設定
                            Call prvvsfFlowList_Edit(CPlngvsfFlowSPRouteID)
                        End If
                    
                    Case CPlngvsfFlowReworkReturnOpID   'ﾘﾜｰｸ戻り大工程
                        
                        '@ｺﾋﾟｰ元の場合は処理不可
                        If lvsfFlowList Is vsfFlowList1 Then
                            Exit Sub
                        End If
                        
                        '@既流動ではない場合
                        If .GetCellRange(.Row, CPlngvsfFlowReworkReturnOpID).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorGray) Then
                        
                            '@ﾘﾜｰｸﾙｰﾄIDが設定済みであること(Null OR 空白以外）
                            If .GetData(.Row, CPlngvsfFlowReworkRouteID) <> vbNullString And _
                                .GetData(.Row, CPlngvsfFlowReworkRouteID) <> CPstrComboBrank Then
                            
                                '@一時保存領域をｸﾘｱ
                                mstrTempChangestring = vbNullString
                                '@一時保存領域に退避
                                mstrTempChangestring = .GetData(.Row, CPlngvsfFlowReworkReturnOpID)
                            
                                '@ﾘﾜｰｸ戻り大工程ｺﾝﾎﾞ設定
                                Call prvvsfFlowList_Edit(CPlngvsfFlowReworkReturnOpID)
                            End If
                        End If
                        
                        
                    Case CPlngvsfFlowReworkReturnStepID 'ﾘﾜｰｸ戻り小工程
                    
                        '@ｺﾋﾟｰ元の場合は処理不可
                        If lvsfFlowList Is vsfFlowList1 Then
                            Exit Sub
                        End If
                        
                        '@既流動ではない場合
                        If .GetCellRange(.Row, CPlngvsfFlowReworkReturnStepID).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorGray) Then
                          
                              '@ﾘﾜｰｸ戻り大工程が設定済みであること(Null OR 空白以外）
                              If .GetData(.Row, CPlngvsfFlowReworkReturnOpID) <> vbNullString And _
                                  .GetData(.Row, CPlngvsfFlowReworkReturnOpID) <> CPstrComboBrank Then
                                  '@一時保存領域をｸﾘｱ
                                  mstrTempChangestring = vbNullString
                                  '@一時保存領域に退避
                                  mstrTempChangestring = .GetData(.Row, CPlngvsfFlowReworkReturnStepID)
                                  
                                  '@ﾘﾜｰｸ戻り小工程ｺﾝﾎﾞ設定
                                  Call prvvsfFlowList_Edit(CPlngvsfFlowReworkReturnStepID)
                              End If
                          End If
                        
                    Case CPlngvsfFlowSPReturnOpID       '特殊ﾙｰﾄ戻り大工程
                        
                        '@ｺﾋﾟｰ元の場合は処理不可
                        If lvsfFlowList Is vsfFlowList1 Then
                            Exit Sub
                        End If
                        
                        '@既流動ではない場合
                        If .GetCellRange(.Row, CPlngvsfFlowSPReturnOpID).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorGray) Then
                        
                            '@特殊ﾙｰﾄIDが設定済みであること
                            If .GetData(.Row, CPlngvsfFlowSPRouteID) <> vbNullString And _
                                .GetData(.Row, CPlngvsfFlowSPRouteID) <> CPstrComboBrank Then
                                
                                '@一時保存領域をｸﾘｱ
                                mstrTempChangestring = vbNullString
                                '@一時保存領域に退避
                                mstrTempChangestring = .GetData(.Row, CPlngvsfFlowSPReturnOpID)
                                '@特殊ﾙｰﾄ戻り大工程ｺﾝﾎﾞ設定
                                Call prvvsfFlowList_Edit(CPlngvsfFlowSPReturnOpID)
                            End If
                        End If
                        
                    Case CPlngvsfFlowSPReturnStepID     '特殊ﾙｰﾄ戻り小工程
                        
                        '@ｺﾋﾟｰ元の場合は処理不可
                        If lvsfFlowList Is vsfFlowList1 Then
                            Exit Sub
                        End If
                        
                        '@既流動ではない場合
                        If .GetCellRange(.Row, .Col).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorGray) Then
                            '@特殊ﾙｰﾄ大工程が設定済みであること
                            If .GetData(.Row, CPlngvsfFlowSPReturnOpID) <> vbNullString And _
                                    .GetData(.Row, CPlngvsfFlowSPReturnOpID) <> CPstrComboBrank Then
                                '@一時保存領域をｸﾘｱ
                                mstrTempChangestring = vbNullString
                                '@一時保存領域に退避
                                mstrTempChangestring = .GetData(.Row, CPlngvsfFlowSPReturnStepID)
                                '@特殊ﾙｰﾄ戻り小工程ｺﾝﾎﾞ設定
                                Call prvvsfFlowList_Edit(CPlngvsfFlowSPReturnStepID)
                            End If
                        End If
                        
                    Case CPlngvsfFlowApc                 'APC設定
                    
                        '@ｺﾋﾟｰ元の場合は処理不可
                        If sender Is vsfFlowList1 Then
                            Exit Sub
                        End If
                    
                        '@選択行にF/B設定が存在する場合
                        If .GetData(.Row, CPlngvsfFlowApc) <> vbNullString Then
                            '@ﾌｫﾄF/Bﾎﾞﾀﾝｸﾘｯｸ
                            Call cmdApcSet_Click(cmdApcSet,New EventArgs)
                        End If
                    
                    Case CPlngvsfFlowCarrierCategoryID  'ｷｬﾘｱｶﾃｺﾞﾘ
                        
                        '@ｺﾋﾟｰ元の場合は処理不可
                        If sender Is vsfFlowList1 Then
                            Exit Sub
                        End If
                        
                        '@既流動ではない場合
                        If .GetCellRange(.Row, .Col).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorGray) Then
                            .Select(.Row, CPlngvsfFlowCarrierCategoryID)
                            .StartEditing()
                        End If
                        
                    Case Else
                        '@それ以外の場合
                        Exit Sub
                End Select
                        
                '@ｾﾙを表示する
                .ShowCell(.Row, .Col)
                
                '@ｸﾞﾘｯﾄﾞの高さを設定
                If sender Is vsfFlowList0 Then
                    vsfFlowList1.Height = vsfFlowList0.Height
                Else
                    vsfFlowList0.Height = vsfFlowList1.Height
                End If
                
            End With
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "vsfFlowList_DblClick"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：vsfFlowList_KeyDown
    '機　能：ﾌﾛｰﾘｽﾄ　ｷｰﾀﾞｳﾝ制御
    '引　数：KeyCode：ｷｰｺｰﾄﾞ
    '　　　：Shift  ：Shift/Ctrl/Altｷｰ
    '戻り値：なし
    '作成日：2006/07/12 (Wed) 10:04:51 N.Kasai
    '更新日：2018/03/12 (Mon) 12:43:12 T.Oide
    '備　考：
    Private Sub vsfFlowList_KeyDown(ByVal sender As Object, ByVal e As KeyEventArgs) Handles vsfFlowList0.KeyDown,vsfFlowList1.KeyDown

        Dim llngRow             As Integer      '行
        Dim llngCol             As Integer      '列
        Dim llngRowStart        As Integer      'ｽﾀｰﾄ行
        Dim llngRowEnd          As Integer      'ｴﾝﾄﾞ行
        Dim llngColStart        As Integer      'ｽﾀｰﾄ列
        Dim llngColEnd          As Integer      'ｴﾝﾄﾞ列
        Dim llngAryCount        As Integer      '配列ｶｳﾝﾀ
        Dim llngCnt             As Integer      'ｶｳﾝﾀ
        
        Dim llngMsgAns          As Integer      '戻り値
        Dim lstrAry()           As String       'ｾﾙ内時間制限配列
        Dim lstrAryOp()         As String       'ｾﾙ内ﾌｫﾄFB大工程配列
        Dim lstrAryStep()       As String       'ｾﾙ内ﾌｫﾄFB小工程配列
        Dim lstrSearchNo        As String       '検索番号
        Dim lstrSearchString    As String       '検索文字列
        Dim lblnAns             As Boolean      '汎用戻り値

        Dim lvsfFlowList        As C1FlexGrid   'NSYS イベント元グリッド

        Try
            lvsfFlowList = CType(sender, C1FlexGrid)

            'NSYS データ行がない場合は処理を抜ける
            If lvsfFlowList.Rows.Count <= lvsfFlowList.Rows.Fixed Then
                Return
            End If
            
            '@編集ﾌﾗｸﾞ（0/未編集　1/編集中　2/編集済　3/編集開始前）
            If mlngEditFlag <> 1 Then
                Exit Sub
            End If
            
            '@明細行以外は処理しない。
            If lvsfFlowList.Row < 1 Then
                Exit Sub
            End If
            
            '@矢印ｷｰ押下で余計なｲﾍﾞﾝﾄを走行させない
            Select Case e.KeyCode
                Case Keys.Up, Keys.Down, Keys.Left, Keys.Right
                    '@ちらつき防止の為記述
                    Exit Sub
            End Select

            
        '@↓ｺﾋﾟﾍﾟ処理----------------------------------------------------------------------------------
            
            With lvsfFlowList
            
                '@ｺﾋﾟﾍﾟ対応（Ctrl+V)
                If e.Control = True Then
                
                    Select Case e.KeyCode
                        
                        '@ｺﾋﾟｰ(Ctrl + C)
                        Case Keys.C
                             Select Case .Col
                            
                                '@大工程/小工程/処理条件ｾｯﾄID/WF選択条件/収集項目/不良項目
                                Case CPlngvsfFlowOpID, _
                                        CPlngvsfFlowStepID, _
                                        CPlngvsfFlowConditionID, _
                                        CPlngvsfFlowSelectConditionID, _
                                        CPlngvsfFlowCollectionID, _
                                        CPlngvsfFlowLotScrapSetId
                                    
                                    '@該当項目が空白の場合はｺﾋﾟｰしない
                                    If .GetData(.Row, .Col) = vbNullString Then
                                        Exit Sub
                                    End If
                                    
                                    If sender Is vsfFlowList0 Then
                                    
                                        '@ｺﾋﾟｰ処理
                                        Call mnu21_Click(mnu21, e)
                                    Else
                                        '@ｺﾋﾟｰ処理
                                        Call mnu61_Click(mnu61, e)
                                    End If
                                
                                '@個別処理条件
                                Case CPlngvsfFlowConditionOne
                                    
                                    '@該当項目が空白の場合はｺﾋﾟｰしない
                                    If .GetData(.Row, .Col) = vbNullString Then
                                        Exit Sub
                                    End If
                                    
                                    If sender Is vsfFlowList0 Then
                                        '@ｺﾋﾟｰ処理
                                        Call mnu21_Click(mnu21, e)
                                    Else
                                        '@ﾕｰｻﾞﾌﾟﾛｾｽの場合は個別処理条件のｺﾋﾟｰはしない
                                        If pstrEN01X0KindFlag = "2" Then
                                            Exit Sub
                                        End If
                                        
                                        '@ﾛｯﾄ状態が「投入待ち」の場合は個別処理条件のｺﾋﾟｰはしない
                                        If lblCurrentStatus.Text = CPstrWaitThrowSt Then
                                             Exit Sub
                                        End If
                                        
                                        '@ﾛｯﾄ状態が空白の場合（工順なし）は個別処理条件のｺﾋﾟｰはしない
                                        If lblCurrentStatus.Text = vbNullString Then
                                             Exit Sub
                                        End If
                                    
                                        '@ｺﾋﾟｰ処理
                                        Call mnu61_Click(mnu61, e)
                                    End If
                            
                            End Select

                        '@貼り付け（Ctrl+V)
                        Case Keys.V
                        
                            '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞの場合は処理しない。
                            If sender Is vsfFlowList1 Then
                                Exit Sub
                            End If
                        
                            Select Case .Col
                            
                                '@大工程/小工程/処理条件ｾｯﾄID/収集項目/不良項目
                                Case CPlngvsfFlowOpID, _
                                        CPlngvsfFlowStepID, _
                                        CPlngvsfFlowConditionID, _
                                        CPlngvsfFlowCollectionID, _
                                        CPlngvsfFlowLotScrapSetId
                                        
                                    '@該当項目行が編集不可行の場合
                                    If .GetData(.Row, CPlngvsfFlowPermit) = CMstrPermit2 Then
                                        Exit Sub
                                    End If
                                    
                                    '@貼り付け処理
                                    Call mnu22_Click(mnu22,e)
                            
                                '@個別処理条件の場合
                                Case CPlngvsfFlowConditionOne
                                
                                    '@該当項目行が編集不可行の場合
                                    If .GetData(.Row, CPlngvsfFlowPermit) = CMstrPermit2 Then
                                        Exit Sub
                                    End If
                                    
                                    '@WF選択条件が未設定の場合
                                    If .GetData(.Row, CPlngvsfFlowSelectConditionID) = vbNullString Then
                                        '@貼り付け処理
                                        Call mnu22_Click(mnu22,e)
                                    End If
                                    
                                '@WF選択条件の場合
                                Case CPlngvsfFlowSelectConditionID
                                
                                    '@該当項目行が編集不可行の場合
                                    If .GetData(.Row, CPlngvsfFlowPermit) = CMstrPermit2 Then
                                        Exit Sub
                                    End If
                                    
                                    '@個別処理条件が未設定の場合
                                    If .GetData(.Row, CPlngvsfFlowConditionOne) = vbNullString Then
                                        '@貼り付け処理
                                        Call mnu22_Click(mnu22,e)
                                    End If
                            
                            End Select
                    End Select
                End If
            
            End With
            
        '@↑ｺﾋﾟﾍﾟ処理-------------------------------------------------------------------------------------

        '@↓削除処理--------------------------------------------------------------------------------------
            
            '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞの場合は処理しない。
            If sender Is vsfFlowList1 Then
                Exit Sub
            End If
            
            With lvsfFlowList
                '@ﾌﾟﾛｾｽﾌﾛｰ画面上でのｷｰ押下判定
                Select Case e.KeyCode
                    Case Keys.Delete  '[DELETE]ｷｰ
                        '@選択範囲の取得
                        llngRowStart = .Selection.TopRow
                        llngColStart = .Selection.LeftCol
                        llngRowEnd = .Selection.BottomRow
                        llngColEnd = .Selection.RightCol

                        '@見出し行も含め複数選択した場合
                        '@先頭行を再ｾｯﾄ
                        If llngRowStart = 0 Then
                            llngRowStart = 1
                        End If
                        '@№列も含め複数選択された場合
                        '先頭列を再ｾｯﾄ
                        If llngColStart = 0 Then
                            llngColStart = 1
                        End If
                        
                        '@通常工程の場合
                        '@削除前に対象列が処理号機で記憶設定が含まれる場合はﾒｯｾｰｼﾞを表示する。
                        '@複数列選択
                        If pstrEN01X0ProcFlag = "0" Then
                            For llngCol = llngColStart To llngColEnd
                                If llngCol = CPlngvsfFlowWpRestrict Then
                                    For llngRow = llngRowStart To llngRowEnd
                                        '記憶設定存在ﾁｪｯｸ
                                        lblnAns = prvblnWpRestrictDel_Chk(llngRow)
                                        '@記憶設定あり
                                        If lblnAns = True Then
                                            pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf006W)
                                            '@"<TRM6WI>$$号機記憶設定をクリアします。$号機限定情報もクリアしますがよろしいですか？"
                                            llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                                            '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                                            Select Case llngMsgAns
                                                Case vbNo       '「いいえ」を選択
                                                    Exit Sub
                                                Case Else
                                                    Exit For
                                            End Select
                                        End If
                                    Next
                                End If
                            Next
                        End If
                        
                        '@変更ﾌﾗｸﾞｵﾝ
                        pblnEN01X2Edit = True
                        
                        '@複数列選択
                        For llngCol = llngColStart To llngColEnd
                            '@選択ｾﾙのﾁｪｯｸ
                            Select Case llngCol
                                
                                '@大工程
                                Case CPlngvsfFlowOpID
                                
                                    lblnAns = False
                                
                                    '@選択された範囲を検索
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) = CMstrPermit1 Then
                                            If .GetData(llngRow, CPlngvsfFlowApc) <> vbNullString Then
                                                lblnAns = True
                                                Exit For
                                            End If
                                        End If
                                    Next llngRow
                            
                                    If lblnAns = True Then
                                         pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005K)
                            
                                        '@"<TRM5KI>$$APC設定済みの工程が選択されています。$$削除を行うとAPC設定をクリアしますがよろしいですか？"
                                        llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                                        
                                        '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                                        If llngMsgAns = vbNo Then       '「いいえ」を選択
                                            e.Handled = True
                                            Exit Sub
                                        End If
                                    End If
                                
                                    '@選択された範囲を検索
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) = CMstrPermit1 Then
                                            '@大工程が設定済みの場合
                                            If .GetData(llngRow, llngCol) <> vbNullString Then
                                                '@選択範囲をｸﾘｱ
                                                .SetData(llngRow, llngCol, vbNullString)
                                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowOpID)
                                                cellRange.Style = newStyle
                                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                                                '@Discon初期化
                                                .SetData(llngRow, CPlngvsfFlowOpValid, CMlngValid)
                                                
                                            End If
                                            
                                            '@APC設定の削除
                                            '@APC設定が設定済みの場合
                                            If .GetData(llngRow, CPlngvsfFlowApc) <> vbNullString Then
                                            
                                                '@APC設定を削除
                                                Call pubApc_Del(.GetData(llngRow, CPlngvsfFlowApc))
                                            
                                            End If
                                        End If
                                    Next llngRow
                                        
                                '@小工程
                                Case CPlngvsfFlowStepID
                                
                                    lblnAns = False
                                
                                    '@選択された範囲を検索
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) = CMstrPermit1 Then
                                            If .GetData(llngRow, CPlngvsfFlowApc) <> vbNullString Then
                                                lblnAns = True
                                                Exit For
                                            End If
                                        End If
                                    Next llngRow
                            
                                    If lblnAns = True Then
                                         pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005K)
                            
                                        '@"<TRM5KI>$$APC設定済みの工程が選択されています。$$削除を行うとAPC設定をクリアしますがよろしいですか？"
                                        llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                                        
                                        '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                                        If llngMsgAns = vbNo Then       '「いいえ」を選択
                                            e.Handled = True
                                            Exit Sub
                                        End If
                                    End If
                                
                                    
                                    '@選択された範囲を検索
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) = CMstrPermit1 Then
                                            '@小工程が設定済みの場合
                                            If .GetData(llngRow, llngCol) <> vbNullString Then
                                                '@選択範囲をｸﾘｱ
                                                .SetData(llngRow, llngCol, vbNullString)
                                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                Dim cellRange As CellRange = .GetCellRange(llngRow, llngCol)
                                                cellRange.Style = newStyle
                                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                                                '@Discon初期化
                                                .SetData(llngRow, CPlngvsfFlowStepValid, CMlngValid)
                                            End If
                                    
                                            '@APC設定の削除
                                            '@APC設定が設定済みの場合
                                            If .GetData(llngRow, CPlngvsfFlowApc) <> vbNullString Then
                                                '@APC設定を削除
                                                Call pubApc_Del(.GetData(llngRow, CPlngvsfFlowApc))
                                            
                                            End If
                                        End If
                                    Next llngRow

                                '@処理条件ｾｯﾄID
                                Case CPlngvsfFlowConditionID
                                
                                    '@選択された範囲を検索
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                                            '@処理条件が設定済みの場合
                                            If .GetData(llngRow, llngCol) <> vbNullString Then
                                                '@ﾌﾗｸﾞを設定
                                                .SetData(llngRow, CPlngvsfFlowLotRecipeFlag, CMstrFlgOff)     'ﾛｯﾄ個別ﾚｼﾋﾟ設定ﾌﾗｸﾞｵﾌ
                                                .SetData(llngRow, CPlngvsfFlowWFRecipeFlag, CMstrFlgOff)      'WF個別ﾚｼﾋﾟ設定ﾌﾗｸﾞｵﾌ
                                                .SetData(llngRow, CPlngvsfFlowRecipeChgFlg, CMstrFlgOff)      '工順ﾚｼﾋﾟ変更ﾌﾗｸﾞｵﾌ
                                            
                                                '@個別処理条件が設定済みの場合
                                                If .GetData(llngRow, CPlngvsfFlowConditionOne) <> vbNullString Then
                                                    '@個別処理条件をｸﾘｱ
                                                    .SetData(llngRow, CPlngvsfFlowConditionOne, vbNullString)
                                                    '@ﾊﾞｯｸｶﾗｰ変更
                                                    '@文字色変更
                                                    Dim newStyle2 As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                    newStyle2.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                    newStyle2.ForeColor = Color.Black
                                                    Dim cellRange2 As CellRange = .GetCellRange(llngRow, CPlngvsfFlowConditionOne)
                                                    cellRange2.Style = newStyle2
                                                    .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
            
                                                    
                                                    '@構造体
                                                    Call prvAryConDetailEnable_Set(llngRow)
                                                    
                                                    '@ﾃﾞﾌｫﾙﾄ処理条件再表示処理
                                                    Call prvCondition_Disp(llngRow)
                                                    
                                                End If
                                            
                                                '@処理条件ｾｯﾄID/Verをｸﾘｱ
                                                .Clear(ClearFlags.Content, llngRow, CPlngvsfFlowConditionID, _
                                                                  llngRow, CPlngvsfFlowConditionVer)

                                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowConditionID, _
                                                                       llngRow, CPlngvsfFlowConditionVer)
                                                cellRange.Style = newStyle
                                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                                                
                                                '@Discon初期化
                                                .SetData(llngRow, CPlngvsfFlowConditionValid, CMlngValid)
                                                
                                                '@個別処理条件設定ﾎﾞﾀﾝを無効にする
                                                cmdParCondition.Enabled = False
                                            
                                            End If
                                        End If
                                    Next llngRow
                                    
                                '@個別処理条件
                                Case CPlngvsfFlowConditionOne
                                    
                                    '@選択された範囲を検索
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                                            '@個別処理条件が設定済みの場合
                                            If .GetData(llngRow, llngCol) <> vbNullString Then
                                                                                
                                                '@個別処理条件をｸﾘｱ
                                                .SetData(llngRow, llngCol, vbNullString)
                                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                Dim cellRange As CellRange = .GetCellRange(llngRow, llngCol)
                                                cellRange.Style = newStyle
                                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
            
                                                
                                                '@構造体
                                                Call prvAryConDetailEnable_Set(llngRow)
                                                
                                                '@ﾃﾞﾌｫﾙﾄ処理条件再表示処理
                                                Call prvCondition_Disp(llngRow)
                                            
                                                '@個別処理条件設定ﾎﾞﾀﾝを無効にする
                                                cmdParCondition.Enabled = False
                                                
                                                'APC枚葉設定制御
                                                Call ControlApcWfUnitFlg(lvsfFlowList, llngRow)
                                            End If
                                        End If
                                    Next llngRow
                                
                                '@WF選択条件
                                Case CPlngvsfFlowSelectConditionID
                                
                                    '@選択ｾﾙが空白以外の場合
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                                            '@WF選択条件が設定済みの場合
                                            If .GetData(llngRow, llngCol) <> vbNullString Then
                                                '@ｸﾘｱ
                                                .SetData(llngRow, llngCol, vbNullString)
                                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                Dim cellRange As CellRange = .GetCellRange(llngRow, llngCol)
                                                cellRange.Style = newStyle
                                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
            
                                            End If
                                        End If
                                    Next llngRow
                                
                                    '@注意！！！！！
                                    '@現工程、作業待ち、WF選択条件ありの場合はWFﾚｼﾋﾟﾌﾗｸﾞがONである。ここでWF選択条件を削除した場合
                                    '@WFﾚｼﾋﾟﾌﾗｸﾞをOFFにしないと。登録時又は、個別ﾚｼﾋﾟ設定画面を起動した場合、ﾛｯﾄﾚｼﾋﾟの内容で、WFﾚｼﾋﾟﾌﾗｸﾞがON
                                    '@状態になりﾃﾞｰﾀに不整合がおきます。そのためWFﾚｼﾋﾟﾌﾗｸﾞをOFFする。
                                    If mstrCurrentOpID = .GetData(.Row, CPlngvsfFlowOpID) And _
                                       mstrCurrentStepID = .GetData(.Row, CPlngvsfFlowStepID) And _
                                       mstrCurrentStatus = CPstrWaitWorkSt Then
                                        .SetData(.Row, CPlngvsfFlowWFRecipeFlag, CMstrFlgOff)     'WF個別ﾚｼﾋﾟ設定ﾌﾗｸﾞOFF
                                    End If
                                
                                '@収集項目
                                Case CPlngvsfFlowCollectionID
                                    
                                    '@選択された範囲を検索
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                                            '@収集項目が設定済みの場合
                                            If .GetData(llngRow, llngCol) <> vbNullString Then
                                                '@収集項目/Verをｸﾘｱ
                                                .Clear(ClearFlags.Content, llngRow, CPlngvsfFlowCollectionID, _
                                                                  llngRow, CPlngvsfFlowCollectionVer)
                                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowCollectionID, _
                                                                       llngRow, CPlngvsfFlowCollectionVer)
                                                cellRange.Style = newStyle
                                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                                                
                                                '@Discon初期化
                                                .SetData(llngRow, CPlngvsfFlowCollectionValid, CMlngValid)
                                                
                                            End If
                                        End If
                                    Next llngRow
                                                  
                                '@時間制限
                                Case CPlngvsfFlowTimeLimit
                                    
                                    '@特殊ﾛｯﾄの場合は時間制限の新規設定は不可
                                    If pstrEN01X0ProcFlag <> "1" Then
                                    
                                        '@選択された範囲を検索
                                        For llngRow = llngRowStart To llngRowEnd
                                            If .GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                                                '@時間制限が設定済みの場合
                                                If .GetData(llngRow, llngCol) <> vbNullString Then
                                                    '@現在のｾﾙの値を配列に格納
                                                    lstrAry = Split(.GetData(llngRow, llngCol), CMstrComma)
                
                                                    '@配列数分、以下の処理を繰り返す
                                                    For llngAryCount = 0 To UBound(lstrAry)
                                                        '@時間制限番号を取得
                                                        lstrSearchNo = Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo3)
                                                        '@時間制限表示ｸﾘｱ
                                                        Call Me.pubTimeLimitDisp_Del(lstrSearchNo)
                                                    Next
                                                End If
                                            End If
                                        Next
                
                                        '@時間制限ﾎﾞﾀﾝの使用許可
                                        Call prvcmdTimeLimitEnabled_Set()
                                        
                                    End If
                                '@ﾘﾜｰｸﾙｰﾄID
                                Case CPlngvsfFlowReworkRouteID
                                
                                    '@選択された範囲を検索
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                                            '@ﾘﾜｰｸﾙｰﾄが設定済みの場合
                                            If .GetData(llngRow, llngCol) <> vbNullString Then
                                                '@ﾘﾜｰｸﾙｰﾄID/ﾘﾜｰｸ戻り大工程/ﾘﾜｰｸ戻り小工程ｸﾘｱ
                                                .Clear(ClearFlags.Content, llngRow, CPlngvsfFlowReworkRouteID, llngRow, CPlngvsfFlowReworkReturnStepID)
                                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowReworkRouteID, llngRow, CPlngvsfFlowReworkReturnStepID)
                                                cellRange.Style = newStyle
                                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                                                '@Discon初期化
                                                .SetData(llngRow, CPlngvsfFlowReworkRouteValid, CMlngValid)
                                                
                                            End If
                                        End If
                                    Next llngRow
                                    
                                '@ﾘﾜｰｸﾙｰﾄ大工程
                                Case CPlngvsfFlowReworkReturnOpID
                                
                                    '@選択された範囲を検索
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                                            '@ﾘﾜｰｸﾙｰﾄ戻り大工程が設定済みの場合
                                            If .GetData(llngRow, llngCol) <> vbNullString Then
                                                '@ﾘﾜｰｸﾙｰﾄ戻り大工程/ﾘﾜｰｸﾙｰﾄ戻り小工程ｸﾘｱ
                                                .Clear(ClearFlags.Content,llngRow, CPlngvsfFlowReworkReturnOpID, llngRow, CPlngvsfFlowReworkReturnStepID)
                                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowReworkReturnOpID, llngRow, CPlngvsfFlowReworkReturnStepID)
                                                cellRange.Style = newStyle
                                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                                            End If
                                        End If
                                    Next llngRow
                                    
                                '@特殊ﾙｰﾄID
                                Case CPlngvsfFlowSPRouteID
                                
                                    '@選択された範囲を検索
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                                            '@特殊ﾙｰﾄIDが設定済みの場合
                                            If .GetData(llngRow, llngCol) <> vbNullString Then
                                                '@特殊ﾙｰﾄID/特殊ﾙｰﾄ戻り大工程/特殊ﾙｰﾄ戻り小工程ｸﾘｱ
                                                .Clear(ClearFlags.Content, llngRow, CPlngvsfFlowSPRouteID, llngRow, CPlngvsfFlowSPReturnStepID)
                                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowSPRouteID, llngRow, CPlngvsfFlowSPReturnStepID)
                                                cellRange.Style = newStyle
                                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                                                '@Discon初期化
                                                .SetData(llngRow, CPlngvsfFlowSPRouteValid, CMlngValid)
                                            End If
                                        End If
                                    Next llngRow
                                    
                                '@特殊ﾙｰﾄ大工程
                                Case CPlngvsfFlowSPReturnOpID
                            
                                   '@選択された範囲を検索
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                                            '@特殊ﾙｰﾄ戻り大工程が設定済みの場合
                                            If .GetData(llngRow, llngCol) <> vbNullString Then
                                                '@特殊ﾙｰﾄ戻り大工程/特殊ﾙｰﾄ戻り小工程ｸﾘｱ
                                                .Clear(ClearFlags.Content, llngRow, CPlngvsfFlowSPReturnOpID, llngRow, CPlngvsfFlowSPReturnStepID)
                                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowSPReturnOpID, llngRow, CPlngvsfFlowSPReturnStepID)
                                                cellRange.Style = newStyle
                                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
            
                                            End If
                                        End If
                                    Next llngRow
                                
                                '@ﾁｪｯｸﾎﾞｯｸｽ（SPC判定ｽｷｯﾌﾟﾌﾗｸﾞ/FB適用外/FB計算対象外)
                                Case CPlngvsfFlowJudgeSkipFlag, CPlngvsfFlowApcSkipFlag, CPlngvsfFlowApcCalcSkipFlag
                                
                                    '@選択された範囲を検索
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                                            '@ﾁｪｯｸが設定済みの場合
                                            If .GetCellCheck(llngRow, llngCol) = CheckEnum.Checked Then
                                                '@ﾁｪｯｸｸﾘｱ
                                                .SetCellCheck(llngRow, llngCol, CheckEnum.Unchecked)
                                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                Dim cellRange As CellRange = .GetCellRange(llngRow, llngCol)
                                                cellRange.Style = newStyle
                                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
            
                                            End If
                                        End If
                                    Next llngRow
                                
                                '@入替え工程
                                Case CPlngvsfFlowSwapIndictor
                                
                                    lstrSearchString = vbNullString
                                    
                                    '@ﾌﾟﾛｾｽｸﾞﾘｯﾄの行数文、以下の処理を繰り返す
                                    For llngCnt = llngRowStart To llngRowEnd
                                    
                                        If .GetData(llngCnt, CPlngvsfFlowPermit) <> CMstrPermit2 Then

                                            '@入替工程を削除
                                            If .GetData(llngCnt, CPlngvsfFlowSwapIndictor) <> lstrSearchString Then
                                                lstrSearchString = .GetData(llngCnt, CPlngvsfFlowSwapIndictor)
                                                
                                                If lstrSearchString <> vbNullString Then
                                                
                                                    For llngRow = 1 To .Rows.Count - 1
                                                        If .GetData(llngRow, CPlngvsfFlowSwapIndictor) = lstrSearchString Then
                                                            .SetData(llngRow, CPlngvsfFlowSwapIndictor, vbNullString)
                                                            .SetData(llngRow, CPlngvsfFlowSwapIndictorCopy, vbNullString)
                                                            
                                                            '@ﾊﾞｯｸｶﾗｰ変更処理
                                                            Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                            Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowSwapIndictor)
                                                            cellRange.Style = newStyle
                                                            .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                                                            
                                                        End If
                                                    Next
                                                End If
                                            End If
                                        End If
                                    Next
                                
                                '@処理号機
                                Case CPlngvsfFlowWpRestrict
                                
                                    '@通常工程の場合
                                    If pstrEN01X0ProcFlag = "0" Then
                                        '@選択列を検索
                                        For llngRow = llngRowStart To llngRowEnd
                                            If .GetCellRange(llngRow, CPlngvsfFlowWpRestrict).StyleDisplay.BackColor <> ColorTranslator.FromWin32(CMlngBackColorGray) Then
                                                If .GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                                                    '@関連ﾃﾞｰﾀ削除
                                                    Call prvWpRestrictDisp_Del(llngRow)
                                                    '@内容を削除する
                                                    .SetData(llngRow, CPlngvsfFlowWpRestrict, vbNullString)       '号機限定
                                                    .SetData(llngRow, CPlngvsfFlowWpRestrictFlag, "1")            '号機限定変更ﾌﾗｸﾞ
                                                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                    Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowWpRestrict)
                                                    cellRange.Style = newStyle
                                                    .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)           '変更区分（変更あり）
                                                End If
                                            End If
                                        Next
                                    End If

                                '@GRB工程限定設定
                                Case CPlngvsfFlowGrbClass

                                    '@選択ｾﾙが空白以外の場合
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                                            If .GetData(llngRow, llngCol) <> vbNullString Then
                                                '@ｸﾘｱ
                                                .SetData(llngRow, llngCol, vbNullString)
                                                
                                                '@工程の色をｸﾘｱ(GRB工程限定設定なしの場合)
                                                If .GetCellRange(llngRow, CPlngvsfFlowOpID, llngRow, CPlngvsfFlowStepID).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorPink) Then
                                                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_vbWhite")
                                                    newStyle.BackColor = Color.White
                                                    Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowOpID, llngRow, CPlngvsfFlowStepID)
                                                    cellRange.Style = newStyle
                                                End If
                                                
                                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                                Dim newStyle2 As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                newStyle2.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                Dim cellRange2 As CellRange = .GetCellRange(llngRow, llngCol)
                                                cellRange2.Style = newStyle2
                                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）

                                            End If
                                        End If
                                    Next llngRow
                                
                                '@削除禁止
                                Case CPlngvsfFlowAbsNo
                                Case CPlngvsfFlowConditionVer
                                Case CPlngvsfFlowCollectionVer
                                Case CPlngvsfFlowAltSet
                                Case CPlngvsfFlowAltPointer
                                Case CPlngvsfFlowAltStartFlag
                                Case CPlngvsfFlowAltEndFlag
                                Case CPlngvsfFlowTimeLimitFlag
                                Case CPlngvsfFlowLotRecipeFlag
                                Case CPlngvsfFlowWFRecipeFlag
                                Case CPlngvsfFlowSFlag
                                Case CPlngvsfFlowEntryID
                                Case CPlngvsfFlowRecipeChgFlg
                                Case CPlngvsfFlowWorkCondition
                                Case CPlngvsfFlowCommitFlag
                                Case CPlngvsfFlowApc
                                Case CPlngvsfFlowState
                                Case CPlngvsfFlowPermit
                                Case CPlngvsfFlowChange
                                Case CPlngvsfFlowPriority
                                Case CPlngvsfFlowReportPointFlag
                                Case CPlngvsfFlowApcTeosGroupNo, CPlngvsfFlowApcTeosNoInGroup, CPlngvsfFlowApcTeosCalcSkipFlag
                                Case CPlngvsfFlowTeosPrismAPC
        '@↓2018/03/12 (Mon) 12:41:58 T.Oide **************************************************
                                Case CPlngvsfFlowRecpSelApc
        '@↑2018/03/12 (Mon) 12:41:58 T.Oide **************************************************
                                
                                '@その他
                                Case Else
                                    '@選択ｾﾙが空白以外の場合
                                    For llngRow = llngRowStart To llngRowEnd
                                        If .GetData(llngRow, CPlngvsfFlowPermit) <> CMstrPermit2 Then
                                            If .GetData(llngRow, llngCol) <> vbNullString Then
                                                '@ｸﾘｱ
                                                .SetData(llngRow, llngCol, vbNullString)
                                                
                                                '@ﾊﾞｯｸｶﾗｰ変更処理
                                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                                Dim cellRange As CellRange = .GetCellRange(llngRow, llngCol)
                                                cellRange.Style = newStyle
                                                .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
            
                                            End If
                                        End If
                                    Next llngRow
                                
                            End Select
                        Next llngCol
                End Select
                
                .AutoSizeCol(.Col, 6) '列幅自動調整
                
            End With

        '@↑削除処理--------------------------------------------------------------------------------------

            '@配列の初期化
            Erase lstrAry
            Erase lstrAryOp
            Erase lstrAryStep
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "vsfFlowList_KeyDown"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：vsfFlowList_MouseDown
    '機　能：ﾌﾛｰﾘｽﾄ　ﾏｳｽｸﾘｯｸ制御
    '引　数：Button：押下ﾎﾞﾀﾝ
    '　　　：Shift ：Shift/Ctrl/Altｷｰ
    '　　　：x     ：ﾏｳｽ位置
    '　　　：y     ：ﾏｳｽ位置
    '戻り値：なし
    '作成日：2006/07/12 (Wed) 10:05:53 N.Kasai
    '更新日：2006/07/12 (Wed) 10:05:53
    '備　考：
    Private Sub vsfFlowList_MouseDown(ByVal sender As Object, ByVal e As MouseEventArgs) Handles vsfFlowList0.MouseDown,vsfFlowList1.MouseDown
        
        Dim llngSubCnt              As Integer  'ｶｳﾝﾀ
        Dim llngAryCount            As Integer  '配列ｶｳﾝﾀ
        Dim llngRowStart            As Integer  'ｽﾀｰﾄ行
        Dim llngRowEnd              As Integer  'ｴﾝﾄﾞ行
        Dim llngColStart            As Integer  'ｽﾀｰﾄ列
        Dim llngColEnd              As Integer  'ｴﾝﾄﾞ列
        Dim lstrSearchString1       As String   '検索用文字列1
        Dim lstrSearchString2       As String   '検索用文字列2
        Dim lstrChangeString        As String   '変更用文字列
        Dim lstrFontChangeString    As String   'ﾌｫﾝﾄ変更文字列
        Dim lstrAry()               As String   'ｾﾙ内時間制限配列
        
        Dim llngRow                 As Integer  '行（選択開始行）
        Dim llngRowSel              As Integer  '行（選択終了行）
        Dim llngCol                 As Integer  '列（選択開始列）
        Dim llngColSel              As Integer  '列（選択開始列）
        Dim llngCnt                 As Integer  'ｶｳﾝﾀ
        Dim llngFindRow             As Integer  '検索行
        
        Dim lvsfFlowList            As C1FlexGrid   'NSYS イベント元グリッド

        Try
            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            lvsfFlowList = CType(sender, C1FlexGrid)

            With lvsfFlowList
            
                '@ｶﾚﾝﾄ列/行を取得
                mlngWkCol = .MouseCol       '列
                mlngWkRow = .MouseRow       '行

                '@列の有効範囲ﾁｪｯｸ
                If mlngWkCol >= .Cols.Count Then
                    Exit Sub
                End If
                
                '@ﾏｳｽの押下ｷｰ判定
                Select Case e.Button
                    '@左ﾎﾞﾀﾝ
                    Case MouseButtons.Left
                        
                        '@行の有効範囲ﾁｪｯｸ
                        If Not (0 < mlngWkRow And mlngWkRow < .Rows.Count) Then
                            Exit Sub
                        End If
                    
                        '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞの場合は処理しない。
                        If sender Is vsfFlowList1 Then
                            Exit Sub
                        End If
                        
                        '@対象列の判定
                        Select Case mlngWkCol
                            
                            '@代替工程
                            Case CPlngvsfFlowAltSet
                                
                                If .GetData(mlngWkRow, mlngWkCol) <> vbNullString Then
                                    '@ｱｸﾃｨﾌﾞｾﾙが空白ではない場合

                                    '@開始・終了の場合[S/E]、背景色処理中止
                                    If Strings.Right$(.GetData(mlngWkRow, mlngWkCol), 3) = CMstrStartEndMark Then
                                        Exit Sub
                                    End If

                                    '@検索用文字列の取得
                                    lstrSearchString1 = Strings.Right$(.GetData(mlngWkRow, mlngWkCol), 1)
                                    lstrSearchString2 = Mid$(.GetData(mlngWkRow, mlngWkCol), CMlngMidStart3, CMlngMidGetStringNo3)

                                    '@検索用文字列の編集
                                    If lstrSearchString1 = CMstrStartMark Then
                                        '@ｱｸﾃｨﾌﾞｾﾙが"S"だった場合
                                        lstrChangeString = CMstrEndMark         '検索用文字列に"E"をｾｯﾄ
                                    Else
                                        '@ｱｸﾃｨﾌﾞｾﾙが"E"だった場合
                                        lstrChangeString = CMstrStartMark       '検索用文字列に"S"をｾｯﾄ
                                    End If

                                    '@検索用文字列の結合
                                    lstrFontChangeString = lstrSearchString2 & CMstrHyphen & lstrChangeString

                                    '@文字列の検索
                                    For llngSubCnt = 1 To .Rows.Count - 1
                                        '@ｾﾙ内に検索文字列が存在するかﾁｪｯｸ
                                        If InStr(.GetData(llngSubCnt, mlngWkCol), lstrFontChangeString) <> 0 Then
                                            '@検索文字列が存在する場合
                                            '@ｾﾙ書式の変更
                                            Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorPink")
                                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorPink)
                                            Dim cellRange As CellRange = .GetCellRange(llngSubCnt, mlngWkCol)
                                            cellRange.Style = newStyle  'ﾊﾞｯｸｶﾗｰ(ﾋﾟﾝｸ)
                                            Exit For
                                        End If
                                    Next llngSubCnt
                                End If
                            
                            '@時間制限
                            Case CPlngvsfFlowTimeLimit
                                
                                If .GetData(mlngWkRow, mlngWkCol) <> vbNullString Then
                                    '@ｱｸﾃｨﾌﾞｾﾙが空白ではない場合

                                    '@現在のｾﾙの値を配列に格納
                                    lstrAry = Split(.GetData(mlngWkRow, CPlngvsfFlowTimeLimit), CMstrComma)

                                    '@配列数分、以下の処理を繰り返す
                                    For llngAryCount = 0 To UBound(lstrAry)

                                        '@検索用文字列の取得
                                        lstrSearchString1 = Strings.Left$(lstrAry(llngAryCount), CMlngLeftGetStringNo6)
                                        
                                        '@文字列の検索
                                        For llngSubCnt = 1 To .Rows.Count - 1
                                            If llngSubCnt <> mlngWkRow Then
                                                '@ｾﾙ内に検索文字列が存在するかﾁｪｯｸ
                                                If InStr(.GetData(llngSubCnt, mlngWkCol), lstrSearchString1) <> 0 Then
                                                    '@検索文字列が存在する場合
                                                    '@ｾﾙ書式の変更
                                                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorPink")
                                                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorPink)
                                                    Dim cellRange As CellRange = .GetCellRange(llngSubCnt, mlngWkCol)
                                                    cellRange.Style = newStyle  'ﾊﾞｯｸｶﾗｰ(ﾋﾟﾝｸ)
                                                    Exit For
                                                End If
                                            End If
                                        Next llngSubCnt
                                    Next
                                End If
                                
                            '@APC設定
                            Case CPlngvsfFlowApc
                                
                                If .GetData(mlngWkRow, mlngWkCol) <> vbNullString Then
                                    '@ｱｸﾃｨﾌﾞｾﾙが空白ではない場合

                                    '@現在のｾﾙの値を配列に格納
                                    lstrAry = Split(.GetData(mlngWkRow, CPlngvsfFlowApc), CMstrComma)

                                    '@配列数分、以下の処理を繰り返す
                                    For llngAryCount = 0 To UBound(lstrAry)

                                        '@検索用文字列の取得
                                        lstrSearchString1 = Strings.Left$(lstrAry(llngAryCount), CMlngLeftGetStringNo6)
                                        
                                        '@文字列の検索
                                        For llngSubCnt = 1 To .Rows.Count - 1
                                            If llngSubCnt <> mlngWkRow Then
                                                '@ｾﾙ内に検索文字列が存在するかﾁｪｯｸ
                                                If InStr(.GetData(llngSubCnt, mlngWkCol), lstrSearchString1) <> 0 Then
                                                    '@検索文字列が存在する場合
                                                    '@ｾﾙ書式の変更
                                                    Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorPink")
                                                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorPink)
                                                    Dim cellRange As CellRange = .GetCellRange(llngSubCnt, mlngWkCol)
                                                    cellRange.Style = newStyle     'ﾊﾞｯｸｶﾗｰ(ﾋﾟﾝｸ)
                                                    Exit For
                                                End If
                                            End If
                                        Next llngSubCnt
                                    Next
                                End If
                        
                            '@処理号機限定
                            Case CPlngvsfFlowWpRestrict
                                '@ｱｸﾃｨﾌﾞｾﾙのﾁｪｯｸ
                                '@ｱｸﾃｨﾌﾞｾﾙが空白ではない場合
                                If .GetData(mlngWkRow, mlngWkCol) <> vbNullString Then
                                   
                                    Select Case Strings.Right$(.GetData(mlngWkRow, mlngWkCol), 1)
                                        '@記憶の場合
                                        Case CMstrWpMarkMark
                                            '@検索用文字列の取得
                                            lstrSearchString1 = Strings.Left$(.GetData(mlngWkRow, mlngWkCol), CMlngLeftGetStringNo5)
                                            
                                            '@文字列の検索
                                            For llngCnt = 1 To .Rows.Count - 1
                                                If llngCnt <> mlngWkRow Then
                                                    '@ｾﾙ内に検索文字列が存在するかﾁｪｯｸ
                                                    If Strings.Left$(.GetData(llngCnt, mlngWkCol), 5) = lstrSearchString1 Then
                                                        '@検索文字列が存在する場合
                                                        '@ｾﾙ書式の変更
                                                        Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorPink")
                                                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorPink)
                                                        Dim cellRange As CellRange = .GetCellRange(llngCnt, mlngWkCol)
                                                        cellRange.Style = newStyle     'ﾊﾞｯｸｶﾗｰ(ﾋﾟﾝｸ)
                                                    End If
                                                End If
                                            Next llngCnt
                                            
                                        '@限定の場合
                                        Case CMstrWpUseMark
                                            '@検索用文字列の取得
                                            lstrSearchString1 = Strings.Left$(.GetData(mlngWkRow, mlngWkCol), CMlngLeftGetStringNo6) & CMstrWpMarkMark
                                            '@検索
                                            llngFindRow = .FindRow(lstrSearchString1, .Rows.Fixed, CPlngvsfFlowWpRestrict, False)
                                            If llngFindRow <> -1 Then
                                                '@ｾﾙ書式の変更
                                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorPink")
                                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorPink)
                                                Dim cellRange As CellRange = .GetCellRange(llngFindRow, mlngWkCol)
                                                cellRange.Style = newStyle     'ﾊﾞｯｸｶﾗｰ(ﾋﾟﾝｸ)
                                            End If
                                    End Select
                                End If
                            
                            '@TEOS PrismAPC
                            Case CPlngvsfFlowTeosPrismAPC
                                
                                '@背景色変更
                                Call prvApcBackColerChg(mlngWkRow, mlngWkCol)
                                                
                        End Select
                    
                        '@配列のｸﾘｱ
                        Erase lstrAry

                    
                    '@右ﾎﾞﾀﾝ
                    Case MouseButtons.Right
                    
                        '@編集ﾌﾗｸﾞ（0/未編集　1/編集中　2/編集済　3/編集開始前）
                        If mlngEditFlag <> 1 Then
                            Exit Sub
                        End If
                        
                        If mlngWkRow = -1 Then '行
                           If sender Is vsfFlowList0 Then
                                If .Rows.Count = 1 Then
                                    '@ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【ｺﾋﾟｰ/行挿入】
                                    Dim p = Cursor.Position
                                    Me.mnu1.Show(p)
                                    Exit Sub
                                End If
                           End If
                        End If
                        
                        '@行の有効範囲ﾁｪｯｸ
                        If Not (0 < mlngWkRow And mlngWkRow < .Rows.Count) Then
                            Exit Sub
                        End If
                        
                        '@ｶﾚﾝﾄ列を判定
                        Select Case mlngWkCol
                            '@№列
                            Case CPlngvsfFlowNo
                                '@選択範囲の取得
                                llngRowStart = .Selection.TopRow
                                llngColStart = .Selection.LeftCol
                                llngRowEnd = .Selection.BottomRow
                                llngColEnd = .Selection.RightCol
                                .Redraw = False
                                '@選択行全体をﾊｲﾗｲﾄ
                                .Select(llngRowStart, CPlngvsfFlowNo, llngRowEnd, .Cols.Count - 1)
                                .Redraw = True
                                If sender Is vsfFlowList0 Then
                                
                                    '@ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【ｺﾋﾟｰ/行挿入】
                                    Dim p = Cursor.Position
                                    Me.mnu1.Show(p)
                                
                                Else
                                    '@ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【ｺﾋﾟｰ/行挿入】
                                    Dim p = Cursor.Position
                                    Me.mnu5.Show(p)
                                End If
                                
                                
                            '@処理条件ｾｯﾄID/WF選択条件/収集項目/不良項目
                            Case CPlngvsfFlowConditionID, _
                                        CPlngvsfFlowSelectConditionID, _
                                        CPlngvsfFlowCollectionID, _
                                        CPlngvsfFlowLotScrapSetId, _
                                        CPlngvsfFlowOpID, _
                                        CPlngvsfFlowStepID

                                .Select(mlngWkRow, mlngWkCol)
                                
                                If sender Is vsfFlowList0 Then
                                    '@ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【ｺﾋﾟｰ/貼り付け/削除】
                                    Dim p = Cursor.Position
                                    Me.mnu2.Show(p)
                                Else
                                    '@ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【ｺﾋﾟｰ】
                                    Dim p = Cursor.Position
                                    Me.mnu6.Show(p)
                                End If
                            
                            '@個別処理条件
                            Case CPlngvsfFlowConditionOne
                                
                                .Select(mlngWkRow, mlngWkCol)
                                
                                If sender Is vsfFlowList0 Then
                                    '@ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【ｺﾋﾟｰ/貼り付け/削除】
                                    Dim p = Cursor.Position
                                    Me.mnu2.Show(p)
                                Else
                                
                                    '@ﾕｰｻﾞﾌﾟﾛｾｽの場合は個別処理条件のｺﾋﾟｰはしない
                                    If pstrEN01X0KindFlag = "2" Then
                                        Exit Sub
                                    End If
                                    
                                    '@ﾛｯﾄ状態が「投入待ち」の場合は個別処理条件のｺﾋﾟｰはしない
                                    If lblCurrentStatus.Text = CPstrWaitThrowSt Then
                                         Exit Sub
                                    End If
                                    
                                    '@ﾛｯﾄ状態が空白の場合（工順なし）は個別処理条件のｺﾋﾟｰはしない
                                    If lblCurrentStatus.Text = vbNullString Then
                                         Exit Sub
                                    End If
                                    
                                    '@ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【ｺﾋﾟｰ】
                                    Dim p = Cursor.Position
                                    Me.mnu6.Show(p)
                                End If
                                
                                    
                            '@時間制限列
                            Case CPlngvsfFlowTimeLimit
                                
                                '@編集不可工程の場合
                                If .GetData(mlngWkRow, CPlngvsfFlowPermit) = CMstrPermit2 Then
                                    Exit Sub
                                End If
                                
                                '@特殊ﾛｯﾄの場合は時間制限の新規設定は不可
                                If pstrEN01X0ProcFlag = "1" Then
                                    Exit Sub
                                End If
                                
                                .Select(mlngWkRow, mlngWkCol)
                                '@ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【時間制限開始/時間制限終了】
                                Dim p = Cursor.Position
                                Me.mnu3.Show(p)
                            
                            '@入替え工程
                            Case CPlngvsfFlowSwapIndictor
                                
                                If sender Is vsfFlowList0 Then
                                    '@ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【ｺﾋﾟｰ Then
                                
                                    '@現在のｾﾙ選択位置を変数に代入
                                    '@↓選択範囲を取得します。Row=RowSel,Col=ColSelとなる場合は単一ｾﾙの選択のみになる
                                    llngRow = .Row          '行（選択開始行）
                                    llngRowSel = .RowSel    '行（選択終了行）
                                    llngCol = .Col          '列（選択開始列）
                                    llngColSel = .ColSel    '列（選択開始列）
                                    
                                    '@選択範囲の取得
                                    llngRowStart = .Selection.TopRow
                                    llngColStart = .Selection.LeftCol
                                    llngRowEnd = .Selection.BottomRow
                                    llngColEnd = .Selection.RightCol
                                    
                                    '@編集不可の場合
                                    For llngCnt = llngRowStart To llngRowEnd
                                        
                                        '@編集不可工程or部分編集不可の場合
                                        If .GetData(llngCnt, CPlngvsfFlowPermit) = CMstrPermit2 Or _
                                            .GetData(llngCnt, CPlngvsfFlowPermit) = CMstrPermit3 Then
                                            
                                            '@入替設定不可
                                            Exit Sub
                                        End If
                                    
                                    Next
                                    
                                    If (llngCol = llngColSel) And (llngRow <> llngRowSel) Then
                                        .Select(llngRow, llngCol, llngRowSel, llngColSel)
                                        Dim p = Cursor.Position
                                        Me.mnu4.Show(p)
                                    End If
                                End If
                            
                            '@処理号機設定
                            Case CPlngvsfFlowWpRestrict
                                
                                If sender Is vsfFlowList0 Then
                                
                                    '@編集不可工程の場合
                                    If .GetData(mlngWkRow, CPlngvsfFlowPermit) = CMstrPermit2 Then
                                        Exit Sub
                                    End If
                                    
                                    '@特殊ﾛｯﾄの場合新規設定は不可
                                    If pstrEN01X0ProcFlag = "1" Then
                                        Exit Sub
                                    End If
                                
                                    .Select(mlngWkRow, mlngWkCol)
                                    '@ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【処理号機設定】
                                    Dim p = Cursor.Position
                                    Me.mnu7.Show(p)
                                End If
                        
                            '@TPAL設定
                            Case CPlngvsfFlowTpalClass
                                
                                If sender Is vsfFlowList0 Then
                                
                                    '@編集不可工程の場合
                                    If .GetData(mlngWkRow, CPlngvsfFlowPermit) = CMstrPermit2 Then
                                        Exit Sub
                                    End If
                                    
                                    .Select(mlngWkRow, mlngWkCol)
                                    '@ﾎﾟｯﾌﾟｱｯﾌﾟﾒﾆｭｰ【TPAL設定】
                                    Dim p = Cursor.Position
                                    Me.mnu8.Show(p)
                                End If
                        
                        End Select
                End Select
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "vsfFlowList_MouseDown"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：cmdAdd_Click
    '機　能：追加ﾎﾞﾀﾝ押下
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/22 (Mon) 11:37:43 N.Kasai
    '更新日：2018/04/05 (Thu) 10:57:39 T.Oide
    '備　考：
    Private Sub cmdAdd_Click(ByVal sender As Object, ByVal e As EventArgs) Handles cmdAdd.Click

        Dim llngWkRow   As Integer          'ｶﾚﾝﾄ行位置
        Dim llngWkCol   As Integer          'ｶﾚﾝﾄ列位置
        Dim llngAddRow  As Integer          '行追加対象行
        Dim nKeepRow        As Integer
        Dim strKeepGroup    As String
        Dim oApcTeosData    As TypeApcTeos
        
        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            nKeepRow = -1
            strKeepGroup = ""
            oApcTeosData.strCalcSkipFlag = "0"
            oApcTeosData.strApcType = ""
            oApcTeosData.strGroupNo = ""
            oApcTeosData.strNoInGroup = ""
            
            With vsfFlowList0
                
                If .GetData(.Rows.Count - 1, CPlngvsfFlowPermit) = CMstrPermit3 Then
                    '@R,AﾛｯﾄorSﾛｯﾄ判定
                    Select Case .GetData(.Rows.Count - 1, CPlngvsfFlowState)
                        Case CMstrState13
                            '@行追加
                            .AddItem(vbNullString, .Rows.Count - 1)
                            .TopRow = .Rows.Count - 2     'ｽｸﾛｰﾙﾊﾞｰの移動
                            .Row = .Rows.Count - 2        'ｶﾚﾝﾄｾﾙの設定
                            llngAddRow = .Rows.Count - 2

                        Case CMstrState14
                            '@行追加
                            .AddItem(vbNullString, .Rows.Count - 1)
                            .TopRow = .Rows.Count - 2     'ｽｸﾛｰﾙﾊﾞｰの移動
                            .Row = .Rows.Count - 2        'ｶﾚﾝﾄｾﾙの設定
                            llngAddRow = .Rows.Count - 2
                        Case Else
                            '@行追加
                            .AddItem(.Rows.Count)          '最終行（行番号の再採番も同時に行う）
                            .TopRow = .Rows.Count - 1     'ｽｸﾛｰﾙﾊﾞｰの移動
                            .Row = .Rows.Count - 1        'ｶﾚﾝﾄｾﾙの設定
                            llngAddRow = .Rows.Count - 1
                    End Select
                Else
                    '@行追加
                    .AddItem(.Rows.Count)          '最終行（行番号の再採番も同時に行う）
                    .TopRow = .Rows.Count - 1     'ｽｸﾛｰﾙﾊﾞｰの移動
                    .Row = .Rows.Count - 1        'ｶﾚﾝﾄｾﾙの設定
                    llngAddRow = .Rows.Count - 1
                End If
                
                '@Noの再ｾｯﾄ
                Call prvNo_Set(vsfFlowList0)

                
                '@№のﾊﾞｯｸｶﾗｰを編集処理色へ変更
                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                Dim cellRange As CellRange = .GetCellRange(llngAddRow, CPlngvsfFlowAbsNo)
                cellRange.Style = newStyle
                
                .SetData(llngAddRow, CPlngvsfFlowAbsNo, plngSeqNoCnt)
                plngSeqNoCnt = plngSeqNoCnt + 1
                
                '@処理条件ｾｯﾄIDVerのﾊﾞｯｸｶﾗｰを変更不可色へ変更
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                cellRange = .GetCellRange(llngAddRow, CPlngvsfFlowConditionVer, _
                                       llngAddRow, CPlngvsfFlowConditionVer)
                cellRange.Style = newStyle
                '@収集項目ｾｯﾄIDVerのﾊﾞｯｸｶﾗｰを変更不可色へ変更
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                cellRange = .GetCellRange(llngAddRow, CPlngvsfFlowCollectionVer, _
                                       llngAddRow, CPlngvsfFlowCollectionVer)
                cellRange.Style = newStyle
                '@代替工程部分のﾊﾞｯｸｶﾗｰを変更
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                cellRange = .GetCellRange(llngAddRow, CPlngvsfFlowAltSet, _
                                       llngAddRow, CPlngvsfFlowAltEndFlag)
                cellRange.Style = newStyle
                '@ﾌｫﾄF/B部分のﾊﾞｯｸｶﾗｰを変更
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                cellRange = .GetCellRange(llngAddRow, CPlngvsfFlowApc, _
                                       llngAddRow, CPlngvsfFlowApcCalcSkipFlag)
                cellRange.Style = newStyle
                                       
                '@TEOS PrismAPC設定のﾊﾞｯｸｶﾗｰを変更
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                cellRange = .GetCellRange(llngAddRow, CPlngvsfFlowTeosPrismAPC, _
                                       llngAddRow, CPlngvsfFlowTeosPrismAPC)
                cellRange.Style = newStyle

        '@↓2018/04/05 (Thu) 10:57:20 T.Oide **************************************************
                '@「ﾚｼﾋﾟ選択APC設定」のﾊﾞｯｸｶﾗｰを変更
                newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                cellRange = .GetCellRange(llngAddRow, CPlngvsfFlowRecpSelApc, _
                                       llngAddRow, CPlngvsfFlowRecpSelApc)
                cellRange.Style = newStyle
        '@↑2018/04/05 (Thu) 10:57:20 T.Oide **************************************************


               
                '@ﾘﾜｰｸ、特殊ﾛｯﾄの場合はﾘﾜｰｸ、特殊ﾙｰﾄの設定は行わない
                Select Case pstrEN01X0ProcFlag
                    
                    '@ﾘﾜｰｸ、特殊流動
                    Case "1"
                        '@ﾘﾜｰｸ～特殊ﾙｰﾄ部分のﾊﾞｯｸｶﾗｰを変更
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                        cellRange = .GetCellRange(llngAddRow, CPlngvsfFlowReworkRouteID, _
                                                  llngAddRow, CPlngvsfFlowSPReturnStepID)
                        cellRange.Style = newStyle
                                                  
                        '@時間制限のﾊﾞｯｸｶﾗｰを変更
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                        cellRange = .GetCellRange(llngAddRow, CPlngvsfFlowTimeLimit, _
                                                  llngAddRow, CPlngvsfFlowTimeLimitFlag)
                        cellRange.Style = newStyle
                                                  
                        '@処理号機のﾊﾞｯｸｶﾗｰを変更
                        newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                        cellRange = .GetCellRange(llngAddRow, CPlngvsfFlowWpRestrict, _
                                                  llngAddRow, CPlngvsfFlowWpRestrict)
                        cellRange.Style = newStyle
                    
                    Case Else
                        '@今のところなし
                End Select
                
                .SetData(llngAddRow, CPlngvsfFlowAltStartFlag, CMstrFlgOff)       '代替開始ﾌﾗｸﾞ
                .SetData(llngAddRow, CPlngvsfFlowAltEndFlag, CMstrFlgOff)         '代替終了ﾌﾗｸﾞ
                .SetData(llngAddRow, CPlngvsfFlowTimeLimitFlag, CMstrFlgOff)      '時間制限ﾌﾗｸﾞ(変更ﾌﾗｸﾞ0:変更なし、1:変更あり）
                .SetData(llngAddRow, CPlngvsfFlowCommitFlag, CMstrFlgOff)         '号機指定
                .SetData(llngAddRow, CPlngvsfFlowLotRecipeFlag, CMstrFlgOff)      'ﾛｯﾄ個別ﾚｼﾋﾟ設定ﾌﾗｸﾞｵﾌ
                .SetData(llngAddRow, CPlngvsfFlowWFRecipeFlag, CMstrFlgOff)       'WF個別ﾚｼﾋﾟ設定ﾌﾗｸﾞｵﾌ
                .SetData(llngAddRow, CPlngvsfFlowRecipeChgFlg, CMstrFlgOff)       '工順ﾚｼﾋﾟ変更ﾌﾗｸﾞｵﾝ
                
                '@SPCｽｷｯﾌﾟﾌﾗｸﾞ（ﾁｪｯｸなし）
                .SetCellCheck(llngAddRow, CPlngvsfFlowJudgeSkipFlag, CheckEnum.Unchecked)

                '@APC設定（ﾁｪｯｸなし）
                .SetCellCheck(llngAddRow, CPlngvsfFlowApcSkipFlag, CheckEnum.Unchecked)
                .SetCellCheck(llngAddRow, CPlngvsfFlowApcCalcSkipFlag, CheckEnum.Unchecked)
                
                'APC枚葉設定の制御
                .SetCellCheck(llngAddRow, CPlngvsfFlowApcWfUnitFlg, CheckEnum.Unchecked)
                .SetCellCheck(llngAddRow, CPlngvsfFlowApcWfUnitFlgSetable, CheckEnum.Unchecked)
                
                .SetData(llngAddRow, CPlngvsfFlowState, CMstrState8)              '状態（追加挿入）
                .SetData(llngAddRow, CPlngvsfFlowPermit, CMstrPermit1)            '変更可否（変更可）
                .SetData(llngAddRow, CPlngvsfFlowChange, CMstrChange1)            '変更区分（変更あり）
                
                '@discon初期設定(有効）
                .SetData(llngAddRow, CPlngvsfFlowOpValid, CMlngValid)             '有効ﾃﾞｰﾀ
                .SetData(llngAddRow, CPlngvsfFlowStepValid, CMlngValid)           '有効ﾃﾞｰﾀ
                .SetData(llngAddRow, CPlngvsfFlowConditionValid, CMlngValid)      '有効ﾃﾞｰﾀ
                .SetData(llngAddRow, CPlngvsfFlowCollectionValid, CMlngValid)     '有効ﾃﾞｰﾀ
                .SetData(llngAddRow, CPlngvsfFlowReworkRouteValid, CMlngValid)    '有効ﾃﾞｰﾀ
                .SetData(llngAddRow, CPlngvsfFlowSPRouteValid, CMlngValid)        '有効ﾃﾞｰﾀ

                'ﾏｯﾌﾟ適用ﾌﾗｸﾞ（ﾁｪｯｸなし）
                .SetCellCheck(llngAddRow, CPlngvsfFlowMapUseFlag, CheckEnum.Unchecked)
                '組立(2A0)以外無効化
                If pstrSBID <> CPstrSBID2A0 Then
                    newStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorGray")
                    newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorGray)
                    cellRange = .GetCellRange(llngAddRow, CPlngvsfFlowMapUseFlag, _
                                        llngAddRow, CPlngvsfFlowMapUseFlag)
                    cellRange.Style = newStyle
                End If
                
                '@TEOS F/B設定
                Call SetApcTeosData(vsfFlowList0, llngAddRow, oApcTeosData, nKeepRow, strKeepGroup)
                
                '@ﾌﾟﾛｾｽﾌﾛｰの画面ｻｲｽﾞを変更
                .Height = mlngvsfPcTabOnHeight

                '@編集画面の表示
                With stbSetPanel
                    .Visible = True
                    .SelectedIndex = CMlngOpTabNo         '大工程ﾀﾌﾞを表示
                    .Top = vsfFlowList0.Top + mlngvsfPcTabOnHeight
                End With
                cmdSetPanel.Enabled = True      '設定画面表示ﾎﾞﾀﾝ使用可


                '@表示画面の移動
                '@ｶﾚﾝﾄ行/列を変数に格納
                llngWkRow = .Row            '行
                llngWkCol = .Col            '列

                '@ﾎﾞﾀﾝ制御
                '@移動ﾎﾞﾀﾝ(↑)(↓)・削除ﾎﾞﾀﾝ
                Call prvCmdUpDownDelEnabled_Set(vsfFlowList0)

                '@登録ﾎﾞﾀﾝの使用許可
                Call prvCmdUpdateEnabled_Set()
                
                '@変更ﾌﾗｸﾞｵﾝ
                pblnEN01X2Edit = True

                '@ｶﾚﾝﾄ行のﾁｪｯｸ
                If .TopRow = llngWkRow Then
                    '@ｶﾚﾝﾄ行が最初行の場合
                    '@ｽｸﾛｰﾙ移動なし
                Else
                    '@ｶﾚﾝﾄ行が最初行ではない場合
                    '@ｶﾚﾝﾄ行を.TopRowとして設定
                    .TopRow = llngWkRow
                End If
                
                '@ﾌｫｰｶｽ移動（大工程）
                .Col = CPlngvsfFlowOpID
                
                '@ﾌｫｰｶｽｾｯﾄ
                Call pubSetFocus(vsfFlowList0)
                
            End With
            
            '@画面ﾘｻｲｽﾞ
            Call Form_Resize(Me, e)
            
            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "cmdAdd_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：CmdEdit_Click
    '機　能：編集ﾎﾞﾀﾝ押下
    '引　数：なし
    '戻り値：なし
    '作成日：2006/05/22 (Mon) 12:32:47 N.Kasai
    '更新日：2006/05/22 (Mon) 12:32:47
    '備　考：
    Private Sub cmdEdit_Click(ByVal sender As Object, ByVal e As EventArgs) Handles cmdEdit.Click

        Try

            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If

            With vsfFlowList0
                
                '@見出し行の場合
                If .Row < 1 Then
                    Exit Sub
                End If
            
                '@ｶﾚﾝﾄｾﾙの判定
                Select Case .Col
                    '大工程、小工程、処理条件ｾｯﾄID、測定条件ｾｯﾄID、収集項目ｾｯﾄID、不良項目ｾｯﾄID
                    Case CPlngvsfFlowOpID, _
                         CPlngvsfFlowStepID, _
                         CPlngvsfFlowConditionID, _
                         CPlngvsfFlowConditionOne, _
                         CPlngvsfFlowSelectConditionID, _
                         CPlngvsfFlowCollectionID, _
                         CPlngvsfFlowLotScrapSetId
                        
                        '@ﾀﾞﾌﾞﾙｸﾘｯｸ処理と同じ処理を行う
                        Call vsfFlowList_DblClick(vsfFlowList0,e)
                        
                    Case Else
                    
                        '@大工程を初期表示
                        .Col = CPlngvsfFlowOpID
                        '@ﾀﾞﾌﾞﾙｸﾘｯｸ処理と同じ処理を行う
                        Call vsfFlowList_DblClick(vsfFlowList0,e)
                        
                End Select
            End With

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "CmdEdit_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub

    '関数名：cmdDel_Click
    '機　能：削除ﾎﾞﾀﾝ押下
    '引　数：なし
    '戻り値：なし
    '作成日：2006/07/12 (Wed) 10:09:58 N.Kasai
    '更新日：2018/03/15 (Thu) 14:42:21 T.Oide
    '備　考：
    Private Sub cmdDel_Click(ByVal sender As Object, ByVal e As EventArgs) Handles cmdDel.Click
        
        Dim llngRowStart            As Integer  'ｽﾀｰﾄ行
        Dim llngRowEnd              As Integer  'ｴﾝﾄﾞ行
        Dim llngColStart            As Integer  'ｽﾀｰﾄ列
        Dim llngColEnd              As Integer  'ｴﾝﾄﾞ列
        Dim llngCnt                 As Integer  'ｶｳﾝﾀ
        Dim llngCnt3                As Integer  'ｶｳﾝﾀ
        Dim llngMsgAns              As Integer  '戻り値
        Dim llngRow                 As Integer  '行ｶｳﾝﾀ
        Dim llngAryCount            As Integer  '配列ｶｳﾝﾀ
        Dim lstrAltPointer          As String   '代替ﾎﾟｲﾝﾀ
        Dim lstrAry()               As String   '時間制限配列
        Dim lstrSearchNo            As String   '検索番号
        Dim lstrSearchString        As String   '検索文字列
        Dim llngDelCnt              As Integer  '削除行数
        Dim lblnFlg                 As Boolean  '戻り工程設定ﾌﾗｸﾞ
        Dim lblnSpFlag              As Boolean  'ﾘﾜｰｸ・特殊ﾙｰﾄ・入替可能工程・代替工程設定(設定)ﾌﾗｸﾞ
        Dim lblnNotSpFlag           As Boolean  'ﾘﾜｰｸ・特殊ﾙｰﾄ・入替可能工程・代替工程設定(非設定)ﾌﾗｸﾞ
        Dim lblnNotReturnFlag       As Boolean  'ﾘﾜｰｸ・特殊ﾙｰﾄ・入替可能工程・代替工程設定(戻り工程非設定)ﾌﾗｸﾞ
        Dim lblnSwapFlag            As Boolean  '入替存在ﾌﾗｸﾞ
        Dim lblnAltSetFlag          As Boolean  '代替存在ﾌﾗｸﾞ
        Dim lblnTimeLimitFlag       As Boolean  '時間制限存在ﾌﾗｸﾞ
        Dim lblnApcFlag             As Boolean  'APC設定存在ﾌﾗｸﾞ
        Dim lblnCurrentFlag         As Boolean  '現工程確認ﾌﾗｸﾞ
        Dim lblnWpRestrictFlag      As Boolean  '処理号機確認ﾌﾗｸﾞ
        Dim lstApcTeosGroup()       As String   '削除されたAPC TEOSグループ番号保持
        Dim nApcTeosDataCount       As Integer  'APC TEOS用データ数
        Dim lstrTeosPrismAPCGroup() As String   '削除されたTEOS PrismAPCグループ番号保持
        Dim llngTeosPrismApcCnt     As Integer  'APC TEOS用データ数
        Dim lblnReportPointFlag     As Boolean
        Dim lstRecpSelApc()         As String   'ﾚｼﾋﾟ選択APC(削除用)
        Dim llngRecpSelApcCnt       As Integer  'ﾚｼﾋﾟ選択APCｶｳﾝﾄ(削除用)
        Dim lblnIcchi               As Boolean  'ﾚｼﾋﾟ選択APCﾃﾞｰﾀ格納判定用
        Dim strTmp                  As String
        
        Try
            'NSYS クリック処理中は処理を抜ける
            If Me.ActiveControl Is sender Then
                If Me.buttonProcessing = True Then
                    Return
                End If
                Me.buttonProcessing = True
            End If
            
            ReDim lstApcTeosGroup(1)
            
            With vsfFlowList0
                '@選択範囲の取得
                llngRowStart = .Selection.TopRow
                llngColStart = .Selection.LeftCol
                llngRowEnd = .Selection.BottomRow
                llngColEnd = .Selection.RightCol

                '@範囲外の場合、処理中止
                If llngRowEnd > .Rows.Count - 1 Then
                    llngRowEnd = .Rows.Count - 1
                End If
                
                '@現工程/作業待ちを含んで編集可能行を全て削除は不可ﾁｪｯｸ-----------------------------↓
                '@削除数分ﾙｰﾌﾟ
                lblnCurrentFlag = False
                lblnReportPointFlag = False
                For llngCnt = llngRowStart To llngRowEnd
                    '@現工程/作業待ち
                    If .GetData(llngCnt, CPlngvsfFlowState) = CMstrState4 Then
                        lblnCurrentFlag = True
                    End If
                    

                    '@実績報告工程を含んでいる場合削除NG
                    If .GetData(llngCnt, CPlngvsfFlowReportPointFlag) <> vbNullString Then
                        lblnReportPointFlag = True
                    End If
                    
                Next
                
                '@現工程/作業待ちを含んでいる場合
                If lblnCurrentFlag = True Then
                    '@削除
                    If llngRowEnd = .Rows.Count - 1 Then
                        '@現工程/作業待ちを含んで編集可能行を全て削除は不可
                        '@表示ﾒｯｾｰｼﾞ変換
                        pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar008K, Me.Text)
                        '@"<TRM8KW>$$現在工程作業待ちを含む全ての工程を削除することはできません。"
                        Call publngMsgBox(pstrDMsg, vbExclamation, Me.Text, True, 16, False)
                        
                        Erase lstApcTeosGroup

                        Exit Sub
                    End If
                End If
                
                '@実績報告工程を含んでいる場合削除NG
                If lblnReportPointFlag = True Then
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgWar0126, CMstrRowDelAction, Me.Text)
                    '@"<TRM126W>$$実績報告工程(赤字工程)を[%1]すると在庫の差異が発生します。"
                    '　　　　　　 [%1]する場合は必ず生産管理担当者と調整のうえ実行してください。"
                    llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                    
                    '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                    If llngMsgAns = vbNo Then       '「いいえ」を選択(削除処理ｷｬﾝｾﾙ)
                        Exit Sub
                    End If
                End If
                '@現工程/作業待ちを含んで編集可能行を全て削除は不可ﾁｪｯｸ-----------------------------↑

                
                '@削除数の取得
                llngDelCnt = llngRowEnd - llngRowStart + 1
                
                '@戻り工程設定ﾌﾗｸﾞfalse
                lblnFlg = False
                
                '@ﾘﾜｰｸ・特殊ﾙｰﾄ・入替可能工程・代替工程設定(設定、非設定)ﾌﾗｸﾞをfalseに
                lblnSpFlag = False
                lblnNotSpFlag = False
                lblnNotReturnFlag = False
                lblnWpRestrictFlag = False
                
                '@削除数分ﾙｰﾌﾟ
                For llngCnt = llngRowStart To llngRowEnd
                    
                    '@編集可能工程の場合
                    If .GetData(llngCnt, CPlngvsfFlowPermit) = CMstrPermit1 Or _
                       .GetData(llngCnt, CPlngvsfFlowPermit) = CMstrPermit4 Then
                        
                        '@入替設定
                        If .GetData(llngCnt, CPlngvsfFlowSwapIndictor) <> vbNullString Then
                            lblnSwapFlag = True
                            lblnFlg = True
                        End If
                        
                        '@代替設定
                        If .GetData(llngCnt, CPlngvsfFlowAltSet) <> vbNullString Then
                            lblnAltSetFlag = True
                            lblnFlg = True
                        End If
                        
                        '@時間制限
                         If .GetData(llngCnt, CPlngvsfFlowTimeLimit) <> vbNullString Then
                            lblnTimeLimitFlag = True
                            lblnFlg = True
                        End If
                        
                        '@APC設定
                        If .GetData(llngCnt, CPlngvsfFlowApc) <> vbNullString Then
                            lblnApcFlag = True
                            lblnFlg = True
                        End If
                        
                        '@処理号機設定
                        If .GetData(llngCnt, CPlngvsfFlowWpRestrict) <> vbNullString Then
                            lblnWpRestrictFlag = True
                            lblnFlg = True
                        End If
                        
                        'APC TEOSが設定されている工程が削除された
                        If .GetData(llngCnt, CPlngvsfFlowApcTeosGroupNo) <> vbNullString Then
                            '削除されたグループ番号を保持
                            nApcTeosDataCount = UBound(lstApcTeosGroup)
            
                            '要素数を拡張
                            ReDim Preserve lstApcTeosGroup(nApcTeosDataCount + 1)
                            
                            'データ格納
                            lstApcTeosGroup(nApcTeosDataCount -1) = .GetData(llngCnt, CPlngvsfFlowApcTeosGroupNo)
                        Else
                            '削除された行に対してスキップフラグ＝ＯＮ処理
                            Call UpdateApcTeosSkip(vsfFlowList0, llngCnt)
                        End If
                        
                        '@TEOS PrismAPCの行が削除された場合
                        If .GetData(llngCnt, CPlngvsfFlowTeosPrismAPC) <> vbNullString Then
                                                                                
                            '@削除ｸﾞﾙｰﾌﾟ格納
                            ReDim Preserve lstrTeosPrismAPCGroup(llngTeosPrismApcCnt)
                            lstrTeosPrismAPCGroup(llngTeosPrismApcCnt) = _
                                Mid$(.GetData(llngCnt, CPlngvsfFlowTeosPrismAPC), CMlngMidStart1, CMlngMidGetStringNo3)
                            
                            '@削除されたｸﾞﾙｰﾌﾟ№を格納
                            llngTeosPrismApcCnt = llngTeosPrismApcCnt + 1

                        End If
                        
        '@↓2018/03/15 (Thu) 14:41:18 T.Oide **************************************************
                        '@ﾚｼﾋﾟ選択APCの行か削除された場合
                        If .GetData(llngCnt, CPlngvsfFlowRecpSelApc) <> vbNullString Then
                            
                            strTmp = Mid$(.GetData(llngCnt, CPlngvsfFlowRecpSelApc), 1, 6)
                            
                            '@既に格納済ではないか確認
                            lblnIcchi = False
                            For llngCnt3 = 1 To llngRecpSelApcCnt
                                '@「FF-001」が一致しているか
                                If lstRecpSelApc(llngCnt3) = strTmp Then
                                    lblnIcchi = True
                                End If
                            Next
                            
                            '@未登録であれば追加
                            If lblnIcchi = False Then
                                '@削除されたｸﾞﾙｰﾌﾟ№を格納
                                llngRecpSelApcCnt = llngRecpSelApcCnt + 1
                                
                                '@削除ｸﾞﾙｰﾌﾟ格納
                                ReDim Preserve lstRecpSelApc(llngRecpSelApcCnt)
                                lstRecpSelApc(llngRecpSelApcCnt) = strTmp
                                
                                lblnFlg = True      '@注意メッセージ表示用
                            End If
                        End If
        '@↑2018/03/15 (Thu) 14:41:18 T.Oide **************************************************
                    
                    End If
                Next
                
                If lblnFlg = True Then
                
                    '@表示ﾒｯｾｰｼﾞ変換
                    pstrDMsg = pubstrMsgReplace_Set(CPstrMsgInf005L)

                    '@"<TRM5LI>$$行削除を実行すます。
                    '@$該当行に代替、入替、時間制限、APC、処理号機設定が設定済みの場合は
                    '@$設定がクリアされますがよろしいですか？"
                    llngMsgAns = publngMsgBox(pstrDMsg & vbCrLf, vbNo, Me.Text, True, 16, False)
                    '@ﾒｯｾｰｼﾞﾎﾞｯｸｽの戻り値判定
                    If llngMsgAns = vbNo Then       '「いいえ」を選択(削除処理ｷｬﾝｾﾙ)
                    
                        Erase lstApcTeosGroup

                        Exit Sub
                    End If
                
                End If
                

                '@選択された行数分、個別処理設定配列/代替を削除
                For llngCnt = llngRowStart To llngRowEnd
                    
                    '@編集可能工程の場合
                    If .GetData(llngCnt, CPlngvsfFlowPermit) = CMstrPermit1 Or _
                            .GetData(llngCnt, CPlngvsfFlowPermit) = CMstrPermit4 Then

                        '@処理条件が個別処理設定の場合
                        If .GetData(llngCnt, CPlngvsfFlowConditionOne) <> vbNullString Then
                            '@個別処理設定配列を削除
                            Call prvLotCondDetailList_Del(.GetData(llngCnt, CPlngvsfFlowAbsNo))
                            
                            '@ﾌﾗｸﾞを初期化設定
                            .SetData(llngCnt, CPlngvsfFlowLotRecipeFlag, CMstrFlgOff)  'ﾛｯﾄ個別ﾚｼﾋﾟ設定ﾌﾗｸﾞｵﾌ
                            .SetData(llngCnt, CPlngvsfFlowWFRecipeFlag, CMstrFlgOff)   'WF個別ﾚｼﾋﾟ設定ﾌﾗｸﾞｵﾌ
                            .SetData(llngCnt, CPlngvsfFlowRecipeChgFlg, CMstrFlgOff)   '工順ﾚｼﾋﾟ変更ﾌﾗｸﾞｵﾌ
                            .SetData(llngCnt, CPlngvsfFlowWorkCondition, vbNullString) '作業条件ｸﾘｱ
                        End If
                              
                              
                        If lblnAltSetFlag = True Then
                            '@代替が設定されていたら
                            If .GetData(llngCnt, CPlngvsfFlowAltSet) <> vbNullString Then
                                
                                '@検索するﾎﾟｲﾝﾀを取得
                                lstrAltPointer = Strings.Left$(.GetData(llngCnt, CPlngvsfFlowAltSet), CMlngLeftGetStringNo5)
                                
                                '@ﾌﾛｰﾘｽﾄを検索
                                For llngRow = 1 To .Rows.Count - 1
                                    '@一致する代替ﾎﾟｲﾝﾀがあったら
                                    If InStr(.GetData(llngRow, CPlngvsfFlowAltSet), lstrAltPointer) > 0 Then
                                        '@代替工程を削除
                                        .SetData(llngRow, CPlngvsfFlowAltSet, vbNullString)
                                        .SetData(llngRow, CPlngvsfFlowAltPointer, vbNullString)
                                        .SetData(llngRow, CPlngvsfFlowAltStartFlag, CMstrFlgOff)
                                        .SetData(llngRow, CPlngvsfFlowAltEndFlag, CMstrFlgOff)
                                        '@ﾊﾞｯｸｶﾗｰ変更処理
                                        Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                        Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowAltSet)
                                        cellRange.Style = newStyle
                                        .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                                    End If
                                Next
                            End If
                        End If
                        
                        If lblnSwapFlag = True Then
                        
                            '@入替工程を削除
                            If .GetData(llngCnt, CPlngvsfFlowSwapIndictor) <> vbNullString Then
                                '@削除対象文字列を取得
                                lstrSearchString = .GetData(llngCnt, CPlngvsfFlowSwapIndictor)
                                
                                '@全行検索
                                For llngRow = 1 To .Rows.Count - 1
                                    '@対象文字が一致した場合
                                    If .GetData(llngRow, CPlngvsfFlowSwapIndictor) = lstrSearchString Then
                                        '@入替え設定の削除
                                        .SetData(llngRow, CPlngvsfFlowSwapIndictor, vbNullString)
                                        .SetData(llngRow, CPlngvsfFlowSwapIndictorCopy, vbNullString)
                                        '@ﾊﾞｯｸｶﾗｰ変更処理
                                        Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                        newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                        Dim cellRange As CellRange = .GetCellRange(llngRow, CPlngvsfFlowSwapIndictor)
                                        cellRange.Style = newStyle
                                        .SetData(llngRow, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                                    End If
                                Next
                            End If
                        End If
                        
                        '@時間制限の削除
                        If lblnTimeLimitFlag = True Then
                            
                            '@時間制限が設定済みの場合
                            If .GetData(llngCnt, CPlngvsfFlowTimeLimit) <> vbNullString Then
                                '@現在のｾﾙの値を配列に格納
                                lstrAry = Split(.GetData(llngCnt, CPlngvsfFlowTimeLimit), CMstrComma)
                
                                '@配列数分、以下の処理を繰り返す
                                For llngAryCount = 0 To UBound(lstrAry)
                                    '@時間制限番号を取得
                                    lstrSearchNo = Mid$(lstrAry(llngAryCount), InStr(1, lstrAry(llngAryCount), CMstrHyphen) + 1, CMlngMidGetStringNo3)
                                    '@時間制限表示ｸﾘｱ
                                    Call Me.pubTimeLimitDisp_Del(lstrSearchNo)
                                Next
                            End If
                    
                            '@時間制限ﾎﾞﾀﾝの使用許可
                            Call prvcmdTimeLimitEnabled_Set()
                            
                        End If
                        
                        '@APC設定の削除
                        If lblnApcFlag = True Then
                        
                            '@APC設定が設定済みの場合
                            If .GetData(llngCnt, CPlngvsfFlowApc) <> vbNullString Then
                                '@APC設定を削除
                                Call pubApc_Del(.GetData(llngCnt, CPlngvsfFlowApc))
                            End If
                        End If
                        
                        '@処理号機設定
                        If lblnWpRestrictFlag = True Then
                        
                            '@処理号機設定の削除
                            '@処理号機設定が設定済みの場合
                            If .GetData(llngCnt, CPlngvsfFlowWpRestrict) <> vbNullString Then
                                '@関連ﾃﾞｰﾀ削除
                                Call prvWpRestrictDisp_Del(llngCnt)
                            End If
                        End If
                        
                    End If
                Next
                
                '@配列の初期化
                Erase lstrAry
                .Redraw = False    
                '@選択された行数分、行削除
                For llngCnt = llngRowStart To llngRowEnd
                    If .GetData(llngRowStart, CPlngvsfFlowPermit) = CMstrPermit1 Or _
                            .GetData(llngRowStart, CPlngvsfFlowPermit) = CMstrPermit4 Then
                        .RemoveItem(llngRowStart)
                    End If
                Next
                .Redraw = True   
                '@Noの再ｾｯﾄ
                Call prvNo_Set(vsfFlowList0)
                
                '@列幅自動調整
                .AutoSizeCols(.Cols.Fixed, .Cols.Count - 1, 6)
                
                '@全行削除された場合
                If .Rows.Count = 1 Then
                
                    '@設定画面を非表示にする
                    Call cmdSetPanel_Click(cmdSetPanel,New EventArgs)
                    
                    '@ﾎﾞﾀﾝ制御
                    cmdEdit.Enabled = False
                    cmdDel.Enabled = False
                End If
                
                '@範囲選択解除処理
                If .Rows.Count - 1 >= llngRowStart Then
                    '@削除の範囲指定の先頭行が最終行以下の場合
                    '@編集可能先頭行へﾌｫｰｶｽをｾｯﾄ
                    .Select(llngRowStart, llngColStart)
                Else
                    '@削除の範囲指定の先頭行が最終行以上の場合
                    If .Rows.Count = llngRowStart Then
                        '@最終行を削除した場合
                        '@現在の最終行にﾌｫｰｶｽをｾｯﾄ
                        .Select(.Rows.Count - 1, llngColStart)
                    Else
                        '@最終行以外を削除した場合
                        '@ﾀｲﾄﾙ選択状態とする
                        .Select(CMlngvsfListRowTitle, llngColStart)
                    End If
                End If
                
                '削除されたAPC TEOSグループと同じ番号を持った工程の情報を消す
                Call ResetApcTeosData(vsfFlowList0, lstApcTeosGroup)
                

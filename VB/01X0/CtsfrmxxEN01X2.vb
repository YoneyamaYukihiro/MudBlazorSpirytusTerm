            With vsfFlowList1
                '@選択範囲の取得
                llngRowStart = .Selection.TopRow
                llngColStart = .Selection.LeftCol
                llngRowEnd = .Selection.BottomRow
                llngColEnd = .Selection.RightCol

                '@見出しも含め選択された場合
                If llngRowStart = 0 Then
                    llngRowStart = 1
                End If
                
                ptypCopyCondDetailList.lngProcCondDetailCnt = 0
                If ptypCopyCondDetailList.typProcCondDetail Is Nothing Then
                    ptypCopyCondDetailList.typProcCondDetail = New List(Of ProcCondDetail)
                Else
                    ptypCopyCondDetailList.typProcCondDetail.Clear
                End If
                mstrOpIdCopy = vbNullString
                mstrStepIdCopy = vbNullString
                mstrConditionCopy = vbNullString
                mstrConditionCopyVer = vbNullString
                mstrConditionCopyValid = vbNullString
                mstrConditionOne = vbNullString
                mstrLotRecipeFlag = vbNullString
                mstrWFRecipeFlag = vbNullString
                mstrRecipeChgFlg = vbNullString
                
                '@ｺﾋﾟｰ配列再定義
                mtypCopyFlowList.lngLotProcFlowCnt = llngRowEnd - llngRowStart + 1
                mtypCopyFlowList.typLotProcFlow = New List(Of FlowList)(mtypCopyFlowList.lngLotProcFlowCnt)

                '@ｶｳﾝﾀ初期化
                llngAryCount = 0
                
                '@選択範囲分、以下の処理を繰り返す
                For llngRow = llngRowStart To llngRowEnd
                    Dim typLotProcFlowTmp As New FlowList
                    '@ｺﾋﾟｰ配列に代入
                    typLotProcFlowTmp.strAbsNo = .GetData(llngRow, CPlngvsfFlowAbsNo)                          '絶対工順番号
                    typLotProcFlowTmp.strOpID = .GetData(llngRow, CPlngvsfFlowOpID)                            '大工程名
                    typLotProcFlowTmp.strStepID = .GetData(llngRow, CPlngvsfFlowStepID)                        '小工程名
                    typLotProcFlowTmp.strConditionId = .GetData(llngRow, CPlngvsfFlowConditionID)              '処理条件ｾｯﾄID
                    typLotProcFlowTmp.strConditionVersion = .GetData(llngRow, CPlngvsfFlowConditionVer)        '処理条件Ver
                    
                    '@ﾕｰｻﾞﾌﾟﾛｾｽの場合は個別処理条件のｺﾋﾟｰはしない
                    '@ﾛｯﾄ状態が「投入待ち」の場合は個別処理条件のｺﾋﾟｰはしない
                    '@ﾛｯﾄ状態が空白の場合（工順なし）は個別処理条件のｺﾋﾟｰはしない
                    If pstrEN01X0KindFlag = "2" Or lblCurrentStatus.Text = CPstrWaitThrowSt Or lblCurrentStatus.Text = vbNullString Then
                        '@個別処理条件はｺﾋﾟｰしない
                        '@特に枚葉はダメだぞ、投入前なのでｽﾛｯﾄﾎﾟｼﾞｼｮﾝが解らん。
                        '@ﾛｯﾄﾚｼﾋﾟはOKだけど、冨谷様より個別設定はｺﾋﾟｰの対象外
                        typLotProcFlowTmp.strConditionOne = vbNullString
                        typLotProcFlowTmp.strProcChangeRecipeFlag = "0"     '工順変更ﾌﾗｸﾞ
                        typLotProcFlowTmp.strLotRecipeFlag = "0"            'ﾛｯﾄﾚｼﾋﾟﾌﾗｸﾞ
                        typLotProcFlowTmp.strWfRecipeFlag = "0"             '枚葉ﾚｼﾋﾟﾌﾗｸﾞ
                        
                    Else
                        typLotProcFlowTmp.strConditionOne = .GetData(llngRow, CPlngvsfFlowConditionOne)        '処理条件（個別）
                    
                        '@ﾌﾗｸﾞ格納
                        '@枚葉ﾚｼﾋﾟﾌﾗｸﾞのみ、WF選択条件が設定されるとｺﾝﾄﾛｰﾙｻｰﾊﾞｰでWFﾚｼﾋﾟﾌﾗｸﾞが立つ場合がある。
                        typLotProcFlowTmp.strProcChangeRecipeFlag = .GetData(llngRow, CPlngvsfFlowRecipeChgFlg)    '工順変更ﾌﾗｸﾞ
                        
                        If .GetData(llngRow, CPlngvsfFlowRecipeChgFlg) = "1" Then
                            typLotProcFlowTmp.strLotRecipeFlag = .GetData(llngRow, CPlngvsfFlowLotRecipeFlag)      'ﾛｯﾄﾚｼﾋﾟﾌﾗｸﾞ
                            typLotProcFlowTmp.strWfRecipeFlag = .GetData(llngRow, CPlngvsfFlowWFRecipeFlag)        '枚葉ﾚｼﾋﾟﾌﾗｸﾞ
                        Else
                            typLotProcFlowTmp.strLotRecipeFlag = "0"      'ﾛｯﾄﾚｼﾋﾟﾌﾗｸﾞ
                            typLotProcFlowTmp.strWfRecipeFlag = "0"       '枚葉ﾚｼﾋﾟﾌﾗｸﾞ
                        End If
                    
                    End If
                    
                    '@ｺﾋﾟｰ元が特殊ﾛｯﾄの場合
                    If ptypEN01X7.strProcFlag = "1" Then
                        typLotProcFlowTmp.strReworkRouteID = vbNullString           'ﾘﾜｰｸﾙｰﾄID
                        typLotProcFlowTmp.strSpecialRouteID = vbNullString          '特殊ﾙｰﾄID
                    Else
                        typLotProcFlowTmp.strReworkRouteID = .GetData(llngRow, CPlngvsfFlowReworkRouteID)      'ﾘﾜｰｸﾙｰﾄID
                        typLotProcFlowTmp.strSpecialRouteID = .GetData(llngRow, CPlngvsfFlowSPRouteID)         '特殊ﾙｰﾄID
                    End If
                    
                    typLotProcFlowTmp.strSelectConditionID = .GetData(llngRow, CPlngvsfFlowSelectConditionID)  'WF選択条件ｾｯﾄID
                    typLotProcFlowTmp.strCollectionID = .GetData(llngRow, CPlngvsfFlowCollectionID)            '収集項目ｾｯﾄID
                    typLotProcFlowTmp.strCollectionVersion = .GetData(llngRow, CPlngvsfFlowCollectionVer)      '収集項目Ver
                    typLotProcFlowTmp.strLotScrapSetID = .GetData(llngRow, CPlngvsfFlowLotScrapSetId)          '不良項目ｾｯﾄID
                    typLotProcFlowTmp.strReworkReturnOpID = vbNullString                                                'ﾘﾜｰｸﾙｰﾄ戻り大工程
                    typLotProcFlowTmp.strReworkReturnStepID = vbNullString                                              'ﾘﾜｰｸﾙｰﾄ戻り小工程
                    typLotProcFlowTmp.strSpecialReturnOpID = vbNullString                                               '特殊ﾙｰﾄ戻り大工程
                    typLotProcFlowTmp.strSpecialReturnStepID = vbNullString                                             '特殊ﾙｰﾄ戻り小工程
                    typLotProcFlowTmp.strSwapIndicator = .GetData(llngRow, CPlngvsfFlowSwapIndictor)           '入替可能工程
                    typLotProcFlowTmp.strAltPointer = vbNullString                                                      '代替工程
                    typLotProcFlowTmp.strAltStartFlag = "0"                                                             '代替工程
                    typLotProcFlowTmp.strAltEndFlag = "0"                                                               '代替工程
                    
                    '@時間制限ｶｳﾝﾀ
                    typLotProcFlowTmp.lngTimeOrderCnt = 0                                                               '時間制限ﾘｽﾄｶｳﾝﾄ
                    typLotProcFlowTmp.strRestrictFlag = "0"                                                             '時間制限ﾌﾗｸﾞ
                    
                    typLotProcFlowTmp.strSFlag = .GetData(llngRow, CPlngvsfFlowSFlag)                          '特殊特性ﾌﾗｸﾞ
                    typLotProcFlowTmp.strEntryID = .GetData(llngRow, CPlngvsfFlowEntryID)                      'ｴﾝﾄﾘID

                    typLotProcFlowTmp.strWorkCondition = .GetData(llngRow, CPlngvsfFlowWorkCondition)          '作業条件
                    typLotProcFlowTmp.strCommitFlag = .GetData(llngRow, CPlngvsfFlowCommitFlag)                '号機指定
                    typLotProcFlowTmp.strJudgeSkipFlag = .GetData(llngRow, CPlngvsfFlowJudgeSkipFlag)          'SPC判定ｽｷｯﾌﾟﾌﾗｸﾞ( 0: SKIP不可、1:SKIP可）
                    typLotProcFlowTmp.strApcSkipFlag = vbNullString                                                     'F/B適用外
                    typLotProcFlowTmp.strApcCalcSkipFlag = vbNullString                                                 'F/B計算除外
                    
                    '@編集ﾌﾗｸﾞ
                    typLotProcFlowTmp.strState = CMstrState8        '状態（追加挿入）
                    typLotProcFlowTmp.strPermit = CMstrPermit1      '変更可否（変更可）
                    typLotProcFlowTmp.strChange = CMstrChange1      '変更区分（変更あり）
                    
                    '@Discon情報格納
                    typLotProcFlowTmp.strOpValid = .GetData(llngRow, CPlngvsfFlowOpValid)                      '大工程有効ﾌﾗｸﾞ
                    typLotProcFlowTmp.strStepValid = .GetData(llngRow, CPlngvsfFlowStepValid)                  '小工程有効ﾌﾗｸﾞ
                    typLotProcFlowTmp.strConditionValid = .GetData(llngRow, CPlngvsfFlowConditionValid)        '処理条件ｾｯﾄID有効ﾌﾗｸﾞ
                    typLotProcFlowTmp.strCollectionValid = .GetData(llngRow, CPlngvsfFlowCollectionValid)      '収集項目ｾｯﾄID有効ﾌﾗｸﾞ
                    typLotProcFlowTmp.strReworkRouteValid = .GetData(llngRow, CPlngvsfFlowReworkRouteValid)    'ﾘﾜｰｸﾙｰﾄID有効ﾌﾗｸﾞ
                    typLotProcFlowTmp.strSpecialRouteValid = .GetData(llngRow, CPlngvsfFlowSPRouteValid)       '特殊ﾙｰﾄID有効ﾌﾗｸﾞ
                    
                    typLotProcFlowTmp.strCdenClass = .GetData(llngRow, CPlngvsfFlowCdenClass)                  'CDEN_CLASS
                    typLotProcFlowTmp.strTpalClass = .GetData(llngRow, CPlngvsfFlowTpalClass)                  'TPAL設定
                    typLotProcFlowTmp.strCarrierCategoryId = .GetData(llngRow, CPlngvsfFlowCarrierCategoryID)  'ｷｬﾘｱｶﾃｺﾞﾘ
                    typLotProcFlowTmp.strGrbClass = .GetData(llngRow, CPlngvsfFlowGrbClass)                    'GRB限定工程設定

                    '@個別処理条件格納
                    If typLotProcFlowTmp.strConditionOne <> vbNullString Then
                        '@ｲﾝﾃﾞｯｸｽ初期化
                        llngIndex = -1
                        
                        For llngCnt2 = 0 To ptypCondDetailListCp.lngProcCondDetailCnt -1
                            '@ｺﾋﾟｰ元のSeq_Noと実構造体の
                            If typLotProcFlowTmp.strAbsNo = ptypCondDetailListCp.typProcCondDetail(llngCnt2).strAbsNo Then
                                llngIndex = llngCnt2
                                Exit For
                            End If
                        Next
                        '@ｲﾝﾃﾞｯｸｽ存在
                        If llngIndex <> -1 Then
                            With ptypCopyCondDetailList
                                '@個別処理設定配列を再定義
                                .lngProcCondDetailCnt = .lngProcCondDetailCnt + 1
                            End With
                        
                            '@個別処理条件格納処理
                            lblnAns = pubblnConditionOneCopy_Set(llngRow)
                            '@ﾚｼﾋﾟIDが未設定
                            If lblnAns = True Then
                                '@「＠レシピ」を挿入
                                typLotProcFlowTmp.strConditionOne = CPstrRecpNot
                            End If
                        Else
                            '@ﾃﾞｰﾀ例外
                             typLotProcFlowTmp.strConditionOne = CPstrRecpNot
                        
                        End If
                    End If

                    mtypCopyFlowList.typLotProcFlow.Add(typLotProcFlowTmp)

                    '@ｶｳﾝﾄｱｯﾌﾟ
                    llngAryCount = llngAryCount + 1
                Next
            
            End With

            '@行ｺﾋﾟｰﾌﾗｸﾞｵﾝ
            mblnClipCopy = True

            Exit Sub

        Catch ex As Exception

            '@ｴﾗｰ情報設定(strMenuKey：機能ID/strProcName：関数名/strErrMessage：ｴﾗｰﾒｯｾｰｼﾞ)
            With ptypOnErrorInfo
                .strMenuKey = CMstrLocalMenuKey             '機能ID
                .strProcName = "mnu11_Click"
                .strErrMessage = vbNullString               'ｴﾗｰﾒｯｾｰｼﾞ
            End With

            '@共通ｴﾗｰ処理
            Call pubOnError_Proc()

        End Try
    End Sub


    '関数名：vsfFlowList_AfterEdit
    '機　能：編集後処理
    '引　数：Row：行
    '　　　：Col：列
    '戻り値：なし
    '作成日：2006/05/19 (Fri) 12:42:29 N.Kasai
    '更新日：2006/05/19 (Fri) 12:42:29
    '備　考：編集後、ﾊﾞｯｸｶﾗｰとﾘｻｲｽﾞを設定
    Private Sub vsfFlowList_AfterEdit(ByVal sender As Object, ByVal e As RowColEventArgs) Handles vsfFlowList0.AfterEdit,vsfFlowList1.AfterEdit
        Dim lvsfFlowList    As C1FlexGrid   'NSYS イベント元グリッド

        Try
            lvsfFlowList = CType(sender, C1FlexGrid)

            'NSYS データ行がない場合は処理を抜ける
            If vsfFlowList0.Rows.Count <= sender.Rows.Fixed Then
                Return
            End If
            
            '@ｺﾋﾟｰ元ｸﾞﾘｯﾄﾞの場合は処理しない。
            If lvsfFlowList Is vsfFlowList1 Then
                Exit Sub
            End If
            
            '@ﾘﾜｰｸﾙｰﾄID
            '@特殊ﾙｰﾄID
            '@ﾘﾜｰｸ戻り大工程
            '@ﾘﾜｰｸ戻り小工程
            '@特殊ﾙｰﾄ戻り大工程
            '@特殊ﾙｰﾄ戻り小工程
            
            With lvsfFlowList
                
                Select Case .Col
                    
                    '@ﾘﾜｰｸﾙｰﾄID
                    Case CPlngvsfFlowReworkRouteID
                    
                        '@選択したﾘﾜｰｸﾙｰﾄIDが存在せず,空欄となった場合には,元の情報を表示
                        If .GetData(.Row, .Col) = vbNullString Then
                            .SetData(.Row, .Col, mstrTempChangestring)
                        End If
                        
                        '@空行が選択された場合はﾘﾜｰｸ戻り大工程、小工程をｸﾘｱ
                        If .GetData(.Row, .Col) = CPstrComboBrank Then
                            
                            '@ｺﾝﾎﾞ用空白をNullへ変更
                            .SetData(.Row, .Col, vbNullString)
                            
                            '@戻り大工程
                            If .GetData(.Row, CPlngvsfFlowReworkReturnOpID) <> vbNullString Then
                                '@戻り大工程をｸﾘｱ
                                .SetData(.Row, CPlngvsfFlowReworkReturnOpID, vbNullString)
                                '@ﾊﾞｯｸｶﾗｰを変更
                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                Dim cellRange As CellRange = .GetCellRange(.Row, CPlngvsfFlowReworkReturnOpID)
                                cellRange.Style = newStyle
                                .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）
                            End If
                            
                            '@戻り小工程
                            If .GetData(.Row, CPlngvsfFlowReworkReturnStepID) <> vbNullString Then
                                ''@戻り小工程をｸﾘｱ
                                .SetData(.Row, CPlngvsfFlowReworkReturnStepID, vbNullString)
                                '@ﾊﾞｯｸｶﾗｰを変更
                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                Dim cellRange As CellRange = .GetCellRange(.Row, CPlngvsfFlowReworkReturnStepID)
                                cellRange.Style = newStyle
                                .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）

                            End If
                            
                        End If
                        
                        '@列幅自動調整
                        .AutoSizeCol(.Col, 6)
                        
                        '@退避領域と同じ場合には,色を変えない
                        If .GetData(.Row, .Col) <> mstrTempChangestring Then
                            '@ﾊﾞｯｸｶﾗｰを変更
                            Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                            newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                            Dim cellRange As CellRange = .GetCellRange(.Row, .Col)
                            cellRange.Style = newStyle  '水色
                            .SetData(.Row, CPlngvsfFlowChange, CMstrChange1)         '変更区分（変更あり）

                        Else
                            '@ﾊﾞｯｸｶﾗｰが"水色"か
                            If .GetCellRange(.Row, .Col).StyleDisplay.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue) Then
                                '@ﾊﾞｯｸｶﾗｰそのまま
                                Dim newStyle As CellStyle = .Styles.Add("CustomStyle_BackColor_CMlngBackColorSBlue")
                                newStyle.BackColor = ColorTranslator.FromWin32(CMlngBackColorSBlue)
                                Dim cellRange As CellRange = .GetCellRange(.Row, .Col)
                                cellRange.Style = newStyle
                            Else

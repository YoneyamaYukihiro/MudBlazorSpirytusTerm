@page "/maintenance-record"
@inject MaintenanceRecordService Svc

<PageTitle>SPIRYTUS - 装置メンテナンス記録票一覧 (EN01Z0)</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">装置メンテナンス記録票一覧 (EN01Z0)</MudText>
<div class="page-wrapper">

<MudPaper Class="pa-3 mb-2" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_fromDate" Label="開始日" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="8" Placeholder="YYYYMMDD" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_toDate" Label="終了日" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="8" Placeholder="YYYYMMDD" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_wpId" Label="装置ID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="20" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                       Disabled="@_loading" OnClick="SearchAsync">
                @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>検索中...</span> }
                else { <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="mr-1" /><span>検索</span> }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = string.Empty">@_error</MudAlert>
}
@if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" /> }

@if (_records is not null)
{
    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">保全記録</MudText>
    <MudPaper Class="pa-2 mb-2" Elevation="1">
        <MudDataGrid T="MaintenanceRecordService.RecordItem" Items="_records" Dense="true" Hover="true" ReadOnly="true" Striped="true">
            <Columns>
                <PropertyColumn Property="x => x.RecordId"     Title="記録ID"     />
                <PropertyColumn Property="x => x.WpId"         Title="装置ID"     />
                <PropertyColumn Property="x => x.WpName"       Title="装置名"     />
                <PropertyColumn Property="x => x.CategoryName" Title="カテゴリ"   />
                <PropertyColumn Property="x => x.RecordDate"   Title="記録日"     />
                <PropertyColumn Property="x => x.EmpName"      Title="担当者"     />
                <PropertyColumn Property="x => x.Status"       Title="状態"       />
                <PropertyColumn Property="x => x.Comments"     Title="コメント"   />
            </Columns>
        </MudDataGrid>
    </MudPaper>
}

</div>

@code {
    private string _fromDate = "";
    private string _toDate   = "";
    private string _wpId     = "";
    private string _error    = "";
    private bool   _loading;
    private IReadOnlyList<MaintenanceRecordService.RecordItem>? _records;

    private async Task SearchAsync()
    {
        _loading = true; _error = ""; StateHasChanged();
        try {
            var r = await Svc.GetPreserveListAsync(_fromDate.Trim(), _toDate.Trim(), _wpId.Trim());
            if (!r.IsSuccess) { _error = r.ErrorMessage; _records = null; return; }
            _records = r.Items;
        } finally { _loading = false; }
    }
}

@page "/lot-divide"
@inject LotDivideService DivideSvc
@inject ISnackbar Snackbar
@using static MudBlazorSpirytusTerm.Services.LotDivideService

<PageTitle>SPIRYTUS - ロット分割 (EN0160)</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" />
}

<MudText Typo="Typo.h6" Class="mb-3">ロット分割 (EN0160)</MudText>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => { _errorMessage = string.Empty; _errorCode = string.Empty; }">
        @if (!string.IsNullOrEmpty(_errorCode))
        {
            <b>[@_errorCode]</b><span> </span>
        }
        @_errorMessage
    </MudAlert>
}

@* ────── キャリアID入力 ────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="12" sm="4" md="3">
            <MudTextField T="string"
                          Value="@_carrierId"
                          ValueChanged="@((string v) => _carrierId = (v ?? "").ToUpperInvariant())"
                          Label="キャリアID (分割元)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="6"
                          Immediate="true"
                          HelperText="Enterキーで照合"
                          Error="@_carrierError"
                          OnKeyUp="OnCarrierKeyUp"
                          Disabled="_loading"
                          Style="font-family: monospace; letter-spacing: 0.1em; text-transform: uppercase;" />
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="FetchCarrierStateAsync"
                       Disabled="@(_loading || string.IsNullOrWhiteSpace(_carrierId))">
                @if (_loading && _carrierState is null)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    <span>照合中...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-1" Size="Size.Small" />
                    <span>照合</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ────── ロット情報 + 分割設定 ────── *@
@if (_carrierState is not null)
{
    <MudGrid Spacing="2" Class="mb-3">

        @* ── 分割元ロット情報 ── *@
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">分割元ロット情報</MudText>
                <MudGrid Spacing="1">
                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">ロットID</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body1"><b>@_carrierState.LotId</b></MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">機種</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_carrierState.PdId @(string.IsNullOrEmpty(_carrierState.PdName) ? "" : $"({_carrierState.PdName})")</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">ロット状態</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_carrierState.NowSt</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">ロット担当者</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_carrierState.EngEmpName</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">WF枚数</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_carrierState.WfNum 枚</MudText></MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        @* ── 分割設定カード ── *@
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">分割設定</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_grbClass"
                                      Label="GRB区分 (分割元)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="4"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_divideLotId"
                                      Label="分割先ロットID"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="20"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_divideGrbClass"
                                      Label="GRB区分 (分割先)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="4"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_empId"
                                      Label="作業者ID"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="10"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_comments"
                                      Label="コメント"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="2"
                                      MaxLength="128"
                                      Disabled="_loading" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ────── スロットマップ ────── *@
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">
            スロットマップ — 分割先に移動するWFを選択してください
        </MudText>
        <MudTable T="SlotRow" Items="_slotRows" Dense="true" Hover="true" Elevation="0">
            <HeaderContent>
                <MudTh>スロット</MudTh>
                <MudTh>WFID</MudTh>
                <MudTh>状態</MudTh>
                <MudTh>バッチID</MudTh>
                <MudTh>GRB</MudTh>
                <MudTh>分割先へ</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.SlotNo</MudTd>
                <MudTd>@context.WfId</MudTd>
                <MudTd>@context.WfClass</MudTd>
                <MudTd>@context.BatchId</MudTd>
                <MudTd>@context.Grb</MudTd>
                <MudTd>
                    <MudCheckBox T="bool" Value="@context.MoveToDivide"
                                 ValueChanged="@((bool v) => context.MoveToDivide = v)"
                                 Size="Size.Small" Disabled="_loading" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    @* ── ガイダンスメッセージ ── *@
    @if (!string.IsNullOrEmpty(_guidMsg))
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            [@_guidMsgCode] @_guidMsg
        </MudAlert>
    }

    @* ────── ボタン ────── *@
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.CallSplit"
                   OnClick="ExecuteDivideAsync"
                   Disabled="@(_loading || _carrierState is null)">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                <span>処理中...</span>
            }
            else
            {
                <span>分割確定</span>
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Clear"
                   OnClick="ClearAll" Disabled="_loading">
            クリア
        </MudButton>
    </MudStack>
}

@code {
    private string _carrierId      = "";
    private string _grbClass       = "";
    private string _divideLotId    = "";
    private string _divideGrbClass = "";
    private string _comments       = "";
    private string _empId          = "";
    private bool   _carrierError   = false;
    private bool   _loading        = false;
    private string _errorMessage   = "";
    private string _errorCode      = "";
    private string _guidMsg        = "";
    private string _guidMsgCode    = "";

    private CarrierStateResult? _carrierState = null;
    private List<SlotRow>       _slotRows     = [];

    private sealed class SlotRow
    {
        public string SlotNo       { get; init; } = "";
        public string WfId         { get; init; } = "";
        public string WfClass      { get; init; } = "";
        public string BatchId      { get; init; } = "";
        public string Grb          { get; init; } = "";
        public bool   MoveToDivide { get; set;  }
    }

    private async Task OnCarrierKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await FetchCarrierStateAsync();
    }

    private async Task FetchCarrierStateAsync()
    {
        _carrierError = false;
        if (string.IsNullOrWhiteSpace(_carrierId)) return;
        if (_carrierId.Length != 6) { _carrierError = true; return; }

        _loading      = true;
        _carrierState = null;
        _slotRows     = [];
        _guidMsg      = "";
        _guidMsgCode  = "";
        _errorMessage = "";
        _errorCode    = "";
        StateHasChanged();

        var result = await DivideSvc.GetCarrierStateAsync(_carrierId);
        _loading = false;

        if (!result.IsSuccess)
        {
            _errorMessage = result.ErrorMessage;
            _errorCode    = result.ErrorCode;
            return;
        }

        _carrierState = result;
        // スロットマップ初期化（実際は lot_.waferlist で取得）
        if (int.TryParse(result.WfNum, out var wfNum) && wfNum > 0)
        {
            _slotRows = Enumerable.Range(1, Math.Min(wfNum, 25))
                .Select(i => new SlotRow { SlotNo = i.ToString("D2"), WfId = $"WF{i:D3}" })
                .ToList();
        }
        Snackbar.Add($"ロット {result.LotId} を取得しました。", Severity.Info);
    }

    private async Task ExecuteDivideAsync()
    {
        if (_carrierState is null) return;
        _loading = true;
        _guidMsg = "";
        StateHasChanged();

        var wfMap = _slotRows
            .Where(r => r.MoveToDivide)
            .Select(r => new WfMapItem(r.WfId, r.SlotNo))
            .ToList();

        var req = new DivideRequest(
            LotId:          _carrierState.LotId,
            GrbClass:       _grbClass,
            DivideLotId:    _divideLotId,
            DivideGrbClass: _divideGrbClass,
            Comments:       _comments,
            EmpId:          _empId,
            LotLastUpdate:  _carrierState.LotLastUpdate,
            DivideWfMapList: wfMap);

        var result = await DivideSvc.ExecuteAsync(req);
        _loading = false;

        if (!result.IsSuccess)
        {
            _errorMessage = result.ErrorMessage;
            _errorCode    = result.ErrorCode;
            return;
        }

        _guidMsg     = result.GuidMsg;
        _guidMsgCode = result.GuidMsgCode;
        Snackbar.Add($"ロット分割を完了しました。 ロット: {_carrierState.LotId}", Severity.Success);
        ClearAll();
    }

    private void ClearAll()
    {
        _carrierId      = "";
        _carrierError   = false;
        _carrierState   = null;
        _slotRows       = [];
        _grbClass       = "";
        _divideLotId    = "";
        _divideGrbClass = "";
        _comments       = "";
        _empId          = "";
        _errorMessage   = "";
        _errorCode      = "";
        _guidMsg        = "";
        _guidMsgCode    = "";
    }
}

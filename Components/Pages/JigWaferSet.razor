@page "/jig-wafer-set"
@inject JigWaferSetService Svc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - 治具ウェハーセット (EN02F0)</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">治具ウェハーセット (EN02F0)</MudText>
<div class="page-wrapper">

<MudPaper Class="pa-3 mb-2" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_jjigId" Label="JJIG ID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="20" Immediate="true"
                          OnKeyDown="OnKeyDownAsync" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                       Disabled="@(!CanSearch || _loading)" OnClick="SearchAsync">
                @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>検索中...</span> }
                else { <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="mr-1" /><span>検索</span> }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = string.Empty">@_error</MudAlert>
}
@if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" /> }

@if (_info is not null)
{
    <MudPaper Class="pa-2 mb-2" Elevation="1">
        <MudGrid Spacing="1">
            <MudItem xs="6" sm="3"><MudText Typo="Typo.caption" Color="Color.Secondary">JJIG ID</MudText><MudText Typo="Typo.body2">@_info.JjigId</MudText></MudItem>
            <MudItem xs="6" sm="3"><MudText Typo="Typo.caption" Color="Color.Secondary">JJIG名</MudText><MudText Typo="Typo.body2">@_info.JjigName</MudText></MudItem>
            <MudItem xs="6" sm="3"><MudText Typo="Typo.caption" Color="Color.Secondary">状態</MudText><MudText Typo="Typo.body2">@_info.Status</MudText></MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-2 mb-2" Elevation="1">
        <MudDataGrid T="JigWaferSetService.SlotItem" Items="@(_info.Slots ?? [])" Dense="true" Hover="true" ReadOnly="true" Striped="true">
            <Columns>
                <PropertyColumn Property="x => x.SlotNo" Title="スロットNo" />
                <PropertyColumn Property="x => x.WfNo"   Title="WF No"      />
                <PropertyColumn Property="x => x.LotId"  Title="ロットID"   />
                <PropertyColumn Property="x => x.Status" Title="状態"        />
            </Columns>
        </MudDataGrid>
    </MudPaper>

    <MudPaper Class="pa-3" Elevation="1">
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_lotId" Label="ロットID" Variant="Variant.Outlined"
                              Margin="Margin.Dense" MaxLength="16" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_empId" Label="社員ID" Variant="Variant.Outlined"
                              Margin="Margin.Dense" MaxLength="10" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium"
                           Disabled="@(!CanSet || _setting)" OnClick="SetWaferAsync">
                    @if (_setting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>処理中...</span> }
                    else { <span>セット</span> }
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

</div>

@code {
    private string _jjigId = "";
    private string _lotId  = "";
    private string _empId  = "";
    private string _error  = "";
    private bool   _loading, _setting;
    private JigWaferSetService.JjigInfoResult? _info;

    private bool CanSearch => !string.IsNullOrWhiteSpace(_jjigId);
    private bool CanSet    => _info is not null && !string.IsNullOrWhiteSpace(_lotId) && !string.IsNullOrWhiteSpace(_empId);

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    { if (e.Key == "Enter" && CanSearch && !_loading) await SearchAsync(); }

    private async Task SearchAsync()
    {
        _loading = true; _error = ""; _info = null; StateHasChanged();
        try {
            var r = await Svc.GetJjigInfoAsync(_jjigId.Trim());
            if (!r.IsSuccess) { _error = r.ErrorMessage; return; }
            _info = r;
        } finally { _loading = false; }
    }

    private async Task SetWaferAsync()
    {
        if (_info is null) return;
        _setting = true; _error = ""; StateHasChanged();
        try {
            var wafers = (_info.Slots ?? []).Select(s => (s.SlotNo, s.WfNo)).ToList();
            var r = await Svc.SetWaferAsync(_info.JjigId, _lotId.Trim(), _empId.Trim(), wafers);
            if (!r.IsSuccess) { _error = r.ErrorMessage; Snackbar.Add(r.ErrorMessage, Severity.Error); return; }
            Snackbar.Add("セットしました。", Severity.Success);
            _info = null; _jjigId = ""; _lotId = "";
        } finally { _setting = false; }
    }
}

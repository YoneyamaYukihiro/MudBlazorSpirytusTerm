@page "/work-end"
@inject WorkService WorkSvc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - 作業終了 (EN0060)</PageTitle>

@* ────────────────────── ローディングバー ────────────────────── *@
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" />
}

<MudText Typo="Typo.h6" Class="mb-3">作業終了 (EN0060)</MudText>

@* ────────────────────── エラーアラート ────────────────────── *@
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => { _errorMessage = string.Empty; _errorCode = string.Empty; }">
        @if (!string.IsNullOrEmpty(_errorCode))
        {
            <b>[@_errorCode]</b><span> </span>
        }
        @_errorMessage
    </MudAlert>
}

@* ────────────────────── ガイダンスメッセージ ────────────────────── *@
@if (!string.IsNullOrEmpty(_guidanceMsg))
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => { _guidanceMsg = string.Empty; _guidanceMsgCode = string.Empty; }">
        @if (!string.IsNullOrEmpty(_guidanceMsgCode))
        {
            <b>[@_guidanceMsgCode]</b><span> </span>
        }
        @_guidanceMsg
    </MudAlert>
}

@* ────────────────────── キャリアID入力 ────────────────────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="12" sm="4" md="3">
            <MudTextField T="string"
                          Value="@_carrierId"
                          ValueChanged="@((string v) => _carrierId = (v ?? "").ToUpperInvariant())"
                          Label="キャリアID"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Placeholder="6文字で入力"
                          MaxLength="6"
                          Immediate="true"
                          HelperText="@_carrierHelperText"
                          Error="@(_carrierError)"
                          OnKeyUp="OnCarrierKeyUp"
                          Disabled="_loading"
                          Style="font-family: monospace; letter-spacing: 0.1em; text-transform: uppercase;" />
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="FetchLotInfoAsync"
                       Disabled="@(_loading || string.IsNullOrWhiteSpace(_carrierId))">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    <span>照合中...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-1" Size="Size.Small" />
                    <span>照合</span>
                }
            </MudButton>
        </MudItem>
        <MudItem xs="12" sm="5" md="7">
            @if (_lotInfo is not null)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                    ロット取得済
                </MudChip>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

@* ────────────────────── ロット情報 ────────────────────── *@
@if (_lotInfo is not null)
{
    <MudGrid Spacing="2" Class="mb-2">

        @* ── ロット情報カード ── *@
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">ロット情報</MudText>
                <MudGrid Spacing="1">
                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">ロットID</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body1"><b>@_lotInfo.LotId</b></MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">機種</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_lotInfo.PdId @(string.IsNullOrEmpty(_lotInfo.PdName) ? "" : $"({_lotInfo.PdName})")</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">ロット状態</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_lotInfo.NowSt</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">ロット管理者</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_lotInfo.EngEmpName</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">フロー区分</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_lotInfo.FlowClass</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">WF枚数 / チップ数</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_lotInfo.WfNum 枚 / @_lotInfo.ChipQuantity 個</MudText></MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        @* ── 時間・条件カード ── *@
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">時間・条件</MudText>
                <MudGrid Spacing="1">
                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">開始日時</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_lotInfo.StartTime</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">タイムリミット</MudText></MudItem>
                    <MudItem xs="7">
                        <MudText Typo="Typo.body2" Color="@(string.IsNullOrEmpty(_lotInfo.LimitTime) ? Color.Default : Color.Warning)">
                            @(string.IsNullOrEmpty(_lotInfo.LimitTime) ? "-" : _lotInfo.LimitTime)
                        </MudText>
                    </MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">作業条件</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@(string.IsNullOrEmpty(_lotInfo.WorkCondition) ? "-" : _lotInfo.WorkCondition)</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">コメント</MudText></MudItem>
                    <MudItem xs="7">
                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap; word-break: break-all;">
                            @(string.IsNullOrEmpty(_lotInfo.Comments) ? "-" : _lotInfo.Comments)
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ────────────────────── 工程選択 ────────────────────── *@
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">工程選択</MudText>

        @if (_stepRows.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Warning">選択可能な工程がありません。</MudText>
        }
        else
        {
            <MudTable T="StepRow"
                      Items="_stepRows"
                      Dense="true"
                      Hover="true"
                      @bind-SelectedItem="_selectedStep"
                      RowClassFunc="StepRowClass"
                      Elevation="0"
                      Style="cursor: pointer;">
                <HeaderContent>
                    <MudTh>大工程</MudTh>
                    <MudTh>小工程</MudTh>
                    <MudTh>D</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.OpId</MudTd>
                    <MudTd>@context.StepId</MudTd>
                    <MudTd>@(context.IsDefault ? "○" : "")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    @* ────────────────────── 追加入力 ────────────────────── *@
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">追加入力</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="8" md="6">
                <MudTextField @bind-Value="_workMemo"
                              Label="作業メモ"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="2"
                              MaxLength="128" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ────────────────────── ボタン ────────────────────── *@
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Stop"
                   OnClick="ConfirmWorkEndAsync"
                   Disabled="@(_loading || _selectedStep is null)">
            確 定
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Clear"
                   OnClick="ClearAll"
                   Disabled="_loading">
            クリア
        </MudButton>
    </MudStack>
}

@code {

    // ── 画面データ ──────────────────────────────────────────────

    private string _carrierId          = "";
    private string _workMemo           = "";

    private bool   _loading            = false;
    private bool   _carrierError       = false;
    private string _carrierHelperText  = "Enterキーで照合";
    private string _errorMessage       = "";
    private string _errorCode          = "";
    private string _guidanceMsg        = "";
    private string _guidanceMsgCode    = "";

    private WorkService.LotCurStateResult? _lotInfo;
    private List<StepRow>   _stepRows     = [];
    private StepRow?        _selectedStep = null;

    // ── 工程行モデル ─────────────────────────────────────────────

    private sealed record StepRow(
        string OpId,
        string StepId,
        string AltNumber,
        bool   IsDefault
    );

    // ── イベント ─────────────────────────────────────────────────

    private async Task OnCarrierKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await FetchLotInfoAsync();
    }

    private async Task FetchLotInfoAsync()
    {
        _carrierError      = false;
        _carrierHelperText = "Enterキーで照合";

        if (string.IsNullOrWhiteSpace(_carrierId))
            return;

        if (_carrierId.Length != 6)
        {
            _carrierError      = true;
            _carrierHelperText = "キャリアIDは6桁で入力してください。";
            return;
        }

        _loading         = true;
        _lotInfo         = null;
        _stepRows        = [];
        _selectedStep    = null;
        _errorMessage    = "";
        _errorCode       = "";
        _guidanceMsg     = "";
        _guidanceMsgCode = "";
        StateHasChanged();

        // VBソース CtsbasxxMG0060.vb: CLASS_DIVISION は作業終了に対応する値
        var result = await WorkSvc.GetLotCurStateAsync(_carrierId, classDivision: "");
        _loading = false;

        if (!result.IsSuccess)
        {
            _errorCode    = result.ErrorCode;
            _errorMessage = string.IsNullOrEmpty(result.ErrorMessage)
                ? "ロット情報の取得に失敗しました。"
                : result.ErrorMessage;
            return;
        }

        _lotInfo = result;

        // 工程行の構築 (WpList は不要 — OpId/StepId のみ使用)
        if (result.StepList is not null)
        {
            foreach (var step in result.StepList)
            {
                _stepRows.Add(new StepRow(
                    OpId:      step.OpId,
                    StepId:    step.StepId,
                    AltNumber: step.AltNumber,
                    IsDefault: step.StepDivision == "1"
                ));
            }
        }

        // D列「○」の行を優先、なければ1件のみの場合に自動選択
        _selectedStep = _stepRows.FirstOrDefault(r => r.IsDefault)
                     ?? (_stepRows.Count == 1 ? _stepRows[0] : null);

        Snackbar.Add($"ロット {result.LotId} を取得しました。", Severity.Success);
    }

    private string StepRowClass(StepRow row, int _)
        => _selectedStep == row ? "mud-selected-item" : "";

    private async Task ConfirmWorkEndAsync()
    {
        if (_lotInfo is null || _selectedStep is null)
            return;

        _loading = true;
        StateHasChanged();

        var request = new WorkService.WorkEndRequest(
            LotId:         _lotInfo.LotId,
            OpId:          _selectedStep.OpId,
            StepId:        _selectedStep.StepId,
            EmpId:         "",
            LotLastUpdate: _lotInfo.LotLastUpdate,
            Comments:      _workMemo
        );

        var result = await WorkSvc.WorkEndAsync(request);
        _loading = false;

        if (!result.IsSuccess)
        {
            _errorCode    = result.ErrorCode;
            _errorMessage = string.IsNullOrEmpty(result.ErrorMessage)
                ? "作業終了に失敗しました。"
                : result.ErrorMessage;
            return;
        }

        Snackbar.Add(
            $"作業終了を登録しました。 ロット: {_lotInfo.LotId}",
            Severity.Success);

        // ガイダンスメッセージがある場合は画面上に表示
        if (!string.IsNullOrEmpty(result.GuidanceMsg))
        {
            _guidanceMsg     = result.GuidanceMsg;
            _guidanceMsgCode = result.GuidanceMsgCode;
        }

        ClearAll(keepGuidance: true);
    }

    private void ClearAll(bool keepGuidance = false)
    {
        _carrierId         = "";
        _workMemo          = "";
        _lotInfo           = null;
        _stepRows          = [];
        _selectedStep      = null;
        _carrierError      = false;
        _carrierHelperText = "Enterキーで照合";
        _errorMessage      = "";
        _errorCode         = "";
        if (!keepGuidance)
        {
            _guidanceMsg     = "";
            _guidanceMsgCode = "";
        }
    }
}

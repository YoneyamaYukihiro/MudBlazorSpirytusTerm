@page "/pr-order"
@inject PrOrderService Svc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - P/Rオーダー管理 (EN01S0)</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">P/Rオーダー管理 (EN01S0)</MudText>
<div class="page-wrapper">

<MudPaper Class="pa-3 mb-2" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_fromDate" Label="開始日" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="8" Placeholder="YYYYMMDD" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_toDate" Label="終了日" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="8" Placeholder="YYYYMMDD" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                       Disabled="@_loading" OnClick="SearchAsync">
                @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>検索中...</span> }
                else { <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="mr-1" /><span>検索</span> }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = string.Empty">@_error</MudAlert>
}
@if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" /> }

@if (_items is not null)
{
    <MudPaper Class="pa-2" Elevation="1">
        <MudDataGrid T="PrOrderService.OrderItem" Items="_items" Dense="true" Hover="true"
                     ReadOnly="true" Striped="true" SelectedItem="_selected"
                     SelectedItemChanged="OnRowSelected">
            <Columns>
                <PropertyColumn Property="x => x.OrderId"    Title="オーダーID" />
                <PropertyColumn Property="x => x.OrderDate"  Title="オーダー日" />
                <PropertyColumn Property="x => x.CostCode"   Title="コストコード" />
                <PropertyColumn Property="x => x.GlobalDept" Title="部署"     />
                <PropertyColumn Property="x => x.PartName"   Title="部材名"   />
                <PropertyColumn Property="x => x.Qty"        Title="数量"     />
                <PropertyColumn Property="x => x.Status"     Title="状態"     />
            </Columns>
        </MudDataGrid>
    </MudPaper>

    @if (_selected is not null)
    {
        <MudPaper Class="pa-3 mt-2" Elevation="1">
            <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_costCode" Label="コストコード" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" MaxLength="20" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_empId" Label="社員ID" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" MaxLength="10" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium"
                               Disabled="@(!CanChange || _changing)" OnClick="ChangeOrderAsync">
                        @if (_changing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>処理中...</span> }
                        else { <span>変更</span> }
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
}

</div>

@code {
    private string _fromDate = "";
    private string _toDate   = "";
    private string _costCode = "";
    private string _empId    = "";
    private string _error    = "";
    private bool   _loading, _changing;
    private IReadOnlyList<PrOrderService.OrderItem>? _items;
    private PrOrderService.OrderItem? _selected;

    private bool CanChange => _selected is not null && !string.IsNullOrWhiteSpace(_empId);

    private void OnRowSelected(PrOrderService.OrderItem? item)
    { _selected = item; if (item is not null) _costCode = item.CostCode; }

    private async Task SearchAsync()
    {
        _loading = true; _error = ""; _selected = null; StateHasChanged();
        try {
            var r = await Svc.GetOrderListAsync(_fromDate.Trim(), _toDate.Trim());
            if (!r.IsSuccess) { _error = r.ErrorMessage; _items = null; return; }
            _items = r.Items;
        } finally { _loading = false; }
    }

    private async Task ChangeOrderAsync()
    {
        if (_selected is null) return;
        _changing = true; _error = ""; StateHasChanged();
        try {
            var r = await Svc.ChangeOrderAsync(_selected.OrderId, _costCode.Trim(), _selected.GlobalDept,
                _empId.Trim(), _selected.MsgVer);
            if (!r.IsSuccess) { _error = r.ErrorMessage; Snackbar.Add(r.ErrorMessage, Severity.Error); return; }
            Snackbar.Add("変更しました。", Severity.Success);
            _selected = null; await SearchAsync();
        } finally { _changing = false; }
    }
}

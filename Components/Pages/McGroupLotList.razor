@page "/mc-group-lot-list"
@inject McGroupLotListService Svc
@inject EquipmentService EqSvc
@inject ISnackbar Snackbar
@using static MudBlazorSpirytusTerm.Services.McGroupLotListService

<PageTitle>SPIRYTUS - 装置グループ別ロット一覧 (EN00J0)</PageTitle>

<MudText Typo="Typo.h6" Class="mb-3">装置グループ別ロット一覧 (EN00J0)</MudText>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = string.Empty">
        @_errorMessage
    </MudAlert>
}

@* ────── 検索エリア ────── *@
<MudPaper Class="pa-3 mb-2" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="EquipmentService.McGroup"
                       Label="装置グループ"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Value="_selectedGroup"
                       ValueChanged="OnGroupChanged"
                       Clearable="true"
                       ToStringFunc="@(g => g is null ? "" : $"{g.Id} {g.Name}")"
                       AnchorOrigin="Origin.BottomLeft"
                       Disabled="@(_groupsLoading || _loading)">
                @if (_groupsLoading)
                {
                    <MudSelectItem T="EquipmentService.McGroup" Value="null" Disabled="true">読み込み中...</MudSelectItem>
                }
                else
                {
                    foreach (var g in _groups)
                    {
                        <MudSelectItem T="EquipmentService.McGroup" Value="g">@g.Id @g.Name</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="FetchAsync"
                       Disabled="@(_loading || _groupsLoading)"
                       StartIcon="@Icons.Material.Filled.Search">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    <span>検索中...</span>
                }
                else
                {
                    <span>検索</span>
                }
            </MudButton>
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @if (_items is not null)
                {
                    <span>@_items.Count 件</span>
                }
            </MudText>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ────── グリッド ────── *@
@if (_items is not null)
{
    <MudDataGrid T="LotItem"
                 Items="_items"
                 Dense="true"
                 Hover="true"
                 Striped="true"
                 Filterable="true"
                 FilterMode="DataGridFilterMode.ColumnFilterRow"
                 SortMode="SortMode.Multiple"
                 Virtualize="true"
                 FixedHeader="true"
                 Height="calc(100vh - 280px)"
                 RowStyleFunc="RowStyle"
                 Elevation="1">
        <Columns>
            <PropertyColumn Property="x => x.LotId"               Title="ロットID"     Sortable="true" />
            <PropertyColumn Property="x => x.CarrierId"           Title="キャリアID"   Sortable="true" />
            <PropertyColumn Property="x => x.OpId"                Title="大工程"       Sortable="true" />
            <PropertyColumn Property="x => x.StepId"              Title="小工程"       Sortable="true" />
            <PropertyColumn Property="x => x.NowSt"               Title="状態"         Sortable="true" />
            <PropertyColumn Property="x => x.CurrentPositionName" Title="現在位置"     Sortable="true" />
            <TemplateColumn Title="フラグ" Filterable="false" Sortable="false">
                <CellTemplate>
                    @{ var sb = new System.Text.StringBuilder(); }
                    @{ if (context.Item.LotHoldFlag == "1") sb.Append("保"); }
                    @{ if (context.Item.LotStopFlag  == "1") sb.Append("停"); }
                    @{ if (context.Item.ReworkFlag   == "1") sb.Append("リ"); }
                    @{ else if (context.Item.ReworkFlag == "2") sb.Append("追"); }
                    @{ if (context.Item.CfFlag       == "1") sb.Append("CF"); }
                    @sb.ToString()
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.WfNum"               Title="WF枚数"       Sortable="true" />
            <PropertyColumn Property="x => x.LotPriority"         Title="優先度"       Sortable="true" />
            <PropertyColumn Property="x => x.LimitTime"           Title="制限時間"     Sortable="true" />
            <PropertyColumn Property="x => x.WarnTime"            Title="警告時間"     Sortable="true" />
            <PropertyColumn Property="x => x.DispatchStartTime"   Title="開始予定"     Sortable="true" />
            <PropertyColumn Property="x => x.PdId"                Title="機種"         Sortable="true" />
            <PropertyColumn Property="x => x.FlowClass"           Title="流動区分"     Sortable="true" />
            <PropertyColumn Property="x => x.SendSbId"            Title="送出SB"       Sortable="true" />
        </Columns>
    </MudDataGrid>
}

@code {
    private bool   _loading       = false;
    private bool   _groupsLoading = true;
    private string _errorMessage  = "";

    private IReadOnlyList<EquipmentService.McGroup>  _groups = [];
    private EquipmentService.McGroup?                _selectedGroup;
    private IReadOnlyList<LotItem>?                  _items;

    protected override async Task OnInitializedAsync()
    {
        _groups = await EqSvc.GetMcGroupListAsync();
        _groupsLoading = false;
    }

    private async Task OnGroupChanged(EquipmentService.McGroup? g)
    {
        _selectedGroup = g;
        await FetchAsync();
    }

    private async Task FetchAsync()
    {
        _loading      = true;
        _errorMessage = "";
        StateHasChanged();

        var groupId = _selectedGroup?.Id ?? "";
        var result  = await Svc.GetLotListAsync(mcGroupId: groupId);
        _loading = false;

        if (!result.IsSuccess)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _items = result.Items ?? [];
        Snackbar.Add($"{_items.Count} 件取得しました。", Severity.Info);
    }

    private string RowStyle(LotItem item, int index)
    {
        if (item.LotStopFlag == "1" || item.LotHoldFlag == "1")
            return "background-color: #FFF3E0;";
        return string.Empty;
    }
}

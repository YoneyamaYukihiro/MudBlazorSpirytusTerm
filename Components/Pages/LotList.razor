@page "/lot-list"
@inject LotListService LotListSvc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - 装置別ロット一覧</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" />
}

<MudText Typo="Typo.h6" Class="mb-2">装置別ロット一覧 (EN0150)</MudText>

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_req.SbId" Label="システムブロックID" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_req.WpId" Label="装置ID (WPID)" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_req.ClassDivision" Label="区分" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="12" md="4">
            <MudGrid Spacing="1">
                <MudItem xs="6">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="LoadAsync"
                               Disabled="_loading"
                               FullWidth="true">
                        @if (_loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            <span>送信中...</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="mr-1" Size="Size.Small" />
                            <span>再表示</span>
                        }
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Clear"
                               OnClick="ClearFilter"
                               FullWidth="true">
                        クリア
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
}

<MudDataGrid T="LotListService.LotInfo"
             Items="@(_response?.LotList ?? Array.Empty<LotListService.LotInfo>())"
             Dense="true"
             Striped="true"
             Hover="true"
             Bordered="true"
             Loading="_loading"
             Height="calc(100vh - 320px)">
    <Columns>
        <PropertyColumn Property="x => x.Status" Title="状態" />
        <PropertyColumn Property="x => x.CarrierId" Title="キャリアID" />
        <PropertyColumn Property="x => x.LotId" Title="ロットID" />
        <PropertyColumn Property="x => x.PdId" Title="機種" />
        <PropertyColumn Property="x => x.OpId" Title="大工程" />
        <PropertyColumn Property="x => x.StepId" Title="小工程" />
        <PropertyColumn Property="x => x.RecipeId" Title="レシピ" />
        <PropertyColumn Property="x => x.WfNum" Title="WF枚数" />
        <PropertyColumn Property="x => x.ChipQuantity" Title="チップ数" />
        <PropertyColumn Property="x => x.LotLastUpdate" Title="最終更新" />
    </Columns>
    <NoRecordsContent>
        @if (!_loading)
        {
            <MudText Color="Color.Secondary">データがありません。</MudText>
        }
    </NoRecordsContent>
</MudDataGrid>

@code {
    private LotListService.LotListRequest _req = new();
    private LotListService.LotListResponse? _response;
    private bool _loading;
    private string _error = string.Empty;

    private async Task LoadAsync()
    {
        _loading = true;
        _error = string.Empty;

        try
        {
            _response = await LotListSvc.GetLotListAsync(_req);
            if (!_response.IsSuccess)
            {
                _error = _response.ErrorMessage;
                Snackbar.Add(_response.ErrorMessage, Severity.Error);
            }
            else
            {
                Snackbar.Add($"{_response.LotList.Count} 件取得", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Snackbar.Add($"通信エラー: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ClearFilter()
    {
        _req = new();
        _response = null;
        _error = string.Empty;
    }
}

@page "/equipment-data"
@inject EquipmentDataService EqDataSvc
@inject ISnackbar Snackbar
@using static MudBlazorSpirytusTerm.Services.EquipmentDataService

<PageTitle>SPIRYTUS - 装置データ参照/登録 (EN00T0)</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" />
}

<MudText Typo="Typo.h6" Class="mb-3">装置データ参照/登録 (EN00T0)</MudText>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = string.Empty">
        @_errorMessage
    </MudAlert>
}

@* ────── 検索条件 ────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="12" sm="4" md="3">
            <MudTextField @bind-Value="_lotId"
                          Label="ロットID *"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="20"
                          Disabled="_loading" />
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudTextField @bind-Value="_opId"
                          Label="大工程ID"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="10"
                          Disabled="_loading" />
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudTextField @bind-Value="_stepId"
                          Label="小工程ID"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="10"
                          Disabled="_loading" />
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudSelect T="string" @bind-Value="_dataUnit"
                       Label="データ単位"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="_loading">
                <MudSelectItem Value="@("1")">ロット単位</MudSelectItem>
                <MudSelectItem Value="@("2")">WF単位</MudSelectItem>
            </MudSelect>
        </MudItem>
        @if (_dataUnit == "2")
        {
            <MudItem xs="12" sm="3" md="2">
                <MudTextField @bind-Value="_wfId"
                              Label="WFID"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="10"
                              Disabled="_loading" />
            </MudItem>
        }
        <MudItem xs="12" sm="3" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="FetchCollectParamsAsync"
                       Disabled="@(_loading || string.IsNullOrWhiteSpace(_lotId))">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    <span>取得中...</span>
                }
                else
                {
                    <span>取得</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ────── 収集データ一覧 ────── *@
@if (_result is not null)
{
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">カテゴリID</MudText>
                <MudText Typo="Typo.body1">@(_result.CategoryId)</MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">ロットデータ収集完了フラグ</MudText>
                <MudText Typo="Typo.body1">@(_result.LotDataCollCompFlag)</MudText>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">収集データ一覧</MudText>
        @if (_result.Items is null || _result.Items.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">収集データがありません。</MudAlert>
        }
        else
        {
            <MudTable T="CollectionItem" Items="_result.Items" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>項目名</MudTh>
                    <MudTh>カテゴリID</MudTh>
                    <MudTh>収集タイプ</MudTh>
                    <MudTh>CEID</MudTh>
                    <MudTh>現在値</MudTh>
                    <MudTh>入力値</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ItemName</MudTd>
                    <MudTd>@context.CategoryId</MudTd>
                    <MudTd>@context.CollectionType</MudTd>
                    <MudTd>@context.CeidValue</MudTd>
                    <MudTd>@context.CurrentValue</MudTd>
                    <MudTd>
                        <MudTextField T="string"
                                      Value="@GetInputValue(context.ItemName)"
                                      ValueChanged="@((string v) => SetInputValue(context.ItemName, v))"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      Style="min-width:120px;" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="RegisterDataAsync"
                           Disabled="_loading">
                    データ登録
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearAll" Disabled="_loading">
                    クリア
                </MudButton>
            </MudStack>
        }
    </MudPaper>
}

@code {
    private string _lotId    = "";
    private string _opId     = "";
    private string _stepId   = "";
    private string _dataUnit = "1";
    private string _wfId     = "";
    private bool   _loading  = false;
    private string _errorMessage = "";

    private CollectParamsResult?        _result      = null;
    private Dictionary<string, string>  _inputValues = new();

    private string GetInputValue(string key)
        => _inputValues.TryGetValue(key, out var v) ? v : "";

    private void SetInputValue(string key, string value)
        => _inputValues[key] = value;

    private async Task FetchCollectParamsAsync()
    {
        if (string.IsNullOrWhiteSpace(_lotId)) return;
        _loading      = true;
        _result       = null;
        _inputValues  = new();
        _errorMessage = "";
        StateHasChanged();

        var res = await EqDataSvc.GetCollectParamsAsync(_lotId, _opId, _stepId, _dataUnit, _wfId);
        _loading = false;

        if (!res.IsSuccess)
        {
            _errorMessage = res.ErrorMessage;
            return;
        }

        _result = res;
        Snackbar.Add($"装置収集データを取得しました。 ロット: {_lotId}", Severity.Info);
    }

    private async Task RegisterDataAsync()
    {
        _loading = true;
        StateHasChanged();

        // 実装中 - lot_.regcollectparams 等で登録
        await Task.Delay(500);
        _loading = false;
        Snackbar.Add("装置データを登録しました。", Severity.Success);
    }

    private void ClearAll()
    {
        _lotId       = "";
        _opId        = "";
        _stepId      = "";
        _wfId        = "";
        _dataUnit    = "1";
        _result      = null;
        _inputValues = new();
        _errorMessage = "";
    }
}

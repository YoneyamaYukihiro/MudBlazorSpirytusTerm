@page "/abnormal-processing-register"
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - 工程異常/不適合品処理票登録 (EN00U0)</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" />
}

<MudText Typo="Typo.h6" Class="mb-3">工程異常/不適合品処理票登録 (EN00U0)</MudText>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = string.Empty">
        @_errorMessage
    </MudAlert>
}
@if (_registerSuccess)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => _registerSuccess = false">
        処理票を登録しました。
    </MudAlert>
}

@* ────── 処理票種別 + 対象ロット ────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="string" @bind-Value="_reportType"
                       Label="処理票種別"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="_loading">
                <MudSelectItem Value="@("AB")">工程異常処理票 (AB)</MudSelectItem>
                <MudSelectItem Value="@("NC")">不適合品処理票 (NC)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudTextField T="string"
                          Value="@_carrierId"
                          ValueChanged="@((string v) => _carrierId = (v ?? "").ToUpperInvariant())"
                          Label="キャリアID"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="6"
                          Immediate="true"
                          HelperText="Enterキーで照合"
                          Error="@_carrierError"
                          OnKeyUp="OnCarrierKeyUp"
                          Disabled="_loading"
                          Style="font-family: monospace; letter-spacing: 0.1em; text-transform: uppercase;" />
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="FetchAsync"
                       Disabled="@(_loading || string.IsNullOrWhiteSpace(_carrierId))">
                @if (_loading && !_fetched)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    <span>照合中...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-1" Size="Size.Small" />
                    <span>照合</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ────── ロット情報 + 処理票内容 ────── *@
@if (_fetched)
{
    <MudGrid Spacing="2" Class="mb-3">

        @* ── ロット情報 ── *@
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">対象ロット情報</MudText>
                <MudGrid Spacing="1">
                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">ロットID</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body1"><b>@_lotId</b></MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">機種ID</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_pdId</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">ロット状態</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_nowSt</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">大工程</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_opId</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">小工程</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_stepId</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">WF枚数</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_wfNum 枚</MudText></MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        @* ── 処理票内容 ── *@
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">処理票内容</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_abnormalOpId"
                                      Label="異常発生 大工程ID"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="10"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_abnormalStepId"
                                      Label="異常発生 小工程ID"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="10"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_abnormalWpId"
                                      Label="異常発生 装置ID"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="20"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_reasonCode"
                                      Label="異常原因コード"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="10"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_affectedWfNum"
                                      Label="影響WF枚数"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="3"
                                      InputType="InputType.Number"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_empId"
                                      Label="登録者ID"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="10"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_abnormalContent"
                                      Label="異常内容 *"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="3"
                                      MaxLength="512"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_dispositionContent"
                                      Label="処置内容"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="3"
                                      MaxLength="512"
                                      Disabled="_loading" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ────── ボタン ────── *@
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.ReportProblem"
                   OnClick="ConfirmAsync"
                   Disabled="@(_loading || string.IsNullOrWhiteSpace(_abnormalContent))">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                <span>登録中...</span>
            }
            else
            {
                <span>処理票登録</span>
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Clear"
                   OnClick="ClearAll" Disabled="_loading">
            クリア
        </MudButton>
    </MudStack>
}

@code {
    private string _reportType         = "AB";
    private string _carrierId          = "";
    private string _lotId              = "";
    private string _pdId               = "";
    private string _nowSt              = "";
    private string _opId               = "";
    private string _stepId             = "";
    private string _wfNum              = "";
    private string _abnormalOpId       = "";
    private string _abnormalStepId     = "";
    private string _abnormalWpId       = "";
    private string _reasonCode         = "";
    private string _affectedWfNum      = "";
    private string _empId              = "";
    private string _abnormalContent    = "";
    private string _dispositionContent = "";
    private bool   _carrierError       = false;
    private bool   _loading            = false;
    private bool   _fetched            = false;
    private bool   _registerSuccess    = false;
    private string _errorMessage       = "";

    private async Task OnCarrierKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await FetchAsync();
    }

    private async Task FetchAsync()
    {
        _carrierError = false;
        if (string.IsNullOrWhiteSpace(_carrierId)) return;
        if (_carrierId.Length != 6) { _carrierError = true; return; }

        _loading         = true;
        _fetched         = false;
        _registerSuccess = false;
        _errorMessage    = "";
        StateHasChanged();

        // 実装中 - lot_.curstate で照合
        await Task.Delay(300);
        _loading = false;
        _fetched = true;
        _lotId   = "ABLOT001";
        _pdId    = "PDAB01";
        _nowSt   = "処理中";
        _opId    = "OP300";
        _stepId  = "ST400";
        _wfNum   = "25";
        _abnormalOpId   = _opId;
        _abnormalStepId = _stepId;
        Snackbar.Add($"ロット {_lotId} を取得しました。", Severity.Info);
    }

    private async Task ConfirmAsync()
    {
        _loading         = true;
        _registerSuccess = false;
        StateHasChanged();

        // 実装中 - 工程異常/不適合品処理票登録メッセージ送信
        await Task.Delay(500);
        _loading         = false;
        _registerSuccess = true;
        Snackbar.Add($"処理票({_reportType})を登録しました。 ロット: {_lotId}", Severity.Success);
        ClearFormFields();
    }

    private void ClearFormFields()
    {
        _abnormalOpId       = "";
        _abnormalStepId     = "";
        _abnormalWpId       = "";
        _reasonCode         = "";
        _affectedWfNum      = "";
        _empId              = "";
        _abnormalContent    = "";
        _dispositionContent = "";
    }

    private void ClearAll()
    {
        ClearFormFields();
        _carrierId    = "";
        _carrierError = false;
        _fetched      = false;
        _lotId        = "";
        _pdId         = "";
        _nowSt        = "";
        _opId         = "";
        _stepId       = "";
        _wfNum        = "";
        _registerSuccess = false;
        _errorMessage = "";
    }
}

@page "/lot-throw-rsv-list"
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - 投入予定ロット一覧 (EN00P0)</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" />
}

<MudText Typo="Typo.h6" Class="mb-3">投入予定ロット一覧 (EN00P0)</MudText>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = string.Empty">
        @_errorMessage
    </MudAlert>
}

@* ────── 検索条件 ────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="12" sm="4" md="3">
            <MudTextField @bind-Value="_pdId"
                          Label="機種ID"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="20"
                          Disabled="_loading"
                          HelperText="空白=全機種" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudTextField @bind-Value="_startDate"
                          Label="投入予定日 From (YYYYMMDD)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="8"
                          Placeholder="例: 20251201"
                          Disabled="_loading" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudTextField @bind-Value="_endDate"
                          Label="投入予定日 To (YYYYMMDD)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="8"
                          Placeholder="例: 20251231"
                          Disabled="_loading" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="string" @bind-Value="_flowClass"
                       Label="種別区分"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="_loading">
                <MudSelectItem Value="@("")">全種別</MudSelectItem>
                <MudSelectItem Value="@("QA")">品確 (QA)</MudSelectItem>
                <MudSelectItem Value="@("MN")">モニター (MN)</MudSelectItem>
                <MudSelectItem Value="@("DM")">ダミー (DM)</MudSelectItem>
                <MudSelectItem Value="@("MQ")">量産 (MQ)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="FetchListAsync"
                       Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    <span>検索中...</span>
                }
                else
                {
                    <span>検索</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ────── 一覧 ────── *@
@if (_rows.Count > 0)
{
    <MudPaper Class="pa-0" Elevation="1">
        <MudTable T="RsvRow" Items="_rows" Dense="true" Hover="true"
                  @bind-SelectedItem="_selectedRow" Elevation="0" Style="cursor: pointer;">
            <ToolBarContent>
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">
                    全 @_rows.Count 件
                </MudText>
                <MudSpacer />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>No.</MudTh>
                <MudTh>ロットID</MudTh>
                <MudTh>機種ID</MudTh>
                <MudTh>種別</MudTh>
                <MudTh>WF枚数</MudTh>
                <MudTh>投入予定日</MudTh>
                <MudTh>ロット担当者</MudTh>
                <MudTh>状態</MudTh>
                <MudTh>承認</MudTh>
                <MudTh>登録日時</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.No</MudTd>
                <MudTd><b>@context.LotId</b></MudTd>
                <MudTd>@context.PdId</MudTd>
                <MudTd>@context.FlowClass</MudTd>
                <MudTd>@context.WfNum</MudTd>
                <MudTd>@context.PlanThrowinDate</MudTd>
                <MudTd>@context.EngEmpName</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@StatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
                </MudTd>
                <MudTd>
                    @if (context.Approved)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.RadioButtonUnchecked" Color="Color.Default" Size="Size.Small" />
                    }
                </MudTd>
                <MudTd>@context.EntryTime</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}
else if (_searched)
{
    <MudAlert Severity="Severity.Info" Dense="true">該当する投入予定ロットがありません。</MudAlert>
}

@code {
    private string  _pdId       = "";
    private string  _startDate  = "";
    private string  _endDate    = "";
    private string  _flowClass  = "";
    private bool    _loading    = false;
    private bool    _searched   = false;
    private string  _errorMessage = "";

    private List<RsvRow> _rows       = [];
    private RsvRow?      _selectedRow;

    private sealed record RsvRow(
        int    No,
        string LotId,
        string PdId,
        string FlowClass,
        string WfNum,
        string PlanThrowinDate,
        string EngEmpName,
        string Status,
        bool   Approved,
        string EntryTime
    );

    private Color StatusColor(string status) => status switch
    {
        "未承認" => Color.Warning,
        "承認済" => Color.Success,
        "投入済" => Color.Info,
        _       => Color.Default
    };

    private async Task FetchListAsync()
    {
        _loading  = true;
        _searched = false;
        _rows     = [];
        _errorMessage = "";
        StateHasChanged();

        // 実装中 - lot_.rsvlist_ MsgVer="03.00" で取得
        await Task.Delay(500);
        _loading  = false;
        _searched = true;

        // サンプルデータ
        _rows = new List<RsvRow>
        {
            new(1, "LOT20250001", "PD001", "MQ", "25", "20251215", "担当者A", "未承認", false, "2025/12/01 09:00"),
            new(2, "LOT20250002", "PD002", "QA", "10", "20251220", "担当者B", "承認済", true, "2025/12/01 10:30"),
            new(3, "LOT20250003", "PD001", "DM", "5",  "20251225", "担当者C", "投入済", true, "2025/12/01 11:00"),
        };
        Snackbar.Add($"投入予定ロット {_rows.Count} 件を取得しました。", Severity.Info);
    }
}

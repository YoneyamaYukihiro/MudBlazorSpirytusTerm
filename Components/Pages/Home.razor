@page "/"

<PageTitle>SPIRYTUS - メニュー</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">メインメニュー</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">

    <MudTabPanel Text="流動系">
        <MudGrid Spacing="2">
            @foreach (var item in _flowMenuItems)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Style="height: 64px; font-size: 0.85rem; white-space: normal; line-height: 1.3;"
                               Href="@item.Href">
                        @item.Title
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="ツール系">
        <MudGrid Spacing="2">
            @foreach (var item in _toolMenuItems)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               FullWidth="true"
                               Size="Size.Large"
                               Style="height: 64px; font-size: 0.85rem; white-space: normal; line-height: 1.3;"
                               Href="@item.Href">
                        @item.Title
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="お気に入り">
        <MudText Typo="Typo.body1" Color="Color.Secondary">お気に入りメニューはまだ登録されていません。</MudText>
    </MudTabPanel>

</MudTabs>


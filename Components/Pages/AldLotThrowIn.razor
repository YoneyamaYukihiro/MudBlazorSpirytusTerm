@page "/ald-lot-throwin"
@inject AldLotThrowInService Svc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - ロット投入(ALD) (EN02R0)</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">ロット投入(ALD) (EN02R0)</MudText>
<div class="page-wrapper">

<MudPaper Class="pa-3 mb-2" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_batchId" Label="バッチID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="20" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_lotId" Label="ロットID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="16" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_pdId" Label="品種ID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="20" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_lotPriority" Label="ロット優先度" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="5" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_flowClass" Label="フロー区分" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="5" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_classDiv" Label="クラス区分" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="5" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_empId" Label="社員ID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="10" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="_comments" Label="コメント" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="100" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium"
                       Disabled="@(!CanThrowIn || _throwing)" OnClick="ThrowInAsync">
                @if (_throwing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>処理中...</span> }
                else { <span>投入</span> }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = string.Empty">@_error</MudAlert>
}

</div>

@code {
    private string _batchId     = "";
    private string _lotId       = "";
    private string _pdId        = "";
    private string _lotPriority = "";
    private string _flowClass   = "";
    private string _classDiv    = "";
    private string _empId       = "";
    private string _comments    = "";
    private string _error       = "";
    private bool   _throwing;

    private bool CanThrowIn => !string.IsNullOrWhiteSpace(_batchId) && !string.IsNullOrWhiteSpace(_lotId) && !string.IsNullOrWhiteSpace(_empId);

    private async Task ThrowInAsync()
    {
        _throwing = true; _error = ""; StateHasChanged();
        try {
            var r = await Svc.ThrowInAsync(_batchId.Trim(), _lotId.Trim(), _pdId.Trim(), _lotPriority.Trim(),
                _comments.Trim(), _empId.Trim(), _flowClass.Trim(), "", "", _classDiv.Trim(), "", "", "01.00");
            if (!r.IsSuccess) { _error = r.ErrorMessage; Snackbar.Add(r.ErrorMessage, Severity.Error); return; }
            Snackbar.Add("投入しました。", Severity.Success);
            _batchId = ""; _lotId = ""; _pdId = ""; _comments = "";
        } finally { _throwing = false; }
    }
}

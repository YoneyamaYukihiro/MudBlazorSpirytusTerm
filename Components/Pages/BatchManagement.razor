@page "/batch-management"
@inject BatchManagementService BatchMgmtSvc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - バッチ装置管理 (EN02N0)</PageTitle>

@* ────────────────────── ローディングバー ────────────────────── *@
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" />
}

<MudText Typo="Typo.h6" Class="mb-3">バッチ装置管理 (EN02N0)</MudText>

@* ────────────────────── エラーアラート ────────────────────── *@
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => { _errorMessage = string.Empty; _errorCode = string.Empty; }">
        @if (!string.IsNullOrEmpty(_errorCode))
        {
            <b>[@_errorCode]</b><span> </span>
        }
        @_errorMessage
    </MudAlert>
}

@* ────────────────────── 装置グループ・装置選択 ────────────────────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.End">

        @* 装置グループ *@
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="string"
                       Value="@_selectedMcGroupId"
                       ValueChanged="OnMcGroupChangedAsync"
                       Label="装置グループ"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="@_loading">
                @foreach (var g in _mcGroups)
                {
                    <MudSelectItem Value="@g.Id">@g.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        @* 装置 *@
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="string"
                       @bind-Value="_selectedWpId"
                       Label="装置"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="@(_loading || _wpList.Count == 0)">
                @foreach (var wp in _wpList)
                {
                    <MudSelectItem Value="@wp.WpId">@wp.WpName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        @* 最新取得ボタン *@
        <MudItem xs="12" sm="4" md="3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="FetchDataAsync"
                       Disabled="@(_loading || string.IsNullOrEmpty(_selectedWpId))">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    <span>取得中...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="mr-1" Size="Size.Small" />
                    <span>最新取得</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ────────────────────── バッチ編成設定 ────────────────────── *@
@if (_composeStatus is not null)
{
    <MudGrid Spacing="2" Class="mb-3">

        @* ── バッチ編成方式 ── *@
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">バッチ編成方式</MudText>
                <MudGrid Spacing="1">
                    <MudItem xs="5">
                        <MudSelect T="string"
                                   @bind-Value="_batchComposeType"
                                   Label="編成方式"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="_loading">
                            <MudSelectItem Value="@("1")">自動</MudSelectItem>
                            <MudSelectItem Value="@("0")">手動</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="7">
                        <MudGrid Spacing="0">
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">最終更新者</MudText>
                                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(_composeStatus.EditEmpName) ? "-" : _composeStatus.EditEmpName)</MudText>
                            </MudItem>
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">最終更新日時</MudText>
                                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(_composeStatus.EditTime) ? "-" : _composeStatus.EditTime)</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ────────────────────── レシピ一覧 (編集可) ────────────────────── *@
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">バッチ自動編成レシピ設定</MudText>

        @if (_editRows.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">レシピ設定がありません。</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Bordered="true" Style="width:auto; min-width:600px;">
                <thead>
                    <tr>
                        <th style="width:50px;">順</th>
                        <th style="width:120px;">種別</th>
                        <th style="min-width:180px;">バッチ自動編成レシピ</th>
                        <th style="width:120px;">枚数設定 WF[枚]≧</th>
                        <th style="width:120px;">時間設定 時間[H]≧</th>
                        <th style="width:120px;">時間設定 WF[枚]≧</th>
                        <th style="width:140px;">最終更新日時</th>
                        <th style="width:100px;">最終更新者</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _editRows)
                    {
                        <tr>
                            <td style="text-align:center;">@row.SeqNum</td>
                            <td>@RecipeTypeName(row.RecipeType)</td>
                            <td>
                                @if (row.RecipeType != "0")
                                {
                                    <MudSelect T="string"
                                               Value="@row.RecipeId"
                                               ValueChanged="@((string v) => row.RecipeId = v)"
                                               Margin="Margin.Dense"
                                               Variant="Variant.Text"
                                               Disabled="_loading"
                                               Style="font-size:0.85rem;">
                                        @foreach (var c in GetRecipeChoices(row.RecipeType))
                                        {
                                            <MudSelectItem Value="@c.RecipeId">@c.RecipeId</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <span>@row.RecipeId</span>
                                }
                            </td>
                            <td>
                                <MudTextField T="string"
                                              Value="@row.WfNum"
                                              ValueChanged="@((string v) => row.WfNum = v)"
                                              Margin="Margin.Dense"
                                              Variant="Variant.Text"
                                              Disabled="@(_loading || row.RecipeType == "0")" />
                            </td>
                            <td>
                                @if (row.RecipeType != "0" && _timeNumOptions.Count > 0)
                                {
                                    <MudSelect T="string"
                                               Value="@row.TimeNum"
                                               ValueChanged="@((string v) => row.TimeNum = v)"
                                               Margin="Margin.Dense"
                                               Variant="Variant.Text"
                                               Disabled="_loading"
                                               Style="font-size:0.85rem;">
                                        @foreach (var t in _timeNumOptions)
                                        {
                                            <MudSelectItem Value="@t">@t</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudTextField T="string"
                                                  Value="@row.TimeNum"
                                                  ValueChanged="@((string v) => row.TimeNum = v)"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Text"
                                                  Disabled="@(_loading || row.RecipeType == "0")" />
                                }
                            </td>
                            <td>
                                <MudTextField T="string"
                                              Value="@row.TimeWfNum"
                                              ValueChanged="@((string v) => row.TimeWfNum = v)"
                                              Margin="Margin.Dense"
                                              Variant="Variant.Text"
                                              Disabled="@(_loading || row.RecipeType == "0")" />
                            </td>
                            <td style="white-space:nowrap; font-size:0.8rem;">@row.EditTime</td>
                            <td style="font-size:0.8rem;">@row.EditEmpName</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>

    @* ────────────────────── 待ちロット一覧 ────────────────────── *@
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">バッチ装置待ちロット一覧</MudText>

        @if (_waitingLots.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">待ちロットはありません。</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Bordered="true" Striped="true" Style="width:auto;">
                <thead>
                    <tr>
                        <th>№</th>
                        <th>優</th>
                        <th>ロットID</th>
                        <th>レシピ</th>
                        <th>種</th>
                        <th>WF</th>
                        <th>待時間[H]</th>
                        <th>キャリアID</th>
                        <th>キャリア位置</th>
                        <th>大工程</th>
                        <th>小工程</th>
                    </tr>
                </thead>
                <tbody>
                    @{int lotNo = 1;}
                    @foreach (var lot in _waitingLots)
                    {
                        <tr>
                            <td style="text-align:center;">@(lotNo++)</td>
                            <td style="text-align:center;">@lot.LotPriority</td>
                            <td>@lot.LotId</td>
                            <td>@lot.RecipeId</td>
                            <td>@lot.FlowClass</td>
                            <td style="text-align:right;">@lot.WfQuantity</td>
                            <td style="text-align:right;">@lot.WaitTimeH</td>
                            <td>@lot.CarrierId</td>
                            <td>@lot.CurrentPositionName</td>
                            <td>@lot.OpId</td>
                            <td>@lot.StepId</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>

    @* ────────────────────── ボタン ────────────────────── *@
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="ConfirmAsync"
                   Disabled="@_loading">
            確 定
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Clear"
                   OnClick="@(() => ClearData())"
                   Disabled="_loading">
            クリア
        </MudButton>
    </MudStack>
}

@code {

    // ── 画面データ ──────────────────────────────────────────────

    private bool   _loading           = false;
    private string _errorMessage      = "";
    private string _errorCode         = "";

    private string _selectedMcGroupId = "";
    private string _selectedWpId      = "";
    private string _batchComposeType  = "0";

    private IReadOnlyList<BatchManagementService.McGroupEntry>   _mcGroups = [];
    private IReadOnlyList<BatchManagementService.WpEntry>  _wpList      = [];
    private List<string>                                   _timeNumOptions = [];

    private BatchManagementService.ComposeStatusResult?    _composeStatus = null;
    private List<EditableRecipeRow>                        _editRows      = [];
    private IReadOnlyList<BatchManagementService.WaitingLot> _waitingLots = [];
    private IReadOnlyList<BatchManagementService.RecipeChoice> _recipeChoices = [];

    // ── 編集可能レシピ行 ──────────────────────────────────────────

    private sealed class EditableRecipeRow
    {
        public string SeqNum      { get; init; } = "";
        public string RecipeType  { get; init; } = "";
        public string RecipeId    { get; set;  } = "";
        public string WfNum       { get; set;  } = "";
        public string TimeNum     { get; set;  } = "";
        public string TimeWfNum   { get; set;  } = "";
        public string EditEmpName { get; init; } = "";
        public string EditTime    { get; init; } = "";
        // 元の値（編集フラグ計算用）
        public string OrigRecipeId  { get; init; } = "";
        public string OrigWfNum     { get; init; } = "";
        public string OrigTimeNum   { get; init; } = "";
        public string OrigTimeWfNum { get; init; } = "";
    }

    // ── 初期化 ─────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        StateHasChanged();

        // バッチ装置グループのみ取得 (ClassDivision = "2G")
        _mcGroups = await BatchMgmtSvc.GetBatchMcGroupListAsync();

        if (_mcGroups.Count == 1)
        {
            _selectedMcGroupId = _mcGroups[0].Id;
            await LoadWpListAsync(_selectedMcGroupId);
        }

        _loading = false;
    }

    // ── 装置グループ変更 ─────────────────────────────────────────

    private async Task OnMcGroupChangedAsync(string groupId)
    {
        _selectedMcGroupId = groupId;
        _selectedWpId      = "";
        _wpList            = [];
        ClearData();

        if (!string.IsNullOrEmpty(groupId))
            await LoadWpListAsync(groupId);
    }

    private async Task LoadWpListAsync(string mcGroupId)
    {
        _loading = true;
        StateHasChanged();

        _wpList = await BatchMgmtSvc.GetWpListAsync(mcGroupId);

        if (_wpList.Count == 1)
            _selectedWpId = _wpList[0].WpId;

        _loading = false;
    }

    // ── 最新取得 ─────────────────────────────────────────────────

    private async Task FetchDataAsync()
    {
        if (string.IsNullOrEmpty(_selectedWpId))
            return;

        _loading      = true;
        _errorMessage = "";
        _errorCode    = "";
        ClearData();
        StateHasChanged();

        // 3つを並行取得
        var statusTask = BatchMgmtSvc.GetComposeStatusAsync(_selectedWpId);
        var recipeTask = BatchMgmtSvc.GetRecipeListAsync(_selectedWpId);
        var lotTask    = BatchMgmtSvc.GetWaitingLotListAsync(_selectedWpId);
        await Task.WhenAll(statusTask, recipeTask, lotTask);

        var statusResult = statusTask.Result;
        var recipeResult = recipeTask.Result;
        var lotResult    = lotTask.Result;

        _loading = false;

        if (!statusResult.IsSuccess)
        {
            _errorCode    = statusResult.ErrorCode;
            _errorMessage = string.IsNullOrEmpty(statusResult.ErrorMessage)
                ? "バッチ編成設定の取得に失敗しました。"
                : statusResult.ErrorMessage;
            return;
        }

        _composeStatus   = statusResult;
        _batchComposeType = statusResult.BatchComposeType == "1" ? "1" : "0";

        // レシピ選択肢の設定
        _recipeChoices = recipeResult.IsSuccess && recipeResult.RecipeChoices is not null
            ? recipeResult.RecipeChoices
            : [];

        // 時間選択肢
        _timeNumOptions = [];
        if (recipeResult.IsSuccess && !string.IsNullOrEmpty(recipeResult.TimeNumItem))
        {
            _timeNumOptions = recipeResult.TimeNumItem
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();
        }

        // 編集行の構築
        _editRows = (statusResult.RecipeList ?? [])
            .Select(r => new EditableRecipeRow
            {
                SeqNum       = r.SeqNum,
                RecipeType   = r.RecipeType,
                RecipeId     = r.RecipeId,
                WfNum        = r.WfNum,
                TimeNum      = r.TimeNum,
                TimeWfNum    = r.TimeWfNum,
                EditEmpName  = r.EditEmpName,
                EditTime     = r.EditTime,
                OrigRecipeId  = r.RecipeId,
                OrigWfNum     = r.WfNum,
                OrigTimeNum   = r.TimeNum,
                OrigTimeWfNum = r.TimeWfNum
            })
            .ToList();

        // 待ちロット
        _waitingLots = lotResult.IsSuccess && lotResult.Lots is not null
            ? lotResult.Lots
            : [];

        Snackbar.Add($"装置 {_selectedWpId} のデータを取得しました。", Severity.Success);
    }

    // ── 確定 ─────────────────────────────────────────────────────

    private async Task ConfirmAsync()
    {
        if (_composeStatus is null)
            return;

        _loading = true;
        StateHasChanged();

        // 編集フラグの計算
        var composeTypeChanged = _batchComposeType != (_composeStatus.BatchComposeType == "1" ? "1" : "0");
        var globalEditFlag = composeTypeChanged ? "1" : "0";

        var recipeRows = _editRows.Select(r =>
        {
            var rowEdited = r.RecipeId  != r.OrigRecipeId
                         || r.WfNum     != r.OrigWfNum
                         || r.TimeNum   != r.OrigTimeNum
                         || r.TimeWfNum != r.OrigTimeWfNum;
            return new BatchManagementService.RecipeRow(
                SeqNum:      r.SeqNum,
                RecipeType:  r.RecipeType,
                RecipeId:    r.RecipeId,
                WfNum:       r.WfNum,
                TimeNum:     r.TimeNum,
                TimeWfNum:   r.TimeWfNum,
                EditFlag:    rowEdited ? "1" : "0"
            );
        }).ToList();

        var request = new BatchManagementService.ComposeRegistRequest(
            WpId:             _selectedWpId,
            EmpId:            "",
            BatchComposeType: _batchComposeType,
            EditFlag:         globalEditFlag,
            RecipeList:       recipeRows
        );

        var result = await BatchMgmtSvc.RegisterComposeAsync(request);
        _loading = false;

        if (!result.IsSuccess)
        {
            _errorCode    = result.ErrorCode;
            _errorMessage = string.IsNullOrEmpty(result.ErrorMessage)
                ? "バッチ編成設定の登録に失敗しました。"
                : result.ErrorMessage;
            return;
        }

        Snackbar.Add("バッチ編成設定を登録しました。", Severity.Success);

        // 登録後に最新情報を再取得
        await FetchDataAsync();
    }

    // ── クリア ──────────────────────────────────────────────────

    private void ClearData()
    {
        _composeStatus  = null;
        _editRows       = [];
        _waitingLots    = [];
        _recipeChoices  = [];
        _timeNumOptions = [];
        _batchComposeType = "0";
    }

    // ── ヘルパー ──────────────────────────────────────────────────

    private static string RecipeTypeName(string recipeType) => recipeType switch
    {
        "1" => "製品",
        "2" => "ガスクリーニング",
        "3" => "プリコート",
        _   => "未設定"
    };

    private IReadOnlyList<BatchManagementService.RecipeChoice> GetRecipeChoices(string recipeType)
        => _recipeChoices.Where(c => c.RecipeType == recipeType).ToList();
}

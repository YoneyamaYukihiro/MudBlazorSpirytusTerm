@page "/tpal-bonding"
@inject ISnackbar Snackbar
@inject TpalBondingService Svc

<PageTitle>SPIRYTUS - TPAL貼り合わせ登録 (EN01A0)</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" />
}

<MudText Typo="Typo.h6" Class="mb-3">TPAL貼り合わせ登録 (EN01A0)</MudText>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = string.Empty">
        @_errorMessage
    </MudAlert>
}

@* ────── 親ロット(TFT)照合 ────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">親ロット (TFT) 照合</MudText>
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="12" sm="4" md="3">
            <MudTextField T="string"
                          Value="@_tftCarrierId"
                          ValueChanged="@((string v) => _tftCarrierId = (v ?? "").ToUpperInvariant())"
                          Label="TFTキャリアID"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="6"
                          Immediate="true"
                          HelperText="Enterキーで照合"
                          Error="@_tftCarrierError"
                          OnKeyUp="OnTftCarrierKeyUp"
                          Disabled="_loading"
                          Style="font-family: monospace; letter-spacing: 0.1em; text-transform: uppercase;" />
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="FetchTftAsync"
                       Disabled="@(_loading || string.IsNullOrWhiteSpace(_tftCarrierId))">
                @if (_loading && !_tftFetched)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    <span>照合中...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-1" Size="Size.Small" />
                    <span>照合</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (_tftFetched)
    {
        <MudGrid Spacing="1" Class="mt-2">
            <MudItem xs="5" sm="3"><MudText Typo="Typo.body2" Class="mud-text-secondary">TFTロットID</MudText></MudItem>
            <MudItem xs="7" sm="9"><MudText Typo="Typo.body1"><b>@_tftLotId</b></MudText></MudItem>

            <MudItem xs="5" sm="3"><MudText Typo="Typo.body2" Class="mud-text-secondary">機種</MudText></MudItem>
            <MudItem xs="7" sm="9"><MudText Typo="Typo.body2">@_tftPdId</MudText></MudItem>

            <MudItem xs="5" sm="3"><MudText Typo="Typo.body2" Class="mud-text-secondary">状態</MudText></MudItem>
            <MudItem xs="7" sm="9"><MudText Typo="Typo.body2">@_tftNowSt</MudText></MudItem>

            <MudItem xs="5" sm="3"><MudText Typo="Typo.body2" Class="mud-text-secondary">WF枚数</MudText></MudItem>
            <MudItem xs="7" sm="9"><MudText Typo="Typo.body2">@_tftWfNum 枚</MudText></MudItem>
        </MudGrid>
    }
</MudPaper>

@* ────── TPAL使用実績一覧 ────── *@
@if (_tftFetched)
{
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">
            TPAL使用実績 — キャリアID / TPALロットID / 貼数 / 不良数 / 残数 / 有効期限
        </MudText>

        <MudGrid Spacing="2" AlignItems="AlignItems.End" Class="mb-2">
            <MudItem xs="12" sm="4" md="3">
                <MudTextField T="string"
                              Value="@_tpalCarrierId"
                              ValueChanged="@((string v) => _tpalCarrierId = (v ?? "").ToUpperInvariant())"
                              Label="TPALキャリアID"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="6"
                              Immediate="true"
                              HelperText="Enterキーで追加"
                              OnKeyUp="OnTpalCarrierKeyUp"
                              Disabled="_loading"
                              Style="font-family: monospace; letter-spacing: 0.1em; text-transform: uppercase;" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddTpalAsync"
                           Disabled="@(_loading || string.IsNullOrWhiteSpace(_tpalCarrierId))">
                    追加
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_tpalRows.Count > 0)
        {
            <MudTable T="TpalRow" Items="_tpalRows" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>No.</MudTh>
                    <MudTh>キャリアID</MudTh>
                    <MudTh>TPALロットID</MudTh>
                    <MudTh>貼数</MudTh>
                    <MudTh>不良数</MudTh>
                    <MudTh>残数</MudTh>
                    <MudTh>有効期限</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.No</MudTd>
                    <MudTd>@context.CarrierId</MudTd>
                    <MudTd>@context.TpalLotId</MudTd>
                    <MudTd>
                        <MudTextField T="string"
                                      Value="@context.CoverNum"
                                      ValueChanged="@((string v) => context.CoverNum = v)"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      MaxLength="5"
                                      InputType="InputType.Number"
                                      Style="width:60px;" />
                    </MudTd>
                    <MudTd>
                        <MudTextField T="string"
                                      Value="@context.OutNum"
                                      ValueChanged="@((string v) => context.OutNum = v)"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      MaxLength="5"
                                      InputType="InputType.Number"
                                      Style="width:60px;" />
                    </MudTd>
                    <MudTd>@context.RestNum</MudTd>
                    <MudTd>@context.LimitTime</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => _tpalRows.Remove(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    @* ── 作業情報 ── *@
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4" md="3">
                <MudTextField @bind-Value="_empId"
                              Label="作業者ID"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="10"
                              Disabled="_loading" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ────── ボタン ────── *@
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Layers"
                   OnClick="ConfirmAsync"
                   Disabled="@(_loading || _tpalRows.Count == 0)">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                <span>処理中...</span>
            }
            else
            {
                <span>貼り合わせ登録</span>
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Clear"
                   OnClick="ClearAll" Disabled="_loading">
            クリア
        </MudButton>
    </MudStack>
}

@code {
    private string _tftCarrierId   = "";
    private string _tpalCarrierId  = "";
    private string _tftLotId      = "";
    private string _tftPdId       = "";
    private string _tftNowSt      = "";
    private string _tftWfNum      = "";
    private string _tftLastUpdate = "";
    private string _empId         = "";
    private bool   _tftCarrierError = false;
    private bool   _loading       = false;
    private bool   _tftFetched    = false;
    private string _errorMessage  = "";

    private List<TpalRow> _tpalRows = [];

    private sealed class TpalRow
    {
        public int    No         { get; init; }
        public string CarrierId  { get; init; } = "";
        public string TpalLotId  { get; set;  } = "";
        public string CoverNum   { get; set;  } = "0";
        public string OutNum     { get; set;  } = "0";
        public string RestNum    { get; set;  } = "0";
        public string LimitTime  { get; set;  } = "";
    }

    private async Task OnTftCarrierKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await FetchTftAsync();
    }

    private async Task OnTpalCarrierKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTpalAsync();
    }

    private async Task FetchTftAsync()
    {
        _tftCarrierError = false;
        if (string.IsNullOrWhiteSpace(_tftCarrierId)) return;
        if (_tftCarrierId.Length != 6) { _tftCarrierError = true; return; }

        _loading     = true;
        _tftFetched  = false;
        _tpalRows    = [];
        _errorMessage = "";
        StateHasChanged();

        var lotResult = await Svc.GetTftLotAsync(_tftCarrierId);
        if (!lotResult.IsSuccess)
        {
            _loading      = false;
            _errorMessage = lotResult.ErrorMessage;
            return;
        }

        _tftLotId     = lotResult.LotId;
        _tftPdId      = lotResult.PdId;
        _tftNowSt     = lotResult.NowSt;
        _tftWfNum     = lotResult.WfNum;
        _tftLastUpdate = lotResult.LotLastUpdate;

        // TPAL使用実績取得
        var usageResult = await Svc.GetTpalUsageAsync(_tftLotId);
        _loading    = false;
        _tftFetched = true;

        if (usageResult.IsSuccess && usageResult.Items is { } items)
        {
            _tpalRows = items.Select((e, i) => new TpalRow
            {
                No        = i + 1,
                CarrierId = e.CarrierId,
                TpalLotId = e.TpalLotId,
                CoverNum  = e.CoverNum,
                OutNum    = e.OutNum,
                RestNum   = e.RestNum,
                LimitTime = e.LimitTime,
            }).ToList();
        }

        Snackbar.Add($"TFTロット {_tftLotId} を取得しました。", Severity.Info);
    }

    private async Task AddTpalAsync()
    {
        if (string.IsNullOrWhiteSpace(_tpalCarrierId)) return;
        _loading = true;
        StateHasChanged();

        var result = await Svc.GetCombableTpalAsync(_tpalCarrierId, _tftLotId);
        _loading = false;

        if (!result.IsSuccess)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _tpalRows.Add(new TpalRow
        {
            No        = _tpalRows.Count + 1,
            CarrierId = _tpalCarrierId,
            TpalLotId = result.TpalLotId,
            RestNum   = result.RestNum,
            LimitTime = result.LimitTime,
        });
        _tpalCarrierId = "";
    }

    private async Task ConfirmAsync()
    {
        _loading = true;
        StateHasChanged();

        var rows = _tpalRows.Select(r => new TpalBondingService.TpalCombRow(
            r.CarrierId, r.TpalLotId, r.CoverNum, r.OutNum)).ToList();

        var result = await Svc.RegisterBondingAsync(_tftLotId, _empId, _tftLastUpdate, rows);
        _loading = false;

        if (!result.IsSuccess)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        Snackbar.Add($"TPAL貼り合わせを登録しました。 ロット: {_tftLotId}", Severity.Success);
        ClearAll();
    }

    private void ClearAll()
    {
        _tftCarrierId    = "";
        _tpalCarrierId   = "";
        _tftCarrierError = false;
        _tftFetched      = false;
        _tftLotId        = "";
        _tftPdId         = "";
        _tftNowSt        = "";
        _tftWfNum        = "";
        _tftLastUpdate   = "";
        _empId           = "";
        _tpalRows        = [];
        _errorMessage    = "";
    }
}

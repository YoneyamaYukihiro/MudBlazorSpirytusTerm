@page "/transport-mode"
@inject TransportModeService Svc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - 搬送モード管理 (EN01L0)</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">搬送モード管理 (EN01L0)</MudText>
<div class="page-wrapper">

<MudPaper Class="pa-3 mb-2" Elevation="1">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
               Disabled="@_loading" OnClick="LoadAsync">
        @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>読込中...</span> }
        else { <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Class="mr-1" /><span>一覧取得</span> }
    </MudButton>
</MudPaper>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = string.Empty">@_error</MudAlert>
}
@if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" /> }

@if (_items is not null)
{
    <MudPaper Class="pa-2" Elevation="1">
        <MudDataGrid T="TransportModeService.ModeItem" Items="_items" Dense="true" Hover="true"
                     ReadOnly="true" Striped="true" SelectedItem="_selected"
                     SelectedItemChanged="OnRowSelected">
            <Columns>
                <PropertyColumn Property="x => x.WpId"           Title="装置ID"   />
                <PropertyColumn Property="x => x.WpName"         Title="装置名"   />
                <PropertyColumn Property="x => x.CurrentMode"    Title="現モード" />
                <PropertyColumn Property="x => x.CurrentModeName" Title="モード名" />
            </Columns>
        </MudDataGrid>
    </MudPaper>

    @if (_selected is not null)
    {
        <MudPaper Class="pa-3 mt-2" Elevation="1">
            <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_newMode" Label="新モード" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" MaxLength="10" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_empId" Label="社員ID" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" MaxLength="10" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium"
                               Disabled="@(!CanChange || _changing)" OnClick="ChangeModeAsync">
                        @if (_changing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>処理中...</span> }
                        else { <span>変更</span> }
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
}

</div>

@code {
    private string _newMode  = "";
    private string _empId    = "";
    private string _error    = "";
    private bool   _loading, _changing;
    private IReadOnlyList<TransportModeService.ModeItem>? _items;
    private TransportModeService.ModeItem? _selected;

    private bool CanChange => _selected is not null && !string.IsNullOrWhiteSpace(_newMode) && !string.IsNullOrWhiteSpace(_empId);

    private void OnRowSelected(TransportModeService.ModeItem? item) { _selected = item; }

    private async Task LoadAsync()
    {
        _loading = true; _error = ""; _selected = null; StateHasChanged();
        try {
            var r = await Svc.GetModeListAsync();
            if (!r.IsSuccess) { _error = r.ErrorMessage; _items = null; return; }
            _items = r.Items;
        } finally { _loading = false; }
    }

    private async Task ChangeModeAsync()
    {
        if (_selected is null) return;
        _changing = true; _error = ""; StateHasChanged();
        try {
            var r = await Svc.ChangeModeAsync(_selected.WpId, _newMode.Trim(), _empId.Trim(), _selected.MsgVer);
            if (!r.IsSuccess) { _error = r.ErrorMessage; Snackbar.Add(r.ErrorMessage, Severity.Error); return; }
            Snackbar.Add("モードを変更しました。", Severity.Success);
            _selected = null; _newMode = ""; await LoadAsync();
        } finally { _changing = false; }
    }
}

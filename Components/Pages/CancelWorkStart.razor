@page "/cancel-work-start"
@inject WorkService WorkSvc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - 作業開始取消/処理開始取消 (EN0130)</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" />
}

<MudText Typo="Typo.h6" Class="mb-3">作業開始取消/処理開始取消 (EN0130)</MudText>

@* ────── エラーアラート ────── *@
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => { _errorMessage = string.Empty; _errorCode = string.Empty; }">
        @if (!string.IsNullOrEmpty(_errorCode))
        {
            <b>[@_errorCode]</b><span> </span>
        }
        @_errorMessage
    </MudAlert>
}

@* ────── キャリアID入力 ────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="12" sm="4" md="3">
            <MudTextField T="string"
                          Value="@_carrierId"
                          ValueChanged="@((string v) => _carrierId = (v ?? "").ToUpperInvariant())"
                          Label="キャリアID"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Placeholder="6文字で入力"
                          MaxLength="6"
                          Immediate="true"
                          HelperText="@_carrierHelperText"
                          Error="@_carrierError"
                          OnKeyUp="OnCarrierKeyUp"
                          Disabled="_loading"
                          Style="font-family: monospace; letter-spacing: 0.1em; text-transform: uppercase;" />
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="FetchLotInfoAsync"
                       Disabled="@(_loading || string.IsNullOrWhiteSpace(_carrierId))">
                @if (_loading && _lotInfo is null)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    <span>照合中...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-1" Size="Size.Small" />
                    <span>照合</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ────── ロット情報・取消入力 ────── *@
@if (_lotInfo is not null)
{
    @* ── 取消モードバナー ── *@
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Undo">
        <b>@CancelModeLabel</b> — 現在のロット状態: <b>@_lotInfo.NowSt</b>
    </MudAlert>

    <MudGrid Spacing="2" Class="mb-3">

        @* ── ロット情報カード ── *@
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">ロット情報</MudText>
                <MudGrid Spacing="1">
                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">ロットID</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body1"><b>@_lotInfo.LotId</b></MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">機種</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_lotInfo.PdId @(string.IsNullOrEmpty(_lotInfo.PdName) ? "" : $"({_lotInfo.PdName})")</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">ロット状態</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_lotInfo.NowSt</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">ロット管理者</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_lotInfo.EngEmpName</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">フロー区分</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_lotInfo.FlowClass</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">WF枚数 / チップ数</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_lotInfo.WfNum 枚 / @_lotInfo.ChipQuantity 個</MudText></MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        @* ── 取消設定カード ── *@
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">取消設定</MudText>
                <MudGrid Spacing="2">

                    @* 戻す先 *@
                    <MudItem xs="12">
                        <MudSelect T="string"
                                   @bind-Value="_cancelMode"
                                   Label="戻す先"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="_loading">
                            <MudSelectItem Value="@("0")">作業待ち</MudSelectItem>
                            @if (CanReturnToBeforeProcess)
                            {
                                <MudSelectItem Value="@("1")">前処理</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    @* 作業メモ *@
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_workMemo"
                                      Label="作業メモ"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="3"
                                      MaxLength="2048"
                                      Disabled="_loading" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ────── ボタン ────── *@
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Undo"
                   OnClick="ConfirmCancelAsync"
                   Disabled="_loading">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                <span>処理中...</span>
            }
            else
            {
                <span>確 定</span>
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Clear"
                   OnClick="ClearAll"
                   Disabled="_loading">
            クリア
        </MudButton>
    </MudStack>
}

@code {

    private string _carrierId        = "";
    private string _workMemo         = "";
    private string _cancelMode       = "0";  // "0"=作業待ち, "1"=前処理

    private bool   _loading          = false;
    private bool   _carrierError     = false;
    private string _carrierHelperText = "Enterキーで照合";
    private string _errorMessage     = "";
    private string _errorCode        = "";

    private WorkService.LotCurStateResult? _lotInfo;

    // ── 判定プロパティ ──

    /// <summary>処理中 → 処理開始取消 / 前処理 → 作業開始取消</summary>
    private bool IsProcessCancel => _lotInfo?.NowSt == "処理中";

    private string CancelModeLabel => IsProcessCancel ? "処理開始取消" : "作業開始取消";

    /// <summary>処理中の場合のみ「前処理に戻す」を選択可能</summary>
    private bool CanReturnToBeforeProcess => IsProcessCancel;

    // ── イベント ──

    private async Task OnCarrierKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await FetchLotInfoAsync();
    }

    private async Task FetchLotInfoAsync()
    {
        _carrierError      = false;
        _carrierHelperText = "Enterキーで照合";

        if (string.IsNullOrWhiteSpace(_carrierId))
            return;

        if (_carrierId.Length != 6)
        {
            _carrierError      = true;
            _carrierHelperText = "キャリアIDは6桁で入力してください。";
            return;
        }

        _loading      = true;
        _lotInfo      = null;
        _cancelMode   = "0";
        _errorMessage = "";
        _errorCode    = "";
        StateHasChanged();

        // ClassDivision "19" = ロット現在状態取得(ロット作業開始取消)
        var result = await WorkSvc.GetLotCurStateAsync(_carrierId, classDivision: "19");
        _loading = false;

        if (!result.IsSuccess)
        {
            _errorCode    = result.ErrorCode;
            _errorMessage = string.IsNullOrEmpty(result.ErrorMessage)
                ? "ロット情報の取得に失敗しました。"
                : result.ErrorMessage;
            return;
        }

        _lotInfo = result;
        Snackbar.Add($"ロット {result.LotId} を取得しました。", Severity.Info);
    }

    private async Task ConfirmCancelAsync()
    {
        if (_lotInfo is null)
            return;

        _loading = true;
        StateHasChanged();

        var request = new WorkService.CancelStartRequest(
            LotId:         _lotInfo.LotId,
            EmpId:         "",
            LotLastUpdate: _lotInfo.LotLastUpdate,
            CancelMode:    _cancelMode,
            Comments:      _workMemo
        );

        var result = await WorkSvc.CancelStartAsync(request);
        _loading = false;

        if (!result.IsSuccess)
        {
            _errorCode    = result.ErrorCode;
            _errorMessage = string.IsNullOrEmpty(result.ErrorMessage)
                ? $"{CancelModeLabel}に失敗しました。"
                : result.ErrorMessage;
            return;
        }

        var destLabel = _cancelMode == "1" ? "前処理" : "作業待ち";
        Snackbar.Add(
            $"{CancelModeLabel}を登録しました。 ロット: {_lotInfo.LotId}  → {destLabel}",
            Severity.Success);

        if (!string.IsNullOrEmpty(result.GuidanceMsg))
            Snackbar.Add(result.GuidanceMsg, Severity.Info);

        ClearAll();
    }

    private void ClearAll()
    {
        _carrierId         = "";
        _workMemo          = "";
        _cancelMode        = "0";
        _lotInfo           = null;
        _carrierError      = false;
        _carrierHelperText = "Enterキーで照合";
        _errorMessage      = "";
        _errorCode         = "";
    }
}

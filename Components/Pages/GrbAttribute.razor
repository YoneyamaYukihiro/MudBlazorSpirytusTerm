@page "/grb-attribute"
@inject GrbAttributeService Svc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - GRB属性設定 (EN02L0)</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">GRB属性設定 (EN02L0)</MudText>
<div class="page-wrapper">

<MudPaper Class="pa-3 mb-2" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_lotId" Label="ロットID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="16" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_classDiv" Label="クラス区分" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="5" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_grbClass" Label="GRBクラス" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="5" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_empId" Label="社員ID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="10" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_lotLastUpdate" Label="最終更新" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="20" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium"
                       Disabled="@(!CanSet || _setting)" OnClick="SetAsync">
                @if (_setting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>処理中...</span> }
                else { <span>設定</span> }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = string.Empty">@_error</MudAlert>
}

</div>

@code {
    private string _lotId         = "";
    private string _classDiv      = "";
    private string _grbClass      = "";
    private string _empId         = "";
    private string _lotLastUpdate = "";
    private string _error         = "";
    private bool   _setting;

    private bool CanSet => !string.IsNullOrWhiteSpace(_lotId) && !string.IsNullOrWhiteSpace(_empId);

    private async Task SetAsync()
    {
        _setting = true; _error = ""; StateHasChanged();
        try {
            var r = await Svc.SetGrbAttributeAsync(_lotId.Trim(), _classDiv.Trim(), _empId.Trim(),
                _lotLastUpdate.Trim(), [], "01.00");
            if (!r.IsSuccess) { _error = r.ErrorMessage; Snackbar.Add(r.ErrorMessage, Severity.Error); return; }
            Snackbar.Add("GRB属性を設定しました。", Severity.Success);
            _lotLastUpdate = r.LotLastUpdate;
        } finally { _setting = false; }
    }
}

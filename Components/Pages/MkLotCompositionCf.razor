@page "/mk-lot-composition-cf"
@inject MkLotCompositionCfService Svc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - MKロット編成(CF) (EN02E0)</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">MKロット編成(CF) (EN02E0)</MudText>
<div class="page-wrapper">

<MudPaper Class="pa-3 mb-2" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_carrierId" Label="キャリアID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="6" Immediate="true"
                          Style="font-family:monospace;text-transform:uppercase;"
                          OnKeyDown="OnKeyDownAsync" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                       Disabled="@(!CanSearch || _loading)" OnClick="SearchAsync">
                @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>検索中...</span> }
                else { <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="mr-1" /><span>検索</span> }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = string.Empty">@_error</MudAlert>
}
@if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" /> }

@if (_info is not null)
{
    <MudPaper Class="pa-2 mb-2" Elevation="1">
        <MudGrid Spacing="1">
            <MudItem xs="6" sm="3"><MudText Typo="Typo.caption" Color="Color.Secondary">ロットID</MudText><MudText Typo="Typo.body2">@_info.LotId</MudText></MudItem>
            <MudItem xs="6" sm="3"><MudText Typo="Typo.caption" Color="Color.Secondary">キャリアID</MudText><MudText Typo="Typo.body2">@_info.CarrierId</MudText></MudItem>
            <MudItem xs="6" sm="3"><MudText Typo="Typo.caption" Color="Color.Secondary">品種</MudText><MudText Typo="Typo.body2">@_info.PdId</MudText></MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-2 mb-2" Elevation="1">
        <MudDataGrid T="MkLotCompositionCfService.ChipItem" Items="@(_info.Chips ?? [])" Dense="true" Hover="true" ReadOnly="true" Striped="true">
            <Columns>
                <PropertyColumn Property="x => x.SlotNo"     Title="スロットNo" />
                <PropertyColumn Property="x => x.WfNo"       Title="WF No"      />
                <PropertyColumn Property="x => x.ChipNo"     Title="チップNo"   />
                <PropertyColumn Property="x => x.StatusName" Title="状態"        />
            </Columns>
        </MudDataGrid>
    </MudPaper>

    <MudPaper Class="pa-3" Elevation="1">
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_empId" Label="社員ID" Variant="Variant.Outlined"
                              Margin="Margin.Dense" MaxLength="10" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium"
                           Disabled="@(!CanMove || _moving)" OnClick="ChipMoveAsync">
                    @if (_moving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>処理中...</span> }
                    else { <span>チップ移動</span> }
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

</div>

@code {
    private string _carrierId = "";
    private string _empId     = "";
    private string _error     = "";
    private bool   _loading, _moving;
    private MkLotCompositionCfService.ChipMoveInfoResult? _info;

    private bool CanSearch => !string.IsNullOrWhiteSpace(_carrierId);
    private bool CanMove   => _info is not null && !string.IsNullOrWhiteSpace(_empId);

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    { if (e.Key == "Enter" && CanSearch && !_loading) await SearchAsync(); }

    private async Task SearchAsync()
    {
        _loading = true; _error = ""; _info = null; StateHasChanged();
        try {
            var r = await Svc.GetChipMoveInfoAsync(_carrierId.Trim().ToUpper());
            if (!r.IsSuccess) { _error = r.ErrorMessage; return; }
            _info = r;
        } finally { _loading = false; }
    }

    private async Task ChipMoveAsync()
    {
        if (_info is null) return;
        _moving = true; _error = ""; StateHasChanged();
        try {
            var chips = (_info.Chips ?? []).Select(c => (c.SlotNo, c.WfNo)).ToList();
            var r = await Svc.ChipMoveAsync(_info.LotId, _empId.Trim(), _info.LotLastUpdate, chips);
            if (!r.IsSuccess) { _error = r.ErrorMessage; Snackbar.Add(r.ErrorMessage, Severity.Error); return; }
            Snackbar.Add("チップ移動しました。", Severity.Success);
            _info = null; _carrierId = "";
        } finally { _moving = false; }
    }
}

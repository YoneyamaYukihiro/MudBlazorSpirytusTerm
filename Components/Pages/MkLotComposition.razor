@page "/mk-lot-composition"
@inject MkLotCompositionService Svc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - MKロット編成 (EN02C0)</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">MKロット編成 (EN02C0)</MudText>
<div class="page-wrapper">

<MudPaper Class="pa-3 mb-2" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_wpId" Label="装置ID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="20" Immediate="true"
                          OnKeyDown="OnKeyDownAsync" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                       Disabled="@(!CanSearch || _loading)" OnClick="SearchAsync">
                @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>検索中...</span> }
                else { <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="mr-1" /><span>検索</span> }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = string.Empty">@_error</MudAlert>
}
@if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" /> }

@if (_items is not null)
{
    <MudPaper Class="pa-2 mb-2" Elevation="1">
        <MudDataGrid T="MkLotCompositionService.PartItem" Items="_items" Dense="true" Hover="true"
                     MultiSelection="true" ReadOnly="true" Striped="true"
                     SelectedItems="_selectedItems" SelectedItemsChanged="OnSelectionChanged">
            <Columns>
                <SelectColumn T="MkLotCompositionService.PartItem" />
                <PropertyColumn Property="x => x.StockLotId" Title="在庫ロットID" />
                <PropertyColumn Property="x => x.PartId"     Title="部材ID"      />
                <PropertyColumn Property="x => x.PartName"   Title="部材名"      />
                <PropertyColumn Property="x => x.StockNum"   Title="在庫数"      />
                <PropertyColumn Property="x => x.Status"     Title="状態"        />
            </Columns>
        </MudDataGrid>
    </MudPaper>

    <MudPaper Class="pa-3" Elevation="1">
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_carrierId" Label="キャリアID" Variant="Variant.Outlined"
                              Margin="Margin.Dense" MaxLength="6"
                              Style="font-family:monospace;text-transform:uppercase;" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_empId" Label="社員ID" Variant="Variant.Outlined"
                              Margin="Margin.Dense" MaxLength="10" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium"
                           Disabled="@(!CanCompose || _composing)" OnClick="ComposeAsync">
                    @if (_composing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>処理中...</span> }
                    else { <span>編成</span> }
                </MudButton>
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(_mkLotId))
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                編成完了。MKロットID: <strong>@_mkLotId</strong>
            </MudAlert>
        }
    </MudPaper>
}

</div>

@code {
    private string _wpId      = "";
    private string _carrierId = "";
    private string _empId     = "";
    private string _mkLotId   = "";
    private string _error     = "";
    private bool   _loading, _composing;
    private IReadOnlyList<MkLotCompositionService.PartItem>? _items;
    private HashSet<MkLotCompositionService.PartItem> _selectedItems = [];

    private bool CanSearch  => !string.IsNullOrWhiteSpace(_wpId);
    private bool CanCompose => _selectedItems.Count > 0 && !string.IsNullOrWhiteSpace(_carrierId) && !string.IsNullOrWhiteSpace(_empId);

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    { if (e.Key == "Enter" && CanSearch && !_loading) await SearchAsync(); }

    private void OnSelectionChanged(HashSet<MkLotCompositionService.PartItem> items) { _selectedItems = items; }

    private async Task SearchAsync()
    {
        _loading = true; _error = ""; _selectedItems = []; _mkLotId = ""; StateHasChanged();
        try {
            var r = await Svc.GetMkPartListAsync(_wpId.Trim());
            if (!r.IsSuccess) { _error = r.ErrorMessage; _items = null; return; }
            _items = r.Items;
        } finally { _loading = false; }
    }

    private async Task ComposeAsync()
    {
        _composing = true; _error = ""; _mkLotId = ""; StateHasChanged();
        try {
            var ids = _selectedItems.Select(x => x.StockLotId).ToList();
            var r = await Svc.ComposeMkLotAsync(_carrierId.Trim().ToUpper(), _wpId.Trim(), _empId.Trim(), ids);
            if (!r.IsSuccess) { _error = r.ErrorMessage; Snackbar.Add(r.ErrorMessage, Severity.Error); return; }
            _mkLotId = r.MkLotId;
            Snackbar.Add("編成しました。", Severity.Success);
            _selectedItems = [];
        } finally { _composing = false; }
    }
}

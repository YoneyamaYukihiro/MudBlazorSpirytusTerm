@page "/batch-lot-info-change"
@inject BatchLotInfoChangeService Svc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - ロット情報一括変更 (EN02B0)</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">ロット情報一括変更 (EN02B0)</MudText>
<div class="page-wrapper">

<MudPaper Class="pa-3 mb-2" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_opId" Label="OP ID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="20" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_stepId" Label="Step ID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="10" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_wpId" Label="装置ID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="20" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                       Disabled="@_loading" OnClick="SearchAsync">
                @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>検索中...</span> }
                else { <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="mr-1" /><span>検索</span> }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = string.Empty">@_error</MudAlert>
}
@if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" /> }

@if (_items is not null)
{
    <MudPaper Class="pa-2 mb-2" Elevation="1">
        <MudDataGrid T="BatchLotInfoChangeService.OpLotItem" Items="_items" Dense="true" Hover="true"
                     MultiSelection="true" ReadOnly="true" Striped="true"
                     SelectedItems="_selectedItems" SelectedItemsChanged="OnSelectionChanged">
            <Columns>
                <SelectColumn T="BatchLotInfoChangeService.OpLotItem" />
                <PropertyColumn Property="x => x.LotId"     Title="ロットID"  />
                <PropertyColumn Property="x => x.CarrierId" Title="キャリア"  />
                <PropertyColumn Property="x => x.PdId"      Title="品種"      />
                <PropertyColumn Property="x => x.PdName"    Title="品種名"    />
                <PropertyColumn Property="x => x.Priority"  Title="優先度"    />
                <PropertyColumn Property="x => x.WpId"      Title="装置ID"   />
                <PropertyColumn Property="x => x.WpName"    Title="装置名"   />
                <PropertyColumn Property="x => x.Status"    Title="状態"     />
            </Columns>
        </MudDataGrid>
    </MudPaper>

    <MudPaper Class="pa-3" Elevation="1">
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_attributeName" Label="属性名" Variant="Variant.Outlined"
                              Margin="Margin.Dense" MaxLength="40" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_newValue" Label="新しい値" Variant="Variant.Outlined"
                              Margin="Margin.Dense" MaxLength="100" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="_empId" Label="社員ID" Variant="Variant.Outlined"
                              Margin="Margin.Dense" MaxLength="10" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium"
                           Disabled="@(!CanChange || _changing)" OnClick="ChangeAsync">
                    @if (_changing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>処理中...</span> }
                    else { <span>一括変更</span> }
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

</div>

@code {
    private string _opId          = "";
    private string _stepId        = "";
    private string _wpId          = "";
    private string _attributeName = "";
    private string _newValue      = "";
    private string _empId         = "";
    private string _error         = "";
    private bool   _loading, _changing;
    private IReadOnlyList<BatchLotInfoChangeService.OpLotItem>? _items;
    private HashSet<BatchLotInfoChangeService.OpLotItem> _selectedItems = [];

    private bool CanChange => _selectedItems.Count > 0 && !string.IsNullOrWhiteSpace(_attributeName) && !string.IsNullOrWhiteSpace(_empId);

    private void OnSelectionChanged(HashSet<BatchLotInfoChangeService.OpLotItem> items) { _selectedItems = items; }

    private async Task SearchAsync()
    {
        _loading = true; _error = ""; _selectedItems = []; StateHasChanged();
        try {
            var r = await Svc.GetOpLotListAsync(_opId.Trim(), _stepId.Trim(), _wpId.Trim());
            if (!r.IsSuccess) { _error = r.ErrorMessage; _items = null; return; }
            _items = r.Items;
        } finally { _loading = false; }
    }

    private async Task ChangeAsync()
    {
        _changing = true; _error = ""; StateHasChanged();
        try {
            var ids = _selectedItems.Select(x => x.LotId).ToList();
            var r = await Svc.ChangeAttributesAsync(ids, _attributeName.Trim(), _newValue.Trim(), _empId.Trim());
            if (!r.IsSuccess) { _error = r.ErrorMessage; Snackbar.Add(r.ErrorMessage, Severity.Error); return; }
            Snackbar.Add("一括変更しました。", Severity.Success);
            _selectedItems = []; await SearchAsync();
        } finally { _changing = false; }
    }
}

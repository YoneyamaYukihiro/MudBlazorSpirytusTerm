@page "/special-flow"
@inject ISnackbar Snackbar
@inject SpecialFlowService Svc

<PageTitle>SPIRYTUS - 特殊流動(リワーク・追加・先行) (EN00Y0)</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" />
}

<MudText Typo="Typo.h6" Class="mb-3">特殊流動(リワーク・追加・先行) (EN00Y0)</MudText>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = string.Empty">
        @_errorMessage
    </MudAlert>
}

@* ────── 処理区分 + キャリアID ────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="string" @bind-Value="_classDivision"
                       Label="処理区分"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="_loading">
                <MudSelectItem Value="@("RW")">リワーク (RW)</MudSelectItem>
                <MudSelectItem Value="@("AD")">追加 (AD)</MudSelectItem>
                <MudSelectItem Value="@("PR")">先行 (PR)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudTextField T="string"
                          Value="@_carrierId"
                          ValueChanged="@((string v) => _carrierId = (v ?? "").ToUpperInvariant())"
                          Label="キャリアID"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="6"
                          Immediate="true"
                          HelperText="Enterキーで照合"
                          Error="@_carrierError"
                          OnKeyUp="OnCarrierKeyUp"
                          Disabled="_loading"
                          Style="font-family: monospace; letter-spacing: 0.1em; text-transform: uppercase;" />
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="FetchAsync"
                       Disabled="@(_loading || string.IsNullOrWhiteSpace(_carrierId))">
                @if (_loading && !_fetched)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    <span>照合中...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-1" Size="Size.Small" />
                    <span>照合</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ────── ロット情報 + 特殊流動設定 ────── *@
@if (_fetched)
{
    <MudGrid Spacing="2" Class="mb-3">

        @* ── ロット情報 ── *@
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">ロット情報</MudText>
                <MudGrid Spacing="1">
                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">ロットID</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body1"><b>@_lotId</b></MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">機種ID</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_pdId</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">ロット状態</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_nowSt</MudText></MudItem>

                    <MudItem xs="5"><MudText Typo="Typo.body2" Class="mud-text-secondary">WF枚数</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_wfNum 枚</MudText></MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        @* ── 特殊流動設定 ── *@
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">特殊流動設定</MudText>
                <MudGrid Spacing="2">
                    @if (_classDivision == "RW")
                    {
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_reworkReason"
                                          Label="リワーク原因 (大分類)"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          MaxLength="10"
                                          Disabled="_loading" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_reworkSubReason"
                                          Label="リワーク原因 (小分類)"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          MaxLength="10"
                                          Disabled="_loading" />
                        </MudItem>
                    }
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_toOpId"
                                      Label="リワーク先 大工程ID"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="10"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_toStepId"
                                      Label="リワーク先 小工程ID"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="10"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_empId"
                                      Label="作業者ID"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="10"
                                      Disabled="_loading" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_comments"
                                      Label="作業メモ"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="3"
                                      MaxLength="256"
                                      Disabled="_loading" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ── ガイダンスメッセージ ── *@
    @if (!string.IsNullOrEmpty(_guidMsg))
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            [@_guidMsgCode] @_guidMsg
        </MudAlert>
    }

    @* ────── ボタン ────── *@
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.SettingsBackupRestore"
                   OnClick="ConfirmAsync"
                   Disabled="_loading">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                <span>処理中...</span>
            }
            else
            {
                <span>特殊流動確定</span>
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Clear"
                   OnClick="ClearAll" Disabled="_loading">
            クリア
        </MudButton>
    </MudStack>
}

@code {
    private string _classDivision   = "RW";
    private string _carrierId       = "";
    private string _lotId           = "";
    private string _pdId            = "";
    private string _nowSt           = "";
    private string _wfNum           = "";
    private string _lotLastUpdate   = "";
    private string _toOpId          = "";
    private string _toStepId        = "";
    private string _empId           = "";
    private string _comments        = "";
    private string _reworkReason    = "";
    private string _reworkSubReason = "";
    private bool   _carrierError    = false;
    private bool   _loading         = false;
    private bool   _fetched         = false;
    private string _errorMessage    = "";
    private string _guidMsg         = "";
    private string _guidMsgCode     = "";

    private async Task OnCarrierKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await FetchAsync();
    }

    private async Task FetchAsync()
    {
        _carrierError = false;
        if (string.IsNullOrWhiteSpace(_carrierId)) return;
        if (_carrierId.Length != 6) { _carrierError = true; return; }

        _loading      = true;
        _fetched      = false;
        _errorMessage = "";
        StateHasChanged();

        var result = await Svc.GetCarrierStateAsync(_carrierId);
        _loading = false;

        if (!result.IsSuccess)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _fetched       = true;
        _lotId         = result.LotId;
        _pdId          = result.PdId;
        _nowSt         = result.NowSt;
        _wfNum         = result.WfNum;
        _lotLastUpdate = result.LotLastUpdate;
        Snackbar.Add($"ロット {_lotId} を取得しました。", Severity.Info);
    }

    private async Task ConfirmAsync()
    {
        _loading = true;
        _guidMsg = "";
        StateHasChanged();

        var result = await Svc.RegisterAsync(
            _lotId, _classDivision, _toOpId, _toStepId, _empId, _lotLastUpdate,
            _reworkReason, _reworkSubReason, _comments);
        _loading = false;

        if (!result.IsSuccess)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        _guidMsg     = result.GuidanceMsg;
        _guidMsgCode = result.GuidanceMsgCode;
        Snackbar.Add($"特殊流動({_classDivision})を登録しました。 ロット: {_lotId}", Severity.Success);
        ClearAll();
    }

    private void ClearAll()
    {
        _carrierId       = "";
        _carrierError    = false;
        _fetched         = false;
        _lotId           = "";
        _pdId            = "";
        _nowSt           = "";
        _wfNum           = "";
        _lotLastUpdate   = "";
        _toOpId          = "";
        _toStepId        = "";
        _empId           = "";
        _comments        = "";
        _reworkReason    = "";
        _reworkSubReason = "";
        _errorMessage    = "";
        _guidMsg         = "";
        _guidMsgCode     = "";
    }
}

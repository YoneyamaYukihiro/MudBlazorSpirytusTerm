@page "/cmp-maintenance"
@inject CmpMaintenanceService Svc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - CMPメンテナンス (EN01N0)</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">CMPメンテナンス (EN01N0)</MudText>
<div class="page-wrapper">

<MudPaper Class="pa-3 mb-2" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_wpId" Label="装置ID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="20" Immediate="true"
                          OnKeyDown="OnKeyDownAsync" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                       Disabled="@(!CanSearch || _loading)" OnClick="SearchAsync">
                @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>検索中...</span> }
                else { <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="mr-1" /><span>検索</span> }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = string.Empty">@_error</MudAlert>
}
@if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" /> }

@if (_items is not null)
{
    <MudPaper Class="pa-2" Elevation="1">
        <MudDataGrid T="CmpMaintenanceService.CmpItem" Items="_items" Dense="true" Hover="true"
                     ReadOnly="true" Striped="true" SelectedItem="_selected"
                     SelectedItemChanged="OnRowSelected">
            <Columns>
                <PropertyColumn Property="x => x.WpId"         Title="装置ID"   />
                <PropertyColumn Property="x => x.WpName"       Title="装置名"   />
                <PropertyColumn Property="x => x.HeadNo"       Title="ヘッドNo" />
                <PropertyColumn Property="x => x.PlatenNo"     Title="プラテンNo"/>
                <PropertyColumn Property="x => x.CurrentRate"  Title="現レート" />
                <PropertyColumn Property="x => x.TargetRate"   Title="目標レート"/>
                <PropertyColumn Property="x => x.StatusName"   Title="状態"     />
            </Columns>
        </MudDataGrid>
    </MudPaper>

    @if (_selected is not null)
    {
        <MudPaper Class="pa-3 mt-2" Elevation="1">
            <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                <MudItem xs="12" sm="2">
                    <MudTextField @bind-Value="_newRate" Label="新レート" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" MaxLength="10" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudTextField @bind-Value="_empId" Label="社員ID" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" MaxLength="10" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium"
                               Disabled="@(!CanChange || _changing)" OnClick="ChangeRateAsync">
                        @if (_changing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>処理中...</span> }
                        else { <span>レート変更</span> }
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
}

</div>

@code {
    private string _wpId    = "";
    private string _newRate = "";
    private string _empId   = "";
    private string _error   = "";
    private bool   _loading, _changing;
    private IReadOnlyList<CmpMaintenanceService.CmpItem>? _items;
    private CmpMaintenanceService.CmpItem? _selected;

    private bool CanSearch => !string.IsNullOrWhiteSpace(_wpId);
    private bool CanChange => _selected is not null && !string.IsNullOrWhiteSpace(_newRate) && !string.IsNullOrWhiteSpace(_empId);

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    { if (e.Key == "Enter" && CanSearch && !_loading) await SearchAsync(); }

    private void OnRowSelected(CmpMaintenanceService.CmpItem? item) { _selected = item; }

    private async Task SearchAsync()
    {
        _loading = true; _error = ""; _selected = null; StateHasChanged();
        try {
            var r = await Svc.GetCmpListAsync(_wpId.Trim());
            if (!r.IsSuccess) { _error = r.ErrorMessage; _items = null; return; }
            _items = r.Items;
        } finally { _loading = false; }
    }

    private async Task ChangeRateAsync()
    {
        if (_selected is null) return;
        _changing = true; _error = ""; StateHasChanged();
        try {
            var r = await Svc.ChangeRateAsync(_selected.WpId, _selected.HeadNo, _selected.PlatenNo,
                _newRate.Trim(), _empId.Trim(), _selected.MsgVer);
            if (!r.IsSuccess) { _error = r.ErrorMessage; Snackbar.Add(r.ErrorMessage, Severity.Error); return; }
            Snackbar.Add("レートを変更しました。", Severity.Success);
            _selected = null; _newRate = ""; await SearchAsync();
        } finally { _changing = false; }
    }
}

@page "/lot-throwin-assembly"
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - ロット投入(組立) (EN00Q0)</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" />
}

<MudText Typo="Typo.h6" Class="mb-3">ロット投入(組立) (EN00Q0)</MudText>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = string.Empty">
        @_errorMessage
    </MudAlert>
}

@* ────── 投入ロット一覧 ────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">投入ロット一覧</MudText>
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="12" sm="4" md="3">
            <MudTextField T="string"
                          Value="@_carrierId"
                          ValueChanged="@((string v) => _carrierId = (v ?? "").ToUpperInvariant())"
                          Label="キャリアID"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="6"
                          Immediate="true"
                          HelperText="Enterキーで追加"
                          OnKeyUp="OnCarrierKeyUp"
                          Disabled="_loading"
                          Style="font-family: monospace; letter-spacing: 0.1em; text-transform: uppercase;" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddCarrierToListAsync"
                       Disabled="@(_loading || string.IsNullOrWhiteSpace(_carrierId))">
                追加
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (_lotList.Count > 0)
    {
        <MudTable T="LotRow" Items="_lotList" Dense="true" Hover="true"
                  @bind-SelectedItem="_selectedLot" Elevation="0" Class="mt-3">
            <HeaderContent>
                <MudTh>No.</MudTh>
                <MudTh>キャリアID</MudTh>
                <MudTh>ロットID</MudTh>
                <MudTh>種別</MudTh>
                <MudTh>WF枚数</MudTh>
                <MudTh>チップ枚数</MudTh>
                <MudTh>コメント</MudTh>
                <MudTh>送品先</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.RowNo</MudTd>
                <MudTd>@context.CarrierId</MudTd>
                <MudTd><b>@context.LotId</b></MudTd>
                <MudTd>@context.FlowClass</MudTd>
                <MudTd>@context.WfNum</MudTd>
                <MudTd>@context.ChipNum</MudTd>
                <MudTd>@(context.HasComment ? "有" : "")</MudTd>
                <MudTd>@context.SendSbName</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => RemoveLot(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@* ────── 投入設定 ────── *@
@if (_lotList.Count > 0)
{
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">投入設定</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4" md="3">
                <MudTextField @bind-Value="_pdId"
                              Label="機種ID"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="20"
                              Disabled="_loading" />
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudTextField @bind-Value="_flowClass"
                              Label="種別区分"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="4"
                              Disabled="_loading" />
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudTextField @bind-Value="_entryId"
                              Label="エントリID"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="20"
                              Disabled="_loading" />
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudTextField @bind-Value="_empId"
                              Label="作業者ID"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="10"
                              Disabled="_loading" />
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudTextField @bind-Value="_engEmpId"
                              Label="ロット担当者ID"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="10"
                              Disabled="_loading" />
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudTextField @bind-Value="_lotPriority"
                              Label="優先度"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="4"
                              Disabled="_loading" />
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_comments"
                              Label="コメント(作業メモ)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="2"
                              MaxLength="256"
                              Disabled="_loading" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ────── ボタン ────── *@
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Input"
                   OnClick="ConfirmThrowinAsync"
                   Disabled="@(_loading || _lotList.Count == 0)">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                <span>処理中...</span>
            }
            else
            {
                <span>投入確定</span>
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Clear"
                   OnClick="ClearAll" Disabled="_loading">
            クリア
        </MudButton>
    </MudStack>
}

@code {
    private string  _carrierId   = "";
    private string  _pdId        = "";
    private string  _flowClass   = "";
    private string  _entryId     = "";
    private string  _empId       = "";
    private string  _engEmpId    = "";
    private string  _lotPriority = "1";
    private string  _comments    = "";
    private bool    _loading     = false;
    private string  _errorMessage = "";

    private List<LotRow> _lotList    = [];
    private LotRow?      _selectedLot;

    private sealed record LotRow(
        int    RowNo,
        string CarrierId,
        string LotId,
        string FlowClass,
        string WfNum,
        string ChipNum,
        bool   HasComment,
        string SendSbName
    );

    private async Task OnCarrierKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddCarrierToListAsync();
    }

    private async Task AddCarrierToListAsync()
    {
        if (string.IsNullOrWhiteSpace(_carrierId)) return;
        _loading = true;
        StateHasChanged();

        // 実装中 - lot_.curstate で照合後ロット追加
        await Task.Delay(200);
        var rowNo = _lotList.Count + 1;
        _lotList.Add(new LotRow(
            RowNo:      rowNo,
            CarrierId:  _carrierId,
            LotId:      $"LOT{rowNo:D4}",
            FlowClass:  "",
            WfNum:      "0",
            ChipNum:    "0",
            HasComment: false,
            SendSbName: ""));
        _carrierId = "";
        _loading   = false;
        Snackbar.Add($"キャリア {_carrierId} を追加しました。", Severity.Info);
    }

    private void RemoveLot(LotRow row) => _lotList.Remove(row);

    private async Task ConfirmThrowinAsync()
    {
        if (_lotList.Count == 0) return;
        _loading = true;
        StateHasChanged();

        // 実装中 - lot_.asmthrowin_ 送信
        await Task.Delay(500);
        _loading = false;
        Snackbar.Add("ロット投入(組立)を登録しました。", Severity.Success);
        ClearAll();
    }

    private void ClearAll()
    {
        _carrierId    = "";
        _pdId         = "";
        _flowClass    = "";
        _entryId      = "";
        _empId        = "";
        _engEmpId     = "";
        _lotPriority  = "1";
        _comments     = "";
        _lotList      = [];
        _selectedLot  = null;
        _errorMessage = "";
    }
}

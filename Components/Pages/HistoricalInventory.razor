@page "/historical-inventory"
@inject HistoricalInventoryService Svc

<PageTitle>SPIRYTUS - 過去在庫一覧 (EN01Y0)</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">過去在庫一覧 (EN01Y0)</MudText>
<div class="page-wrapper">

<MudPaper Class="pa-3 mb-2" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_fromDate" Label="開始日" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="8" Placeholder="YYYYMMDD" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_toDate" Label="終了日" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="8" Placeholder="YYYYMMDD" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_pdId" Label="品種ID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="20" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField @bind-Value="_opId" Label="OP ID" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="20" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                       Disabled="@_loading" OnClick="SearchAsync">
                @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /><span>検索中...</span> }
                else { <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="mr-1" /><span>検索</span> }
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="() => _error = string.Empty">@_error</MudAlert>
}
@if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" /> }

@if (_items is not null)
{
    <MudPaper Class="pa-2" Elevation="1">
        <MudDataGrid T="HistoricalInventoryService.SnapshotItem" Items="_items" Dense="true" Hover="true" ReadOnly="true" Striped="true">
            <Columns>
                <PropertyColumn Property="x => x.LotId"        Title="ロットID"     />
                <PropertyColumn Property="x => x.CarrierId"    Title="キャリアID"   />
                <PropertyColumn Property="x => x.PdId"         Title="品種"         />
                <PropertyColumn Property="x => x.PdName"       Title="品種名"       />
                <PropertyColumn Property="x => x.FlowClass"    Title="フロー区分"   />
                <PropertyColumn Property="x => x.OpId"         Title="OP ID"       />
                <PropertyColumn Property="x => x.StepId"       Title="Step ID"     />
                <PropertyColumn Property="x => x.WpId"         Title="装置ID"      />
                <PropertyColumn Property="x => x.WpName"       Title="装置名"      />
                <PropertyColumn Property="x => x.SnapshotDate" Title="スナップショット日時" />
                <PropertyColumn Property="x => x.WfNum"        Title="枚数"         />
                <PropertyColumn Property="x => x.Status"       Title="状態"         />
            </Columns>
        </MudDataGrid>
    </MudPaper>
}

</div>

@code {
    private string _fromDate = "";
    private string _toDate   = "";
    private string _pdId     = "";
    private string _opId     = "";
    private string _error    = "";
    private bool   _loading;
    private IReadOnlyList<HistoricalInventoryService.SnapshotItem>? _items;

    private async Task SearchAsync()
    {
        _loading = true; _error = ""; StateHasChanged();
        try {
            var r = await Svc.GetSnapshotListAsync(_fromDate.Trim(), _toDate.Trim(), _pdId.Trim(), _opId.Trim());
            if (!r.IsSuccess) { _error = r.ErrorMessage; _items = null; return; }
            _items = r.Items;
        } finally { _loading = false; }
    }
}

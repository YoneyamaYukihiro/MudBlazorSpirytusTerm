@page "/cf-lot-composition"
@inject CfLotCompositionService CfLotSvc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - CFロット編成 (EN00B0)</PageTitle>

<MudText Typo="Typo.h6" Class="mb-3">CFロット編成 (EN00B0)</MudText>

@* ────────────────────── エラーアラート ────────────────────── *@
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = string.Empty">
        @_errorMessage
    </MudAlert>
}

@* ────────────────────── 入力エリア ────────────────────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">基本情報</MudText>
    <MudGrid Spacing="2" AlignItems="AlignItems.End">

        @* キャリアID *@
        <MudItem xs="12" sm="6" md="3">
            <MudTextField Label="キャリアID"
                          @bind-Value="_carrierId"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="_loading"
                          Immediate="false" />
        </MudItem>

        @* 作業者ID *@
        <MudItem xs="12" sm="6" md="2">
            <MudTextField Label="作業者ID"
                          @bind-Value="_empId"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="_loading"
                          Immediate="false" />
        </MudItem>

        @* 投入数 *@
        <MudItem xs="12" sm="6" md="2">
            <MudTextField Label="投入数"
                          @bind-Value="_num"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="_loading"
                          Immediate="false" />
        </MudItem>

        @* 機種ID *@
        <MudItem xs="12" sm="6" md="2">
            <MudTextField Label="機種ID"
                          @bind-Value="_pdId"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="_loading"
                          Immediate="false" />
        </MudItem>

        @* 画面サイズ *@
        <MudItem xs="12" sm="6" md="2">
            @if (_screenSizesLoading)
            {
                <MudTextField Label="画面サイズ" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Disabled="true" Value="@("読込中...")" />
            }
            else
            {
                <MudSelect T="string"
                           Label="画面サイズ"
                           @bind-Value="_screenSizeId"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Disabled="_loading">
                    <MudSelectItem Value="@string.Empty">-- 選択 --</MudSelectItem>
                    @foreach (var s in _screenSizes)
                    {
                        <MudSelectItem Value="@s.ScreenSizeId">@s.ScreenSizeId (詰数: @s.ChipCount)</MudSelectItem>
                    }
                </MudSelect>
            }
        </MudItem>

        @* ロット担当者ID *@
        <MudItem xs="12" sm="6" md="2">
            <MudTextField Label="ロット担当者ID"
                          @bind-Value="_engEmpId"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="_loading"
                          Immediate="false" />
        </MudItem>

        @* 投入装置ID *@
        <MudItem xs="12" sm="6" md="2">
            <MudTextField Label="投入装置ID"
                          @bind-Value="_wpId"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="_loading"
                          Immediate="false" />
        </MudItem>

        @* エントリID *@
        <MudItem xs="12" sm="6" md="2">
            <MudTextField Label="エントリID"
                          @bind-Value="_entryId"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="_loading"
                          Immediate="false" />
        </MudItem>

    </MudGrid>
</MudPaper>

@* ────────────────────── パレットマップ ────────────────────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudText Typo="Typo.subtitle2" Class="mb-2 mud-text-secondary">
        パレットマップ (スロット数: @_paletteSlots)
    </MudText>

    <div style="overflow-x:auto;">
        <MudSimpleTable Dense="true" Bordered="true" Style="min-width:600px;font-size:0.8rem;">
            <thead>
                <tr>
                    <th style="min-width:60px;">スロット</th>
                    <th style="min-width:140px;">パレットID</th>
                    <th style="min-width:80px;">チップ数</th>
                    <th style="min-width:140px;">ロットID</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < _paletteItems.Count; i++)
                {
                    var idx = i;   // capture
                    <tr>
                        <td style="text-align:center;">@(i + 1)</td>
                        <td>
                            <MudTextField @bind-Value="_paletteItems[idx].PaletteId"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Disabled="_loading"
                                          Immediate="false"
                                          Style="font-size:0.8rem;" />
                        </td>
                        <td>
                            <MudTextField @bind-Value="_paletteItems[idx].ChipCount"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Disabled="_loading"
                                          Immediate="false"
                                          Style="font-size:0.8rem;" />
                        </td>
                        <td>
                            <MudTextField @bind-Value="_paletteItems[idx].LotId"
                                          Variant="Variant.Text"
                                          Margin="Margin.Dense"
                                          Disabled="_loading"
                                          Immediate="false"
                                          Style="font-size:0.8rem;" />
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </div>

    @* スロット数変更 *@
    <div class="mt-2" style="display:flex;gap:8px;align-items:center;">
        <MudText Typo="Typo.caption">スロット数:</MudText>
        <MudNumericField T="int"
                         Value="_paletteSlots"
                         ValueChanged="OnSlotCountChanged"
                         Min="1" Max="18"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Style="width:80px;"
                         Disabled="_loading" />
    </div>
</MudPaper>

@* ────────────────────── 操作ボタン ────────────────────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="RegisterAsync"
                       Disabled="@(_loading || !CanRegister)"
                       StartIcon="@Icons.Material.Filled.Save">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    <span>送信中...</span>
                }
                else
                {
                    <span>CFロット編成登録</span>
                }
            </MudButton>
        </MudItem>
        <MudItem>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       OnClick="ClearForm"
                       Disabled="_loading"
                       StartIcon="@Icons.Material.Filled.Clear">
                クリア
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ────────────────────── ガイダンスメッセージ ────────────────────── *@
@if (!string.IsNullOrEmpty(_guidMsg))
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2"
              ShowCloseIcon="true" CloseIconClicked="() => _guidMsg = string.Empty">
        @_guidMsg
        @if (!string.IsNullOrEmpty(_returnLotId))
        {
            <span class="ml-2">投入ロットID: <strong>@_returnLotId</strong></span>
        }
    </MudAlert>
}

@* ────────────────────── ローディングバー ────────────────────── *@
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" />
}

@code {
    // ── 状態 ──────────────────────────────────────────────────────
    private bool    _loading;
    private string  _errorMessage = string.Empty;
    private string  _guidMsg      = string.Empty;
    private string  _returnLotId  = string.Empty;

    // ── 画面サイズマスタ ─────────────────────────────────────────
    private bool _screenSizesLoading;
    private IReadOnlyList<CfLotCompositionService.ScreenSizeEntry> _screenSizes = [];
    private string _screenSizeId = string.Empty;

    // ── 入力フィールド ───────────────────────────────────────────
    // VBソース: cmbScreenSize / txtCarrierId / txtEmpID / txtNum / cmbProduct / txtTechManID / cmbThrowinWPList / cmbEntryID

    private string _carrierId = string.Empty;
    private string _empId     = string.Empty;
    private string _num       = string.Empty;
    private string _pdId      = string.Empty;
    private string _entryId   = string.Empty;
    private string _engEmpId  = string.Empty;
    private string _wpId      = string.Empty;

    // ── パレットマップ ────────────────────────────────────────────
    // VBソース: CMlngtxtPaletteE = 17 → 18スロット (0～17)
    private int _paletteSlots = 18;

    private List<PaletteSlotModel> _paletteItems = Enumerable.Range(0, 18)
        .Select(i => new PaletteSlotModel { SlotIndex = i })
        .ToList();

    // ── 登録可否チェック ─────────────────────────────────────────
    private bool CanRegister =>
        !string.IsNullOrWhiteSpace(_carrierId) &&
        !string.IsNullOrWhiteSpace(_empId);

    // ── 初期化 ────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _screenSizesLoading = true;
        try
        {
            var result = await CfLotSvc.GetScreenSizeListAsync();
            if (result.IsSuccess && result.Items is not null)
            {
                _screenSizes = result.Items;
                // 1件のみの場合は自動選択 (VBソース: cmbScreenSize.ListCount = 1)
                if (_screenSizes.Count == 1)
                    _screenSizeId = _screenSizes[0].ScreenSizeId;
            }
            else
            {
                _errorMessage = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"画面サイズマスタ取得エラー: {ex.Message}";
        }
        finally
        {
            _screenSizesLoading = false;
        }
    }

    // ── スロット数変更 ────────────────────────────────────────────
    private void OnSlotCountChanged(int newCount)
    {
        _paletteSlots = newCount;
        while (_paletteItems.Count < newCount)
            _paletteItems.Add(new PaletteSlotModel { SlotIndex = _paletteItems.Count });
        while (_paletteItems.Count > newCount)
            _paletteItems.RemoveAt(_paletteItems.Count - 1);
    }

    // ── CFロット編成登録 ──────────────────────────────────────────
    private async Task RegisterAsync()
    {
        _loading      = true;
        _errorMessage = string.Empty;
        _guidMsg      = string.Empty;
        _returnLotId  = string.Empty;

        try
        {
            // パレットマップ構築: パレットIDが設定されているスロットのみ送信
            // VBソース: If .typPaletteMapList(llngCnt).strPaletteID <> vbNullString Then
            var paletteMap = _paletteItems
                .Where(p => !string.IsNullOrWhiteSpace(p.PaletteId))
                .Select(p => new CfLotCompositionService.PaletteMapItem(
                    SlotPosition: (p.SlotIndex + 1).ToString(),
                    PaletteId:    p.PaletteId.Trim(),
                    ChipCount:    p.ChipCount.Trim(),
                    LotId:        p.LotId.Trim()
                ))
                .ToList();

            var result = await CfLotSvc.RegisterCfLotAsync(
                carrierId:  _carrierId.Trim(),
                empId:      _empId.Trim(),
                num:        _num.Trim(),
                pdId:       _pdId.Trim(),
                entryId:    _entryId.Trim(),
                engEmpId:   _engEmpId.Trim(),
                wpId:       _wpId.Trim(),
                paletteMap: paletteMap);

            if (result.IsSuccess)
            {
                _returnLotId = result.ReturnLotId;
                _guidMsg     = string.IsNullOrEmpty(result.GuidMsg)
                    ? "CFロット編成登録が完了しました。"
                    : result.GuidMsg;
                Snackbar.Add("CFロット編成登録完了", Severity.Success);
            }
            else
            {
                _errorMessage = result.ErrorMessage;
                Snackbar.Add(result.ErrorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            Snackbar.Add($"通信エラー: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ── クリア ────────────────────────────────────────────────────
    private void ClearForm()
    {
        _carrierId    = string.Empty;
        _empId        = string.Empty;
        _num          = string.Empty;
        _pdId         = string.Empty;
        _entryId      = string.Empty;
        _engEmpId     = string.Empty;
        _wpId         = string.Empty;
        _screenSizeId = _screenSizes.Count == 1 ? _screenSizes[0].ScreenSizeId : string.Empty;
        _errorMessage = string.Empty;
        _guidMsg      = string.Empty;
        _returnLotId  = string.Empty;

        // パレットをリセット
        foreach (var p in _paletteItems)
            p.Clear();
    }

    // ── モデル ───────────────────────────────────────────────────

    /// <summary>パレットスロットの入力値モデル。</summary>
    private sealed class PaletteSlotModel
    {
        public int    SlotIndex { get; set; }
        public string PaletteId { get; set; } = string.Empty;
        public string ChipCount { get; set; } = string.Empty;
        public string LotId     { get; set; } = string.Empty;

        public void Clear()
        {
            PaletteId = string.Empty;
            ChipCount = string.Empty;
            LotId     = string.Empty;
        }
    }
}

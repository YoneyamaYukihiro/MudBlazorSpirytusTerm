@page "/abnormal-processing-list"
@inject AbnormalProcessingService AbnormalSvc
@inject ISnackbar Snackbar

<PageTitle>SPIRYTUS - 工程異常/不適合品処理票一覧 (EN00V0)</PageTitle>

<MudText Typo="Typo.h6" Class="mb-3">工程異常/不適合品処理票一覧 (EN00V0)</MudText>

@* ────────────────────── 検索エリア ────────────────────── *@
<MudPaper Class="pa-3 mb-2" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.End">

        @* 検索開始日 *@
        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker Label="開始日"
                           @bind-Date="_startDate"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="yyyy/MM/dd"
                           Disabled="_loading" />
        </MudItem>

        @* 検索終了日 *@
        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker Label="終了日"
                           @bind-Date="_endDate"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           DateFormat="yyyy/MM/dd"
                           Disabled="_loading" />
        </MudItem>

        @* 検索条件(状態) *@
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="string"
                       Label="状態フィルタ"
                       Value="_statusFilter"
                       ValueChanged="v => _statusFilter = v"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="_loading">
                <MudSelectItem Value="@("all")">全て</MudSelectItem>
                <MudSelectItem Value="@("0")">未処置</MudSelectItem>
                <MudSelectItem Value="@("1")">処置済</MudSelectItem>
                <MudSelectItem Value="@("2")">承認済</MudSelectItem>
            </MudSelect>
        </MudItem>

        @* 起案者ID *@
        <MudItem xs="12" sm="6" md="2">
            <MudTextField Label="起案者ID"
                          @bind-Value="_findEmpId"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="_loading"
                          Immediate="false" />
        </MudItem>

        @* 担当者ID *@
        <MudItem xs="12" sm="6" md="2">
            <MudTextField Label="担当者ID"
                          @bind-Value="_toEmpId"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="_loading"
                          Immediate="false" />
        </MudItem>

        @* 取得ボタン *@
        <MudItem xs="12" sm="6" md="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="LoadAsync"
                       Disabled="_loading"
                       StartIcon="@Icons.Material.Filled.Search">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    <span>取得中...</span>
                }
                else
                {
                    <span>最新取得</span>
                }
            </MudButton>
        </MudItem>

    </MudGrid>
</MudPaper>

@* ────────────────────── エラー / 件数 ────────────────────── *@
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" Style="height:4px;" />
}

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2"
              ShowCloseIcon="true" CloseIconClicked="() => _error = string.Empty">
        @_error
    </MudAlert>
}

@if (_fetched && _result?.IsSuccess == true)
{
    <MudText Typo="Typo.caption" Class="mb-1">
        情報取得日時 @_fetchTime.ToString("yyyy/MM/dd HH:mm:ss")　件数: @FilteredItems.Count 件
    </MudText>
}

@* ────────────────────── 処理票一覧 ────────────────────── *@
@if (_fetched && _result?.IsSuccess == true)
{
    <div style="overflow-x:auto;">
        <MudSimpleTable Dense="true" Bordered="true" Striped="true" Hover="true"
                        Style="min-width:1200px;font-size:0.78rem;">
            <thead>
                <tr>
                    <th style="min-width:35px;">№</th>
                    <th style="min-width:35px;">種</th>
                    <th style="min-width:40px;">状態</th>
                    <th style="min-width:145px;">発見日時</th>
                    <th style="min-width:100px;">起案者ID</th>
                    <th style="min-width:110px;">起案者名</th>
                    <th style="min-width:180px;">工程異常名</th>
                    <th style="min-width:85px;">発行№</th>
                    <th style="min-width:130px;">ロットID</th>
                    <th style="min-width:97px;">装置ID</th>
                    <th style="min-width:185px;">装置名</th>
                    <th style="min-width:80px;">大工程</th>
                    <th style="min-width:80px;">小工程</th>
                    <th style="min-width:80px;">処置名</th>
                    <th style="min-width:50px;">WF数</th>
                    <th style="min-width:145px;">更新日時</th>
                    <th style="min-width:100px;">依頼元ID</th>
                    <th style="min-width:110px;">依頼元名</th>
                    <th style="min-width:145px;">依頼日時</th>
                </tr>
            </thead>
            <tbody>
                @{ int rowNo = 1; }
                @foreach (var item in FilteredItems)
                {
                    <tr style="@GetRowStyle(item)">
                        <td style="text-align:right;">@rowNo</td>
                        <td style="text-align:center;font-weight:bold;">@DocClassLabel(item.DocClass)</td>
                        <td style="text-align:center;">@StatusLabel(item.ApprovalFlag, item.AllDisposalFlag)</td>
                        <td>@item.FindDate</td>
                        <td>@item.FindEmpId</td>
                        <td>@item.FindEmpName</td>
                        <td>@item.ExcpItemName</td>
                        <td>@item.ExcpNo</td>
                        <td>@(string.Join(", ", item.LotList.Select(l => l.LotId)))</td>
                        <td>@item.FindWpId</td>
                        <td>@item.FindWpName</td>
                        <td>@item.FindOpId</td>
                        <td>@item.FindStepId</td>
                        <td>@item.DispoName</td>
                        <td style="text-align:right;">@item.DispoWfNum</td>
                        <td>@item.EditTime</td>
                        <td>@item.FromEmpId</td>
                        <td>@item.FromEmpName</td>
                        <td>@item.FromEntryTime</td>
                    </tr>
                    rowNo++;
                }
            </tbody>
        </MudSimpleTable>
    </div>
}
else if (!_loading && _fetched)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
        該当データがありません。
    </MudText>
}
else if (!_loading && !_fetched)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
        検索条件を指定して「最新取得」を押してください。
    </MudText>
}

@code {
    // ── 状態 ──────────────────────────────────────────────────────
    private bool    _loading;
    private bool    _fetched;
    private string  _error       = string.Empty;
    private DateTime _fetchTime;
    private AbnormalProcessingService.ListResult? _result;

    // ── 検索条件 ─────────────────────────────────────────────────
    // VBソース: CMlngPeriod = 3 (検索期間3年)
    private DateTime? _startDate    = DateTime.Today.AddYears(-3);
    private DateTime? _endDate      = DateTime.Today;
    private string    _statusFilter = "all";
    private string    _findEmpId    = string.Empty;
    private string    _toEmpId      = string.Empty;

    // ── フィルタ済み一覧 ──────────────────────────────────────────
    private IReadOnlyList<AbnormalProcessingService.AbnormalItem> FilteredItems
    {
        get
        {
            if (_result?.Items is null) return [];
            if (_statusFilter == "all") return _result.Items;

            return _result.Items.Where(x =>
            {
                // 承認済: ApprovalFlag="2" / 処置済: AllDisposalFlag="1" かつ ApprovalFlag != "2" / 未処置: それ以外
                return _statusFilter switch
                {
                    "2" => x.ApprovalFlag == "2",
                    "1" => x.AllDisposalFlag == "1" && x.ApprovalFlag != "2",
                    "0" => x.AllDisposalFlag != "1" && x.ApprovalFlag != "2",
                    _   => true
                };
            }).ToList();
        }
    }

    // ── 初期化 ────────────────────────────────────────────────────
    protected override Task OnInitializedAsync() => Task.CompletedTask;

    // ── データ取得 ──────────────────────────────────────────────────
    private async Task LoadAsync()
    {
        _loading = true;
        _error   = string.Empty;
        _fetched = false;

        try
        {
            var start = (_startDate ?? DateTime.Today.AddYears(-3)).ToString("yyyy/MM/dd") + " 00:00:00";
            var end   = (_endDate   ?? DateTime.Today).ToString("yyyy/MM/dd")              + " 23:59:59";

            _result = await AbnormalSvc.GetListAsync(
                startDate:      start,
                endDate:        end,
                classDivision:  AbnormalProcessingService.ClassDivisionAll,
                findEmpId:      _findEmpId.Trim(),
                toEmpId:        _toEmpId.Trim());

            if (_result.IsSuccess)
            {
                _fetchTime = DateTime.Now;
                _fetched   = true;
                Snackbar.Add($"{_result.Items?.Count ?? 0} 件取得", Severity.Success);
            }
            else
            {
                _error = _result.ErrorMessage;
                Snackbar.Add(_result.ErrorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Snackbar.Add($"通信エラー: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ── 表示ヘルパー ──────────────────────────────────────────────

    /// <summary>
    /// 帳票種別ラベル。
    /// VBソース: CMstrExcp = "異" (工程異常), CMstrIngong = "不" (不適合品)
    /// </summary>
    private static string DocClassLabel(string docClass) => docClass switch
    {
        "0" => "異",
        "1" => "不",
        _   => docClass
    };

    /// <summary>
    /// 承認/処置状態ラベル。
    /// VBソース: CMstrApplyFlag="済" / CMstrDisposalFlag="処" / CMstrNoDisposalFlag="未"
    /// ApprovalFlag="2" → 承認済 / AllDisposalFlag="1" → 処置済 / それ以外 → 未処置
    /// </summary>
    private static string StatusLabel(string approvalFlag, string allDisposalFlag)
    {
        if (approvalFlag == "2")      return "済";
        if (allDisposalFlag == "1")   return "処";
        return "未";
    }

    /// <summary>
    /// 行背景色。
    /// 承認済 → 青系 / 処置済 → 緑系 / 未処置 → 白
    /// </summary>
    private static string GetRowStyle(AbnormalProcessingService.AbnormalItem item)
    {
        if (item.ApprovalFlag == "2")    return "background-color:#DDEEFF;";
        if (item.AllDisposalFlag == "1") return "background-color:#EEFFEE;";
        return string.Empty;
    }
}

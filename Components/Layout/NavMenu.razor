
<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">メインメニュー</MudNavLink>
    <MudDivider Class="my-2" />

    <MudNavGroup Title="流動系" Icon="@Icons.Material.Filled.Waves" Expanded="true">
        @foreach (var item in _flowMenuItems)
        {
            @if (item.Href == "#")
            {
                <MudNavLink Icon="@Icons.Material.Filled.ChevronRight" Disabled="true">@item.Title</MudNavLink>
            }
            else
            {
                <MudNavLink Href="@item.Href" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ChevronRight">@item.Title</MudNavLink>
            }
        }
    </MudNavGroup>

    <MudNavGroup Title="ツール系" Icon="@Icons.Material.Filled.Build" Expanded="false">
        @foreach (var item in _toolMenuItems)
        {
            @if (item.Href == "#")
            {
                <MudNavLink Icon="@Icons.Material.Filled.ChevronRight" Disabled="true">@item.Title</MudNavLink>
            }
            else
            {
                <MudNavLink Href="@item.Href" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ChevronRight">@item.Title</MudNavLink>
            }
        }
    </MudNavGroup>

    <MudNavGroup Title="お気に入り" Icon="@Icons.Material.Filled.Star" Expanded="false">
        <MudNavLink Icon="@Icons.Material.Outlined.Info" Disabled="true">登録なし</MudNavLink>
    </MudNavGroup>

</MudNavMenu>


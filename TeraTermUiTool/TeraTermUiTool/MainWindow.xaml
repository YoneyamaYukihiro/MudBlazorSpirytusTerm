<Window x:Class="TeraTermUiTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TeraTermUiTool.Views"
        Title="Tera Term UI Tool" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="8">
            <TabItem Header=" 接続 ">
                <views:ConnectionView x:Name="ConnectionTab"/>
            </TabItem>
            <TabItem Header=" マクロ作成 ">
                <views:MacroBuilderView x:Name="MacroTab"/>
            </TabItem>
            <TabItem Header=" ログ設定 ">
                <views:LogView x:Name="LogTab"/>
            </TabItem>
            <TabItem Header=" ファイル転送 ">
                <views:FileTransferView x:Name="FileTransferTab"/>
            </TabItem>
            <TabItem Header=" 設定 ">
                <views:SettingsView x:Name="SettingsTab"/>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="準備完了"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

<UserControl x:Class="TeraTermUiTool.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="プロファイル">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="新規" Click="OnNewProfile"/>
                    <Button Content="削除" Click="OnDeleteProfile"/>
                </StackPanel>
                <ListBox x:Name="ProfileList" SelectionChanged="OnProfileSelected"
                         DisplayMemberPath="Name"/>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="接続情報">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="プロファイル名"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameBox"/>

                <Label Grid.Row="1" Grid.Column="0" Content="プロトコル"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProtocolBox" SelectionChanged="OnProtocolChanged">
                    <ComboBoxItem Content="SSH2" Tag="Ssh2"/>
                    <ComboBoxItem Content="Telnet" Tag="Telnet"/>
                    <ComboBoxItem Content="Serial (COM)" Tag="Serial"/>
                </ComboBox>

                <Label Grid.Row="2" Grid.Column="0" Content="ホスト"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="HostBox"/>

                <Label Grid.Row="3" Grid.Column="0" Content="ポート"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="PortBox"/>

                <Label Grid.Row="4" Grid.Column="0" Content="ユーザー名"/>
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="UserBox"/>

                <Label Grid.Row="5" Grid.Column="0" Content="認証方式"/>
                <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="AuthBox" SelectionChanged="OnAuthChanged">
                    <ComboBoxItem Content="パスワード" Tag="Password"/>
                    <ComboBoxItem Content="公開鍵" Tag="PublicKey"/>
                    <ComboBoxItem Content="キーボード対話" Tag="KeyboardInteractive"/>
                </ComboBox>

                <Label Grid.Row="6" Grid.Column="0" Content="パスワード"/>
                <PasswordBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PasswordBox"/>

                <Label Grid.Row="7" Grid.Column="0" Content="鍵ファイル" x:Name="KeyLabel"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="KeyFileBox"/>
                <Button Grid.Row="7" Grid.Column="2" Content="参照..." Click="OnBrowseKey"/>

                <CheckBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" x:Name="SavePasswordBox"
                          Content="パスワードを保存する（DPAPI で暗号化）" Margin="4"/>

                <GroupBox Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Header="シリアル設定" x:Name="SerialGroup" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="COMポート"/>
                        <TextBox Grid.Column="1" x:Name="ComPortBox" Text="COM1"/>
                        <Label Grid.Column="2" Content="ボーレート"/>
                        <TextBox Grid.Column="3" x:Name="BaudBox" Text="9600"/>
                    </Grid>
                </GroupBox>

                <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                            Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="保存" Click="OnSave"/>
                    <Button Content="接続" Click="OnConnect" FontWeight="Bold" Background="#3478F6" Foreground="White"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
